	BCast = { Vector3.new(0.4, 1.0, -2.0), CFrame.Angles(math.rad(-90), 0, 0) },
	-- the wand, held low at your side and angled ahead (no body pose of its own: you stand up straight), and drawn up
	-- and back over the shoulder before a cast
	WHold = { Vector3.new(1.0, -0.2, -0.9), CFrame.Angles(math.rad(-55), 0, 0) },
	WDraw = { Vector3.new(1.1, 1.3, 0.2), CFrame.Angles(math.rad(-150), 0, 0) },
}
M.BodyFor = { BRead = "Read" } -- reading: head bowed over it

---------------------------------------------------------------------------
-- server: your actions (the client predicts them; this is the authority)
---------------------------------------------------------------------------
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local P, states, aliveChar, spend, setAction, cancelSwing, pose, bodyPose, setTrail, hitStopActor, playSound, SOUNDS, burst, damageEnemy, enemiesInSector, EnemiesFolder, now

local C = Config.Combat
local LATENCY = 0.12 -- the client predicts its own actions; give it this much slack

local function canStart(st, kind)
	local t = now()
	if kind == "Dodge" then
		return t >= st.dodgeAt - LATENCY
	end
	return t >= st.attackAt - LATENCY
end

-- which light attack in the chain comes next (server is the authority)
local function nextComboStep(st, kind, attacks)
	if kind ~= "Light" then
		return 1
	end
	if st.lastKind == "Light" and now() <= st.comboUntil then
		return st.lastStep % #attacks.Light + 1
	end
	return 1
end

local hitParams = OverlapParams.new()
hitParams.FilterType = Enum.RaycastFilterType.Include
hitParams.CollisionGroup = "HitQuery"

local function enemyModelOf(part)
	local m = part
	while m and m.Parent ~= EnemiesFolder do
		m = m.Parent
	end
	return m
end

local function bladeEnds(actor, weld) -- (weld: a dual-wielder's left sword's, else the main one)
	weld = weld or actor.weld
	local handle = weld and weld.Parent and weld.Part1
	if not handle or not handle.Parent then
		return nil
	end
	-- a scythe cuts from mid-haft out to its tip, not just along the blade
	local base = handle:FindFirstChild("HaftMid") or handle:FindFirstChild("BladeBase")
	local tip = handle:FindFirstChild("BladeTip")
	if not base or not tip then
		return nil
	end
	return base.WorldPosition, tip.WorldPosition
end

-- Hits land when the blade itself reaches the target: every frame of the swing
-- the blade's path since last frame is swept with small spheres along its length.
-- The weapon's Reach (Config.Weapons) stretches the swept blade outward from you (the
-- hit reaches this many times as far as the visible tip); the weapon itself looks the same.
local function runBladeSweep(player, st, a, id)
	local def = Config.weaponOf(player)
	local reach = a.Reach or def.Reach
	local _, _, me0 = aliveChar(player)
	local pathFrom = a.PathRadius and me0 and me0.Position -- (a dash's cut: the line you ran along)
	local damage = math.floor(a.Damage * Config.scaling(player, def) + 0.5) -- stats (def.Scaling)
	local hitSet = {}
	local hitCount = 0
	local t0 = now()
	local openAt, closeAt = a.Windup - 0.03, a.Windup + a.Swing + 0.05
	local prevBase, prevTip = {}, {}
	local usedFallback = false
	local conn

	local function land(m)
		if hitSet[m] then
			return
		end
		local h = m:FindFirstChildOfClass("Humanoid")
		if not h or h.Health <= 0 then
			return
		end
		hitSet[m] = true
		hitCount += 1
		damageEnemy(m, damage, player, a.Poise, a.HitStop)
		hitStopActor(st, a.HitStop, false)
		closeAt += a.HitStop or 0 -- the frozen blade gets that time back
	end

	conn = RunService.Heartbeat:Connect(function()
		local el = now() - t0
		if st.attackId ~= id or el > closeAt or not aliveChar(player) then
			conn:Disconnect()
			if Config.Debug then
				print(string.format("[Combat] %s %s hit %d enemy(s)%s", player.Name, a.Name or "attack", hitCount, usedFallback and " (fallback arc - no sword found)" or ""))
			end
			return
		end
		if el < openAt then
			return
		end
		local base, tip = bladeEnds(st)
		if not base then
			-- no sword (shouldn't happen): one simple arc check mid-swing
			if not usedFallback and el >= a.Windup + a.Swing * 0.5 then
				usedFallback = true
				local _, _, root = aliveChar(player)
				if root then
					for _, m in ipairs(enemiesInSector(root.CFrame, a.Range, a.HalfAngle)) do
						land(m)
					end
				end
			end
			return
		end
		local _, _, me = aliveChar(player)
		if me and pathFrom then
			for k = 0, 6 do
				for _, part in ipairs(workspace:GetPartBoundsInRadius(pathFrom:Lerp(me.Position, k / 6), a.PathRadius, hitParams)) do
					local m = enemyModelOf(part)
					if m then
						land(m)
					end
				end
			end
		end
		-- every blade you hold: the main one, and a dual-wielder's second
		for k, weld in ipairs(st.weld2 and { st.weld, st.weld2 } or { st.weld }) do
			local bs, ts = bladeEnds(st, weld)
			if bs then
				if me then
					ts = me.Position + (ts - me.Position) * reach
				end
				prevBase[k], prevTip[k] = prevBase[k] or bs, prevTip[k] or ts
				for i = 0, 3 do
					local f = i / 3
					local b, tp = prevBase[k]:Lerp(bs, f), prevTip[k]:Lerp(ts, f)
					for j = 0, 5 do
						local p = b:Lerp(tp, j / 5)
						for _, part in ipairs(workspace:GetPartBoundsInRadius(p, C.BladeRadius, hitParams)) do
							local m = enemyModelOf(part)
							if m then
								land(m)
							end
						end
					end
				end
				prevBase[k], prevTip[k] = bs, ts
			end
		end
	end)
end

local swing -- (below playerAttack)
local castFireball -- (below swing)
local castLaser -- (below castFireball)
local function playerAttack(player, kind, requestedStep, aim)
	local st = states[player]
	local attacks = Config.weaponOf(player).Attacks
	local list = attacks[kind]
	local char, _, hrp = aliveChar(player)
	if not (st and list and char) then
		return
	end
	if not canStart(st, "Attack") then
		return
	end
	local step = nextComboStep(st, kind, attacks)
	local a = list[math.min(step, #list)]
	if Config.Debug and requestedStep and requestedStep ~= step then
		print(string.format("[Combat] combo desync: client step %s, server step %d", tostring(requestedStep), step))
	end
	if not spend(st, a.Cost) then
		return
	end
	a.Name = a.Name or (kind .. step)
	local t = now()
	if a.Laser then
		st.laserStop, st.laserAim = false, aim and aim.Magnitude > 0.5 and aim.Unit or nil -- (castLaser, the client's hold)
	end
	st.healing = false
	st.lastKind, st.lastStep = kind, step
	if kind == "Running" then
		st.lastKind, st.lastStep = "Light", 2 -- a quick light after it comes out as the backhand
	end
	local total = a.Windup + a.Swing + a.Recover
	setAction(st, t, total, a.Windup + a.Swing + a.Recover * C.DodgeCancel, a.Windup + a.Swing + a.Recover * C.AttackCancel)
	st.comboUntil = t + total + C.ComboGrace
	st.attackId += 1
	local id = st.attackId

	swing(player, st, a, id, hrp, kind == "Heavy", aim)
end

-- one swing, from its windup: the blade's hits, and its poses back round to guard
function swing(player, st, a, id, hrp, heavy, aim)
	-- 1) GAMEPLAY: the swept-blade hit check (or, from a book, a fireball at the swing)
	if a.Fireball or a.Laser then
		task.delay(a.Windup, function()
			if st.attackId == id and aliveChar(player) then
				if a.Laser then
					castLaser(player, st, a, aim, id)
				else
					castFireball(player, st, a, aim)
				end
			end
		end)
	else
		runBladeSweep(player, st, a, id)
	end

	-- 2) VISUALS: windup -> swing -> follow-through -> back to guard
	local p1, p2, p3 = a.Poses[1], a.Poses[2], a.Poses[3]
	pose(st, p1, a.Windup)
	if a.Body then
		bodyPose(st, a.Body[1], a.Windup)
	end
	task.delay(a.Windup, function()
		if st.attackId ~= id or not aliveChar(player) then
			return
		end
		local def = Config.weaponOf(player)
		if not (a.Fireball or a.Laser) then -- (the books have their own sounds)
			playSound(hrp, def.SlashSound or (heavy and SOUNDS.Lunge or SOUNDS.Slash), 0.6, 0.9 + math.random() * 0.2)
			setTrail(st, true)
		end
		if def.Iai and not a.Draw then -- the Tachi's every cut crackles (the draw has its own)
			playSound(hrp, SOUNDS.Lightning[math.random(2, 3)], 0.7, 0.95 + math.random() * 0.1)
		end
		pose(st, p2, a.Swing * 0.45, Enum.EasingStyle.Linear)
		task.wait(a.Swing * 0.45)
		if st.attackId ~= id then
			return
		end
		pose(st, p3, a.Swing * 0.55)
		if a.Body then
			bodyPose(st, a.Body[2], a.Swing * 0.6)
		end
		task.wait(a.Swing * 0.55 + a.Recover * 0.3)
		if st.attackId ~= id then
			return
		end
		setTrail(st, false)
		pose(st, "Idle", a.Recover * 0.5)
	end)
end

-- a fireball (a.Fireball) from the book in your hand along aim (else straight ahead): flies
-- until it hits an enemy (damage x the weapon's Scaling), a wall, or runs out of Range
function castFireball(player, st, a, aim)
	local char, _, hrp = aliveChar(player)
	local F = a.Fireball
	local def = Config.weaponOf(player)
	local damage = math.floor(a.Damage * Config.scaling(player, def) + 0.5)
	local handle = st.weld and st.weld.Parent and st.weld.Part1
	local from = handle and handle.Position or hrp.Position + hrp.CFrame.LookVector * 2
	local dir = (aim and aim.Magnitude > 0.5) and aim.Unit or hrp.CFrame.LookVector
	-- a white-hot core inside a layered blaze, licking flames streaming off behind it,
	-- smoke and embers in its wake (Fire and emitters on an invisible carrier)
	local ball = Instance.new("Part")
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.one * F.Size * 0.55
	ball.Material = Enum.Material.Neon
	ball.Color = Color3.fromRGB(255, 220, 140)
	ball.Transparency = 0.15
	ball.Anchored, ball.CanCollide, ball.CanQuery, ball.CanTouch = true, false, false, false
	ball.CFrame = CFrame.new(from)
	local function emitter(texture, colors, size, life, rate, speed, extra)
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = texture
		pe.Color = ColorSequence.new(colors)
		pe.Size = size
		pe.Lifetime = life
		pe.Rate = rate
		pe.Speed = speed
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.LockedToPart = false -- (so they trail behind it)
		for k, v in pairs(extra or {}) do
			pe[k] = v
		end
		pe.Parent = ball
	end
	local FIRE, SMOKE, SPARK = "rbxasset://textures/particles/fire_main.dds", "rbxasset://textures/particles/smoke_main.dds", "rbxasset://textures/particles/sparkles_main.dds"
	local sz = F.Size
	emitter(FIRE, { ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 240, 170)), ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 140, 40)), ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 30, 10)) },
		NumberSequence.new({ NumberSequenceKeypoint.new(0, sz * 1.6), NumberSequenceKeypoint.new(1, sz * 0.4) }), NumberRange.new(0.15, 0.35), 90, NumberRange.new(0.5, 2),
		{ LightEmission = 0.9, Transparency = NumberSequence.new(0.1, 1), RotSpeed = NumberRange.new(-200, 200), Rotation = NumberRange.new(0, 360) })
	emitter(SMOKE, Color3.fromRGB(60, 44, 36), NumberSequence.new(sz * 0.8, sz * 2.2), NumberRange.new(0.4, 0.8), 25, NumberRange.new(0.5, 1.5),
		{ Transparency = NumberSequence.new(0.5, 1), RotSpeed = NumberRange.new(-60, 60) })
	emitter(SPARK, Color3.fromRGB(255, 190, 90), NumberSequence.new(0.15, 0), NumberRange.new(0.3, 0.7), 30, NumberRange.new(2, 6),
		{ LightEmission = 1, Acceleration = Vector3.new(0, -8, 0) })
	local fire = Instance.new("Fire")
	fire.Size, fire.Heat = sz * 3, 6
	fire.Color, fire.SecondaryColor = Color3.fromRGB(255, 120, 30), Color3.fromRGB(255, 220, 120)
	fire.Parent = ball
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness = Color3.fromRGB(255, 150, 60), 14, 2.5
	light.Parent = ball
	ball.Parent = workspace
	playSound(ball, SOUNDS.FireCast, 0.7, 0.9 + math.random() * 0.2)
	local wallParams = RaycastParams.new()
	wallParams.FilterDescendantsInstances = { char, EnemiesFolder, ball }
	wallParams.RespectCanCollide = true
	local pos, travelled, conn = from, 0, nil
	local function boom(at)
		conn:Disconnect()
		-- the carrier stops and goes dark while its flames and smoke burn out
		ball.Transparency = 1
		for _, d in ipairs(ball:GetChildren()) do
			if d:IsA("ParticleEmitter") or d:IsA("Fire") then
				d.Enabled = false
			end
		end
		light.Range = 18
		task.delay(0.15, light.Destroy, light)
		game:GetService("Debris"):AddItem(ball, 3)
		burst(at, Color3.fromRGB(255, 150, 50), 26, 0.45, 18)
		burst(at, Color3.fromRGB(255, 230, 150), 10, 0.25, 10)
		playSound(ball, SOUNDS.FireHit, 0.8, 0.9 + math.random() * 0.2)
	end
	conn = RunService.Heartbeat:Connect(function(dt)
		local step = math.min(F.Speed * dt, F.Range - travelled)
		local wall = workspace:Raycast(pos, dir * step, wallParams)
		local nextPos = wall and wall.Position or pos + dir * step
		-- swept in a few spheres so a fast ball can't skip over a thin enemy
		for i = 1, 3 do
			for _, part in ipairs(workspace:GetPartBoundsInRadius(pos:Lerp(nextPos, i / 3), F.Radius, hitParams)) do
				local m = enemyModelOf(part)
				local h = m and m:FindFirstChildOfClass("Humanoid")
				if h and h.Health > 0 then
					damageEnemy(m, damage, player, a.Poise, a.HitStop)
					boom(pos:Lerp(nextPos, i / 3))
					return
				end
			end
		end
		travelled += step
		pos = nextPos
		ball.CFrame = CFrame.new(pos)
		if wall or travelled >= F.Range then
			local burnable = wall and wall.Instance.Parent
			if burnable and burnable:GetAttribute("Burnable") then
				burnable:SetAttribute("Lit", true) -- (init.server burns it away: Map.Brushwood)
			end
			boom(pos)
		end
	end)
end

-- a dark beam (a.Laser) from the book in your hand along aim, for Duration s: every Tick it hurts each
-- enemy in it for Pct % of its MAX health (x the weapon's Scaling, so Darkness). Stops at the first wall;
-- a roll or a hit (which bump attackId) cuts it off.
local PURPLE, PURPLE_CORE = Color3.fromRGB(62, 20, 125), Color3.fromRGB(130, 80, 195)
local VIOLET, ABYSS = Color3.fromRGB(150, 40, 190), Color3.fromRGB(30, 14, 70) -- (the beam's colour drifts between these)
local SPARKLE, SMOKE_TEX = "rbxasset://textures/particles/sparkles_main.dds", "rbxasset://textures/particles/smoke_main.dds"
-- what keeps the beam from being a plain bar (made once a cast, moved every frame by laserFxStep): tendrils writhing
-- round it, a smoky sheath crawling along it, a sigil turning at the book (two rings, shards wheeling round them),
-- motes drifting off its whole length, and dark smoke and sparks pouring off the pages
local function laserFx(part, outer, L)
	local w = L.Width
	local fx = { tendrils = {}, shards = {}, rings = {} }
	local function ends()
		local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
		a0.Parent, a1.Parent = outer, outer
		return a0, a1
	end
	for i = 1, 3 do -- (three, a third of a turn apart, each on its own pair of attachments so it can twist)
		local a0, a1 = ends()
		local b = Instance.new("Beam")
		b.Attachment0, b.Attachment1 = a0, a1
		b.Texture, b.TextureMode, b.TextureLength, b.TextureSpeed = SPARKLE, Enum.TextureMode.Wrap, 4, 2 + i
		b.Color = ColorSequence.new(PURPLE_CORE, VIOLET)
		b.LightEmission, b.LightInfluence, b.Segments, b.FaceCamera = 1, 0, 24, true
		b.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.7, 0.35), NumberSequenceKeypoint.new(1, 1) })
		b.Parent = outer
		fx.tendrils[i] = { a0 = a0, a1 = a1, beam = b }
	end
	local haze = Instance.new("Beam")
	fx.h0, fx.h1 = ends()
	haze.Attachment0, haze.Attachment1 = fx.h0, fx.h1
	haze.Texture, haze.TextureMode, haze.TextureLength, haze.TextureSpeed = SMOKE_TEX, Enum.TextureMode.Wrap, 6, -1.5
	haze.Color, haze.LightEmission, haze.LightInfluence, haze.FaceCamera = ColorSequence.new(ABYSS, PURPLE), 0.4, 0, true
	haze.Transparency = NumberSequence.new(0.55, 1)
	haze.Parent = outer
	fx.haze = haze
	for i = 1, 2 do
		fx.rings[i] = part(Enum.PartType.Cylinder, i == 1 and PURPLE_CORE or VIOLET, 0.25)
	end
	for i = 1, 6 do
		local s = part(Enum.PartType.Block, i % 2 == 0 and PURPLE_CORE or VIOLET, 0.1)
		s.Size = Vector3.new(0.08, 0.08, 0.45) * w
		fx.shards[i] = s
	end
	-- motes off the beam's whole length (its outer box is the emitter's volume)
	local motes = Instance.new("ParticleEmitter")
	motes.Texture, motes.Shape, motes.ShapeStyle = SPARKLE, Enum.ParticleEmitterShape.Box, Enum.ParticleEmitterShapeStyle.Volume
	motes.Color = ColorSequence.new(PURPLE_CORE, VIOLET)
	motes.Size = NumberSequence.new(0.35 * w, 0)
	motes.Transparency = NumberSequence.new(0, 1)
	motes.Lifetime, motes.Speed, motes.SpreadAngle = NumberRange.new(0.35, 0.8), NumberRange.new(1, 4), Vector2.new(180, 180)
	motes.LightEmission, motes.Rate, motes.RotSpeed = 1, 60, NumberRange.new(-200, 200)
	motes.Parent = outer
	fx.motes = motes
	-- smoke and sparks off the pages, from the sigil's hub at the book
	local hub = part(Enum.PartType.Ball, PURPLE, 1)
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture, smoke.Color = SMOKE_TEX, ColorSequence.new(PURPLE, ABYSS)
	smoke.Size = NumberSequence.new(0.4 * w, 2 * w)
	smoke.Transparency = NumberSequence.new(0.4, 1)
	smoke.Lifetime, smoke.Speed, smoke.SpreadAngle = NumberRange.new(0.5, 1), NumberRange.new(1.5, 3), Vector2.new(60, 60)
	smoke.Rate, smoke.RotSpeed, smoke.Acceleration = 30, NumberRange.new(-60, 60), Vector3.new(0, 2, 0)
	smoke.Parent = hub
	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture, sparks.Color, sparks.LightEmission = SPARKLE, ColorSequence.new(PURPLE_CORE), 1
	sparks.Size = NumberSequence.new(0.25, 0)
	sparks.Lifetime, sparks.Speed, sparks.SpreadAngle, sparks.Rate = NumberRange.new(0.2, 0.45), NumberRange.new(6, 12), Vector2.new(70, 70), 40
	sparks.Parent = hub
	fx.emitters = { motes, smoke, sparks }
	fx.beams = { haze, fx.tendrils[1].beam, fx.tendrils[2].beam, fx.tendrils[3].beam }
	fx.parts = { hub, fx.rings[1], fx.rings[2], table.unpack(fx.shards) }
	fx.hub = hub
	return fx
end
-- one frame of it: o the book, tip where it burns, len between, t seconds since the cast
local function laserFxStep(fx, outer, core, flare, L, o, tip, len, t)
	local w = L.Width
	local pulse = 1 + 0.18 * math.sin(t * 14) + 0.08 * math.sin(t * 31)
	local shift = (math.sin(t * 2.6) + 1) / 2
	outer.Size = Vector3.new(w * pulse, w * pulse, len)
	core.Size = Vector3.new(w * 0.4 * (1 + 0.3 * math.sin(t * 22)), w * 0.4 * (1 + 0.3 * math.sin(t * 19 + 1)), len)
	outer.Color = PURPLE:Lerp(VIOLET, shift * 0.7):Lerp(ABYSS, (1 - shift) * 0.3)
	core.Color = PURPLE_CORE:Lerp(Color3.new(1, 1, 1), 0.15 + 0.15 * math.sin(t * 9))
	flare.Size = Vector3.one * w * (1.6 + 0.5 * math.sin(t * 11))
	-- (in the outer box's own space its +Z end is the book, -Z the tip)
	local curve = math.min(len * 0.1, 3.5) * w
	for i, td in ipairs(fx.tendrils) do
		local a = math.deg(t * (4 + i * 0.7)) + i * 120
		td.a0.Position, td.a1.Position = Vector3.new(0, 0, len / 2), Vector3.new(0, 0, -len / 2)
		td.a0.Orientation = Vector3.new(0, 0, a)
		td.a1.Orientation = Vector3.new(0, 0, a + 140 + 60 * math.sin(t * 3 + i))
		td.beam.CurveSize0 = curve * (0.6 + 0.4 * math.sin(t * 5 + i * 2))
		td.beam.CurveSize1 = -curve * (0.6 + 0.4 * math.cos(t * 4 + i))
		local tw = w * (0.35 + 0.15 * math.sin(t * 13 + i * 2))
		td.beam.Width0, td.beam.Width1 = tw * 1.4, tw * 0.5
	end
	fx.h0.Position, fx.h1.Position = Vector3.new(0, 0, len / 2), Vector3.new(0, 0, -len / 2)
	fx.haze.Width0, fx.haze.Width1 = w * (2.6 + 0.6 * math.sin(t * 6)), w * (1.4 + 0.4 * math.sin(t * 7 + 2))
	fx.motes.Rate = math.clamp(len * 2.5, 10, 150)
	-- the sigil at the book: two rings breathing out of step, shards wheeling round them, tumbling
	local face = CFrame.lookAt(o, tip)
	fx.hub.CFrame = face
	for i, r in ipairs(fx.rings) do
		local d = w * (i == 1 and 2.2 or 3.2) * (1 + 0.15 * math.sin(t * 6 + i * 2))
		r.Size = Vector3.new(0.06, d, d)
		r.Transparency = 0.2 + 0.3 * (math.sin(t * 8 + i * 3) + 1) / 2
		r.CFrame = face * CFrame.new(0, 0, -0.4 * i * w) * CFrame.Angles(0, math.pi / 2, 0) -- (a cylinder's axis is its X: turned down the beam)
	end
	local rad = w * (1.6 + 0.35 * math.sin(t * 4))
	for i, s in ipairs(fx.shards) do
		local a = t * (i % 2 == 0 and 5 or -4) + i / #fx.shards * math.pi * 2
		s.CFrame = face * CFrame.new(math.cos(a) * rad, math.sin(a) * rad, -0.6 * w + 0.2 * math.sin(t * 7 + i)) * CFrame.Angles(t * 6 + i, t * 4, a)
	end
end
function castLaser(player, st, a, aim, id)
	local char, _, hrp = aliveChar(player)
	local L = a.Laser
	local def = Config.weaponOf(player)
	local mult = Config.scaling(player, def)
	local dir = (aim and aim.Magnitude > 0.5) and aim.Unit or hrp.CFrame.LookVector
	local function part(shape, color, tr)
		local p = Instance.new("Part")
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
		p.Material, p.Color, p.Transparency, p.Shape, p.Size = Enum.Material.Neon, color, tr, shape, Vector3.one
		p.Parent = workspace
		return p
	end
	local outer = part(Enum.PartType.Block, PURPLE, 0.2)
	local core = part(Enum.PartType.Block, PURPLE_CORE, 0.1)
	local flare = part(Enum.PartType.Ball, PURPLE, 0.3)
	flare.Size = Vector3.one * L.Width * 1.8
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness = PURPLE_CORE, 14, 2
	light.Parent = flare
	local fx = laserFx(part, outer, L)
	playSound(hrp, SOUNDS.FireCast, 0.7, 0.6)
	local wallParams = RaycastParams.new()
	wallParams.FilterDescendantsInstances = { char, EnemiesFolder, outer, core, flare }
	wallParams.RespectCanCollide = true
	local nextTick, t0, lastBurst = now(), now(), 0
	local conn
	local function stop()
		conn:Disconnect()
		if L.Hold and now() - t0 > L.Duration and st.attackId == id then -- (a held beam: a brief recovery)
			st.busyUntil, st.attackAt = now() + 0.3, now() + 0.25
			pose(st, "Idle", 0.2)
		end
		for _, e in ipairs(fx.emitters) do
			e.Enabled = false
		end
		for _, bm in ipairs(fx.beams) do
			bm.Enabled = false
		end
		for _, p in ipairs({ outer, core, flare, table.unpack(fx.parts) }) do
			game:GetService("TweenService"):Create(p, TweenInfo.new(0.12), { Transparency = 1 }):Play()
			Debris:AddItem(p, 0.2)
		end
	end
	conn = RunService.Heartbeat:Connect(function(dt)
		local t = now()
		local held = L.Hold and not st.laserStop and st.stamina > 0
		if st.attackId ~= id or (t - t0 > L.Duration and not held) or not aliveChar(player) then
			stop()
			return
		end
		local dir = (L.Hold and st.laserAim) or dir
		if L.Hold and t - t0 > L.Duration then -- held past the tap: it costs stamina, and you stay busy
			st.stamina = math.max(0, st.stamina - L.Drain * dt)
			st.lastSpend = t
			st.busyUntil, st.attackAt = math.max(st.busyUntil, t + 0.1), math.max(st.attackAt, t + 0.1)
		end
		local handle = st.weld and st.weld.Parent and st.weld.Part1
		local o = handle and handle.Position or hrp.Position + hrp.CFrame.LookVector * 2
		local wall = workspace:Raycast(o, dir * L.Range, wallParams)
		local len = wall and wall.Distance or L.Range
		local tip = o + dir * len
		local cf = CFrame.lookAt(o + dir * len / 2, tip)
		outer.CFrame, core.CFrame, flare.CFrame = cf, cf, CFrame.new(tip)
		laserFxStep(fx, outer, core, flare, L, o, tip, len, t - t0)
		if t - lastBurst > 0.2 then -- (sparks where it burns)
			lastBurst = t
			burst(tip, PURPLE, 6, 0.3, 8)
		end
		if t >= nextTick then
			nextTick = t + Config.DarkBookTick
			local hitThisTick = {}
			for _, p in ipairs(workspace:GetPartBoundsInBox(cf, Vector3.new(L.Width + 0.5, L.Width + 0.5, len), hitParams)) do
				local m = enemyModelOf(p)
				local h = m and m:FindFirstChildOfClass("Humanoid")
				if h and h.Health > 0 and not hitThisTick[m] then
					hitThisTick[m] = true -- (once a tick, however many of its parts are in the beam)
					damageEnemy(m, h.MaxHealth * L.Pct / 100 * mult, player, L.Poise, 0)
				end
			end
		end
	end)
end

local function playerRoll(player, back)
	local st = states[player]
	if not st or not aliveChar(player) then
		return
	end
	if not canStart(st, "Dodge") or player:GetAttribute("Broken") then -- (BROKEN: no rolling, Config.Break)
		return
	end
	if not spend(st, back and P.BackstepCost or P.RollCost) then
		return
	end
	local t = now()
	st.healing = false
	st.lastKind = nil -- a roll breaks the light chain
	cancelSwing(st)
	local dur = back and P.BackstepDuration or P.RollDuration
	-- the client rolled LATENCY ago by the time this arrives: start the window where the player saw it
	if t >= (st.phaseUntil or 0) then -- (a roll mustn't cut a Foul Dagger phase short)
		st.iStart = t + P.IFrameStart - LATENCY
		st.iEnd = t + (back and P.BackstepIFrameEnd or P.IFrameEnd) - LATENCY
	end
	setAction(st, t, dur - 0.03, dur * 0.8, dur * 0.8)
end

-- THE FOUL DAGGER'S Q (Config.FoulPhase): for Duration s you're half-transparent, armor and weapon
-- too, and nothing can hurt you (the same i-frames a roll gives: Core.damagePlayer). It doesn't stop
-- you acting. The cooldown counts from the press.
local function playerPhase(player)
	local st = states[player]
	local char, _, hrp = aliveChar(player)
	local D = Config.FoulPhase
	local t = now()
	if not (st and char) or not canStart(st, "Dodge") or t < (st.phaseReadyAt or 0) - LATENCY then
		return
	end
	st.phaseReadyAt = t + D.Cooldown
	st.phaseUntil = t + D.Duration
	st.iStart, st.iEnd = t, t + D.Duration
	local was = {}
	for _, d in ipairs(char:GetDescendants()) do
		if (d:IsA("BasePart") or d:IsA("Decal")) and d.Transparency < 0.5 then
			was[d] = d.Transparency
			d.Transparency = 0.5
		end
	end
	local GREEN = Color3.fromRGB(150, 190, 70)
	local glow = Instance.new("Highlight")
	glow.Adornee, glow.FillColor, glow.FillTransparency = char, GREEN, 0.75
	glow.OutlineColor, glow.OutlineTransparency, glow.DepthMode = GREEN, 0.2, Enum.HighlightDepthMode.Occluded
	glow.Parent = char
	local rot = Instance.new("ParticleEmitter")
	rot.Texture = "rbxasset://textures/particles/smoke_main.dds"
	rot.Color = ColorSequence.new(Color3.fromRGB(110, 150, 50), Color3.fromRGB(40, 60, 20))
	rot.LightEmission = 0.4
	rot.Size = NumberSequence.new(1.2, 2.4)
	rot.Transparency = NumberSequence.new(0.5, 1)
	rot.Lifetime = NumberRange.new(0.6, 1.1)
	rot.Rate = 30
	rot.Speed = NumberRange.new(1, 3)
	rot.Acceleration = Vector3.new(0, 4, 0)
	rot.SpreadAngle = Vector2.new(180, 180)
	rot.Parent = hrp
	burst(hrp.Position, GREEN, 20, 0.4, 14)
	playSound(hrp, SOUNDS.Unsheath, 0.7, 0.5)
	task.delay(D.Duration, function()
		for d, v in pairs(was) do
			if d.Parent then
				d.Transparency = v
			end
		end
		glow:Destroy()
		rot:Destroy()
		if hrp.Parent then
			burst(hrp.Position, GREEN, 20, 0.4, 14)
			playSound(hrp, SOUNDS.Deflect, 0.5, 0.6)
		end
	end)
end

local function playerDeflect(player)
	local st = states[player]
	if not st or not aliveChar(player) then
		return
	end
	if player:GetAttribute("Weapon") ~= "Scythe" then
		return
	end
	if not canStart(st, "Dodge") then
		if Config.Debug then
			print(string.format("[Deflect] refused: still busy for %.2fs", st.dodgeAt - LATENCY - now()))
		end
		return
	end
	local CFG = Config.ScytheDeflect
	if not spend(st, CFG.Cost) then
		if Config.Debug then
			print("[Deflect] refused: no stamina")
		end
		return
	end
	local t = now()
	st.healing = false
	st.lastKind = nil
	cancelSwing(st)
	local dur = CFG.Duration
	local win = CFG.Window
	local twirl = CFG.Twirl
	-- the deflect frames only open once the twirl clicks into guard
	st.deflectStart = t + twirl - LATENCY
	st.deflectEnd = t + twirl + win
	setAction(st, t, twirl + dur, twirl + dur * 0.7, twirl + dur * 0.75)
	local id = st.attackId -- (cancelSwing above bumped it; a hit mid-twirl bumps it again)
	task.spawn(function()
		-- snap up overhead, then one full turn in quarters
		local snap = twirl * 0.2
		local quarter = (twirl - snap) / 4
		pose(st, "UTwirlA", snap)
		task.wait(snap)
		for _, g in ipairs({ "UTwirlB", "UTwirlC", "UTwirlD", "UTwirlA" }) do
			if st.attackId ~= id then
				return
			end
			pose(st, g, quarter, Enum.EasingStyle.Linear)
			task.wait(quarter)
		end
		if st.attackId ~= id then
			return
		end
		pose(st, "UDeflect", 0.04, Enum.EasingStyle.Back) -- the click into guard
		task.wait(dur * 0.65)
		if st.attackId == id and (st.deflectEnd or 0) > 0 and now() >= st.deflectEnd then
			pose(st, "Idle", 0.2)
		end
	end)
end

-- THE DRAW (Gozen Tachi, Q; Config.TachiDraw). Standing still: sheathe it and settle.
-- Settled ("IaiReady"): Q draws it in one cut, invulnerable for its first few frames
-- (dash = W was held: the client runs you forward, and the cut is the wide DashAttack).
-- A draw a touch early (the client queued it) still counts. Anything else you do, walking
-- off (the client's "IaiCancel", from CancelAfter on), or a hit - each bumps attackId -
-- breaks the stance.
local function playerIai(player, dash)
	local st = states[player]
	local char, _, hrp = aliveChar(player)
	if not (st and char) or not Config.weaponOf(player).Iai then
		return
	end
	local D = Config.TachiDraw
	local t = now()
	if st.iaiId == st.attackId and t >= st.iaiReadyAt - LATENCY then
		if not spend(st, D.Cost) then
			return
		end
		st.iaiId = nil
		player:SetAttribute("IaiReady", false)
		local a = dash and D.DashAttack or D.Attack
		st.healing = false
		st.lastKind = nil
		st.iStart, st.iEnd = t, t + D.IFrames
		local total = a.Windup + a.Swing + a.Recover
		setAction(st, t, total, a.Windup + a.Swing + a.Recover * C.DodgeCancel, a.Windup + a.Swing + a.Recover * C.AttackCancel)
		st.attackId += 1
		-- you vanish for exactly the i-frames, then come back in a lightning strike as the
		-- cut lands (its Windup is the i-frames, Config.TachiDraw)
		local hidden = {}
		for _, d in ipairs(char:GetDescendants()) do
			if (d:IsA("BasePart") or d:IsA("Decal")) and d.Transparency < 1 then
				hidden[d] = d.Transparency
				d.Transparency = 1
			elseif d:IsA("ParticleEmitter") and d.Enabled then
				hidden[d] = true
				d.Enabled = false
			end
		end
		burst(hrp.Position, Color3.fromRGB(170, 215, 255), 14, 0.3, 10)
		task.delay(D.IFrames, function()
			for d, v in pairs(hidden) do
				if d.Parent then
					if v == true then
						d.Enabled = true
					else
						d.Transparency = v
					end
				end
			end
			if not hrp.Parent then
				return
			end
			local at = hrp.Position
			lightningArc(at + Vector3.new(math.random() * 2 - 1, 14, math.random() * 2 - 1), at, 6, 0.18, 1.6)
			for _ = 1, 4 do
				local off = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 5
				lightningArc(at, at + off, 3, 0.07, 0.6)
			end
			burst(at, Color3.fromRGB(190, 225, 255), 24, 0.35, 16)
			playSound(hrp, SOUNDS.Lightning[1], 1, 1)
		end)
		swing(player, st, a, st.attackId, hrp, true)
		return
	end
	if not canStart(st, "Attack") then
		return
	end
	st.healing = false
	st.lastKind = nil
	cancelSwing(st)
	local id = st.attackId
	st.iaiId, st.iaiReadyAt = id, t + D.SheatheTime
	setAction(st, t, D.SheatheTime, 0, D.SheatheTime)
	pose(st, "TSheathed", D.SheatheTime * 0.6)
	bodyPose(st, "Iai", D.SheatheTime)
	playSound(hrp, SOUNDS.Unsheath, 0.6, 0.8)
	task.spawn(function()
		while st.attackId == id and aliveChar(player) == char do
			if not player:GetAttribute("IaiReady") and now() >= t + D.SheatheTime then
				player:SetAttribute("IaiReady", true) -- settled: the blade clicks home
				playSound(hrp, SOUNDS.Deflect, 0.4, 1.6)
			end
			RunService.Heartbeat:Wait()
		end
		player:SetAttribute("IaiReady", false) -- (the draw has already cleared it)
	end)
end

-- CAELEN'S SPIN (the twin blades, Q; Config.CaelenSpin): both swords flung out, you spin with
-- them for Duration seconds and steer by walking as normal (the client turns you round; this
-- is the damage, every Tick, to everything within Radius). A roll (or a hit) ends it.
local function playerSpin(player)
	local st = states[player]
	local char, _, hrp = aliveChar(player)
	if not (st and char) or not Config.weaponOf(player).Spin or not canStart(st, "Attack") then
		return
	end
	local D = Config.CaelenSpin
	if now() < (st.spinReadyAt or 0) - LATENCY or not spend(st, D.Cost) then
		return
	end
	local t = now()
	st.spinReadyAt = t + D.Duration + D.Cooldown -- (Cooldown counts from when the spin ends)
	st.healing = false
	st.lastKind = nil
	cancelSwing(st)
	setAction(st, t, D.Duration, D.Duration * 0.3, D.Duration)
	local id = st.attackId
	pose(st, "GWhirl", 0.15)
	bodyPose(st, "CWhirl", 0.15)
	setTrail(st, true)
	playSound(hrp, SOUNDS.Slash, 0.8, 0.5)
	task.spawn(function()
		local def = Config.weaponOf(player)
		local damage = math.floor(D.Damage * Config.scaling(player, def) + 0.5)
		local el = 0
		while el < D.Duration and st.attackId == id and aliveChar(player) == char do
			task.wait(D.Tick)
			el += D.Tick
			if st.attackId ~= id then
				break
			end
			playSound(hrp, def.SlashSound or SOUNDS.Slash, 0.5, 0.8 + math.random() * 0.2)
			for _, m in ipairs(enemiesInSector(hrp.CFrame, D.Radius, 180)) do
				local h = m:FindFirstChildOfClass("Humanoid")
				if h and h.Health > 0 then
					damageEnemy(m, damage, player, D.Poise, 0)
				end
			end
		end
		setTrail(st, false)
		if st.attackId == id then
			pose(st, "Idle", 0.3)
		end
	end)
end

local function playerHeal(player)
	local st = states[player]
	local char, _, hrp = aliveChar(player)
	if not (st and char) then
		return
	end
	if not canStart(st, "Attack") or st.flasks <= 0 then
		return
	end
	local t = now()
	st.flasks -= 1
	player:SetAttribute("Flasks", st.flasks)
	st.lastKind = nil
	cancelSwing(st)
	setAction(st, t, P.FlaskTime, P.FlaskTime, P.FlaskTime)
	st.healing = true
	pose(st, "Drink", 0.3)
	local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 160, 70)
	glow.Range = 8
	glow.Brightness = 2
	glow.Parent = hand or hrp
	Debris:AddItem(glow, P.FlaskTime)
	task.delay(P.FlaskTime * 0.45, function()
		local c, h, root = aliveChar(player)
		if st.healing and c then
			h.Health = math.min(h.MaxHealth, h.Health + P.FlaskHeal)
			burst(root.Position, Color3.fromRGB(255, 160, 70), 18, 0.3, 6)
		end
		st.healing = false
		task.wait(P.FlaskTime * 0.3)
		pose(st, "Idle", 0.3)
	end)
end

function M.init(core)
	P, states, aliveChar, spend, setAction, cancelSwing, pose, bodyPose, setTrail, hitStopActor, playSound, SOUNDS, burst, damageEnemy, enemiesInSector, EnemiesFolder, now = core.P, core.states, core.aliveChar, core.spend, core.setAction, core.cancelSwing, core.pose, core.bodyPose, core.setTrail, core.hitStopActor, core.playSound, core.SOUNDS, core.burst, core.damageEnemy, core.enemiesInSector, core.EnemiesFolder, core.now
	hitParams.FilterDescendantsInstances = { EnemiesFolder }
end

M.attack = function(player, kind, step, aim)
	playerAttack(player, kind, step, aim)
end
M.roll = function(player, back)
	playerRoll(player, back)
end
M.deflect = function(player)
	if Config.weaponOf(player).Phase then
		return playerPhase(player)
	end
	playerDeflect(player)
end
M.iai = function(player, dash)
	playerIai(player, dash)
end
M.iaiCancel = function(player)
	local st = states[player]
	if st and st.iaiId and st.iaiId == st.attackId then
		st.iaiId = nil
		cancelSwing(st) -- (stands up; the stance's loop sees the bump and clears IaiReady)
	end
end
M.spin = function(player)
	playerSpin(player)
end
M.heal = function(player)
	playerHeal(player)
end

return M
]]></ProtectedString>
					<string name="ScriptGuid">{69AEC524-FBF0-4795-88D7-784B1EC66A2D}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Knight</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">37103886d8e24c800aefca76000003e5</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000006">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- MABEL (kind Wick): the girl in the candlelit nook north of the Upper Drain.
-- Wise past her years, and she knows rather more than she lets on. He he.
-- Her name and every line she says are in Config.Wick.
--
-- EVERYTHING ABOUT THIS CHARACTER IS IN THIS ONE FILE:
--   M.Proportions / M.Poses   body shape and its full-body poses (the client animator uses these too)
--   M.Colors / M.Look         how the rig is dressed (RigBuilder calls Look with a kit of helpers:
--                             deco(part, name, size, offset, color, material?, shape?), V(x,y,z), at(x,y,z) ...)
--   M.Weapons / M.Grips       the weapon's model, and the grip poses its swings tween between
--   M.init(Core) and below    behaviour (server only)
-- SHARED TOOLKIT: server code here gets the shared helpers through M.init(Core)
-- (see the list at the top of ServerScriptService/GameServer/Core.lua). Body
-- poses not defined here (Idle, Windup, Strike, SweepWindup, SweepEnd, Recover,
-- Flinch, Stagger, Crouch, Air, Roar, Kneel) are shared ones from PuppetMath.
local M = {}
M.Kind = "Wick"
-- small, slight, swallowed by a shawl several sizes too big
M.Proportions = { girth = 0.8, arm = 0.95, hunch = 0.12 }
M.IdlePose = "WickSit"
M.Poses = {
	-- sitting on her crate, knees drawn up, candle in her lap; a tilt of the head
	-- and hunched shoulders when she giggles; looking up at you
	WickSit = { drop = 2.05, lean = 0.22, head = 0.2, tuck = 0.85, footR = 0.3, footL = 0.3, la1 = 0.7, la3 = -0.35, lel = 1.5, freeL = 0, breathe = 0.6 },
	WickGiggle = { drop = 2.0, lean = 0.38, side = 0.14, head = 0.05, twist = 0.1, tuck = 0.9, footR = 0.3, footL = 0.3, la1 = 1.0, la3 = -0.3, lel = 2.0, freeL = 0, breathe = 3 },
	WickLook = { drop = 2.05, lean = 0.05, side = -0.1, head = -0.15, twist = -0.12, tuck = 0.85, footR = 0.3, footL = 0.3, la1 = 0.7, la3 = -0.35, lel = 1.5, freeL = 0 },
}
M.Colors = { skin = Color3.fromRGB(186, 170, 150), torso = Color3.fromRGB(88, 84, 76), legs = Color3.fromRGB(70, 64, 56), arms = Color3.fromRGB(88, 84, 76) }
M.FistSkin = true

function M.Look(k)
	local deco, parts, V, at, rgb, MAT, look = k.deco, k.parts, k.V, k.at, k.rgb, k.MAT, k.look
	local cw, ch, cd, hw, hd, aw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.la, k.ua
	-- a small girl in a grey shawl far too big for her, hood up, bare feet,
	-- a twist of red thread round one wrist. Most of her face is in shadow;
	-- what you can see is a pale chin and a small, knowing smile.
	local shawl, shawlDark, thread = look.torso, rgb(62, 58, 52), rgb(130, 34, 30)
	parts.Head.Color = rgb(14, 12, 12) -- the dark inside the hood
	deco("Head", "Chin", V(0.72, 0.36, 0.1), at(0, -0.33, -0.61), look.skin, MAT.SmoothPlastic)
	deco("Head", "Smile", V(0.32, 0.05, 0.04), at(0.03, -0.37, -0.675) * CFrame.Angles(0, 0, 0.12), rgb(70, 40, 36), MAT.SmoothPlastic)
	deco("Head", "SmileCorner", V(0.07, 0.05, 0.04), at(0.2, -0.345, -0.675) * CFrame.Angles(0, 0, 0.6), rgb(70, 40, 36), MAT.SmoothPlastic)
	deco("Head", "HoodBack", V(1.4, 1.6, 0.32), at(0, 0.1, 0.62), shawl, MAT.Fabric)
	deco("Head", "HoodTop", V(1.42, 0.32, 1.5), at(0, 0.8, 0), shawl, MAT.Fabric)
	deco("Head", "HoodBrim", V(1.44, 0.3, 0.42), at(0, 0.62, -0.62) * CFrame.Angles(0.3, 0, 0), shawlDark, MAT.Fabric)
	deco("Head", "HoodL", V(0.2, 1.55, 1.45), at(-0.68, 0.06, 0), shawl, MAT.Fabric)
	deco("Head", "HoodR", V(0.2, 1.55, 1.45), at(0.68, 0.06, 0), shawl, MAT.Fabric)
	deco("Head", "Fringe", V(0.9, 0.18, 0.06), at(-0.05, 0.33, -0.6), rgb(52, 40, 30), MAT.Fabric) -- a fall of dark hair
	-- her hood comes up in a jester's two points, flopping off either way (the same as the
	-- Dark Hood she gives you: Armor.luau), one in the shawl, one in her red thread
	local Armor = require(game:GetService("ServerScriptService"):WaitForChild("GameServer"):WaitForChild("Armor"))
	Armor.jesterPoints(deco, "Head", Vector3.new(0, 0.9, 0.05) * k.s, 0.4 * k.s, shawl, shawl:Lerp(thread, 0.6), k.s)
	-- the shawl: draped over the shoulders, down past the hips, ragged at the hem
	deco("Chest", "Shawl", V(cw * 1.3, ch * 0.95, cd * 1.35), at(0, -0.05, 0), shawl, MAT.Fabric)
	deco("Chest", "ShawlDrape", V(cw * 1.2, 1.3, 0.12), at(0, -1.2, -cd * 0.65), shawl, MAT.Fabric)
	deco("Chest", "ShawlDrapeB", V(cw * 1.25, 1.5, 0.12), at(0, -1.3, cd * 0.65), shawlDark, MAT.Fabric)
	for i = 0, 3 do
		deco("Chest", "Fray", V(cw * 0.26, 0.3 + (i % 2) * 0.2, 0.1), at(-cw * 0.45 + i * cw * 0.3, -2.0 - (i % 2) * 0.1, -cd * 0.66), shawl:Lerp(rgb(0, 0, 0), 0.2), MAT.Fabric)
	end
	deco("Hips", "Skirt", V(hw * 1.1, 1.2, hd * 1.1), at(0, -0.45, 0), shawlDark, MAT.Fabric)
	for _, n in ipairs({ "R", "L" }) do
		deco(n .. "UpperArm", "Sleeve", V(aw * 1.4, ua * 0.9, aw * 1.4), at(0, 0, 0), shawl, MAT.Fabric)
		parts[n .. "Foot"].Color = look.skin:Lerp(rgb(60, 50, 40), 0.35) -- bare, dirty feet
		parts[n .. "Shin"].Color = look.skin:Lerp(rgb(60, 50, 40), 0.2)
	end
	deco("LLowerArm", "Thread", V(aw * 0.95, 0.07, aw * 0.95), at(0, -la / 2 + 0.25, 0), thread, MAT.Fabric)
	-- eyes: direct children named "Eye"
	for _, x in ipairs({ -0.22, 0.22 }) do
		deco("Head", "Eye", V(0.09, 0.07, 0.05), at(x * 0.9, 0.05, -0.585), rgb(150, 120, 70), MAT.Neon)
	end
end

M.Weapons = {
	-- her candle: a fat stub, held upright in her lap
	Candle = function(w)
		local handle = w.mk("Wax", Vector3.new(0.3, 0.75, 0.3), Color3.fromRGB(214, 202, 172), Enum.Material.SmoothPlastic)
		w.add(w.mk("Flame", Vector3.new(0.14, 0.26, 0.14), Color3.fromRGB(255, 176, 90), Enum.Material.Neon), -0.52)
		return { handle = handle, bladeLen = 0.2 }
	end,
}
M.Grips = {
	-- upright in her lap (the flame is toward the grip's -Y, so flip it up)
	CandleLap = { Vector3.new(0.15, -1.55, -0.85), CFrame.Angles(math.pi, 0, 0) },
}

---------------------------------------------------------------------------
-- server: sitting there, and talking to you
---------------------------------------------------------------------------
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Map, FxRemote, now, pose, bodyPose, giveWeapon, applyLimbGroup, RigBuilder, Roster

function M.spawn()
	local NPCs = workspace:FindFirstChild("NPCs") or Instance.new("Folder") -- (shared: one folder only)
	NPCs.Name = "NPCs" -- animated by the Puppeteer like everyone else, but never hittable
	NPCs.Parent = workspace
	local WICK_SCALE = 0.72
	local model = RigBuilder.build("Wick", WICK_SCALE)
	model.Name = "Wick"
	pcall(function()
		model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	end)
	local weld = giveWeapon(model, "Candle", WICK_SCALE)
	applyLimbGroup(model)
	model.Parent = NPCs
	local hum = model:FindFirstChildOfClass("Humanoid")
	hum.HipHeight = model:GetAttribute("HipHeight")
	local root = model:FindFirstChild("HumanoidRootPart")
	model:PivotTo(Map.Wick + Vector3.new(0, 3 * WICK_SCALE, 0))
	root.Anchored = true -- she's sitting on her crate; she isn't going anywhere
	local weapon = model:FindFirstChild("Weapon")
	local flame = weapon and weapon:FindFirstChild("Flame")
	if flame then
		local l = Instance.new("PointLight")
		l.Color = Color3.fromRGB(255, 170, 90)
		l.Range = 11
		l.Brightness = 1.4
		l.Parent = flame
		l:SetAttribute("Base", l.Brightness)
		game:GetService("CollectionService"):AddTag(l, "Flicker")
	end
	local actor = { model = model, weld = weld, scale = WICK_SCALE }
	pose(actor, "CandleLap", 0.1)
	bodyPose(actor, "WickSit", 0.1)

	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = "Talk"
	pp.ObjectText = "Wick"
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 8
	pp.RequiresLineOfSight = false
	pp.Parent = root

	-- her lines live in ReplicatedStorage/Config -> Config.Wick
	local W = Config.Wick or {}
	local INTRO = W.Intro or {}
	local MORE = W.More or { "..." }
	local AFTER_USHER = W.AfterUsher
	local AFTER_WARDEN = W.AfterWarden
	pp.ObjectText = W.Name or "Wick"

	local talk = {} -- per player: { n = lines heard, usher = said?, warden = said? }
	-- one of her gifts (Config.Armor), put straight on
	local function give(player, key)
		if player:GetAttribute(key) then
			return
		end
		player:SetAttribute(key, true)
		if not Config.wornArmor(player)[key] then
			Config.wearArmor(player, key)
		end
		FxRemote:FireClient(player, "Message", Config.Armor[key].Name .. ". Press T to choose weapons and armor.")
	end
	local busyUntil = 0
	pp.Triggered:Connect(function(player)
		local t = talk[player] or { n = 0 }
		talk[player] = t
		local line
		if Roster.byKind.Warden and Roster.byKind.Warden.isDead() and AFTER_WARDEN and AFTER_WARDEN ~= "" and not t.warden then
			t.warden = true
			line = AFTER_WARDEN
		elseif Roster.byKind.Usher and Roster.byKind.Usher.isDead() and AFTER_USHER and AFTER_USHER ~= "" and not t.usher then
			t.usher = true
			line = AFTER_USHER
			give(player, "DarkHood") -- relieved: the hood that goes with her cloak
		elseif t.n >= #INTRO and not player:GetAttribute("DarkCloak") then
			line = W.CloakLine or "..."
			give(player, "DarkCloak")
		else
			t.n += 1
			line = t.n <= #INTRO and INTRO[t.n] or MORE[(t.n - #INTRO - 1) % #MORE + 1]
		end
		FxRemote:FireClient(player, "Say", W.Name or "Wick", line)
		-- she tilts her head to look at you; a giggle hunches her shoulders
		local giggle = string.find(line, "He he") ~= nil
		bodyPose(actor, giggle and "WickGiggle" or "WickLook", 0.25)
		local now0 = now()
		busyUntil = now0 + 2.2
		task.delay(2.2, function()
			if now() >= busyUntil - 0.01 then
				bodyPose(actor, "WickSit", 0.6)
			end
		end)
	end)
	Players.PlayerRemoving:Connect(function(pl)
		talk[pl] = nil
	end)
end

function M.init(core)
	Map, FxRemote, now, pose, bodyPose, giveWeapon, applyLimbGroup, RigBuilder, Roster = core.Map, core.FxRemote, core.now, core.pose, core.bodyPose, core.giveWeapon, core.applyLimbGroup, core.RigBuilder, core.Roster
end

return M
]]></ProtectedString>
					<string name="ScriptGuid">{261E27B1-3EEF-4444-95BF-4B7EE49B85CA}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Mabel</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">37103886d8e24c800aefca76000003e6</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000007">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- OCULAST, THE BLINDED USHER: optional miniboss of the Blind Chapel, through the
-- Dim Yard's west wall.
--
-- She kneels at the overgrown altar with her back to the door. She is blind:
-- walk up quietly and you can get close (even land a hit - she answers it at
-- once with a turning reap); run, roll or drink a flask nearby and she hears you.
-- In the fight she is fast and hits very hard, but every attack is told by the
-- body: the growth over her eyes flares as she hisses, her stance winds up, the
-- haft scrapes sparks off the stone. No markers.
--
-- FIRST LIFE (the usher: measured, deliberate)
--   Spin      floats a hair off the floor, blade straight out, and turns slowly round
--             and round while drifting after you (speeds in Config.Usher.Spin)
--   Chop      raised high and brought down into the stone (sometimes held late)
--   Lunge     drops low, drags the haft along the floor, rushes in and reaps upward
--   Turnabout a turning reap at whoever is behind her (both lives)
-- When the first bar empties she falls; the bar and the music go. Then the rot
-- gets her up again: a spore burst, a second bar, a new name, a new fighter.
-- SECOND LIFE (the rot's puppet: jerky, relentless). As she rises an extra arm
-- tears out of her back and a single ragged wing unfolds from her head (mutate()).
--   Lurch     yanked sideways out of line, then a near-instant reap from the new angle
--   Dance     three cuts stepping in: across, up off the floor, back across
--   Plunge    crouch, dust, a leap, and down blade-first where you stood
--   Breath    rears back with spores leaking from the hood, breathes a choking cloud
--   Spin      her floating spin again, faster (x1.43), harder (x1.5), drifting after you quicker
--   Rot Tether  a ring of spores follows her; stray outside it and the haze chokes you.
--             It closes in slowly and stops well outside her reach (Config.Usher.Tether)
-- No fissures and no ground markers in either life.
-- Tuning: ReplicatedStorage/Config -> Config.Usher.
local Usher = {}

-- EVERYTHING ABOUT OCULAST IS IN THIS ONE FILE:
--   Usher.Proportions / Usher.Poses   body shape and full-body poses (the client animator uses these too)
--   Usher.Colors / Usher.Look         her robes, hood, shawl and the faint growth in the hood
--   Usher.Weapons / Usher.Grips       the long scythe, and the grip poses its swings tween between
--   Usher.init(ctx) and below         her behaviour (server only). ctx is the shared Core toolkit
--                                     (see the list at the top of GameServer/Core.lua)
-- Tuning: Config.Usher. Body poses not defined here (Windup, Strike, Recover, Stagger,
-- Crouch, Air, Roar, Kneel...) are shared ones from PuppetMath.
Usher.Kind = "Usher"
-- tall, narrow, long-armed; both hands on the haft (the left further up toward the butt)
Usher.Proportions = { girth = 0.74, arm = 1.18, hunch = 0.06, twoHand = 1.15 }
Usher.IdlePose = "UReady"
Usher.Poses = {
	-- kneeling vigil at the altar, head bowed; then lifting it to listen
	UKneel = { drop = 1.5, lean = 0.62, head = 0.55, footR = 0.95, footL = -1.25, freeL = 0, breathe = 0.5 },
	UListen = { drop = 1.3, lean = 0.05, side = 0.2, head = -0.3, twist = 0.15, footR = 0.95, footL = -1.25, freeL = 0, breathe = 2 },
	-- her fighting stance: low, poised, weight forward (her "Idle")
	UReady = { drop = 0.35, lean = 0.22, twist = 0.15, head = 0.05, footR = -0.4, footL = 0.45, spread = 0.12, freeL = 0 },
	-- dragging the blade low behind her before the rising reap; the reap itself
	UDrag = { drop = 0.85, lean = 0.6, twist = -0.55, head = -0.1, footR = -0.8, footL = 0.85, spread = 0.12, freeL = 0 },
	URise = { drop = 0.1, lean = -0.4, twist = 0.35, head = -0.45, footR = 0.9, footL = -0.55, freeL = 0 },
	-- head thrown back (spore breath); wound round to whip the blade behind her
	UShriek = { drop = 0.25, lean = -0.7, head = -0.9, side = 0.05, footR = 0.3, footL = -0.3, breathe = 3, freeL = 0 },
	UTwist = { drop = 0.5, lean = 0.3, twist = 1.2, head = -0.1, footR = 0.5, footL = -0.5, spread = 0.2, freeL = 0 },
	-- upright and still as she floats and turns, feet together, head bowed
	USpin = { drop = -0.05, lean = -0.05, head = 0.35, footR = 0.05, footL = -0.05, spread = -0.15, breathe = 0.3, freeL = 0 },
	-- second life: yanked sideways like a puppet; breathing spores out
	ULurch = { drop = 0.6, lean = 0.25, side = 0.4, twist = 0.45, head = 0.25, footR = 0.6, footL = -0.3, spread = 0.35, freeL = 0 },
	UExhale = { drop = 0.45, lean = 0.6, head = -0.15, footR = 0.6, footL = -0.5, breathe = 3, freeL = 0 },
	-- a skittering hop back out of reach
	UHop = { drop = 0.35, lean = -0.3, head = 0.1, tuck = 0.25, footR = -0.4, footL = 0.3, la1 = 0.7, la3 = -0.9, lel = 0.6, freeL = 0 },
	-- counter stance: planted wide and low, upright, blind face lifted, the haft held up over her head
	UStance = { drop = 0.6, lean = -0.12, head = -0.25, footR = -0.75, footL = 0.8, spread = 0.45, breathe = 0.2, freeL = 0 },
}
Usher.Colors = { skin = Color3.fromRGB(128, 126, 110), torso = Color3.fromRGB(74, 68, 56), legs = Color3.fromRGB(66, 60, 50), arms = Color3.fromRGB(74, 68, 56) }
Usher.FistSkin = true

function Usher.Look(k)
	local deco, parts, V, at, rgb, MAT, D, s, look = k.deco, k.parts, k.V, k.at, k.rgb, k.MAT, k.D, k.s, k.look
	local cw, ch, cd, hw, hd, aw, lw, la = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la
	-- Oculast, the Blinded Usher: a chapel usher's vestments gone grey with damp,
	-- a deep hood and veil, and where her eyes were, the rot has taken root.
	local robe, robeDark, rope = look.torso, rgb(52, 47, 40), rgb(96, 84, 56)
	local bone, flesh, fleshDark = rgb(176, 168, 146), rgb(98, 82, 58), rgb(62, 48, 38)
	local shin = D.shin / s
	-- long skirt from the hips almost to the floor (front/back/sides, slightly flared)
	local skirtL = 2.45
	deco("Hips", "Skirt", V(hw * 1.05, skirtL, 0.1), at(0, -skirtL / 2 + 0.15, -hd / 2 - 0.06) * CFrame.Angles(-0.07, 0, 0), robe, MAT.Fabric)
	deco("Hips", "Skirt", V(hw * 1.1, skirtL, 0.1), at(0, -skirtL / 2 + 0.15, hd / 2 + 0.06) * CFrame.Angles(0.08, 0, 0), robeDark, MAT.Fabric)
	for _, sx in ipairs({ -1, 1 }) do
		deco("Hips", "Skirt", V(0.1, skirtL - 0.1, hd * 1.05), at(sx * (hw / 2 + 0.06), -skirtL / 2 + 0.2, 0) * CFrame.Angles(0, 0, sx * 0.07), robeDark, MAT.Fabric)
	end
	-- a ragged hem
	for i = 0, 4 do
		local x = (i - 2) * hw * 0.24
		deco("Hips", "Hem", V(hw * 0.2, 0.35 + (i % 2) * 0.25, 0.1), at(x, -skirtL + 0.05 - (i % 2) * 0.12, -hd / 2 - 0.13), robe:Lerp(rgb(0, 0, 0), 0.2), MAT.Fabric)
	end
	-- the legs read as robe in motion
	for _, n in ipairs({ "R", "L" }) do
		parts[n .. "Thigh"].Color = robeDark
		parts[n .. "Shin"].Color = robeDark
		deco(n .. "Shin", "Wrap", V(lw * 1.1, shin * 0.5, lw * 1.1), at(0, -shin * 0.2, 0), rgb(84, 76, 60), MAT.Fabric)
	end
	-- tabard bearing the prison's eye, slashed through
	deco("Chest", "Tabard", V(cw * 0.6, ch * 1.05, 0.08), at(0, -0.1, -cd / 2 - 0.05), robeDark, MAT.Fabric)
	deco("Hips", "TabardTail", V(hw * 0.55, 1.4, 0.08), at(0, -0.55, -hd / 2 - 0.15), robeDark, MAT.Fabric)
	deco("Chest", "Emblem", V(0.5, 0.5, 0.04), at(0, 0.2, -cd / 2 - 0.1) * CFrame.Angles(0, 0, math.pi / 4), bone, MAT.Fabric)
	deco("Chest", "EmblemEye", V(0.17, 0.17, 0.05), at(0, 0.2, -cd / 2 - 0.12), rgb(30, 22, 20), MAT.Fabric)
	deco("Chest", "Slash", V(0.85, 0.07, 0.05), at(0, 0.2, -cd / 2 - 0.13) * CFrame.Angles(0, 0, 0.6), rgb(70, 24, 20), MAT.Fabric)
	-- mantle over the shoulders, rope belt, prayer beads, an unlit usher's lamp
	deco("Chest", "Mantle", V(cw * 1.2, 0.55, cd * 1.3), at(0, ch / 2 - 0.2, 0), robeDark, MAT.Fabric)
	deco("Chest", "MantleBack", V(cw * 1.05, 1.3, 0.1), at(0, ch / 2 - 0.85, cd / 2 + 0.08), robeDark, MAT.Fabric)
	deco("Hips", "Belt", V(hw + 0.1, 0.18, hd + 0.1), at(0, 0.28, 0), rope, MAT.Fabric)
	for i = 0, 5 do
		deco("Hips", "Bead", V(0.13, 0.13, 0.13), at(-hw / 2 + 0.05, 0.12 - i * 0.16, -hd / 2 + 0.05 + (i % 2) * 0.03), bone, MAT.SmoothPlastic, Enum.PartType.Ball)
	end
	deco("Hips", "Lamp", V(0.32, 0.45, 0.32), at(hw / 2 + 0.12, -0.35, -0.1), rgb(40, 36, 32), MAT.Metal)
	deco("Hips", "LampGlass", V(0.2, 0.28, 0.2), at(hw / 2 + 0.12, -0.35, -0.1), rgb(60, 58, 44), MAT.Glass)
	-- long bell sleeves
	for _, n in ipairs({ "R", "L" }) do
		deco(n .. "LowerArm", "Sleeve", V(aw * 1.45, la * 0.55, aw * 1.45), at(0, la * 0.05, 0), robe, MAT.Fabric)
	end
	-- the rot has climbed her: boils over the left shoulder and down the back
	for _, b in ipairs({ { -0.6, 0.65, 0.15, 0.42 }, { -0.75, 0.4, 0.3, 0.3 }, { -0.4, 0.75, 0.35, 0.28 }, { -0.2, 0.1, 0.55, 0.35 }, { 0.1, -0.3, 0.55, 0.25 } }) do
		deco("Chest", "Boil", V(b[4], b[4], b[4]), at(b[1] * cw / 2 * 1.6, b[2], b[3] * cd), fleshDark:Lerp(flesh, (b[1] + 1) / 2), MAT.SmoothPlastic, Enum.PartType.Ball)
	end
	-- hood and veil
	deco("Head", "HoodBack", V(1.35, 1.6, 0.3), at(0, 0.1, 0.62), robeDark, MAT.Fabric)
	deco("Head", "HoodTop", V(1.35, 0.3, 1.45), at(0, 0.78, 0.02), robeDark, MAT.Fabric)
	deco("Head", "HoodPeak", V(0.9, 0.5, 0.9), at(0, 0.98, 0.25) * CFrame.Angles(0.5, 0, 0), robeDark, MAT.Fabric)
	deco("Head", "HoodL", V(0.18, 1.55, 1.35), at(-0.66, 0.08, 0.02), robeDark, MAT.Fabric)
	deco("Head", "HoodR", V(0.18, 1.55, 1.35), at(0.66, 0.08, 0.02), robeDark, MAT.Fabric)
	deco("Head", "Veil", V(1.2, 1.9, 0.08), at(0, -0.95, 0.76) * CFrame.Angles(0.12, 0, 0), robe:Lerp(rgb(0, 0, 0), 0.3), MAT.Fabric)
	-- no face to speak of: a black void under the hood and a shawl over the mouth.
	-- Her eyes are bound: a stained linen blindfold knotted tight across them,
	-- with old dark streaks run down from under it. Nothing in her face glows.
	-- Her attack tell is the rot instead: parts named "Tell" (fungal caps sprouting
	-- through the crown of her hood, pustules on her rotting left shoulder) flare.
	parts.Head.Color = rgb(8, 8, 8)
	parts.Head.Material = MAT.SmoothPlastic
	deco("Head", "HoodBrim", V(1.42, 0.34, 0.4), at(0, 0.6, -0.6) * CFrame.Angles(0.25, 0, 0), robeDark, MAT.Fabric)
	deco("Head", "HoodLipL", V(0.2, 1.2, 0.3), at(-0.6, 0.05, -0.66), robeDark, MAT.Fabric)
	deco("Head", "HoodLipR", V(0.2, 1.2, 0.3), at(0.6, 0.05, -0.66), robeDark, MAT.Fabric)
	deco("Head", "Shawl", V(1.18, 0.62, 0.2), at(0, -0.36, -0.64) * CFrame.Angles(-0.08, 0, 0), robe:Lerp(rgb(0, 0, 0), 0.15), MAT.Fabric)
	deco("Head", "ShawlFold", V(1.0, 0.12, 0.22), at(0, -0.12, -0.7), robe:Lerp(rgb(0, 0, 0), 0.45), MAT.Fabric)
	deco("Chest", "ShawlDrape", V(cw * 0.7, 0.9, 0.14), at(-0.1, ch / 2 - 0.35, -cd / 2 - 0.12) * CFrame.Angles(0, 0, 0.12), robe:Lerp(rgb(0, 0, 0), 0.15), MAT.Fabric)
	local linen, linenDark, stain = rgb(124, 112, 88), rgb(92, 80, 62), rgb(64, 30, 24)
	deco("Head", "Blindfold", V(1.04, 0.27, 0.06), at(0, 0.14, -0.6), linen, MAT.Fabric) -- keeps the old part name other scripts may look for
	deco("Head", "BlindCloth", V(0.86, 0.11, 0.05), at(0.02, 0.17, -0.635) * CFrame.Angles(0, 0, 0.32), linenDark, MAT.Fabric) -- a second wrap, crossed
	for _, sx in ipairs({ -1, 1 }) do
		deco("Head", "BlindStain", V(0.1, 0.16, 0.04), at(sx * 0.19, 0.17, -0.64), stain, MAT.Fabric) -- seeping through where the eyes were
		deco("Head", "TearStreak", V(0.05, 0.13, 0.03), at(sx * 0.2, -0.03, -0.62), stain, MAT.Fabric) -- dried, run down the void
	end
	-- the growth that took her eyes has come out through the top of the hood
	for _, c in ipairs({ { -0.32, 0.86, -0.42, 0.22 }, { -0.08, 0.95, -0.3, 0.18 }, { 0.22, 0.88, -0.4, 0.15 }, { -0.5, 0.7, -0.55, 0.13 } }) do
		deco("Head", "Tell", V(c[4], c[4], c[4]), at(c[1], c[2], c[3]), rgb(34, 32, 20), MAT.Neon, Enum.PartType.Ball)
	end
	for _, c in ipairs({ { -0.68, 0.78, -0.05, 0.2 }, { -0.85, 0.52, 0.1, 0.16 }, { -0.5, 0.88, 0.22, 0.15 } }) do
		deco("Chest", "Tell", V(c[4], c[4], c[4]), at(c[1] * cw / 2 * 1.6, c[2], c[3] * cd), rgb(34, 32, 20), MAT.Neon, Enum.PartType.Ball)
	end
end

Usher.Weapons = {
	-- her harvest-blade: a long haft (hands near the butt) and a rusted crescent hooked
	-- off its end. The blade lies in the haft's YZ plane, curling back toward the hands;
	-- the edge is on the inside of the curve.
	Scythe = function(w)
		local R, mk, add = w.R, w.mk, w.add
		local rust, edge = Color3.fromRGB(92, 82, 70), Color3.fromRGB(150, 144, 128)
		-- (9 studs of haft at scale 1: hands near the butt, blade hooked off the far end)
		local handle = mk("Haft", Vector3.new(0.27, 9.0, 0.27), Color3.fromRGB(42, 33, 26), Enum.Material.Wood)
		add(mk("Wrap", Vector3.new(0.33, 0.9, 0.33), Color3.fromRGB(84, 76, 60), Enum.Material.Fabric), 3.1)
		add(mk("Wrap", Vector3.new(0.33, 0.7, 0.33), Color3.fromRGB(84, 76, 60), Enum.Material.Fabric), 4.25)
		add(mk("Collar", Vector3.new(0.48, 0.7, 0.48), w.iron, Enum.Material.Metal), -4.15)
		add(mk("Tang", Vector3.new(0.14, 0.4, 0.7), w.iron, Enum.Material.Metal), -4.3, nil, -0.3)
		for _, b in ipairs({ { 1.88, 0.62, 5, -4.25, -0.9 }, { 1.58, 0.52, 15, -3.98, -2.52 }, { 1.28, 0.38, 35, -3.44, -3.75 } }) do
			local rot = CFrame.Angles(R(b[3]), 0, 0)
			add(mk("Blade", Vector3.new(0.08, b[2], b[1]), rust, Enum.Material.CorrodedMetal), b[4], rot, b[5])
			-- the honed inner edge (toward the haft's hands)
			local up = rot.UpVector * (b[2] / 2 + 0.03)
			add(mk("Edge", Vector3.new(0.05, 0.07, b[1]), edge, Enum.Material.Metal), b[4] + up.Y, rot, b[5] + up.Z)
		end
		local scale = w.scale
		return {
			handle = handle,
			bladeLen = 3.3,
			gripC1 = CFrame.new(0, 3.1 * scale, 0), -- right hand 1.4 from the butt
			setup = function(h, a0, a1)
				-- hits are swept from the haft's middle, along to its end and out to the tip
				a0.Position = Vector3.new(0, -4.28 * scale, 0)
				a1.Position = Vector3.new(0, -3.09 * scale, -4.23 * scale)
				local mid = Instance.new("Attachment")
				mid.Name = "HaftMid"
				mid.Position = Vector3.new(0, -0.6 * scale, 0)
				mid.Parent = h
				-- sparks thrown off when the haft's end scrapes the floor (enabled by her moves)
				local sp = Instance.new("ParticleEmitter")
				sp.Name = "Sparks"
				sp.Texture = "rbxasset://textures/particles/sparkles_main.dds"
				sp.Rate = 70
				sp.Enabled = false
				sp.Lifetime = NumberRange.new(0.25, 0.6)
				sp.Speed = NumberRange.new(6, 14)
				sp.SpreadAngle = Vector2.new(60, 60)
				sp.Acceleration = Vector3.new(0, -40, 0)
				sp.Size = NumberSequence.new(0.22, 0)
				sp.Color = ColorSequence.new(Color3.fromRGB(255, 205, 140))
				sp.LightEmission = 1
				sp.Parent = a0
			end,
		}
	end,
}
-- scythe grips (positions at scale 1; the hand is on the haft near the butt)
Usher.Grips = {
	UIdle = { Vector3.new(1.1, -0.1, -0.6), CFrame.Angles(0, math.rad(-20), 0) * CFrame.Angles(math.rad(68), 0, 0) },
	UKneelGrip = { Vector3.new(0.15, -0.9, -1.1), CFrame.Angles(math.rad(180), 0, 0) }, -- planted upright, blade over her head
	URaise = { Vector3.new(0.7, 2.5, 0.5), CFrame.Angles(math.rad(233), 0, math.rad(8)) * CFrame.Angles(0, math.pi, 0) },
	UChop = { Vector3.new(0.25, -0.5, -1.9), CFrame.Angles(0, math.rad(8), 0) * CFrame.Angles(math.rad(72), 0, 0) * CFrame.Angles(0, math.pi, 0) },
	USweepBack = { Vector3.new(1.7, 0.3, 0.9), CFrame.Angles(0, math.rad(-50), 0) * CFrame.Angles(0, 0, math.rad(80)) },
	USweepMid = { Vector3.new(0.2, 0.3, -1.7), CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(0, 0, math.rad(80)) },
	USweepEnd = { Vector3.new(-1.3, 0.3, -0.6), CFrame.Angles(0, math.rad(200), 0) * CFrame.Angles(0, 0, math.rad(80)) },
	USweepEndR = { Vector3.new(-1.3, 0.3, -0.6), CFrame.Angles(0, math.rad(200), 0) * CFrame.Angles(0, 0, math.rad(80)) * CFrame.Angles(0, math.pi, 0) },
	USweepMidR = { Vector3.new(0.2, 0.3, -1.7), CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(0, 0, math.rad(80)) * CFrame.Angles(0, math.pi, 0) },
	USweepBackR = { Vector3.new(1.7, 0.3, 0.9), CFrame.Angles(0, math.rad(-50), 0) * CFrame.Angles(0, 0, math.rad(80)) * CFrame.Angles(0, math.pi, 0) },
	UDragBack = { Vector3.new(1.5, -0.6, 1.3), CFrame.Angles(0, math.rad(-165), 0) * CFrame.Angles(math.rad(70), 0, 0) }, -- haft end on the floor behind her
	URising = { Vector3.new(0.4, 2.4, -1.5), CFrame.Angles(0, math.rad(10), 0) * CFrame.Angles(math.rad(150), 0, 0) },
	UDeflect = { Vector3.new(0.3, 0.8, -1.2), CFrame.Angles(math.rad(35), math.rad(40), math.rad(-30)) * CFrame.Angles(0, math.pi, 0) },
	-- her counter stance: both hands over her head, haft level across it, the blade out to her right
	UStance = { Vector3.new(0.5, 2.6, -0.3), CFrame.Angles(0, math.rad(-90), 0) * CFrame.Angles(math.rad(100), 0, 0) },
	-- the player's scythe: carried high, haft at the chest and the blade up over the right shoulder
	UGuard = { Vector3.new(1.0, 0.9, -0.7), CFrame.Angles(0, math.rad(25), 0) * CFrame.Angles(math.rad(205), 0, 0) },
	-- the deflect's overhead twirl: one full turn in quarters, haft level just above the head
	UTwirlA = { Vector3.new(0.3, 2.9, -0.2), CFrame.Angles(0, 0, 0) * CFrame.Angles(math.rad(100), 0, 0) },
	UTwirlB = { Vector3.new(0.3, 2.9, -0.2), CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(math.rad(100), 0, 0) },
	UTwirlC = { Vector3.new(0.3, 2.9, -0.2), CFrame.Angles(0, math.rad(180), 0) * CFrame.Angles(math.rad(100), 0, 0) },
	UTwirlD = { Vector3.new(0.3, 2.9, -0.2), CFrame.Angles(0, math.rad(270), 0) * CFrame.Angles(math.rad(100), 0, 0) },
}
Usher.BodyFor = {
	UIdle = "Idle", URaise = "Windup", UChop = "Strike", USweepBack = "SweepWindup", USweepEnd = "SweepEnd",
	USweepEndR = "SweepEnd", USweepBackR = "SweepWindup", UDragBack = "UDrag", URising = "URise",
	UDeflect = "Deflect", UGuard = "Idle", UStance = "UStance",
	UTwirlA = "Twirl", UTwirlB = "Twirl", UTwirlC = "Twirl", UTwirlD = "Twirl",
}

local U: any = nil -- runtime state, created by Usher.init
local api: any = {}

function Usher.owns(model)
	return U ~= nil and model ~= nil and U.model == model
end
function Usher.actor()
	return U and U.current
end
function Usher.poiseState()
	return U
end
function Usher.onHit(player)
	if U and api.onHit then
		api.onHit(player)
	end
end
function Usher.onPoiseBreak()
	if U and api.onPoiseBreak then
		api.onPoiseBreak()
	end
end
function Usher.spawn()
	if U and api.spawn then
		api.spawn()
	end
end
function Usher.reset()
	if U and api.reset then
		api.reset()
	end
end
function Usher.isDead()
	return U ~= nil and U.state == "dead"
end
function Usher.inChapel(pos)
	return U ~= nil and api.inChapel and api.inChapel(pos) or false
end

function Usher.init(ctx)
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local TweenService = game:GetService("TweenService")
	local Debris = game:GetService("Debris")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local CFG = ctx.Config.Usher
	local SOUNDS = ctx.SOUNDS
	local now, flat = ctx.now, ctx.flat
	local pose, bodyPose, setTrail, playSound = ctx.pose, ctx.bodyPose, ctx.setTrail, ctx.playSound
	local S = CFG.Scale
	local HOME = ctx.Map.Usher.Home
	local MINP, MAXP = ctx.Map.Usher.Min, ctx.Map.Usher.Max
	local ROT_DARK, ROT_FLESH = Color3.fromRGB(62, 48, 38), Color3.fromRGB(110, 92, 62)
	local SPORE = Color3.fromRGB(200, 192, 120)
	-- the faint growth deep in her black hood: barely there, flaring as her tell
	local BLIND_BASE, BLIND_P2, BLIND_FLARE = Color3.fromRGB(34, 32, 20), Color3.fromRGB(120, 110, 58), Color3.fromRGB(235, 225, 140)

	U = { state = "none", gen = 0, cd = {} } -- none | kneel | waking | fight | returning | dead
	if ctx.registerTarget then
		ctx.registerTarget(function(model)
			if not Usher.owns(model) then
				return nil
			end
			return {
				owner = U,
				actor = U.current,
				maxPoise = CFG.Poise,
				freeze = false,
				damageMult = function(player) -- weak to strength weapons (Config.Usher.WeakTo)
					return CFG.WeakTo[player:GetAttribute("Weapon")] or 1
				end,
				onHit = function(player)
					Usher.onHit(player) -- struck at her vigil: she wakes
				end,
				onBreak = function()
					Usher.onPoiseBreak()
				end,
				evade = function(player) -- true = the blow misses (her counter stance)
					return api.evade ~= nil and api.evade(player)
				end,
			}
		end)
	end

	local function rand(lo, hi)
		return lo + math.random() * (hi - lo)
	end

	local function dmg(x)
		return math.max(1, math.floor(x * (CFG.DamageScale or 1) + 0.5))
	end

	local function inChapel(pos)
		return pos.X >= MINP.X - 1 and pos.X <= MAXP.X + 1 and pos.Z >= MINP.Z - 1 and pos.Z <= MAXP.Z + 1 and pos.Y > -4 and pos.Y < 20
	end
	api.inChapel = inChapel

	local function live(a)
		return U.gen == a.gen and U.state == "fight" and a.hum.Parent ~= nil and a.hum.Health > 0
	end

	local function free(a)
		return live(a) and now() >= (U.staggerUntil or 0)
	end

	local function tempo()
		return U.phase2 and CFG.Phase2Tempo or 1
	end

	-- she is blind: the louder you are, the better she tracks you
	local function noisy(pl)
		local st = ctx.states[pl]
		local char, _, hrp = ctx.aliveChar(pl)
		if not (st and char) then
			return false
		end
		local t = now()
		local moving = flat(hrp.AssemblyLinearVelocity).Magnitude > 3
		local rolling = (st.iEnd or 0) > 0 and t >= st.iStart - 0.08 and t <= st.iEnd + 0.2
		return (st.sprinting and moving) or rolling or st.healing
	end

	local function turnRate(pl)
		local r = math.rad(U.phase2 and CFG.TurnRate2 or CFG.TurnRate)
		if pl then
			r *= noisy(pl) and 1.35 or 0.8
		end
		return r
	end

	-- nearest living player inside the chapel
	local function target(a)
		local best, bestD, bestPl
		for _, pl in ipairs(Players:GetPlayers()) do
			local char, _, hrp = ctx.aliveChar(pl)
			if char and inChapel(hrp.Position) then
				local d = flat(hrp.Position - a.root.Position).Magnitude
				if not bestD or d < bestD then
					best, bestD, bestPl = char, d, pl
				end
			end
		end
		return best, bestPl
	end

	---------------------------------------------------------------------------
	-- the boss bar + music
	---------------------------------------------------------------------------
	-- Her humanoid holds both lives (HP + HP2); the bar shows only the current one.
	-- quiet: the bar without the music (her second life's theme waits till she's up)
	local function showBar(a, quiet)
		U.barOn = true
		ReplicatedStorage:SetAttribute("BossName", U.phase2 and CFG.Name2 or CFG.Name)
		ReplicatedStorage:SetAttribute("BossMaxHP", U.phase2 and CFG.HP2 or CFG.HP)
		ReplicatedStorage:SetAttribute("BossHP", math.max(0, U.phase2 and a.hum.Health or a.hum.Health - CFG.HP2))
		ReplicatedStorage:SetAttribute("BossActive", true)
		if CFG.Music and CFG.Music ~= "" and not quiet then
			ReplicatedStorage:SetAttribute("Music", U.phase2 and "usher2" or "usher")
		end
	end

	local function hideBar()
		if not U.barOn then
			return
		end
		U.barOn = false
		ReplicatedStorage:SetAttribute("BossActive", false)
		local mus = ReplicatedStorage:GetAttribute("Music")
		if mus == "usher" or mus == "usher2" then
			ReplicatedStorage:SetAttribute("Music", "none")
		end
	end

	---------------------------------------------------------------------------
	-- tells and effects
	---------------------------------------------------------------------------
	local function blindfolds(a)
		local list = {}
		for _, d in ipairs(a.model:GetChildren()) do
			if d.Name == "Tell" and d:IsA("BasePart") then
				table.insert(list, d)
			end
		end
		return list
	end

	local function sporePuff(pos, n, size, speed)
		local anchor = ctx.fxAnchor(pos)
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
		pe.Rate = 0
		pe.Lifetime = NumberRange.new(0.8, 1.8)
		pe.Speed = NumberRange.new((speed or 4) * 0.4, speed or 4)
		pe.SpreadAngle = Vector2.new(70, 70)
		pe.Drag = 3
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, (size or 1) * 0.4), NumberSequenceKeypoint.new(1, (size or 1) * 1.3) })
		pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 1) })
		pe.Color = ColorSequence.new(SPORE)
		pe.LightEmission = 0.25
		pe.Parent = anchor
		pe:Emit(n or 8)
		Debris:AddItem(anchor, 2.2)
	end

	-- Every attack opens like this: the growth where her eyes were flares, she
	-- hisses, and a breath of spores escapes her hood.
	local function tell(a, pitch)
		playSound(a.root, SOUNDS.Groan, 0.75, pitch or 1.25)
		playSound(a.root, SOUNDS.Unsheath, 0.35, 1.7)
		for _, d in ipairs(blindfolds(a)) do
			d.Color = BLIND_FLARE
			task.delay(0.3, function()
				if d.Parent then
					TweenService:Create(d, TweenInfo.new(0.45), { Color = U.phase2 and BLIND_P2 or BLIND_BASE }):Play()
				end
			end)
		end
		local head = a.model:FindFirstChild("Head")
		if head then
			sporePuff(head.Position - Vector3.new(0, 0.3, 0), 5, 0.6, 2)
		end
		if U.phase2 and U.mut and U.current == a then
			U.mut.rear() -- second life: the back arm rears, the wing flares
		end
	end

	local function sparks(a, on)
		local weapon = a.model:FindFirstChild("Weapon")
		local sp = weapon and weapon:FindFirstChild("Sparks", true)
		if sp then
			sp.Enabled = on
		end
	end

	local function sparkBurst(pos, n)
		local anchor = ctx.fxAnchor(pos)
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		pe.Rate = 0
		pe.Lifetime = NumberRange.new(0.25, 0.6)
		pe.Speed = NumberRange.new(8, 18)
		pe.SpreadAngle = Vector2.new(70, 70)
		pe.Acceleration = Vector3.new(0, -45, 0)
		pe.Size = NumberSequence.new(0.25, 0)
		pe.Color = ColorSequence.new(Color3.fromRGB(255, 205, 140))
		pe.LightEmission = 1
		pe.Parent = anchor
		pe:Emit(n or 16)
		Debris:AddItem(anchor, 1)
	end

	local function bladePoints(a)
		local handle = a.weld and a.weld.Parent and a.weld.Part1
		if not handle or not handle.Parent then
			return nil
		end
		local m, b, t = handle:FindFirstChild("HaftMid"), handle:FindFirstChild("BladeBase"), handle:FindFirstChild("BladeTip")
		if not (m and b and t) then
			return nil
		end
		return m.WorldPosition, b.WorldPosition, t.WorldPosition
	end

	-- The scythe hurts wherever it actually travels: every frame, the path of the
	-- haft's outer half and the blade since last frame is swept with spheres.
	local hitParams = OverlapParams.new()
	hitParams.FilterType = Enum.RaycastFilterType.Include
	hitParams.CollisionGroup = "HitQuery"
	local function sweep(a, duration, damage, level, seen, radius)
		local chars = {}
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl.Character then
				table.insert(chars, pl.Character)
			end
		end
		hitParams.FilterDescendantsInstances = chars
		seen = seen or {}
		local t0 = now()
		local prev
		while now() - t0 < duration and live(a) do
			local m, b, t = bladePoints(a)
			if m then
				prev = prev or { m, b, t }
				for i = 0, 3 do
					local f = i / 3
					local pm, pb, pt = prev[1]:Lerp(m, f), prev[2]:Lerp(b, f), prev[3]:Lerp(t, f)
					for j = 0, 7 do
						local p = j < 4 and pm:Lerp(pb, j / 4) or pb:Lerp(pt, (j - 4) / 3)
						for _, part in ipairs(workspace:GetPartBoundsInRadius(p, radius or 1.5, hitParams)) do
							local pl = Players:GetPlayerFromCharacter(part:FindFirstAncestorOfClass("Model"))
							if pl and not seen[pl] and ctx.damagePlayer(pl, dmg(damage), a.root.Position, level) then
								seen[pl] = true
							end
						end
					end
				end
				prev = { m, b, t }
			end
			RunService.Heartbeat:Wait()
		end
		return seen
	end

	-- hold a windup, turning toward the target for the first trackFrac of it
	local function hold(a, duration, trackFrac, tChar, tPl)
		local t0 = now()
		while now() - t0 < duration do
			if not free(a) then
				return false
			end
			local dt = task.wait()
			local tr = tChar and tChar:FindFirstChild("HumanoidRootPart")
			if tr and now() - t0 < duration * (trackFrac or 0) then
				ctx.turnTowards(a.root, tr.Position, turnRate(tPl) * dt * 1.6)
			end
		end
		return true
	end

	-- A sweep's warning, made obvious: she draws back slowly (Config.Usher.Telegraph
	-- stretches it), the growth in her hood flares and the haft grates on the stone,
	-- and just before the swing comes a hard glint flashes on the blade's tip.
	local TG1 = CFG.Telegraph or 1.6
	local function tg()
		return U.phase2 and (CFG.Telegraph2 or TG1) or TG1
	end
	local function glint(a)
		local weapon = a.model:FindFirstChild("Weapon")
		local tipAtt = weapon and weapon:FindFirstChild("BladeTip", true)
		if not tipAtt then
			return
		end
		local l = Instance.new("PointLight")
		l.Color = Color3.fromRGB(255, 236, 196)
		l.Range = 14
		l.Brightness = 7
		l.Parent = tipAtt
		TweenService:Create(l, TweenInfo.new(0.45), { Brightness = 0 }):Play()
		Debris:AddItem(l, 0.5)
		local star = Instance.new("ParticleEmitter")
		star.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		star.Rate = 0
		star.Lifetime = NumberRange.new(0.35)
		star.Speed = NumberRange.new(0)
		star.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(0.3, 3), NumberSequenceKeypoint.new(1, 0) })
		star.Color = ColorSequence.new(Color3.fromRGB(255, 240, 210))
		star.LightEmission = 1
		star.RotSpeed = NumberRange.new(180, 260)
		star.LockedToPart = true
		star.Parent = tipAtt
		star:Emit(1)
		Debris:AddItem(star, 0.6)
		playSound(a.root, SOUNDS.Unsheath, 0.55, 2.1)
	end

	local function windup(a, duration, trackFrac, tChar, tPl)
		local d = duration * tg()
		for _, b in ipairs(blindfolds(a)) do
			b.Color = BLIND_FLARE
			task.delay(d, function()
				if b.Parent then
					TweenService:Create(b, TweenInfo.new(0.4), { Color = U.phase2 and BLIND_P2 or BLIND_BASE }):Play()
				end
			end)
		end
		playSound(a.root, SOUNDS.Unsheath, 0.45, 0.55) -- the haft grating as she draws back
		if not hold(a, d * 0.72, trackFrac, tChar, tPl) then
			return false
		end
		glint(a)
		return hold(a, d * 0.28, trackFrac > 0 and 1 or 0, tChar, tPl)
	end

	local function waitLive(a, duration)
		local t0 = now()
		while now() - t0 < duration do
			if not live(a) then
				return false
			end
			task.wait()
		end
		return true
	end

	local function push(a, dir, speed)
		local root = a.root
		if root.Parent and not root.Anchored then
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = dir * speed + Vector3.new(0, v.Y, 0)
		end
	end

	local function fwd(a)
		local f = flat(a.root.CFrame.LookVector)
		return f.Magnitude > 0.1 and f.Unit or Vector3.new(0, 0, -1)
	end

	local function stopAndFace(a, tChar)
		a.hum:MoveTo(a.root.Position)
		a.hum.AutoRotate = false
		local tr = tChar and tChar:FindFirstChild("HumanoidRootPart")
		if tr then
			ctx.turnTowards(a.root, tr.Position, math.rad(30))
		end
	end

	local function ready(a)
		setTrail(a, false)
		sparks(a, false)
		pose(a, "UIdle", 0.3)
	end

	---------------------------------------------------------------------------
	-- moves
	---------------------------------------------------------------------------
	-- the downward chop itself (shared by Chop, Reap's finisher and Harvest)
	local function chopStrike(a, damage)
		setTrail(a, true)
		pose(a, "UChop", 0.11)
		playSound(a.root, SOUNDS.Lunge, 0.8, 0.85)
		push(a, fwd(a), 10)
		local seen = {}
		task.spawn(sweep, a, 0.17, damage, "Large", seen, 1.6)
		task.wait(0.12)
		if not live(a) then
			return false
		end
		local _, base, tip = bladePoints(a)
		local hitAt = tip or (a.root.Position + fwd(a) * 7)
		if base and base.Y < hitAt.Y then
			hitAt = base
		end
		hitAt = Vector3.new(hitAt.X, 0.15, hitAt.Z)
		sparkBurst(hitAt + Vector3.new(0, 0.3, 0), 22)
		ctx.debrisChunks(hitAt + Vector3.new(0, 0.4, 0), 4, 22)
		ctx.dustCloud(hitAt + Vector3.new(0, 0.4, 0), 1.6, 6)
		playSound(a.root, SOUNDS.Impact, 0.9, 1.1)
		ctx.FxRemote:FireAllClients("Shake", hitAt, 0.55)
		return true
	end

	local function chop(a, tChar, tPl, opts)
		opts = opts or {}
		local m = tempo()
		stopAndFace(a, tChar)
		tell(a, 1.2)
		pose(a, "URaise", 0.45 * m * tg())
		playSound(a.root, SOUNDS.Unsheath, 0.6, 0.9)
		if not windup(a, 0.58 * m, 0.75, tChar, tPl) then
			return
		end
		if opts.delayed then
			-- leans back further with a rasping breath; the drop comes late
			bodyPose(a, "URise", 0.3)
			playSound(a.root, SOUNDS.Groan, 0.5, 1.5)
			if not hold(a, rand(0.3, 0.55), 0, nil, nil) then
				return
			end
		end
		if not chopStrike(a, CFG.Damage.Chop) then
			return
		end
		bodyPose(a, "Recover", 0.35) -- the blade is in the stone: punish her
		if not waitLive(a, opts.recover or 0.75 * m) then
			return
		end
		sparkBurst(a.root.Position + fwd(a) * 6 + Vector3.new(0, -2.5, 0), 8) -- wrenching it free
		if not opts.recover then
			ready(a)
		end
	end

	local function reap(a, tChar, tPl, opts)
		opts = opts or {}
		local m = tempo()
		local w = opts.wind or 1
		stopAndFace(a, tChar)
		if not opts.notell then
			tell(a, 1.3)
		end
		pose(a, "USweepBack", 0.36 * m * w * tg())
		playSound(a.root, SOUNDS.Unsheath, 0.5, 1.2)
		if not windup(a, 0.44 * m * w, 0.8, tChar, tPl) then
			return
		end
		setTrail(a, true)
		playSound(a.root, SOUNDS.Slash, 0.8, 0.8)
		pose(a, "USweepMid", 0.1, Enum.EasingStyle.Linear)
		task.delay(0.1, function()
			if live(a) then
				pose(a, "USweepEnd", 0.13)
			end
		end)
		push(a, fwd(a), 13)
		local k = opts.scale or 1
		sweep(a, 0.25, CFG.Damage.Reap * k, "Medium", {}, 1.5)
		if (opts.followUp or opts.finisher) and free(a) then
			-- turns the blade over in her hands and reaps back the other way
			setTrail(a, false)
			pose(a, "USweepEndR", 0.1)
			playSound(a.root, SOUNDS.Unsheath, 0.4, 1.5)
			if not windup(a, 0.3 * m, 0.7, tChar, tPl) then
				return
			end
			setTrail(a, true)
			playSound(a.root, SOUNDS.Slash, 0.8, 0.9)
			pose(a, "USweepMidR", 0.1, Enum.EasingStyle.Linear)
			task.delay(0.1, function()
				if live(a) then
					pose(a, "USweepBackR", 0.13)
				end
			end)
			push(a, fwd(a), 12)
			sweep(a, 0.25, CFG.Damage.Reverse * k, "Medium", {}, 1.5)
		end
		if opts.finisher and free(a) then
			setTrail(a, false)
			pose(a, "URaise", 0.22)
			tell(a, 1.4)
			if not windup(a, 0.3 * m, 0.6, tChar, tPl) then
				return
			end
			if not chopStrike(a, CFG.Damage.Chop * k) then
				return
			end
			bodyPose(a, "Recover", 0.35)
		end
		setTrail(a, false)
		if waitLive(a, opts.recover or (opts.finisher and 0.8 or 0.55) * m) and not opts.recover then
			ready(a)
		end
	end

	-- drops low, drags the haft's end along the stone (sparks), rushes in and reaps upward
	local wallParams = RaycastParams.new()
	wallParams.FilterType = Enum.RaycastFilterType.Exclude
	local function rising(a, damage, level)
		setTrail(a, true)
		sparks(a, false)
		pose(a, "URising", 0.13)
		playSound(a.root, SOUNDS.Slash, 0.9, 0.75)
		local base = select(2, bladePoints(a))
		if base then
			sparkBurst(Vector3.new(base.X, 0.3, base.Z), 14)
		end
		sweep(a, 0.24, damage, level or "Knockdown", {}, 1.6)
		setTrail(a, false)
	end

	local function lunge(a, tChar, tPl)
		local tr = tChar:FindFirstChild("HumanoidRootPart")
		if not tr then
			return
		end
		local m = tempo()
		stopAndFace(a, tChar)
		tell(a, 1.15)
		pose(a, "UDragBack", 0.3)
		task.delay(0.22, function()
			if live(a) then
				sparks(a, true) -- the haft's end hits the floor behind her and scrapes
				playSound(a.root, SOUNDS.Unsheath, 0.6, 0.6)
			end
		end)
		if not hold(a, 0.62 * m, 0.85, tChar, tPl) then
			sparks(a, false)
			return
		end
		local root = a.root
		local dir = fwd(a)
		local dist = math.clamp(flat(tr.Position - root.Position).Magnitude - 7, 3, 24)
		local ignore = { ctx.EnemiesFolder, ctx.Map.Bars }
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl.Character then
				table.insert(ignore, pl.Character)
			end
		end
		wallParams.FilterDescendantsInstances = ignore
		local res = workspace:Raycast(root.Position, dir * (dist + 3), wallParams)
		if res then
			dist = math.max(res.Distance - 3, 0)
		end
		root.Anchored = true
		local start, rot = root.Position, root.CFrame.Rotation
		local dur = math.max(dist / 46, 0.1)
		local t0, nextDust = now(), 0
		playSound(root, SOUNDS.Lunge, 0.7, 0.7)
		while live(a) do
			local k = math.min((now() - t0) / dur, 1)
			local pos = start + dir * dist * k
			root.CFrame = CFrame.new(pos) * rot
			if now() > nextDust then
				nextDust = now() + 0.06
				ctx.dustCloud(Vector3.new(pos.X, 0.5, pos.Z) - dir * 2, 0.8, 2)
			end
			if k >= 1 then
				break
			end
			RunService.Heartbeat:Wait()
		end
		root.Anchored = false
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
		if not live(a) then
			sparks(a, false)
			return
		end
		rising(a, CFG.Damage.Rising)
		bodyPose(a, "Recover", 0.4)
		if waitLive(a, 0.75 * m) then
			ready(a)
		end
	end

	-- a turning reap at whoever is behind her
	local function turnabout(a, tChar, tPl, fast)
		local tr = tChar and tChar:FindFirstChild("HumanoidRootPart")
		if not tr then
			return
		end
		local m = fast and 0.6 or tempo()
		a.hum:MoveTo(a.root.Position)
		a.hum.AutoRotate = false
		tell(a, 1.45)
		bodyPose(a, "UTwist", 0.3 * m)
		pose(a, "USweepBack", 0.3 * m * tg())
		if not windup(a, 0.4 * m, 0, nil, nil) then
			return
		end
		-- whip round to face where the sound came from, the blade cutting the arc behind her
		local root = a.root
		local cur = fwd(a)
		local want = flat(tr.Position - root.Position)
		want = want.Magnitude > 0.1 and want.Unit or -cur
		local yaw0 = math.atan2(-cur.X, -cur.Z)
		local turn = (math.atan2(-want.X, -want.Z) - yaw0 + math.pi) % (2 * math.pi) - math.pi
		setTrail(a, true)
		playSound(root, SOUNDS.Slash, 0.9, 0.7)
		pose(a, "USweepMid", 0.28, Enum.EasingStyle.Linear)
		bodyPose(a, "SweepEnd", 0.28)
		local seen = {}
		task.spawn(sweep, a, 0.32, CFG.Damage.Turnabout, "Medium", seen, 1.6)
		local t0 = now()
		while live(a) do
			local k = math.min((now() - t0) / 0.28, 1)
			ctx.steerYaw(root, yaw0 + turn * k) -- (a physical twist: teleporting a standing rig makes it flicker)
			if k >= 1 then
				break
			end
			RunService.Heartbeat:Wait()
		end
		task.wait(0.06)
		setTrail(a, false)
		if waitLive(a, 0.5 * m) then
			ready(a)
		end
	end

	-- FIRST LIFE: she rises a hair off the floor, scythe held straight out, and
	-- turns slowly round and round while drifting after you across the chapel.
	-- The blade cuts whoever it passes. Speeds/height/length: Config.Usher.Spin.
	local function spin(a, tChar, tPl, second)
		local SP = CFG.Spin
		local speedMult = second and (SP.SpeedMult2 or 1.3) or 1
		local dmgMult = second and (SP.DamageMult2 or 1.5) or 1
		local drift = SP.DriftSpeed * (second and (SP.DriftMult2 or 1) or 1)
		stopAndFace(a, tChar)
		tell(a, 1.1)
		-- the tell: she straightens, the blade swings out level, the hem lifts
		bodyPose(a, "USpin", 0.6)
		pose(a, "USweepMid", 0.6)
		playSound(a.root, SOUNDS.Unsheath, 0.6, 0.6)
		if not windup(a, 0.8 * tempo(), 0.8, tChar, tPl) then
			return
		end
		local root = a.root
		local stand = root.Position.Y
		local yaw = math.atan2(-fwd(a).X, -fwd(a).Z)
		local turn = math.rad(SP.TurnRate * speedMult) * (math.random() < 0.5 and -1 or 1)
		root.Anchored = true
		setTrail(a, true)
		ctx.dustCloud(Vector3.new(root.Position.X, 0.4, root.Position.Z), 1.4, 6)
		local t0 = now()
		local last = t0
		local nextHit = t0
		local seen = {}
		local params = hitParams
		while free(a) and now() - t0 < SP.Duration do
			local t = now()
			local dt = t - last
			last = t
			-- rise into the float over the first half second, settle at the end
			local k = math.min((t - t0) / 0.5, 1, (SP.Duration - (t - t0)) / 0.4)
			yaw += turn * dt
			local pos = root.Position
			local tr = tChar and tChar:FindFirstChild("HumanoidRootPart")
			if tr then
				local rel = flat(tr.Position - pos)
				if rel.Magnitude > 2 then
					pos += rel.Unit * math.min(drift * dt, rel.Magnitude - 2)
				end
			end
			pos = Vector3.new(math.clamp(pos.X, MINP.X + 2, MAXP.X - 2), stand + SP.FloatHeight * math.max(k, 0), math.clamp(pos.Z, MINP.Z + 2, MAXP.Z - 2))
			root.CFrame = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
			-- the blade's real path hurts; each person can be cut again after a beat
			if t >= nextHit then
				nextHit = t + SP.RehitTime
				table.clear(seen)
			end
			local m, b, tip = bladePoints(a)
			if m then
				local chars = {}
				for _, pl in ipairs(Players:GetPlayers()) do
					if pl.Character then
						table.insert(chars, pl.Character)
					end
				end
				params.FilterDescendantsInstances = chars
				for j = 0, 7 do
					local p = j < 4 and m:Lerp(b, j / 4) or b:Lerp(tip, (j - 4) / 3)
					for _, part in ipairs(workspace:GetPartBoundsInRadius(p, 1.6, params)) do
						local pl = Players:GetPlayerFromCharacter(part:FindFirstAncestorOfClass("Model"))
						if pl and not seen[pl] and ctx.damagePlayer(pl, dmg(CFG.Damage.Spin * dmgMult), root.Position, "Medium") then
							seen[pl] = true
						end
					end
				end
			end
			RunService.Heartbeat:Wait()
		end
		setTrail(a, false)
		root.CFrame = CFrame.new(root.Position.X, stand, root.Position.Z) * CFrame.Angles(0, yaw, 0)
		if not free(a) then -- staggered out of it (or the fight ended): drop to the floor
			root.Anchored = false
			return
		end
		root.Anchored = false
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
		-- giddy and open for a moment as she settles
		bodyPose(a, "Recover", 0.4)
		if waitLive(a, SP.Recover) then
			ready(a)
		end
	end

	-- skittering hop back out of reach
	local function hopBack(a)
		if not free(a) then
			return
		end
		bodyPose(a, "UHop", 0.1)
		push(a, -fwd(a), 26)
		playSound(a.root, SOUNDS.Unsheath, 0.3, 1.6)
		waitLive(a, 0.32)
		a.hum:MoveTo(a.root.Position)
		if live(a) then
			bodyPose(a, "Idle", 0.25)
		end
	end

	---------------------------------------------------------------------------
	-- SECOND LIFE: the rot has her now. A different fighter: she lurches about
	-- like a thing on strings, dances in three-cut strings, leaps on you blade
	-- first, and breathes spores. No fissures: the floor stays whole.
	---------------------------------------------------------------------------
	-- jerks sideways out of line (as if yanked), then reaps from the new angle
	local function lurchReap(a, tChar, tPl)
		local tr = tChar:FindFirstChild("HumanoidRootPart")
		if not tr then
			return
		end
		stopAndFace(a, tChar)
		tell(a, 1.5)
		local side = math.random() < 0.5 and -1 or 1
		local rel = flat(tr.Position - a.root.Position)
		rel = rel.Magnitude > 0.1 and rel.Unit or fwd(a)
		local dir = Vector3.new(-rel.Z, 0, rel.X) * side + rel * 0.35
		dir = dir.Unit
		bodyPose(a, "ULurch", 0.12)
		pose(a, "USweepBack", 0.2)
		if not hold(a, 0.22, 0, nil, nil) then
			return
		end
		local root = a.root
		local dist = 7.5
		local ignore = { ctx.EnemiesFolder, ctx.Map.Bars }
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl.Character then
				table.insert(ignore, pl.Character)
			end
		end
		wallParams.FilterDescendantsInstances = ignore
		local res = workspace:Raycast(root.Position, dir * (dist + 2.5), wallParams)
		if res then
			dist = math.max(res.Distance - 2.5, 0)
		end
		local nextPos = root.Position + dir * dist
		if not inChapel(nextPos) then
			dist = 0
		end
		root.Anchored = true
		local start, rot = root.Position, root.CFrame.Rotation
		local t0 = now()
		playSound(root, SOUNDS.Unsheath, 0.5, 0.5)
		while live(a) do
			local k = math.min((now() - t0) / 0.16, 1)
			root.CFrame = CFrame.new(start + dir * dist * k) * rot
			if k >= 1 then
				break
			end
			RunService.Heartbeat:Wait()
		end
		ctx.dustCloud(Vector3.new(root.Position.X, 0.5, root.Position.Z), 1.2, 5)
		root.Anchored = false
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
		if not free(a) then
			return
		end
		-- snaps her head round to you, and the reap comes almost at once
		local tr2 = tChar:FindFirstChild("HumanoidRootPart")
		if tr2 then
			ctx.turnTowards(root, tr2.Position, math.rad(80))
		end
		reap(a, tChar, tPl, { wind = 0.55, followUp = math.random() < 0.5, notell = true })
	end

	-- three cuts, stepping in with each: across, up from the floor, back across
	local function dance(a, tChar, tPl)
		local m = tempo()
		stopAndFace(a, tChar)
		tell(a, 1.4)
		pose(a, "USweepBack", 0.26 * tg())
		if not windup(a, 0.34 * m, 0.8, tChar, tPl) then
			return
		end
		setTrail(a, true)
		playSound(a.root, SOUNDS.Slash, 0.8, 0.85)
		pose(a, "USweepMid", 0.09, Enum.EasingStyle.Linear)
		task.delay(0.09, function()
			if live(a) then
				pose(a, "USweepEnd", 0.12)
			end
		end)
		push(a, fwd(a), 16)
		sweep(a, 0.22, CFG.Damage.Dance1, "Medium", {}, 1.5)
		-- the blade drops behind her and comes up off the floor
		setTrail(a, false)
		pose(a, "UDragBack", 0.16)
		bodyPose(a, "UDrag", 0.16)
		if not windup(a, 0.38 * m, 0.9, tChar, tPl) then
			return
		end
		push(a, fwd(a), 14)
		rising(a, CFG.Damage.Dance2, "Medium")
		-- turned over and back across
		pose(a, "USweepEndR", 0.14)
		if not windup(a, 0.36 * m, 0.9, tChar, tPl) then
			return
		end
		setTrail(a, true)
		playSound(a.root, SOUNDS.Slash, 0.9, 0.75)
		pose(a, "USweepMidR", 0.09, Enum.EasingStyle.Linear)
		task.delay(0.09, function()
			if live(a) then
				pose(a, "USweepBackR", 0.12)
			end
		end)
		push(a, fwd(a), 16)
		sweep(a, 0.22, CFG.Damage.Dance3, "Large", {}, 1.5)
		setTrail(a, false)
		bodyPose(a, "Recover", 0.35)
		if waitLive(a, 0.75 * m) then
			ready(a)
		end
	end

	-- sinks into a crouch, kicks up dust, leaps and comes down blade first
	local function plunge(a, tChar, tPl)
		local tr = tChar:FindFirstChild("HumanoidRootPart")
		if not tr then
			return
		end
		stopAndFace(a, tChar)
		tell(a, 1.0)
		bodyPose(a, "Crouch", 0.4)
		pose(a, "URaise", 0.4)
		if not hold(a, 0.6 * tempo(), 1, tChar, tPl) then
			return
		end
		local root = a.root
		local landing = tr.Parent and tr.Position or root.Position
		landing = Vector3.new(math.clamp(landing.X, MINP.X + 3, MAXP.X - 3), root.Position.Y, math.clamp(landing.Z, MINP.Z + 3, MAXP.Z - 3))
		local start = root.Position
		local look = flat(landing - start)
		local rot = look.Magnitude > 0.1 and CFrame.lookAt(Vector3.zero, look).Rotation or root.CFrame.Rotation
		ctx.dustCloud(Vector3.new(start.X, 0.5, start.Z), 1.6, 8)
		playSound(root, SOUNDS.Lunge, 0.8, 0.6)
		bodyPose(a, "Air", 0.15)
		root.Anchored = true
		local t0, dur, struck = now(), 0.72, false
		while live(a) do
			local k = math.min((now() - t0) / dur, 1)
			root.CFrame = CFrame.new(start:Lerp(landing, k) + Vector3.new(0, math.sin(k * math.pi) * 11, 0)) * rot
			if k > 0.72 and not struck then
				struck = true
				setTrail(a, true)
				pose(a, "UChop", 0.18)
			end
			if k >= 1 then
				break
			end
			RunService.Heartbeat:Wait()
		end
		root.Anchored = false
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
		if not live(a) then
			return
		end
		-- the landing: dust, thrown grit, sparks off the stone (and no cracks)
		bodyPose(a, "Strike", 0.08)
		local ground = Vector3.new(landing.X, 0.2, landing.Z) + fwd(a) * 4
		ctx.dustCloud(ground + Vector3.new(0, 0.5, 0), 3, 14)
		ctx.debrisChunks(ground + Vector3.new(0, 0.4, 0), 6, 24)
		sparkBurst(ground + Vector3.new(0, 0.3, 0), 24)
		playSound(root, SOUNDS.Impact, 1, 0.8)
		ctx.FxRemote:FireAllClients("Shake", ground, 1)
		local seen = sweep(a, 0.12, CFG.Damage.Plunge, "Knockdown", {}, 1.6)
		for _, pl in ipairs(Players:GetPlayers()) do
			local char, _, hrp = ctx.aliveChar(pl)
			if char and not seen[pl] and flat(hrp.Position - ground).Magnitude <= 5 then
				seen[pl] = true
				ctx.damagePlayer(pl, dmg(CFG.Damage.Plunge), ground, "Knockdown")
			end
		end
		setTrail(a, false)
		task.delay(0.25, function()
			if live(a) then
				bodyPose(a, "Recover", 0.4)
			end
		end)
		if waitLive(a, 1.05) then -- she has to drag the blade back out: punish
			ready(a)
		end
	end

	-- POISON (from her second-life Breath): linger in the spore mist longer than
	-- Config.Usher.Breath.PoisonAfter and you're poisoned (the shared status in Core,
	-- tuned by Config.Usher.Poison). It ends when she dies: the rot dies with her.
	local function poisonPlayer(pl)
		if U.state ~= "dead" then
			ctx.poisonPlayer(pl, CFG.Poison)
		end
	end
	local clearAllPoison = ctx.clearAllPoison
	local PCOL = Color3.fromRGB(150, 178, 70) -- poison green (her breath's mist is tinted toward it)

	-- rears back, chest swelling, spores leaking from the hood; then breathes out
	-- a great choking cloud that hangs in the air. Linger in it and you're poisoned.
	-- Size and timing: Config.Usher.Breath.
	local function breath(a, tChar, tPl)
		local BR = CFG.Breath or {}
		stopAndFace(a, tChar)
		tell(a, 0.9)
		pose(a, "UIdle", 0.3)
		bodyPose(a, "UShriek", 0.55)
		local head = a.model:FindFirstChild("Head")
		for i = 0, 4 do
			task.delay(i * 0.2, function()
				if live(a) and head then
					sporePuff(head.Position, 6, 0.8, 1.5)
				end
			end)
		end
		playSound(a.root, SOUNDS.Groan, 0.6, 0.75)
		if not hold(a, 0.9 * tempo() * tg(), 0.5, tChar, tPl) then
			return
		end
		bodyPose(a, "UExhale", 0.15)
		playSound(a.root, SOUNDS.Groan, 1, 1.35)
		playSound(a.root, SOUNDS.Groan, 0.7, 0.9)
		local origin = a.root.Position
		local aim = fwd(a)
		local range = BR.Range or 19
		local n = BR.Puffs or 9
		local baseR = BR.Radius or 3.2
		local linger = BR.Linger or 4
		local centers, radii = {}, {}
		for i = 1, n do
			local f = i / n
			-- the cloud spreads wider and sinks toward the floor the farther it goes
			centers[i] = origin + aim * (range * f) + Vector3.new(0, 2.2 - f * 1.6, 0)
			radii[i] = baseR * (0.75 + f * 0.7)
		end
		-- the gust itself: a heavy rolling burst along the whole length
		for i = 1, n do
			task.delay(i * 0.045, function()
				if live(a) then
					sporePuff(centers[i], 22, radii[i] * 0.6, 5)
				end
			end)
		end
		-- and the mist it leaves behind, hanging there for Linger seconds
		local MIST = SPORE:Lerp(PCOL, 0.55)
		for i = 1, n do
			local anchor = ctx.fxAnchor(centers[i])
			local pe = Instance.new("ParticleEmitter")
			pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
			pe.Rate = 9
			pe.Lifetime = NumberRange.new(1.4, 2.4)
			pe.Speed = NumberRange.new(0.3, 1.2)
			pe.SpreadAngle = Vector2.new(180, 180)
			pe.Drag = 2
			pe.RotSpeed = NumberRange.new(-20, 20)
			pe.Rotation = NumberRange.new(0, 360)
			pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, radii[i] * 0.7), NumberSequenceKeypoint.new(1, radii[i] * 1.5) })
			pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.25, 0.55), NumberSequenceKeypoint.new(1, 1) })
			pe.Color = ColorSequence.new(MIST)
			pe.LightEmission = 0.15
			pe.Parent = anchor
			task.delay(linger, function()
				pe.Enabled = false
			end)
			Debris:AddItem(anchor, linger + 2.6)
		end
		local function inMist(p)
			for i = 1, n do
				local c = centers[i]
				if math.abs(p.Y - c.Y) < radii[i] + 3 and flat(p - c).Magnitude <= radii[i] then
					return true
				end
			end
			return false
		end
		-- the gust's hit
		for _, pl in ipairs(Players:GetPlayers()) do
			local char, _, hrp = ctx.aliveChar(pl)
			if char and inMist(hrp.Position) then
				ctx.damagePlayer(pl, dmg(CFG.Damage.Breath), origin, "Medium")
			end
		end
		-- the mist: stand in it longer than PoisonAfter and you're poisoned
		task.spawn(function()
			local inside, poisoned = {}, {}
			local t0 = now()
			while now() - t0 < linger and U.state ~= "dead" do
				local dt = RunService.Heartbeat:Wait()
				for _, pl in ipairs(Players:GetPlayers()) do
					local char, _, hrp = ctx.aliveChar(pl)
					if char and not poisoned[pl] and inMist(hrp.Position) then
						inside[pl] = (inside[pl] or 0) + dt
						if inside[pl] > (BR.PoisonAfter or 0.1) then
							poisoned[pl] = true
							poisonPlayer(pl)
						end
					else
						inside[pl] = 0
					end
				end
			end
		end)
		if waitLive(a, 0.9) then
			bodyPose(a, "Idle", 0.3)
			ready(a)
		end
	end

	-- COUNTER STANCE: sinks low, blade flat behind her, hood burning, and waits. Strike
	-- her and she slips the blow, is at your side, and cuts you down (Config.Usher.Stance).
	api.evade = function(player)
		if U.stanceOn and not U.stanceBy then
			U.stanceBy = player
		end
		return U.stanceOn == true
	end
	local function stance(a, tChar, tPl)
		local SC = CFG.Stance
		stopAndFace(a, tChar)
		tell(a, 0.8)
		pose(a, "UStance", 0.35)
		playSound(a.root, SOUNDS.Unsheath, 0.6, 0.4)
		if not hold(a, 0.35, 1, tChar, tPl) then
			return
		end
		local folds = blindfolds(a)
		for _, b in ipairs(folds) do
			b.Color = BLIND_FLARE -- lit the whole time she waits: the "don't" sign
		end
		U.stanceOn, U.stanceBy = true, nil
		local t0 = now()
		while now() - t0 < SC.Hold and free(a) and not U.stanceBy do
			task.wait()
		end
		U.stanceOn = false
		local pl = U.stanceBy
		U.stanceBy = nil
		for _, b in ipairs(folds) do
			if b.Parent then
				TweenService:Create(b, TweenInfo.new(0.4), { Color = U.phase2 and BLIND_P2 or BLIND_BASE }):Play()
			end
		end
		local char, hrp
		if pl then
			char, _, hrp = ctx.aliveChar(pl)
		end
		if not (char and free(a)) then
			if live(a) then
				ready(a)
				bodyPose(a, "Idle", 0.3)
			end
			return
		end
		-- the counter: gone from where you struck, already at your side
		ctx.FxRemote:FireClient(pl, "Message", "Parried!")
		local root = a.root
		sporePuff(root.Position, 10, 1, 4)
		local side = flat(hrp.CFrame.RightVector).Unit * (math.random() < 0.5 and -1 or 1)
		local ignore = { ctx.EnemiesFolder, ctx.Map.Bars, char }
		wallParams.FilterDescendantsInstances = ignore
		if workspace:Raycast(hrp.Position, side * 5, wallParams) or not inChapel(hrp.Position + side * 4) then
			side = -side
		end
		local spot = hrp.Position + side * 4
		spot = Vector3.new(spot.X, root.Position.Y, spot.Z)
		root.CFrame = CFrame.lookAt(spot, Vector3.new(hrp.Position.X, spot.Y, hrp.Position.Z))
		root.AssemblyLinearVelocity = Vector3.zero
		ctx.dustCloud(Vector3.new(spot.X, 0.5, spot.Z), 1.2, 5)
		setTrail(a, true)
		pose(a, "USweepEnd", SC.Delay)
		bodyPose(a, "SweepEnd", SC.Delay)
		playSound(root, SOUNDS.Slash, 1, 0.7)
		if not waitLive(a, SC.Delay) then
			return
		end
		local _, hum2 = ctx.aliveChar(pl)
		if hum2 and ctx.damagePlayer(pl, hum2.MaxHealth * 10, root.Position, "Knockdown") then
			sparkBurst(hrp.Position, 30)
			playSound(root, SOUNDS.Impact, 1, 0.8)
			ctx.FxRemote:FireAllClients("Shake", hrp.Position, 0.8)
		end
		if waitLive(a, 0.6) then
			setTrail(a, false)
			ready(a)
			bodyPose(a, "Idle", 0.3)
		end
	end

	---------------------------------------------------------------------------
	-- brain
	---------------------------------------------------------------------------
	local MOVES = {
		-- both lives: the counter stance
		{ name = "Stance", min = 0, max = 14, weight = CFG.Stance.Weight, cd = CFG.Stance.Cooldown, fn = stance },
		-- first life: the usher, measured and deliberate
		{ name = "Spin", life = 1, min = 0, max = 18, weight = 3, cd = 8, fn = spin },
		{ name = "Chop", life = 1, min = 0, max = 14, weight = 3, cd = 2.5, fn = function(a, t, pl)
			chop(a, t, pl, { delayed = math.random() < 0.4 })
		end },
		{ name = "Lunge", life = 1, min = 13, max = 32, weight = 3, cd = 4.5, noise = true, fn = lunge },
		{ name = "Turnabout", min = 0, max = 12, weight = 1, cd = 4, behind = true, fn = function(a, t, pl)
			turnabout(a, t, pl, false)
		end },
		-- second life: the rot's puppet
		{ name = "Lurch", life = 2, min = 0, max = 15, weight = 4, cd = 1.5, fn = lurchReap },
		{ name = "Dance", life = 2, min = 0, max = 12, weight = 3, cd = 4, fn = dance },
		{ name = "Plunge", life = 2, min = 12, max = 32, weight = 3, cd = 5, noise = true, fn = plunge },
		{ name = "Spin2", life = 2, min = 0, max = 22, weight = CFG.Spin.Weight2 or 2, cd = CFG.Spin.Cooldown2 or 10, fn = function(a, t, pl)
			spin(a, t, pl, true)
		end },
		{ name = "Breath", life = 2, min = 0, max = 14, weight = 3, cd = 7, fn = breath },
	}

	local function pick(dist, behind, loud)
		local list, total = {}, 0
		local t = now()
		for _, mv in ipairs(MOVES) do
			if (not mv.life or mv.life == (U.phase2 and 2 or 1)) and dist >= mv.min and dist <= mv.max and t >= (U.cd[mv.name] or 0) then
				local w = mv.weight
				if behind then
					w *= mv.behind and 6 or 0.3
				end
				if loud and mv.noise then
					w *= 3 -- she rushes the sound of a flask being drunk
				end
				if mv.name == U.lastMove then
					w *= 0.2 -- never the same thing twice running, if she can help it
				end
				total += w
				table.insert(list, { mv, w })
			end
		end
		if total <= 0 then
			return nil
		end
		local r = math.random() * total
		for _, e in ipairs(list) do
			r -= e[2]
			if r <= 0 then
				return e[1]
			end
		end
		return list[#list][1]
	end

	local function stalk(a, tr, pl)
		local rel = flat(a.root.Position - tr.Position)
		if rel.Magnitude < 0.1 then
			return
		end
		local keep = math.clamp(rel.Magnitude, 9, 13)
		local around = CFrame.Angles(0, U.stalkSide * 0.6, 0):VectorToWorldSpace(rel.Unit) * keep
		a.hum:MoveTo(tr.Position + around)
		ctx.turnTowards(a.root, tr.Position, turnRate(pl) * 0.1)
	end

	local function kneelAtHome(a)
		U.state = "kneel"
		-- Pinned (anchored) at her exact standing height while she waits. Left to physics, a
		-- rig that isn't moving slowly sinks, and every correction of that reached the client
		-- as a jitter. (Anchoring once made waiting rigs look sunk too, but that was the
		-- client's own HipHeight, which the Puppeteer now holds true.) Released in startFight.
		a.root.Anchored = true
		a.root.CFrame = HOME + Vector3.new(0, 3 * S - 3, 0)
		a.root.AssemblyLinearVelocity = Vector3.zero
		a.hum.AutoRotate = false
		a.hum:MoveTo(a.root.Position)
		pcall(function()
			a.root:SetNetworkOwner(nil)
			a.hum:ChangeState(Enum.HumanoidStateType.Running) -- standing (kneeling is only a pose): a waiting rig not "Running" sinks
		end)
		a.hum.Health = a.hum.MaxHealth
		setTrail(a, false)
		sparks(a, false)
		pose(a, "UKneelGrip", 0.8)
		bodyPose(a, "UKneel", 0.9)
		U.cd = {}
		U.lastMove = nil
		U.poise = nil
		U.stanceOn, U.stanceBy = false, nil
	end

	local watch -- forward

	local function brain(a)
		U.stalkUntil = now() + 0.3
		U.stalkSide = 1
		U.lostSince = nil
		while live(a) do
			task.wait(0.1)
			if not live(a) then
				break
			end
			if now() < (U.staggerUntil or 0) then
				continue
			end
			a.hum.AutoRotate = false
			local tChar, tPl = target(a)
			if not tChar then
				-- nobody left in the chapel: wait a moment, then go back to her vigil
				U.lostSince = U.lostSince or now()
				a.hum:MoveTo(a.root.Position)
				if now() - U.lostSince > 4 then
					if U.phase2 then
						task.defer(api.reset) -- second life: the whole fight starts over
						return
					end
					U.state = "returning"
					hideBar()
					task.spawn(watch, a)
					return
				end
				continue
			end
			U.lostSince = nil
			local tr = tChar:FindFirstChild("HumanoidRootPart")
			if not tr then
				continue
			end
			local rel = flat(tr.Position - a.root.Position)
			local dist = rel.Magnitude
			local facing = dist > 0.1 and fwd(a):Dot(rel.Unit) or 1
			local behind = facing < -0.2
			local loud = ctx.states[tPl] and ctx.states[tPl].healing
			if now() < U.stalkUntil and not behind and not loud then
				stalk(a, tr, tPl)
				continue
			end
			local mv = pick(dist, behind, loud)
			if mv then
				U.lastMove = mv.name
				U.cd[mv.name] = now() + mv.cd
				local ok, err = pcall(mv.fn, a, tChar, tPl)
				if not ok then
					warn("[DGUS] Oculast " .. mv.name .. " error: " .. tostring(err))
					sparks(a, false)
					if a.root.Parent then
						a.root.Anchored = false
					end
				end
				if ctx.Config.Debug then
					print("[Oculast] " .. mv.name)
				end
				if live(a) and mv.name ~= "Lunge" and math.random() < 0.3 and dist < 6 then
					hopBack(a)
				end
				U.stalkSide = math.random() < 0.5 and -1 or 1
				U.stalkUntil = now() + (U.phase2 and rand(0.05, 0.3) or rand(0.2, 0.55)) + (CFG.IdleExtra or 0)
			elseif dist < 4 then
				a.hum:MoveTo(a.root.Position - rel.Unit * 6)
				ctx.turnTowards(a.root, tr.Position, turnRate(tPl) * 0.1)
			else
				a.hum:MoveTo(tr.Position)
				ctx.turnTowards(a.root, tr.Position, turnRate(tPl) * 0.1)
			end
		end
	end

	-- the rot takes root in her: tendrils out of the hood, boils, a rotted blade
	local function growRot(a)
		local head, chest = a.model:FindFirstChild("Head"), a.model:FindFirstChild("Chest")
		local function add(base, size, off, color, shape)
			if not base then
				return
			end
			local p = Instance.new("Part")
			p.Name = "Rot"
			p.Size = size * S
			p.Color = color
			p.Material = Enum.Material.SmoothPlastic
			p.Reflectance = 0.1
			if shape then
				p.Shape = shape
			end
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.Massless = true
			p.CFrame = base.CFrame * CFrame.new(off.Position * S) * off.Rotation
			local w = Instance.new("WeldConstraint")
			w.Part0 = base
			w.Part1 = p
			w.Parent = p
			p.Parent = a.model
		end
		for i = 1, 7 do
			local x = (i - 4) * 0.17
			add(head, Vector3.new(0.14, 1 + math.random() * 0.9, 0.14), CFrame.new(x, 0.75 + math.random() * 0.2, 0.25 + math.random() * 0.25) * CFrame.Angles(-0.6 - math.random() * 0.5, 0, -x * 1.6), ROT_DARK:Lerp(ROT_FLESH, math.random()))
		end
		for _, b in ipairs({ { 0.6, 0.7, 0.1, 0.5 }, { 0.75, 0.45, -0.2, 0.35 }, { -0.1, 0.85, 0.4, 0.4 }, { 0.3, 0.2, 0.55, 0.45 }, { -0.5, -0.2, 0.55, 0.3 }, { 0.2, -0.5, -0.55, 0.32 } }) do
			add(chest, Vector3.new(b[4], b[4], b[4]), CFrame.new(b[1], b[2], b[3]), ROT_DARK:Lerp(ROT_FLESH, math.random()), Enum.PartType.Ball)
		end
		local weapon = a.model:FindFirstChild("Weapon")
		if weapon then
			for _, d in ipairs(weapon:GetDescendants()) do
				if d:IsA("BasePart") and d.Name == "Blade" then
					d.Color = Color3.fromRGB(48, 36, 30)
				elseif d:IsA("BasePart") and d.Name == "Edge" then
					d.Color = Color3.fromRGB(150, 140, 80)
				end
			end
			local tip = weapon:FindFirstChild("BladeTip", true)
			if tip then
				local drip = Instance.new("ParticleEmitter")
				drip.Rate = 6
				drip.Lifetime = NumberRange.new(0.6, 1)
				drip.Speed = NumberRange.new(0, 0.5)
				drip.Acceleration = Vector3.new(0, -25, 0)
				drip.Size = NumberSequence.new(0.12, 0.05)
				drip.Color = ColorSequence.new(Color3.fromRGB(70, 66, 36))
				drip.Parent = tip
			end
		end
		if chest then
			local pe = Instance.new("ParticleEmitter")
			pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
			pe.Rate = 6
			pe.Lifetime = NumberRange.new(1, 2)
			pe.Speed = NumberRange.new(0.5, 1.5)
			pe.Size = NumberSequence.new(0.4, 1.2)
			pe.Transparency = NumberSequence.new(0.6, 1)
			pe.Color = ColorSequence.new(SPORE)
			pe.Parent = chest
		end
	end

	-- What the rot makes of her in her second life: a long, many-jointed arm tears
	-- out of her back and folds over her shoulder, and a single ragged wing
	-- unfolds out of the side of her head. Both grow out piece by piece as she
	-- rises, then never keep still: the arm twitches and claws at the air, the
	-- wing shudders and beats. Before each attack the arm rears up and spreads its
	-- fingers and the wing flares (part of her tell, see tell()).
	-- Shape: change the numbers in MUTANT below (sizes in studs at Scale 1).
	local MUTANT = {
		GrowTime = 1.6, -- how long the arm and wing take to grow out
		ArmLength = 1, -- multiplies the back arm's length
		WingLength = 1, -- multiplies the wing's length
		Flesh = Color3.fromRGB(150, 138, 116), -- the arm's skin: grey, bloodless
		Claw = Color3.fromRGB(40, 34, 28),
		Feather = Color3.fromRGB(176, 168, 146), -- dirty bone-white
		FeatherDark = Color3.fromRGB(92, 84, 70),
	}
	local function mutate(a)
		local head, chest = a.model:FindFirstChild("Head"), a.model:FindFirstChild("Chest")
		if not head or not chest then
			return
		end
		local ch, cd = chest.Size.Y / S, chest.Size.Z / S
		local growing = {} -- { part, weld, size, ball, at }
		-- a piece hinged at `joint` (in base's space, studs at scale 1; when the base
		-- is another piece, measured from that piece's own hinge) that extends along
		-- its own +Y from there; balls sit centred on the joint
		local function piece(base, size, joint, color, mat, at, ball)
			for _, g in ipairs(growing) do
				if g.p == base and not g.ball then
					joint = CFrame.new(0, -g.size.Y / S / 2, 0) * joint
				end
			end
			local p = Instance.new("Part")
			p.Name = "Mutation"
			p.Size = Vector3.new(0.05, 0.05, 0.05)
			p.Color = color
			p.Material = mat or Enum.Material.SmoothPlastic
			if ball then
				p.Shape = Enum.PartType.Ball
			end
			p.Transparency = 1
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.Massless = true
			p.CastShadow = true
			p.TopSurface = Enum.SurfaceType.Smooth
			p.BottomSurface = Enum.SurfaceType.Smooth
			local w = Instance.new("Weld")
			w.Part0 = base
			w.Part1 = p
			w.C0 = CFrame.new(joint.Position * S) * joint.Rotation
			w.C1 = CFrame.new()
			p.CFrame = base.CFrame * w.C0
			w.Parent = p
			p.Parent = a.model
			table.insert(growing, { p = p, w = w, size = size * S, ball = ball, at = at })
			return p, w
		end
		local function len(p)
			for _, g in ipairs(growing) do
				if g.p == p then
					return g.size.Y / S
				end
			end
			return 0
		end
		local A, W = MUTANT.ArmLength, MUTANT.WingLength
		local flesh, fleshDark = MUTANT.Flesh, MUTANT.Flesh:Lerp(ROT_DARK, 0.55)

		-- THE ARM: torn out of her upper back, right of the spine, reaching up and
		-- back, then folding forward over her shoulder like a mantis's
		local T = 0
		piece(chest, Vector3.new(0.75, 0.75, 0.75), CFrame.new(0.28, ch * 0.28, cd / 2 + 0.02), ROT_FLESH, Enum.Material.SmoothPlastic, T, true)
		piece(chest, Vector3.new(0.5, 0.5, 0.5), CFrame.new(0.05, ch * 0.18, cd / 2 + 0.08), ROT_DARK, Enum.Material.SmoothPlastic, T, true)
		local upper, shoulderW = piece(chest, Vector3.new(0.34, 2.1 * A, 0.34), CFrame.new(0.3, ch * 0.3, cd / 2 + 0.05) * CFrame.Angles(0.75, 0, -0.5), flesh, Enum.Material.SmoothPlastic, T + 0.1)
		local uL = len(upper)
		piece(upper, Vector3.new(0.44, 0.44, 0.44), CFrame.new(0, uL, 0), fleshDark, Enum.Material.SmoothPlastic, T + 0.35, true)
		piece(upper, Vector3.new(0.12, 0.5, 0.12), CFrame.new(0, uL * 0.55, 0.16) * CFrame.Angles(0.5, 0, 0), MUTANT.Claw, Enum.Material.SmoothPlastic, T + 0.3) -- a bone spur
		local fore, elbowW = piece(upper, Vector3.new(0.27, 2.4 * A, 0.27), CFrame.new(0, uL, 0) * CFrame.Angles(-1.85, 0, -0.4), flesh:Lerp(fleshDark, 0.3), Enum.Material.SmoothPlastic, T + 0.4)
		local fL = len(fore)
		local hand, wristW = piece(fore, Vector3.new(0.4, 0.42, 0.16), CFrame.new(0, fL, 0) * CFrame.Angles(-0.35, 0, 0), fleshDark, Enum.Material.SmoothPlastic, T + 0.7)
		local fingers = {}
		for i = 1, 4 do
			local x = (i - 2.5) * 0.11
			local fing, fw = piece(hand, Vector3.new(0.07, 0.95 * A, 0.07), CFrame.new(x, 0.42, 0) * CFrame.Angles(-0.55, 0, -x * 1.8), flesh:Lerp(fleshDark, 0.5), Enum.Material.SmoothPlastic, T + 0.85 + i * 0.03)
			piece(fing, Vector3.new(0.06, 0.32, 0.06), CFrame.new(0, len(fing), 0) * CFrame.Angles(-0.6, 0, 0), MUTANT.Claw, Enum.Material.SmoothPlastic, T + 1.0 + i * 0.03)
			table.insert(fingers, { w = fw, base = fw.C0 })
		end

		-- THE WING: one, out of the left side of her head, through the hood; bare
		-- bone near the root, then ragged feathers, some missing
		T = 0.25
		piece(head, Vector3.new(0.55, 0.55, 0.55), CFrame.new(-0.55, 0.62, 0.25), ROT_FLESH, Enum.Material.SmoothPlastic, T, true)
		local humerus, rootW = piece(head, Vector3.new(0.22, 1.5 * W, 0.22), CFrame.new(-0.55, 0.62, 0.25) * CFrame.Angles(0.3, 0, 0.7), MUTANT.Feather:Lerp(ROT_FLESH, 0.5), Enum.Material.SmoothPlastic, T + 0.1)
		local hL = len(humerus)
		piece(humerus, Vector3.new(0.3, 0.3, 0.3), CFrame.new(0, hL, 0), ROT_FLESH, Enum.Material.SmoothPlastic, T + 0.35, true)
		local fa, faW = piece(humerus, Vector3.new(0.17, 2.3 * W, 0.17), CFrame.new(0, hL, 0) * CFrame.Angles(0.1, 0, 0.35), MUTANT.Feather, Enum.Material.SmoothPlastic, T + 0.4)
		local faL = len(fa)
		local tipB, tipW = piece(fa, Vector3.new(0.12, 1.6 * W, 0.12), CFrame.new(0, faL, 0) * CFrame.Angles(0.05, 0, 0.4), MUTANT.Feather, Enum.Material.SmoothPlastic, T + 0.7)
		local tL = len(tipB)
		-- feathers hang down off the trailing edge, swept back toward the tip
		local rnd = Random.new(7)
		local function feathers(bone, boneLen, n, l0, l1, t0)
			for i = 1, n do
				if rnd:NextNumber() > 0.18 then -- a few plucked out
					local f = (i - 0.5) / n
					local l = (l0 + (l1 - l0) * f) * W * (0.75 + rnd:NextNumber() * 0.35)
					local c = MUTANT.Feather:Lerp(MUTANT.FeatherDark, rnd:NextNumber() * 0.8)
					piece(bone, Vector3.new(0.34, l, 0.04), CFrame.new(0, boneLen * f, -0.02 * i) * CFrame.Angles(0, 0, math.pi / 2 - 0.15 - f * 0.3), c, Enum.Material.Fabric, t0 + f * 0.35)
				end
			end
		end
		feathers(humerus, hL, 3, 0.7, 1.1, T + 0.3)
		feathers(fa, faL, 7, 1.3, 2.3, T + 0.6)
		feathers(tipB, tL, 5, 2.4, 1.6, T + 0.9)

		-- grow it all out, root first; each piece unrolls from its hinge
		local grow = MUTANT.GrowTime / 1.6
		for _, g in ipairs(growing) do
			task.delay(g.at * grow, function()
				if not g.p.Parent then
					return
				end
				g.p.Transparency = 0
				local ti = TweenInfo.new(0.3 * grow + 0.05, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
				if g.ball then
					TweenService:Create(g.p, ti, { Size = g.size }):Play()
				else
					g.p.Size = Vector3.new(g.size.X * 0.6, 0.05, g.size.Z * 0.6)
					TweenService:Create(g.p, ti, { Size = g.size }):Play()
					TweenService:Create(g.w, ti, { C1 = CFrame.new(0, -g.size.Y / 2, 0) }):Play()
				end
			end)
		end
		-- the wet crack of it breaking out of her
		for i = 0, 3 do
			task.delay(i * 0.3 * grow, function()
				if a.root.Parent then
					playSound(a.root, SOUNDS.Impact, 0.7, 0.35 + i * 0.08)
					sporePuff(chest.Position + chest.CFrame.LookVector * -0.8 * S, 6, 0.6, 3)
				end
			end)
		end

		-- after that it is never still
		local rest = {
			{ w = shoulderW, base = shoulderW.C0 },
			{ w = elbowW, base = elbowW.C0 },
			{ w = wristW, base = wristW.C0 },
		}
		local wing = { { w = rootW, base = rootW.C0 }, { w = faW, base = faW.C0 }, { w = tipW, base = tipW.C0 } }
		local rearing = 0
		local function twist(j, x, y, z, t, style)
			TweenService:Create(j.w, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { C0 = j.base * CFrame.Angles(x, y, z) }):Play()
		end
		local function rand2(r)
			return (math.random() * 2 - 1) * r
		end
		U.mut = {
			-- before an attack: the arm rears high, fingers splay; the wing flares wide
			rear = function()
				rearing = now() + 0.7
				twist(rest[1], 0.45, 0, -0.25, 0.18, Enum.EasingStyle.Back)
				twist(rest[2], 0.9, 0, 0, 0.18, Enum.EasingStyle.Back)
				twist(rest[3], 0.4, 0, 0, 0.18)
				for i, f in ipairs(fingers) do
					twist(f, 0.7, 0, (i - 2.5) * 0.25, 0.15)
				end
				twist(wing[1], -0.2, 0, 0.3, 0.2, Enum.EasingStyle.Back)
				twist(wing[2], 0, 0, -0.35, 0.2, Enum.EasingStyle.Back)
				twist(wing[3], 0, 0, -0.3, 0.2, Enum.EasingStyle.Back)
			end,
		}
		task.spawn(function()
			task.wait(MUTANT.GrowTime + 0.3)
			local nextBeat = now()
			while U.current == a and a.model.Parent and U.state ~= "dead" do
				if now() >= rearing then
					-- the arm twitches and claws at nothing; sometimes a hard spasm
					local hard = math.random() < 0.2
					local r = hard and 0.5 or 0.18
					local t = hard and 0.09 or rand(0.12, 0.3)
					twist(rest[1], rand2(r), rand2(r), rand2(r), t, Enum.EasingStyle.Back)
					twist(rest[2], rand2(r * 1.2), 0, rand2(r * 0.5), t, Enum.EasingStyle.Back)
					twist(rest[3], rand2(r), rand2(r), 0, t)
					local clench = math.random() < 0.5 and rand(0.4, 0.9) or rand(-0.4, 0)
					for i, f in ipairs(fingers) do
						task.delay(i * 0.03, function()
							twist(f, -clench + rand2(0.1), 0, rand2(0.1), 0.12)
						end)
					end
					-- the wing: a slow shudder most of the time, a full beat now and then
					if now() >= nextBeat then
						nextBeat = now() + rand(1.6, 3.2)
						twist(wing[1], 0.15, 0, 0.35, 0.25, Enum.EasingStyle.Sine)
						twist(wing[2], 0, 0, -0.4, 0.25, Enum.EasingStyle.Sine)
						task.delay(0.28, function()
							twist(wing[1], -0.1, 0, -0.45, 0.4, Enum.EasingStyle.Sine)
							twist(wing[2], 0, 0, 0.35, 0.4, Enum.EasingStyle.Sine)
							twist(wing[3], 0, 0, 0.3, 0.4, Enum.EasingStyle.Sine)
						end)
					else
						twist(wing[1], rand2(0.06), 0, rand2(0.1), 0.35, Enum.EasingStyle.Sine)
						twist(wing[2], 0, 0, rand2(0.12), 0.35, Enum.EasingStyle.Sine)
						twist(wing[3], 0, 0, rand2(0.15), 0.35, Enum.EasingStyle.Sine)
					end
					task.wait(hard and 0.15 or rand(0.25, 0.7))
				else
					task.wait(0.1)
				end
			end
		end)
	end

	-- Her first bar runs out. She falls to her knees, the bar goes, the music
	-- stops... and after a long breath the rot gets up instead, with a new bar.
	-- Her transition takes this much longer than its base timing (1.5 = 50% longer).
	local FALL = CFG.FallTime or 1.5

	-- Breathing while she lies fallen: slow breaths that start barely audible and
	-- swell, louder and harsher, until the rot bursts out of her. Uses SOUNDS.Breath
	-- (an asset id, if you set one) or, by default, Roblox's built-in wind sample
	-- pitched down and filtered so it reads as breath. Returns a function to stop it.
	local function breathing(a, total)
		local head = a.model:FindFirstChild("Head") or a.root
		local snd = Instance.new("Sound")
		local own = SOUNDS.Breath and SOUNDS.Breath ~= ""
		snd.SoundId = own and SOUNDS.Breath or "rbxasset://sounds/action_falling.mp3"
		snd.Looped = true
		snd.Volume = 0
		snd.RollOffMaxDistance = 90
		snd.RollOffMinDistance = 8
		snd.PlaybackSpeed = own and 1 or 0.45
		if not own then
			local eq = Instance.new("EqualizerSoundEffect")
			eq.HighGain = -18 -- soft, airy, no whistle
			eq.MidGain = 2
			eq.LowGain = -6
			eq.Parent = snd
		end
		snd.Parent = head
		snd:Play()
		local alive = true
		task.spawn(function()
			local t0 = now()
			while alive and snd.Parent do
				-- 0 -> 1 over the whole fall: barely there at first, loud by the end
				local k = math.clamp((now() - t0) / total, 0, 1)
				local peak = 0.03 + 1.6 * k * k
				local inhale = 1.5 - 0.6 * k -- breaths get quicker as it builds
				local exhale = 1.9 - 0.8 * k
				if not own then
					snd.PlaybackSpeed = 0.42 + 0.12 * k
				end
				TweenService:Create(snd, TweenInfo.new(inhale, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Volume = peak }):Play()
				task.wait(inhale)
				if not alive then
					break
				end
				if not own then
					snd.PlaybackSpeed = 0.36 + 0.1 * k -- the out-breath sits lower
				end
				TweenService:Create(snd, TweenInfo.new(exhale, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Volume = peak * 0.08 }):Play()
				task.wait(exhale)
			end
		end)
		return function()
			alive = false
			TweenService:Create(snd, TweenInfo.new(0.15), { Volume = 0 }):Play()
			Debris:AddItem(snd, 0.3)
		end
	end

	-- ROT TETHER (second life only). A ring of brambles tears up out of the floor
	-- around her: clusters of black, thorned, rotting branches taller than you,
	-- their tips curling in over the arena, bound together by roots creeping along
	-- the stone, spores drifting off them. The ring follows her about. Inside it
	-- you're fine; stray outside and the haze starts to choke you after a short
	-- grace, a little at first and worse the longer you stay out. It starts wide,
	-- closes in slowly, and stops at MinRadius, well outside her reach, so you
	-- never have to hug her to live. The haze isn't dodged by rolling but never
	-- stuns or knocks you about. Only players inside the chapel are affected.
	-- Tuning: Config.Usher.Tether.
	local BRAMBLE_WOOD = Color3.fromRGB(40, 31, 25)
	local BRAMBLE_THORN = Color3.fromRGB(24, 20, 16)

	-- one cluster of brambles, built around its own invisible root at the origin.
	-- Local space: -Z points in at her, +Z out of the ring, Y up.
	local function bramble(seed, height)
		local rnd = Random.new(seed)
		local function r(lo, hi)
			return rnd:NextNumber(lo, hi)
		end
		local model = Instance.new("Model")
		model.Name = "Bramble"
		local root = Instance.new("Part")
		root.Name = "BrambleRoot"
		root.Size = Vector3.new(3, 1, 3)
		root.Transparency = 1
		root.Anchored = true
		root.CanCollide = false
		root.CanQuery = false
		root.CanTouch = false
		root.CFrame = CFrame.new()
		root.Parent = model
		model.PrimaryPart = root
		local function bit(size, cf, color, mat, ball)
			local p = Instance.new("Part")
			p.Name = "Bramble"
			p.Size = size
			p.CFrame = cf
			p.Color = color
			p.Material = mat or Enum.Material.Wood
			if ball then
				p.Shape = Enum.PartType.Ball
			end
			p.Anchored = false
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.Massless = true
			p.TopSurface = Enum.SurfaceType.Smooth
			p.BottomSurface = Enum.SurfaceType.Smooth
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = p
			w.Parent = p
			p.Parent = model
			return p
		end
		local function along(from, dir)
			-- a CFrame at `from` whose Z axis runs along `dir`
			local up = math.abs(dir.Y) > 0.9 and Vector3.xAxis or Vector3.yAxis
			return CFrame.lookAt(from, from + dir, up)
		end
		-- the twisted stalks: rising, kinking, their tips curling in over the arena
		for _ = 1, rnd:NextInteger(3, 4) do
			local pos = Vector3.new(r(-1.3, 1.3), -0.6, r(-0.7, 0.9))
			local dir = Vector3.new(r(-0.35, 0.35), 1, r(-0.1, 0.45)).Unit
			local w = r(0.4, 0.6)
			local segs = 4
			local len = height * r(0.7, 1.15) / segs
			local curl = r(0.15, 0.4)
			for g = 1, segs do
				local center = pos + dir * len / 2
				bit(Vector3.new(w, w, len + w * 0.4), along(center, dir), BRAMBLE_WOOD:Lerp(ROT_DARK, r(0, 0.6)))
				-- a gnarled knot at the bend
				bit(Vector3.new(w * 1.35, w * 1.35, w * 1.35), CFrame.new(pos), BRAMBLE_WOOD:Lerp(ROT_FLESH, r(0, 0.35)), Enum.Material.Wood, true)
				-- thorns
				for _ = 1, 2 do
					local tp = pos + dir * len * r(0.15, 0.9)
					local side = dir:Cross(Vector3.new(r(-1, 1), r(-1, 1), r(-1, 1))).Unit
					if side.Magnitude == side.Magnitude then -- (skip a NaN)
						local tl = r(0.35, 0.65)
						bit(Vector3.new(0.09, 0.09, tl), along(tp + side * (w / 2 + tl / 2), side + dir * 0.4), BRAMBLE_THORN, Enum.Material.Wood)
					end
				end
				-- now and then a swollen rot-pod or a short side shoot
				if rnd:NextNumber() < 0.3 then
					local side = dir:Cross(Vector3.new(0, 0, 1))
					side = side.Magnitude > 0.05 and side.Unit or Vector3.xAxis
					local sz = r(0.5, 0.9)
					bit(Vector3.new(sz, sz, sz), CFrame.new(pos + dir * len * 0.5 + side * (w / 2 + sz * 0.3)), ROT_FLESH:Lerp(SPORE, r(0, 0.3)), Enum.Material.SmoothPlastic, true)
				elseif rnd:NextNumber() < 0.45 then
					local sd = (dir + Vector3.new(r(-0.9, 0.9), r(-0.2, 0.3), r(-0.9, 0.9))).Unit
					local sl = len * r(0.5, 0.9)
					local sp = pos + dir * len * 0.6
					bit(Vector3.new(w * 0.45, w * 0.45, sl), along(sp + sd * sl / 2, sd), BRAMBLE_WOOD)
				end
				pos += dir * len
				dir = (dir + Vector3.new(r(-0.35, 0.35), -0.08 * g, -curl * g + r(-0.15, 0.15))).Unit
				w *= 0.7
			end
			-- the tip: a dripping hook, or a hanging pod
			if rnd:NextNumber() < 0.4 then
				local sz = r(0.45, 0.75)
				bit(Vector3.new(sz, sz, sz), CFrame.new(pos + Vector3.new(0, -sz / 2, 0)), ROT_FLESH, Enum.Material.SmoothPlastic, true)
			else
				bit(Vector3.new(0.08, 0.08, 0.7), along(pos + dir * 0.35, dir), BRAMBLE_THORN)
			end
		end
		-- the clump of rot at its foot, and roots creeping along the stone either
		-- way round the ring to meet the next cluster
		bit(Vector3.new(3.2, 0.5, 2.6), CFrame.new(0, 0.05, 0) * CFrame.Angles(0, r(-0.4, 0.4), 0), ROT_DARK, Enum.Material.Slate)
		for _, sx in ipairs({ -1, 1 }) do
			for k = 1, 2 do
				local l = r(4, 7)
				local off = Vector3.new(sx * (1 + l / 2), 0.05 + k * 0.08, r(-0.6, 0.6))
				bit(Vector3.new(r(0.3, 0.5), r(0.25, 0.4), l), CFrame.new(off) * CFrame.Angles(r(-0.05, 0.05), math.pi / 2 + r(-0.25, 0.25), 0), BRAMBLE_WOOD:Lerp(ROT_DARK, r(0, 0.5)))
			end
		end
		-- spores drift off it
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
		pe.Rate = 2
		pe.Lifetime = NumberRange.new(2, 3.5)
		pe.Speed = NumberRange.new(0.3, 1.2)
		pe.SpreadAngle = Vector2.new(40, 40)
		pe.EmissionDirection = Enum.NormalId.Top
		pe.Drag = 0.8
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 3) })
		pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.75), NumberSequenceKeypoint.new(1, 1) })
		pe.Color = ColorSequence.new(SPORE)
		pe.LightEmission = 0.15
		pe.Parent = root
		return model, root, pe
	end

	local function rotTether(a)
		local TT = CFG.Tether
		if not TT or TT.Enabled == false then
			return
		end
		local function on()
			local st: string = U.state
			return U.gen == a.gen and U.current == a and U.phase2 and st == "fight" and a.hum.Parent ~= nil and a.hum.Health > 0
		end
		local floorY = HOME.Position.Y - 3
		local N = TT.Clusters or 18
		local H = TT.BrambleHeight or 7
		local folder = Instance.new("Folder")
		folder.Name = "RotTether"
		folder.Parent = workspace
		local roots, emitters = {}, {}
		local seed = math.random(1, 1e6)
		for i = 1, N do
			local model, root, pe = bramble(seed + i * 17, H * (0.8 + ((i * 7) % 5) * 0.1))
			model.Parent = folder
			roots[i] = root
			emitters[i] = pe
		end
		-- the tear of them coming up through the floor
		playSound(a.root, SOUNDS.Impact, 0.8, 0.35)
		playSound(a.root, SOUNDS.Groan, 0.5, 0.5)
		ctx.FxRemote:FireAllClients("Shake", a.root.Position, 0.5)
		if TT.Warning and TT.Warning ~= "" then
			for _, pl in ipairs(Players:GetPlayers()) do
				local char, _, hrp = ctx.aliveChar(pl)
				if char and inChapel(hrp.Position) then
					ctx.FxRemote:FireClient(pl, "Message", TT.Warning)
				end
			end
		end
		local t0 = now()
		local RISE = 1.8
		local outSince = {}
		local nextTick = t0 + RISE -- nothing hurts until they've finished rising
		local phase = 0
		local center = a.root.Position
		local last = {}
		local function radius()
			local k = math.clamp((now() - t0) / TT.ShrinkTime, 0, 1)
			k = 1 - (1 - k) * (1 - k) -- quick at first, slowing as it nears the end
			return TT.StartRadius + (TT.MinRadius - TT.StartRadius) * k
		end
		local function place(r, sink, t)
			for i = 1, N do
				local th = phase + (i / N) * math.pi * 2
				local pos = Vector3.new(center.X + math.cos(th) * r, floorY - sink, center.Z + math.sin(th) * r)
				local inward = Vector3.new(center.X, pos.Y, center.Z)
				local sway = CFrame.Angles(math.sin(t * 0.7 + i * 1.3) * 0.035, 0, math.cos(t * 0.55 + i * 0.9) * 0.035)
				local cf = CFrame.lookAt(pos, inward) * sway
				roots[i].CFrame = cf
				last[i] = cf
			end
		end
		while on() do
			local dt = RunService.Heartbeat:Wait()
			if not on() then
				break
			end
			local t = now()
			local r = radius()
			center = a.root.Position
			phase += dt * 0.05 -- the ring creeps round, slowly
			local rise = math.clamp((t - t0) / RISE, 0, 1)
			rise = 1 - (1 - rise) ^ 3
			place(r, (1 - rise) * (H + 2), t)
			if t >= nextTick then
				local step = TT.TickTime or 0.5
				nextTick = t + step
				for _, pl in ipairs(Players:GetPlayers()) do
					local char, _, hrp = ctx.aliveChar(pl)
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 and inChapel(hrp.Position) and flat(hrp.Position - center).Magnitude > r then
						outSince[pl] = outSince[pl] or t
						local out = t - outSince[pl]
						-- spores gather round you as a warning, even during the grace
						sporePuff(hrp.Position + Vector3.new(0, 1, 0), out < TT.Grace and 2 or 5, 0.7, 1.5)
						if out >= TT.Grace then
							local ramp = math.clamp((out - TT.Grace) / TT.RampTime, 0, 1)
							local dps = TT.DPS + (TT.DPSMax - TT.DPS) * ramp
							hum.Health = math.max(0, hum.Health - dps * step)
						end
					else
						outSince[pl] = nil
					end
				end
			end
		end
		-- she died, the fight reset, or everyone left: the brambles sink back into the floor
		for _, pe in ipairs(emitters) do
			pe.Enabled = false
		end
		task.spawn(function()
			local s0 = now()
			while now() - s0 < 1.4 and folder.Parent do
				local k = (now() - s0) / 1.4
				for i, root in ipairs(roots) do
					if root.Parent and last[i] then
						root.CFrame = last[i] - Vector3.new(0, k * k * (H + 2), 0)
					end
				end
				RunService.Heartbeat:Wait()
			end
			folder:Destroy()
		end)
	end

	api.fall = function(a)
		U.state = "fallen"
		U.transition = true
		setTrail(a, false)
		sparks(a, false)
		local root = a.root
		root.Anchored = false
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
		a.hum:MoveTo(root.Position)
		a.hum.AutoRotate = false
		if U.barOn then
			ReplicatedStorage:SetAttribute("BossHP", 0)
		end
		local mus = ReplicatedStorage:GetAttribute("Music")
		if mus == "usher" then
			ReplicatedStorage:SetAttribute("Music", "none")
		end
		playSound(root, SOUNDS.Groan, 1, 0.8)
		pose(a, "UKneelGrip", 0.6)
		bodyPose(a, "Recover", 0.25)
		task.delay(0.3, function()
			if U.gen == a.gen then
				bodyPose(a, "UKneel", 0.9)
			end
		end)
		for _, d in ipairs(blindfolds(a)) do
			TweenService:Create(d, TweenInfo.new(1.2), { Color = Color3.fromRGB(8, 8, 8) }):Play()
		end
		task.delay(1, function()
			if U.gen == a.gen and U.barOn then
				U.barOn = false
				ReplicatedStorage:SetAttribute("BossActive", false)
			end
		end)
		local function still()
			local st: string = U.state
			return U.gen == a.gen and st == "fallen" and a.hum.Parent ~= nil
		end
		local stopBreath = breathing(a, (3.4 + 0.45 + 0.4 + 1.1) * FALL)
		task.wait(3.4 * FALL)
		if not still() then
			return
		end
		-- something stirs under the robe: a twitch, a breath of spores
		local head = a.model:FindFirstChild("Head")
		bodyPose(a, "Stagger", 0.08)
		sporePuff(head and head.Position or root.Position, 6, 0.8, 2)
		playSound(root, SOUNDS.Unsheath, 0.4, 0.45)
		task.wait(0.45 * FALL)
		if not still() then
			return
		end
		bodyPose(a, "UKneel", 0.2)
		task.wait(0.4 * FALL)
		if not still() then
			return
		end
		-- the tell for the burst: the growth in her hood flares and stays lit,
		-- spores pour out of her, the altar's growth swells with light
		bodyPose(a, "UListen", 0.35)
		for _, d in ipairs(blindfolds(a)) do
			d.Color = BLIND_FLARE
		end
		if ctx.Map.UsherHeart then
			ctx.Map.UsherHeart:SetAttribute("Base", 3)
		end
		playSound(root, SOUNDS.Groan, 0.9, 0.7)
		for i = 0, 3 do
			task.delay(i * 0.25 * FALL, function()
				if still() then
					sporePuff((head and head.Position or root.Position), 8, 1, 3)
				end
			end)
		end
		task.wait(1.1 * FALL)
		if not still() then
			return
		end
		stopBreath()
		local center = Vector3.new(root.Position.X, 0.2, root.Position.Z)
		sporePuff(center + Vector3.new(0, 2, 0), 34, 3, 14)
		ctx.dustCloud(center + Vector3.new(0, 0.6, 0), 4, 16)
		ctx.FxRemote:FireAllClients("Shake", center, 1)
		playSound(root, SOUNDS.Groan, 1, 1.05)
		for _, pl in ipairs(Players:GetPlayers()) do
			local char, _, hrp = ctx.aliveChar(pl)
			if char and flat(hrp.Position - center).Magnitude <= 7.5 then
				ctx.damagePlayer(pl, dmg(CFG.Damage.Burst), center, "Medium")
			end
		end
		growRot(a)
		local okM, errM = pcall(mutate, a) -- looks only: never let it stop the fight
		if not okM and ctx.Config.Debug then
			warn("[Oculast] mutate failed: " .. tostring(errM))
		end
		U.phase2 = true
		U.transition = false
		a.hum.WalkSpeed = CFG.WalkSpeed2
		a.hum.Health = math.min(a.hum.Health, CFG.HP2)
		for _, d in ipairs(blindfolds(a)) do
			TweenService:Create(d, TweenInfo.new(0.8), { Color = BLIND_P2 }):Play()
		end
		if ctx.Map.UsherHeart then
			ctx.Map.UsherHeart:SetAttribute("Base", 2.4)
		end
		bodyPose(a, "Roar", 0.3)
		pose(a, "URaise", 0.35)
		showBar(a, true) -- the second bar (the music waits for her to stand)
		task.wait(0.9 * FALL)
		if not still() then
			return
		end
		ready(a)
		if CFG.Music and CFG.Music ~= "" then
			ReplicatedStorage:SetAttribute("Music", "usher2")
		end
		bodyPose(a, "Idle", 0.3)
		U.cd = {}
		U.lastMove = nil
		U.staggerUntil = 0
		U.poise = nil
		U.state = "fight"
		task.spawn(rotTether, a) -- the ring rises and starts closing in
		brain(a)
	end

	local function startFight(a)
		local root = a.root
		root.Anchored = false
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
		U.state = "fight"
	end

	-- she lifts her head, listens, rises and turns to face you
	local function wake(a, byHit, pl)
		if U.state ~= "kneel" or U.gen ~= a.gen then
			return
		end
		U.state = "waking"
		showBar(a)
		local function stillWaking()
			local st: string = U.state
			return U.gen == a.gen and st == "waking"
		end
		task.spawn(function()
			local tChar = pl and pl.Character
			if byHit then
				-- struck at her vigil: she answers at once
				startFight(a)
				turnabout(a, tChar, pl, true)
				if live(a) then
					brain(a)
				end
				return
			end
			bodyPose(a, "UListen", 0.5)
			tell(a, 1.05)
			task.wait(0.8)
			if not stillWaking() then
				return
			end
			bodyPose(a, "Idle", 0.9)
			pose(a, "UIdle", 0.9)
			playSound(a.root, SOUNDS.Unsheath, 0.6, 0.7)
			local base = select(2, bladePoints(a))
			if base then
				sparkBurst(Vector3.new(base.X, 0.3, base.Z), 10)
			end
			task.wait(0.7)
			-- turns, slowly, toward the sound
			local t0 = now()
			while now() - t0 < 0.9 and stillWaking() do
				local dt = task.wait()
				local tr = tChar and tChar:FindFirstChild("HumanoidRootPart")
				if tr then
					ctx.turnTowards(a.root, tr.Position, math.rad(240) * dt)
				end
			end
			if not stillWaking() then
				return
			end
			playSound(a.root, SOUNDS.Groan, 0.8, 1.15)
			startFight(a)
			brain(a)
		end)
	end

	-- kneeling: listen for intruders. returning: walk home, kneel, heal.
	watch = function(a)
		while U.gen == a.gen and a.hum.Parent and a.hum.Health > 0 do
			if U.state == "returning" then
				local tChar = target(a)
				if tChar then
					-- someone came back in before she got home
					showBar(a)
					U.state = "fight"
					brain(a)
					return
				end
				local home = HOME.Position
				if flat(a.root.Position - home).Magnitude > 2 then
					a.hum.AutoRotate = true
					a.hum:MoveTo(Vector3.new(home.X, a.root.Position.Y, home.Z))
				else
					a.hum.AutoRotate = false
					kneelAtHome(a)
				end
			elseif U.state == "kneel" then
				for _, pl in ipairs(Players:GetPlayers()) do
					local char, _, hrp = ctx.aliveChar(pl)
					if char and inChapel(hrp.Position) then
						local d = flat(hrp.Position - a.root.Position).Magnitude
						if d < CFG.WakeQuiet or (d < CFG.WakeNoisy and noisy(pl)) then
							wake(a, false, pl)
							break
						end
					end
				end
			else
				return
			end
			task.wait(0.15)
		end
	end

	---------------------------------------------------------------------------
	-- life and death
	---------------------------------------------------------------------------
	local function onDied(a)
		if U.gen ~= a.gen or U.state == "dead" then
			return
		end
		U.state = "dead"
		U.barOn = true
		hideBar()
		clearAllPoison() -- the rot dies with her
		ctx.FxRemote:FireAllClients("Banner", "USHER FELLED", "Victory")
		ctx.dropSplinter(a.root.Position, a.model)
		playSound(a.root, SOUNDS.Groan, 1, 0.9)
		if ctx.Map.UsherHeart then
			ctx.Map.UsherHeart:SetAttribute("Base", 0.35) -- the altar's growth gutters
		end
		for _, d in ipairs(a.model:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
			end
		end
		task.spawn(function()
			for _ = 1, 5 do
				if a.root.Parent then
					sporePuff(a.root.Position + Vector3.new(rand(-2, 2), rand(-1, 3), rand(-2, 2)), 12, 1.5, 4)
				end
				task.wait(0.3)
			end
			for _, d in ipairs(a.model:GetDescendants()) do
				if d:IsA("BasePart") then
					TweenService:Create(d, TweenInfo.new(2), { Transparency = 1 }):Play()
				end
			end
			task.wait(2.2)
			a.model:Destroy()
		end)
		-- her reward: her harvest-blade, straight into your hands (moveset: Config.ScytheAttacks)
		task.delay(4, function()
			for _, pl in ipairs(Players:GetPlayers()) do
				pl:SetAttribute("Has_Scythe", true)
				ctx.equipWeapon(pl, "Scythe")
				ctx.FxRemote:FireClient(pl, "Message", ctx.Config.Weapons.Scythe.Name .. ". Her blade is yours now.")
			end
		end)
		-- the reliquary gate in the north wall rises (MapBuilder 9b)
		local gate = ctx.Map.UsherGate
		if gate then
			task.delay(8, function()
				playSound(gate.PrimaryPart, SOUNDS.Unsheath, 1, 0.3)
				local start = gate:GetPivot()
				for i = 1, 75 do
					gate:PivotTo(start + Vector3.new(0, 11.6 * (i / 75), 0))
					task.wait(1 / 30)
				end
				ctx.FxRemote:FireAllClients("Message", "In the chapel's north wall, a gate has opened.")
			end)
		end
	end

	api.spawn = function()
		if U.state == "dead" then
			return
		end
		U.gen += 1
		local model, hum, weld = ctx.makeRig("Oculast", "Usher", S, "Scythe")
		if not model then
			return
		end
		hum.MaxHealth = CFG.HP + CFG.HP2 -- both lives; see showBar
		hum.Health = CFG.HP + CFG.HP2
		hum.WalkSpeed = CFG.WalkSpeed
		hum.BreakJointsOnDeath = false
		hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
		model:SetAttribute("Radius", 1.6)
		model:SetAttribute("Boss", true) -- uses the big bar, not a floating one
		model:SetAttribute("Enemy", true)
		local root = model:FindFirstChild("HumanoidRootPart")
		root.CollisionGroup = "EnemyRoot"
		model:PivotTo(HOME + Vector3.new(0, 3 * S - 3, 0))
		U.model, U.hum, U.root, U.weld = model, hum, root, weld
		U.phase2 = false
		U.transition = false
		U.staggerUntil = 0
		U.poise = nil
		U.cd = {}
		U.lastMove = nil
		U.mut = nil
		local a = { model = model, hum = hum, root = root, weld = weld, scale = S, gen = U.gen }
		U.current = a
		if ctx.Map.UsherHeart then
			ctx.Map.UsherHeart:SetAttribute("Base", 1.6)
		end
		hum.HealthChanged:Connect(function(h)
			if U.gen ~= a.gen or U.state == "dead" then
				return
			end
			if not U.phase2 then
				if h <= CFG.HP2 then
					-- her first life is spent: she can't drop past it, and she falls
					if h < CFG.HP2 then
						hum.Health = CFG.HP2
					end
					if not U.transition then
						U.transition = true
						task.spawn(api.fall, a)
					end
					return
				end
				if U.barOn then
					ReplicatedStorage:SetAttribute("BossHP", h - CFG.HP2)
				end
			elseif U.barOn then
				ReplicatedStorage:SetAttribute("BossHP", math.max(0, h))
			end
		end)
		hum.Died:Connect(function()
			onDied(a)
		end)
		kneelAtHome(a)
		task.spawn(watch, a)
	end

	api.reset = function()
		if U.state == "dead" or U.state == "none" then
			return
		end
		hideBar()
		if U.model then
			U.model:Destroy()
		end
		U.state = "none"
		api.spawn()
	end

	api.onHit = function(player)
		local a = U.current
		if a and U.state == "kneel" then
			wake(a, true, player)
		end
	end

	api.onPoiseBreak = function()
		local a = U.current
		if not a or U.state ~= "fight" then
			return
		end
		U.staggerUntil = now() + CFG.Stagger
		setTrail(a, false)
		sparks(a, false)
		if a.root.Anchored then
			a.root.Anchored = false -- broken out of a lunge
		end
		pose(a, "UIdle", 0.15)
		bodyPose(a, "Stagger", 0.12)
		a.hum:MoveTo(a.root.Position)
		playSound(a.root, SOUNDS.Groan, 0.9, 1.3)
		local head = a.model:FindFirstChild("Head")
		sporePuff(head and head.Position or a.root.Position, 10, 1, 4)
		local gen = a.gen
		task.delay(CFG.Stagger, function()
			if U.gen == gen and U.state == "fight" then
				ready(a)
				bodyPose(a, "Idle", 0.3)
			end
		end)
	end
end

return Usher
]]></ProtectedString>
					<string name="ScriptGuid">{6C940F4F-C2DC-4B05-8666-70ED2BD66E13}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Oculast</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">37103886d8e24c800aefca76000003e7</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000008">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- SKELETON: a jailer's remains that never stopped walking. Twitchy, brittle.
-- Up close: a slow, rattling, telegraphed swipe - or the same rattle cut short into
-- a quick stab (the feint). From range: a coiled lunging thrust. Then a hop back.
--
-- EVERYTHING ABOUT THIS CHARACTER IS IN THIS ONE FILE:
--   M.Proportions / M.Poses   body shape and its full-body poses (the client animator uses these too)
--   M.Colors / M.Look         how the rig is dressed (RigBuilder calls Look with a kit of helpers:
--                             deco(part, name, size, offset, color, material?, shape?), V(x,y,z), at(x,y,z) ...)
--   M.Weapons / M.Grips       the weapon's model, and the grip poses its swings tween between
--   M.init(Core) and below    behaviour (server only)
-- SHARED TOOLKIT: server code here gets the shared helpers through M.init(Core)
-- (see the list at the top of ServerScriptService/GameServer/Core.lua). Body
-- poses not defined here (Idle, Windup, Strike, SweepWindup, SweepEnd, Recover,
-- Flinch, Stagger, Crouch, Air, Roar, Kneel) are shared ones from PuppetMath.
local M = {}
M.Kind = "Skeleton"
M.Proportions = { girth = 0.62, arm = 1.1, hunch = 0.16 } -- rattling bones: thin, long-armed
M.Poses = {
	-- a low sidelong coil before a lunge, the lunge itself, and a skittering hop back
	SkelCoil = { drop = 0.55, lean = 0.1, twist = 0.55, side = 0.06, head = -0.1, footR = -0.6, footL = 0.55, spread = 0.15, la1 = 0.6, la3 = -0.8, lel = 0.9, freeL = 0 },
	SkelLunge = { drop = 0.7, lean = 0.75, twist = -0.35, head = -0.2, footR = 1.0, footL = -1.0, la1 = -0.4, la3 = -0.5, lel = 0.2, freeL = 0 },
	SkelHop = { drop = 0.35, lean = -0.3, head = 0.1, tuck = 0.25, footR = -0.4, footL = 0.3, la1 = 0.7, la3 = -0.9, lel = 0.6, freeL = 0 },
	-- reared back for the slow swipe: up on its toes, chest open, head cocked, free arm thrown out
	SkelReach = { drop = 0.05, lean = -0.35, twist = 0.6, side = -0.1, head = -0.25, footR = -0.5, footL = 0.6, spread = 0.2, la1 = 1.3, la3 = -1.1, lel = 0.3, freeL = 0 },
}
M.Colors = { skin = Color3.fromRGB(178, 168, 142), torso = Color3.fromRGB(22, 20, 18), legs = Color3.fromRGB(168, 158, 132), arms = Color3.fromRGB(172, 162, 136) }
M.FistSkin = true

function M.Look(k)
	local deco, parts, V, at, rgb, MAT, D, s, look = k.deco, k.parts, k.V, k.at, k.rgb, k.MAT, k.D, k.s, k.look
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	local thigh, shin = D.thigh / s, D.shin / s
	local head = parts.Head.Size / s
	local foot = parts.RFoot.Size / s
	local BALL, CYL = Enum.PartType.Ball, Enum.PartType.Cylinder
	-- a jailer's remains that never stopped walking: round, knobbled bones (each one a
	-- slightly different age), a hollow cage of ribs, scraps of old uniform, embers deep
	-- in the sockets. The rig's boxes stay as the joints; the bones hide them.
	for _, p in pairs(parts) do
		if p.Name ~= "HumanoidRootPart" then
			p.Transparency = 1
		end
	end
	for _, d in ipairs(parts.Chest.Parent:GetChildren()) do
		if d.Name == "Fist" then
			d.Transparency = 1
		end
	end
	local rng = Random.new()
	local bone0, old, dark = look.skin, rgb(140, 124, 92), rgb(10, 8, 8)
	local function boneCol()
		return bone0:Lerp(old, rng:NextNumber(0, 0.55))
	end
	local rag, leather, rust = rgb(52, 44, 36), rgb(46, 32, 24), rgb(96, 62, 40)
	local function ball(on, d, x, y, z, color, mat, name)
		return deco(on, name or "Bone", V(d, d, d), at(x, y, z), color or boneCol(), mat or MAT.SmoothPlastic, BALL)
	end
	-- a round bone from a to b (points in the part's own space)
	local function bar(on, a, b, d, color, mat)
		local dir = b - a
		local up = math.abs(dir.Unit.Y) > 0.9 and Vector3.zAxis or Vector3.yAxis
		local cf = CFrame.lookAt((a + b) / 2 * s, b * s, up) * CFrame.Angles(0, math.pi / 2, 0) -- cylinders run along X
		return deco(on, "Bone", V(dir.Magnitude, d, d), cf, color or boneCol(), mat or MAT.SmoothPlastic, CYL)
	end
	local function P(x, y, z)
		return Vector3.new(x, y, z)
	end

	-- skull: a round cranium, a narrower face, deep sockets, a slack jaw
	local hy, hz = head.Y, head.Z
	local skull = boneCol()
	ball("Head", hz * 0.92, 0, 0.14, 0.06, skull, MAT.Limestone)
	deco("Head", "Bone", V(head.X * 0.72, hy * 0.42, 0.5), at(0, -0.12, -hz * 0.28), skull, MAT.Limestone)
	for _, x in ipairs({ -0.24, 0.24 }) do
		ball("Head", 0.34, x, 0.06, -hz * 0.42, dark, MAT.SmoothPlastic, "Socket")
		ball("Head", 0.2, x * 1.35, -0.12, -hz * 0.36, skull) -- cheekbone
		deco("Head", "Eye", V(0.1, 0.1, 0.1), at(x * 0.95, 0.06, -hz * 0.47), rgb(190, 96, 40), MAT.Neon, BALL)
	end
	deco("Head", "Socket", V(0.12, 0.2, 0.06), at(0, -0.14, -hz * 0.535), dark) -- nose hole
	deco("Head", "Bone", V(0.56, 0.08, 0.06), at(0, -0.32, -hz * 0.535), rgb(196, 188, 160)) -- upper teeth
	local jaw = deco("Head", "Bone", V(0.64, 0.16, 0.5), at(0, -0.52, -hz * 0.22) * CFrame.Angles(-0.22, 0, 0), skull:Lerp(old, 0.3))
	deco("Head", "Bone", V(0.5, 0.07, 0.06), at(0, -0.45, -hz * 0.47) * CFrame.Angles(-0.22, 0, 0), rgb(186, 176, 146)) -- lower teeth
	for _, x in ipairs({ -0.3, 0.3 }) do
		bar("Head", P(x, -0.5, -0.05), P(x * 1.05, -0.2, 0.12), 0.12, jaw.Color) -- the jaw's hinge
	end

	-- spine: a column of knobs up the back, into the neck
	local spineZ = cd * 0.3
	for i = 0, 6 do
		local y = -ch / 2 + 0.08 + i * (ch - 0.1) / 6
		ball("Chest", 0.24, 0, y, spineZ)
	end
	for i = 0, 1 do
		ball("Chest", 0.2, 0, ch / 2 + 0.12 + i * 0.16, spineZ * 0.6)
	end
	-- ribcage: five pairs of ribs curving out from the spine round to a breastbone
	local front = -cd / 2
	bar("Chest", P(0, ch / 2 - 0.2, front), P(0, ch / 2 - 1.15, front + 0.02), 0.16) -- breastbone
	for i = 0, 4 do
		local w = cw * (0.78 + 0.26 * math.sin((i + 1) / 6 * math.pi)) / 2
		local y = ch / 2 - 0.3 - i * 0.27
		local d = 0.11
		for _, sx in ipairs({ -1, 1 }) do
			local a, b, c, e = P(sx * 0.1, y, spineZ), P(sx * w, y - 0.06, cd * 0.05), P(sx * w * 0.86, y - 0.14, front * 0.7), P(sx * (i < 4 and 0.08 or w * 0.45), y - 0.24, front)
			bar("Chest", a, b, d)
			ball("Chest", d, b.X, b.Y, b.Z)
			bar("Chest", b, c, d)
			ball("Chest", d, c.X, c.Y, c.Z)
			bar("Chest", c, e, d * 0.9)
		end
	end
	-- collarbones and shoulder blades
	for _, sx in ipairs({ -1, 1 }) do
		bar("Chest", P(sx * 0.08, ch / 2 - 0.12, front), P(sx * cw * 0.5, ch / 2 - 0.02, 0), 0.13)
		deco("Chest", "Bone", V(0.42, 0.55, 0.08), at(sx * cw * 0.28, ch / 2 - 0.45, spineZ + 0.02) * CFrame.Angles(0, 0, sx * 0.25), boneCol())
	end

	-- pelvis: two flaring wings, a sacrum, the lower spine
	ball("Hips", 0.22, 0, 0.35, spineZ * 0.9)
	ball("Hips", 0.26, 0, 0.05, hd * 0.25)
	local pel = boneCol()
	for _, sx in ipairs({ -1, 1 }) do
		deco("Hips", "Bone", V(0.16, 0.48, 0.5), at(sx * hw * 0.32, 0.12, 0.02) * CFrame.Angles(0, sx * 0.3, sx * 0.45), pel, MAT.Limestone)
		bar("Hips", P(sx * hw * 0.4, -0.05, 0), P(sx * 0.08, -0.25, -hd * 0.4), 0.12, pel)
	end
	-- a belt and the rag of a jailer's tabard (not on you: k.NoTabard, Characters/Knight)
	if not k.NoTabard then
		deco("Hips", "Belt", V(hw * 0.95, 0.12, hd * 0.95), at(0, 0.2, 0), leather, MAT.Fabric)
		deco("Hips", "Belt", V(0.2, 0.18, 0.08), at(-0.1, 0.2, -hd * 0.49), rust, MAT.CorrodedMetal)
		deco("Hips", "Rag", V(hw * 0.42, 1.0, 0.05), at(0.08, -0.4, -hd * 0.5) * CFrame.Angles(0.06, 0, 0.07), rag, MAT.Fabric)
		deco("Hips", "Rag", V(hw * 0.3, 0.7, 0.05), at(-hw * 0.3, -0.25, hd * 0.5) * CFrame.Angles(-0.05, 0, -0.12), rag:Lerp(dark, 0.3), MAT.Fabric)
	end

	-- arms: a round upper bone, two thin forearm bones, bony fingers; a dented pauldron
	-- and a rag wound round one forearm
	for _, n in ipairs({ "R", "L" }) do
		local u, l = n .. "UpperArm", n .. "LowerArm"
		ball(u, aw * 0.8, 0, ua / 2 - 0.05, 0)
		bar(u, P(0, ua / 2 - 0.1, 0), P(0, -ua / 2 + 0.05, 0), aw * 0.42)
		ball(u, aw * 0.62, 0, -ua / 2, 0)
		bar(l, P(-aw * 0.16, la / 2, 0), P(-aw * 0.16, -la / 2 + 0.05, 0.02), aw * 0.3)
		bar(l, P(aw * 0.18, la / 2 - 0.05, 0), P(aw * 0.16, -la / 2 + 0.05, -0.02), aw * 0.24)
		ball(l, aw * 0.42, 0, -la / 2, 0) -- the wrist
		for f = -1, 1 do
			bar(l, P(f * aw * 0.22, -la / 2 - 0.05, 0), P(f * aw * 0.28, -la / 2 - 0.4 + math.abs(f) * 0.06, -0.06), 0.07)
		end
	end
	deco("RUpperArm", "Pauldron", V(aw * 1.9, 0.22, aw * 1.8), at(0.05, ua / 2 - 0.02, 0) * CFrame.Angles(0, 0, -0.35), rust, MAT.CorrodedMetal)
	deco("RUpperArm", "Pauldron", V(aw * 1.6, 0.18, aw * 1.5), at(0.12, ua / 2 - 0.22, 0) * CFrame.Angles(0, 0, -0.5), rust:Lerp(dark, 0.25), MAT.CorrodedMetal)
	deco("LLowerArm", "Rag", V(aw * 0.75, 0.35, aw * 0.75), at(0, la * 0.1, 0) * CFrame.Angles(0, 0.4, 0.1), rag, MAT.Fabric)

	-- legs: a round thigh bone, a knee cap, shin bones, a long bony foot
	for _, n in ipairs({ "R", "L" }) do
		local t, sh, ft = n .. "Thigh", n .. "Shin", n .. "Foot"
		ball(t, lw * 0.8, 0, thigh / 2 - 0.05, 0)
		bar(t, P(0, thigh / 2 - 0.1, 0), P(0, -thigh / 2 + 0.05, 0), lw * 0.44)
		ball(t, lw * 0.66, 0, -thigh / 2, 0)
		ball(sh, lw * 0.42, 0, shin / 2 - 0.05, -lw * 0.32) -- knee cap
		bar(sh, P(0, shin / 2, 0), P(0, -shin / 2 + 0.05, 0), lw * 0.36)
		bar(sh, P(lw * 0.24, shin / 2 - 0.08, 0.04), P(lw * 0.2, -shin / 2 + 0.1, 0.04), lw * 0.18)
		ball(ft, foot.X * 0.62, 0, 0.04, foot.Z * 0.32) -- heel
		for f = -1, 1 do
			bar(ft, P(f * foot.X * 0.22, 0.02, foot.Z * 0.22), P(f * foot.X * 0.3, -0.08, -foot.Z * 0.5), 0.1)
		end
	end
end

M.Weapons = {
	Scimitar = function(w)
		-- a notched, curved prison sabre gone brown with age
		local steel = Color3.fromRGB(110, 96, 80)
		local handle = w.mk("Grip", Vector3.new(0.2, 0.9, 0.2), Color3.fromRGB(40, 30, 22), Enum.Material.Wood)
		w.add(w.mk("Guard", Vector3.new(0.7, 0.12, 0.22), w.iron, Enum.Material.Metal), -0.5)
		w.add(w.mk("Blade", Vector3.new(0.34, 2.1, 0.08), steel, Enum.Material.CorrodedMetal), -1.6)
		w.add(w.mk("Blade", Vector3.new(0.3, 1.1, 0.08), steel, Enum.Material.CorrodedMetal), -3.0, CFrame.Angles(w.R(-14), 0, 0), -0.12)
		return { handle = handle, bladeLen = 3.2 }
	end,
}
M.Grips = {
	-- the lunge: blade drawn back at the hip, then driven straight ahead
	ThrustBack = { Vector3.new(1.3, 0.1, 1.0), CFrame.Angles(math.rad(95), math.rad(-10), 0) },
	ThrustOut = { Vector3.new(0.3, 0.7, -2.3), CFrame.Angles(math.rad(90), 0, 0) },
	-- the slow swipe's windup: hand high over the right shoulder, blade up and back
	SkelHigh = { Vector3.new(1.3, 2.7, 0.5), CFrame.Angles(0, 0, math.rad(-25)) * CFrame.Angles(math.rad(215), 0, 0) },
}

-- stats (the shared brain in GameServer/Enemies.lua reads these)
M.Def = {
-- Skeleton: twitchy (a slow telegraphed swipe or its feint up close, a long lunging
-- thrust from mid range, skittering hops back), but fragile: any hit staggers it for
-- a long time and knocks it well back. Engage = distance it starts attacking at.
	HP = 48, Speed = 12.5, Scale = 1, Damage = 13, Range = 5.2, HalfAngle = 70,
	Windup = 0.4, Recover = 0.75, Aggro = 30, Leash = 55, Stagger = 0.95,
	HyperArmor = false, Weapon = "Scimitar", Radius = 1.1, Lunge = 10,
	Poise = 1, HitLevel = "Small", StaggerPush = 26, Engage = 10.5,
	LungeDamage = 22, Moves = "Skeleton",
	SwipeDamage = 28, SwipeWindup = 0.95, -- the slow swipe: raised and held this long, then a wide heavy cut
}

---------------------------------------------------------------------------
-- server: how it fights
---------------------------------------------------------------------------
local pose, playSound, SOUNDS, now, faceTowards, setTrail, flat, playersInSector, damagePlayer, burst, bodyPose

-- SKELETON moveset. Each step checks for a stagger: they break out of anything.
local function skelHold(e, duration, faceTarget)
	local t0 = now()
	while now() - t0 < duration do
		if not e.alive or now() < e.staggerUntil then
			return false
		end
		if faceTarget and faceTarget.Parent then
			faceTowards(e.root, faceTarget.Position)
		end
		task.wait()
	end
	return true
end

local function skelHit(e, range, halfAngle, damage, level)
	if not e.alive then
		return
	end
	local root = e.root
	for _, pl in ipairs(playersInSector(root.CFrame, range, halfAngle, 6)) do
		damagePlayer(pl, damage, root.Position, level)
	end
end

-- a burst of its own walk (dist studs over dur seconds). Setting the root's velocity
-- instead fought the humanoid's controller and read as a snap forward.
local function skelStep(e, dir, dist, dur)
	local hum, root = e.hum, e.root
	if not root.Parent or root.Anchored or dir.Magnitude < 0.1 then
		return
	end
	local gen = {}
	e.stepGen = gen
	hum.WalkSpeed = dist / dur
	hum:MoveTo(root.Position + dir.Unit * dist)
	task.delay(dur, function()
		if e.stepGen == gen and hum.Parent then
			hum.WalkSpeed = e.def.Speed
			hum:MoveTo(root.Position)
		end
	end)
end

-- the embers in its sockets flare (the tell for the big swipe and its feint)
local function skelEyes(e, on)
	for _, d in ipairs(e.root.Parent:GetDescendants()) do
		if d.Name == "Eye" and d:IsA("BasePart") then
			d.Color = on and Color3.fromRGB(255, 220, 120) or Color3.fromRGB(190, 96, 40)
			d.Size = Vector3.one * (on and 0.18 or 0.1)
		end
	end
end

-- the rattle: the blade dragged up high over its shoulder, slow, every bone clattering
local function skelRaise(e, tRoot, duration)
	local root = e.root
	pose(e, "SkelHigh", duration * 0.8)
	bodyPose(e, "SkelReach", duration * 0.8)
	skelEyes(e, true)
	for i = 0, 2 do
		task.delay(i * duration / 3, function()
			if e.alive and now() >= e.staggerUntil then
				playSound(root, SOUNDS.Unsheath, 0.3, 0.7 + i * 0.15)
			end
		end)
	end
	local ok = skelHold(e, duration, tRoot)
	if not ok then
		skelEyes(e, false)
	end
	return ok
end

-- SLOW SWIPE: the big telegraphed cut. Raised high and held, then one wide, heavy
-- diagonal swipe that steps in - and leaves it wide open after.
local function skelSwipe(e, tRoot)
	local def, root = e.def, e.root
	if not skelRaise(e, tRoot, def.SwipeWindup) then
		return false
	end
	skelEyes(e, false)
	setTrail(e, true)
	playSound(root, SOUNDS.Slash, 0.7, 0.75)
	pose(e, "SweepMid", 0.08, Enum.EasingStyle.Linear)
	bodyPose(e, "SweepEnd", 0.16)
	task.delay(0.08, function()
		if e.alive then
			pose(e, "SweepEnd", 0.1)
		end
	end)
	skelStep(e, flat(root.CFrame.LookVector), 3, 0.16)
	task.wait(0.07)
	skelHit(e, def.Range + 1.5, 110, def.SwipeDamage, "Large")
	task.wait(0.1)
	setTrail(e, false)
	e.hum:MoveTo(root.Position)
	return true, def.Recover * 1.4 -- (a long recovery: this is the opening)
end

-- FEINT: starts the same slow rattle, then cuts it short and snaps out a quick
-- stab - punishes rolling on the first sound of the swipe
local function skelFeint(e, tRoot)
	local def, root = e.def, e.root
	if not skelRaise(e, tRoot, def.SwipeWindup * 0.45) then
		return false
	end
	skelEyes(e, false)
	pose(e, "ThrustBack", 0.07)
	bodyPose(e, "SkelCoil", 0.07)
	if not skelHold(e, 0.1, tRoot) then
		return false
	end
	setTrail(e, true)
	playSound(root, SOUNDS.Lunge, 0.5, 1.4)
	pose(e, "ThrustOut", 0.06)
	bodyPose(e, "SkelLunge", 0.06)
	skelStep(e, flat(root.CFrame.LookVector), 4, 0.14)
	task.wait(0.06)
	skelHit(e, def.Range + 0.8, 35, def.Damage, "Medium")
	setTrail(e, false)
	e.hum:MoveTo(root.Position)
	return true
end

-- coils low and sidelong, then lunges in with a long straight thrust
local function skelLunge(e, tRoot)
	local def, root = e.def, e.root
	pose(e, "ThrustBack", 0.35)
	bodyPose(e, "SkelCoil", 0.35)
	playSound(root, SOUNDS.Unsheath, 0.4, 0.85)
	if not skelHold(e, 0.6, tRoot) then
		return false
	end
	local dir = flat(root.CFrame.LookVector)
	dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(0, 0, -1)
	setTrail(e, true)
	playSound(root, SOUNDS.Lunge, 0.5, 1.2)
	pose(e, "ThrustOut", 0.08)
	bodyPose(e, "SkelLunge", 0.08)
	skelStep(e, dir, 7, 0.24)
	local seen = {}
	local t0 = now()
	while now() - t0 < 0.24 do
		if not e.alive or now() < e.staggerUntil then
			setTrail(e, false)
			return false
		end
		for _, pl in ipairs(playersInSector(root.CFrame, 4.6, 35, 6)) do
			if not seen[pl] then
				seen[pl] = true
				damagePlayer(pl, def.LungeDamage, root.Position, "Medium")
			end
		end
		task.wait()
	end
	e.hum:MoveTo(root.Position) -- don't walk back to where the lunge started
	setTrail(e, false)
	return true
end

function M.attack(e, targetChar)
	local def, hum, root = e.def, e.hum, e.root
	local tRoot = targetChar:FindFirstChild("HumanoidRootPart")
	if not tRoot then
		return
	end
	e.attacking = true
	hum:MoveTo(root.Position)
	hum.AutoRotate = false
	faceTowards(root, tRoot.Position)
	local d = flat(tRoot.Position - root.Position).Magnitude
	local ok, recover
	if d > def.Range + 1.5 then
		ok = skelLunge(e, tRoot) -- from range: the coiled lunge
	elseif math.random() < 0.35 then
		ok = skelFeint(e, tRoot)
	else
		ok, recover = skelSwipe(e, tRoot)
	end
	if ok and e.alive then
		-- recovery (punish it), then often a skittering hop back out of reach
		bodyPose(e, "Recover", 0.25)
		pose(e, "Idle", 0.35)
		if skelHold(e, recover or def.Recover, nil) and e.alive and math.random() < 0.55 then
			bodyPose(e, "SkelHop", 0.1)
			local back = -flat(root.CFrame.LookVector)
			if back.Magnitude > 0.1 then
				skelStep(e, back, 5, 0.25)
			end
			playSound(root, SOUNDS.Unsheath, 0.25, 1.6) -- bones rattling
			skelHold(e, 0.3, nil)
			hum:MoveTo(root.Position)
		end
	end
	setTrail(e, false)
	e.stepGen = nil
	hum.WalkSpeed = def.Speed
	if e.alive and now() >= e.staggerUntil then
		pose(e, "Idle", 0.3)
	end
	hum.AutoRotate = true
	e.attacking = false
end
-- any hit that breaks its (tiny) poise: the whole frame reels, bones clattering
function M.onStagger(e)
	bodyPose(e, "Stagger", 0.08)
	burst(e.root.Position + Vector3.new(0, 1, 0), Color3.fromRGB(170, 160, 135), 10, 0.25, 10)
	playSound(e.root, SOUNDS.Unsheath, 0.35, 1.8)
end

function M.init(core)
	pose, playSound, SOUNDS, now, faceTowards, setTrail, flat, playersInSector, damagePlayer, burst, bodyPose = core.pose, core.playSound, core.SOUNDS, core.now, core.faceTowards, core.setTrail, core.flat, core.playersInSector, core.damagePlayer, core.burst, core.bodyPose
end

return M
]]></ProtectedString>
					<string name="ScriptGuid">{7BEEB952-7911-40D1-9B47-4559EDCF4453}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Skeleton</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">37103886d8e24c800aefca76000003e8</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000009">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE OSSUARY WARDEN: the boss beyond the fog. Blackened plate hung with bones, a great mace.
-- Phase 1: slam (sometimes delayed), low sweep (+backhand), stomp, shoulder charge, shockline.
-- Phase 2 at 50%: flaming mace, leap, fire nova, the three-hit string, burning ground.
-- Tuning: Config.Boss. Moves and how he picks them: BOSS_MOVES near the bottom.
--
-- EVERYTHING ABOUT THIS CHARACTER IS IN THIS ONE FILE:
--   M.Proportions / M.Poses   body shape and its full-body poses (the client animator uses these too)
--   M.Colors / M.Look         how the rig is dressed (RigBuilder calls Look with a kit of helpers:
--                             deco(part, name, size, offset, color, material?, shape?), V(x,y,z), at(x,y,z) ...)
--   M.Weapons / M.Grips       the weapon's model, and the grip poses its swings tween between
--   M.init(Core) and below    behaviour (server only)
-- SHARED TOOLKIT: server code here gets the shared helpers through M.init(Core)
-- (see the list at the top of ServerScriptService/GameServer/Core.lua). Body
-- poses not defined here (Idle, Windup, Strike, SweepWindup, SweepEnd, Recover,
-- Flinch, Stagger, Crouch, Air, Roar, Kneel) are shared ones from PuppetMath.
local M = {}
M.Kind = "Warden"
M.Proportions = { girth = 1.2, arm = 1.15, hunch = 0.12, twoHand = -0.9 }
M.IdlePose = "BIdle"
M.Poses = {
	-- his resting stance: weight low and shifting, the chest heaving
	BIdle = { drop = 0.3, lean = 0.2, twist = -0.12, head = 0.08, footR = -0.35, footL = 0.4, spread = 0.12, breathe = 2.6, freeL = 0 },
	-- the first beat of every wind-up: he settles his weight and gathers himself
	BGather = { drop = 0.5, lean = 0.28, twist = -0.32, hip = -0.12, look = 0.12, side = 0.07, head = 0.18, footR = -0.3, footL = 0.45, spread = 0.14, breathe = 3, freeL = 0 },
	-- rearing back for an overhead blow (deeper than the shared Windup)
	BRear = { drop = 0.18, lean = -0.42, twist = 0.38, hip = 0.2, look = -0.15, side = -0.06, head = -0.28, footR = -0.5, footL = 0.6, spread = 0.1, breathe = 3, freeL = 0 },
	-- the torso wound round for a low sweep (deeper than the shared SweepWindup)
	BCoil = { drop = 0.65, lean = 0.3, twist = -1.15, side = -0.1, head = -0.05, footR = -0.4, footL = 0.6, spread = 0.25, breathe = 2.5, freeL = 0 },
	-- weight rocking onto the planted leg before the stomp
	BStompGather = { drop = 0.5, lean = 0.15, side = 0.18, twist = 0.1, hip = 0.12, liftL = 0.15, head = 0.1, footR = 0.2, footL = -0.1, breathe = 3, freeL = 0 },
	-- follow-through: the blow carries his whole body with it
	BSlamDrive = { drop = 0.85, lean = 0.82, twist = -0.25, hip = -0.18, look = 0.1, side = 0.05, head = 0.28, footR = 0.95, footL = -0.85, spread = 0.18, breathe = 3, freeL = 0 },
	BSweepThrough = { drop = 0.55, lean = 0.38, twist = 1.2, side = 0.1, head = 0.05, footR = 0.75, footL = -0.45, spread = 0.3, breathe = 3, freeL = 0 },
	BSweepReturn = { drop = 0.5, lean = 0.3, twist = -1.05, side = -0.1, head = 0.05, footR = -0.4, footL = 0.7, spread = 0.3, breathe = 3, freeL = 0 },
	-- squaring the shoulders and sinking before the charge
	BChargeSet = { drop = 0.6, lean = 0.45, twist = -0.2, hip = -0.15, side = 0.06, head = -0.1, footR = 0.6, footL = -0.7, breathe = 3, freeL = 0 },
	Charge = { drop = 0.85, lean = 0.8, twist = -0.35, hip = 0.1, look = 0.25, head = -0.25, footR = 1.0, footL = -1.0, la1 = -0.6, la3 = -0.4, lel = 1.0, freeL = 0 },
	StompLift = { drop = 0.1, lean = -0.18, side = -0.12, hip = 0.15, lift = 1.7, footR = 0.7, la1 = 0.5, la3 = -1.1, freeL = 0 },
	-- THE REAPING SWEEP (bossSweep): his whole body in it - feet, knees, hips over planted feet (hip), waist (twist, side,
	-- lean), and the head held on you over the shoulder (look) while the rest of him winds away.
	-- plant: the left foot thrown wide and forward, sinking, the mace let down at his right side
	WPlant = { drop = 0.55, lean = 0.3, twist = -0.4, hip = -0.2, side = 0.05, head = 0.15, look = 0.35, footR = -0.5, footL = 0.75, spread = 0.3, breathe = 3, freeL = 0 },
	-- haul: hips and shoulders dragged round to the right after the mace, its head grinding the floor behind him
	WHaul = { drop = 0.75, lean = 0.45, twist = -1.0, hip = -0.45, side = -0.08, head = 0.1, look = 0.65, footR = -0.8, footL = 0.9, spread = 0.35, breathe = 3.5, freeL = 0 },
	-- load: wound as far as he goes - back nearly to you, knees deep, only his eyes still on you. Then it all lets go
	WLoad = { drop = 0.95, lean = 0.5, twist = -1.5, hip = -0.75, side = -0.15, head = -0.05, look = 1.0, footR = -0.95, footL = 1.0, spread = 0.42, breathe = 4.5, freeL = 0 },
	-- the release: driving off the back foot, the hips leading the shoulders through, then the right foot dragged round
	-- after the swing as it pulls him on into the finish
	WRelease = { drop = 0.85, lean = 0.62, twist = 0.1, hip = 0.15, side = 0.1, head = 0.22, look = -0.1, footR = 0.1, footL = 1.15, spread = 0.42, breathe = 3, freeL = 0 },
	WFinish = { drop = 0.72, lean = 0.5, twist = 1.4, hip = 0.6, side = 0.16, head = 0.1, look = -0.6, footR = 0.9, footL = 0.35, spread = 0.3, breathe = 3, freeL = 0 },
	-- THE BACKHAND (phase 2): the swing's weight carried on round behind his left side, the right foot planted, wound the
	-- other way, then the whole of him unwinding back across
	WBackCoil = { drop = 0.9, lean = 0.45, twist = 1.6, hip = 0.8, side = 0.14, head = 0, look = -1.0, footR = 1.05, footL = -0.5, spread = 0.42, breathe = 4.5, freeL = 0 },
	WBackThrough = { drop = 0.85, lean = 0.62, twist = -0.1, hip = -0.15, side = -0.1, head = 0.22, look = 0.1, footR = 1.2, footL = -0.2, spread = 0.42, breathe = 3, freeL = 0 },
	WBackFinish = { drop = 0.75, lean = 0.55, twist = -1.4, hip = -0.6, side = -0.16, head = 0.12, look = 0.6, footR = 0.4, footL = -0.9, spread = 0.3, breathe = 3, freeL = 0 },
	-- (an old spin wind-up: sinks low, feet wide, torso wound all the way round)
	Coil = { drop = 0.95, lean = 0.35, twist = -1.45, side = -0.08, head = -0.1, footR = -0.6, footL = 0.7, spread = 0.3, la1 = 0.4, la3 = -1.0, lel = 0.4, freeL = 0, breathe = 2.5 },
}
M.Colors = { skin = Color3.fromRGB(46, 44, 42), torso = Color3.fromRGB(40, 38, 36), legs = Color3.fromRGB(36, 34, 32), arms = Color3.fromRGB(40, 38, 36) }

function M.Look(k)
	local deco, V, at, rgb, MAT, D, s = k.deco, k.V, k.at, k.rgb, k.MAT, k.D, k.s
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	-- the Ossuary Warden: blackened plate hung with the bones of the prison
	local plate, plateDark, bone, surcoat = rgb(48, 46, 44), rgb(30, 29, 28), rgb(176, 168, 146), rgb(60, 18, 16)
	deco("Chest", "Breastplate", V(cw * 0.95, ch * 0.8, 0.3), at(0, 0.05, -cd / 2 - 0.1), plate, MAT.Metal)
	deco("Chest", "Backplate", V(cw * 0.95, ch * 0.8, 0.25), at(0, 0.05, cd / 2 + 0.08), plateDark, MAT.Metal)
	deco("Chest", "Gorget", V(cw * 0.6, 0.4, cd * 1.15), at(0, ch / 2 - 0.05, 0), plateDark, MAT.Metal)
	deco("Chest", "RibCage", V(cw * 0.5, 0.08, 0.05), at(0, 0.3, -cd / 2 - 0.27), bone)
	deco("Chest", "RibCage", V(cw * 0.42, 0.08, 0.05), at(0, 0.08, -cd / 2 - 0.27), bone)
	deco("Chest", "RibCage", V(cw * 0.34, 0.08, 0.05), at(0, -0.14, -cd / 2 - 0.27), bone)
	deco("Hips", "Faulds", V(hw + 0.2, 0.55, hd + 0.2), at(0, 0.05, 0), plateDark, MAT.Metal)
	-- a surcoat before and behind, worn ragged at the hem (rough 0.5: torn, not shredded)
	local rng, hem = Random.new(11), surcoat:Lerp(rgb(18, 10, 8), 0.6)
	for _, z in ipairs({ -hd / 2 - 0.12, hd / 2 + 0.12 }) do
		local n, w = 6, hw + 0.1
		for i = 1, n do
			local len = rng:NextNumber() < 0.15 and rng:NextNumber(1.1, 1.3) or rng:NextNumber(1.45, 1.7)
			local top = CFrame.new((-0.5 + (i - 0.5) / n) * w, -0.15, z + (i % 2) * 0.012 * math.sign(z)) -- (alternate rags overlap)
			k.tatter(rng, "Hips", top, w / n * 1.6, len, surcoat:Lerp(hem, rng:NextNumber(0, 0.3)), hem, 0.5)
		end
	end
	for _, n in ipairs({ "R", "L" }) do
		local sx = n == "R" and 1 or -1
		deco(n .. "UpperArm", "Pauldron", V(aw * 2.1, 0.75, aw * 1.9), at(0, ua / 2 - 0.1, 0), plate, MAT.Metal)
		deco(n .. "UpperArm", "PauldronSkull", V(0.55, 0.55, 0.55), at(sx * aw * 0.7, ua / 2 + 0.2, 0), plateDark, MAT.SmoothPlastic, Enum.PartType.Ball)
		deco(n .. "UpperArm", "Spike", V(0.18, 0.8, 0.18), at(sx * aw * 0.55, ua / 2 + 0.55, 0.15) * CFrame.Angles(0, 0, -sx * 0.5), plateDark, MAT.SmoothPlastic)
		deco(n .. "LowerArm", "Gauntlet", V(aw * 1.2, 0.8, aw * 1.2), at(0, -la / 2 + 0.4, 0), plateDark, MAT.Metal)
	end
	-- BELOW THE WAIST, A MANGLED MESS (as the Watchdogs are): no pair of legs in plate but a knot of fused flesh and bone,
	-- the two it walks on not matching - the right swollen, the left wasted and twisted with a toe too many - and more
	-- that never grew right hanging off the mass: a withered third limb dragging behind, a stub with a claw, spurs. The
	-- rig's leg boxes are hidden; everything here rides on them, so it still walks as he does.
	local BALL, CYL = Enum.PartType.Ball, Enum.PartType.Cylinder
	local flesh, fleshDark, sinew = rgb(66, 38, 34), rgb(40, 24, 22), rgb(120, 64, 54)
	local tl, sl = D.thigh / s, D.shin / s
	local function ball(on, d, cf, col, mat)
		deco(on, "Mangle", V(d, d, d), cf, col, mat or MAT.Fabric, BALL)
	end
	local function rod(on, len, d, cf, col, mat) -- (standing along the cf's y)
		deco(on, "Mangle", V(len, d, d), cf * CFrame.Angles(0, 0, math.pi / 2), col, mat or MAT.Fabric, CYL)
	end
	for _, pn in ipairs({ "RThigh", "LThigh", "RShin", "LShin", "RFoot", "LFoot" }) do
		k.parts[pn].Transparency = 1
	end
	-- the mass at the hips both legs grow out of, lopsided, plate fused into it where it burst out of his faulds
	ball("Hips", hw * 1.05, at(0.1, -0.3, 0), fleshDark)
	ball("Hips", hw * 0.7, at(hw * 0.32, -0.45, -0.25), flesh)
	ball("Hips", hw * 0.55, at(-hw * 0.3, -0.5, 0.3), flesh)
	ball("Hips", 0.5, at(-0.2, -0.8, -hd * 0.5), sinew)
	deco("Hips", "Mangle", V(0.7, 0.5, 0.12), at(hw * 0.35, -0.3, -hd * 0.62) * CFrame.Angles(0.3, 0.4, 0.5), plateDark, MAT.Metal)
	deco("Hips", "Mangle", V(0.5, 0.6, 0.12), at(-hw * 0.4, -0.4, hd * 0.6) * CFrame.Angles(-0.4, -0.2, -0.7), plate, MAT.Metal)
	for _, sp in ipairs({ { 0.5, -0.2, 0.5, 0.9, -0.9, 0.3 }, { -0.6, -0.5, 0.4, 0.7, -1.2, -0.5 }, { 0.1, -0.7, 0.6, 0.6, -1.5, 0.1 } }) do -- (bone driven out the back)
		deco("Hips", "Mangle", V(0.14, sp[4], 0.14), at(sp[1], sp[2], sp[3]) * CFrame.Angles(sp[5], 0, sp[6]) * at(0, sp[4] / 2, 0), bone, MAT.SmoothPlastic)
	end
	-- the withered third limb, out of the back of the mass and trailing on the ground, its claw dragging
	local drag = at(0.15, -0.55, hd * 0.55) * CFrame.Angles(-0.95, 0.15, 0)
	rod("Hips", 1.6, 0.36, drag * at(0, -0.8, 0), fleshDark)
	ball("Hips", 0.42, drag * at(0, -1.6, 0), sinew)
	rod("Hips", 1.1, 0.26, drag * at(0, -1.6, 0) * CFrame.Angles(0.9, 0, 0) * at(0, -0.55, 0), flesh)
	for _, x in ipairs({ -0.1, 0.1 }) do
		deco("Hips", "Mangle", V(0.1, 0.1, 0.4), drag * at(0, -1.6, 0) * CFrame.Angles(0.9, 0, 0) * at(x, -1.15, -0.1), rgb(26, 22, 20), MAT.Slate)
	end
	-- a stub on the left that never grew past the elbow, a claw at its end
	local stub = at(-hw * 0.5, -0.35, -0.1) * CFrame.Angles(0.2, 0, -0.9)
	rod("Hips", 0.7, 0.3, stub * at(0, -0.35, 0), flesh)
	deco("Hips", "Mangle", V(0.1, 0.35, 0.1), stub * at(0, -0.8, 0) * CFrame.Angles(0.5, 0, 0), bone, MAT.SmoothPlastic)
	-- the two it walks on
	for _, n in ipairs({ "R", "L" }) do
		local sx = n == "R" and 1 or -1
		local sw = n == "R" and 1.25 or 0.85 -- (the right swollen, the left wasted)
		local th, sh, ft = n .. "Thigh", n .. "Shin", n .. "Foot"
		-- thigh: a core with muscle knotted round it, unevenly, and a scrap of the old cuisse sunk in it
		rod(th, tl, lw * 0.85 * sw, at(0, 0, 0) * CFrame.Angles(0.06, 0, sx * 0.08), flesh)
		ball(th, lw * 1.1 * sw, at(sx * 0.12, tl * 0.32, -0.1), fleshDark)
		ball(th, lw * 0.85 * sw, at(-sx * 0.1, -tl * 0.05, 0.22), flesh)
		ball(th, lw * 0.7 * sw, at(sx * 0.22, -tl * 0.25, -0.15), fleshDark)
		deco(th, "Mangle", V(lw * 0.9, 0.5, 0.1), at(sx * 0.1, 0.05, -lw * 0.55) * CFrame.Angles(0.15, sx * 0.3, sx * 0.4), plateDark, MAT.Metal)
		if n == "R" then -- (a cluster of blisters on the swollen one)
			for _, g in ipairs({ { 0.35, 0.4, 0.1, -0.35 }, { 0.28, 0.45, -0.15, -0.25 }, { 0.22, 0.38, -0.3, -0.42 } }) do
				ball(th, g[1], at(g[2], g[3], g[4]), sinew)
			end
		end
		-- the knee: a knob of bone, a spur out the back of it
		ball(th, lw * 0.95, at(0, -tl * 0.5, 0.05), bone:Lerp(fleshDark, 0.4), MAT.Slate)
		deco(th, "Mangle", V(0.12, 0.12, 0.6), at(0, -tl * 0.45, 0.45) * CFrame.Angles(-0.5, sx * 0.2, 0), bone, MAT.SmoothPlastic)
		-- shin: twisted and tapering, tendons standing proud down the back, a lump where it set wrong
		rod(sh, sl, lw * 0.65 * sw, at(0, 0, 0) * CFrame.Angles(-0.05, 0, -sx * 0.1), fleshDark)
		ball(sh, lw * 0.7 * sw, at(sx * 0.12, sl * 0.15, -0.12), flesh)
		for _, x in ipairs({ -0.12, 0.12 }) do
			rod(sh, sl * 0.9, 0.1, at(x, 0, lw * 0.32) * CFrame.Angles(0.1, 0, 0), sinew)
		end
		ball(sh, lw * 0.65, at(0, -sl * 0.48, 0), fleshDark) -- (the ankle)
		-- foot: a heel mass and knuckled toes hooking into claws; the left with one crowded in too many
		ball(ft, 0.6 * sw, at(0, 0, 0.2), fleshDark)
		for j, x in ipairs(n == "L" and { -0.24, -0.08, 0.06, 0.2 } or { -0.22, 0, 0.22 }) do
			local d = (0.28 + (j % 2) * 0.05) * sw
			local cf = at(x, -0.05, -0.25) * CFrame.Angles(0, -x * 0.6, 0)
			ball(ft, d, cf, flesh)
			ball(ft, d * 0.8, cf * at(0, -0.02, -0.22), fleshDark)
			deco(ft, "Mangle", V(0.1, 0.09, 0.28), cf * at(0, -0.06, -0.45) * CFrame.Angles(-0.6, 0, 0), rgb(26, 22, 20), MAT.Slate)
		end
	end
	-- the death-mask: a blackened skull under an iron crown band, a fanged maw, ram's horns.
	local up = CFrame.Angles(0, 0, math.pi / 2)
	local black, iron = rgb(14, 13, 13), rgb(34, 32, 30)
	deco("Head", "Skull", V(1.3, 1.3, 1.3), at(0, 0.12, 0), plate, MAT.Metal, Enum.PartType.Ball)
	deco("Head", "Jaw", V(0.85, 0.42, 0.85), at(0, -0.5, -0.2), plate, MAT.Metal)
	deco("Head", "Maw", V(0.8, 0.16, 0.06), at(0, -0.5, -0.64), black, MAT.SmoothPlastic)
	for i = -2, 2 do -- fangs: long at the corners, short between
		deco("Head", "Fang", V(0.09, 0.3 - math.abs(i) * 0.04, 0.07), at(i * 0.17, -0.5, -0.67), plateDark, MAT.Metal)
	end
	deco("Head", "Nose", V(0.14, 0.2, 0.06), at(0, -0.12, -0.64), black, MAT.SmoothPlastic)
	for _, sx in ipairs({ -1, 1 }) do
		deco("Head", "Socket", V(0.42, 0.32, 0.1), at(sx * 0.26, 0.12, -0.62) * CFrame.Angles(0, 0, sx * 0.25), black, MAT.SmoothPlastic)
	end
	-- an iron band round the brow
	deco("Head", "CrownBand", V(0.2, 1.45, 1.45), at(0, 0.5, 0) * up, iron, MAT.Metal, Enum.PartType.Cylinder)
	-- great ram's horns: out of the dome, back, down past the ear and forward again in a
	-- tightening curl that flares away from the head, ridged and tapering to the tip
	local horn, hornTip = rgb(44, 42, 40), rgb(20, 19, 18) -- blackened like his plate
	for _, sx in ipairs({ -1, 1 }) do
		local N, turns, r0 = 16, 0.9, 0.85
		local function pt(t)
			local phi, r = t * turns * math.pi * 2, r0 * (1 - 0.55 * t)
			return Vector3.new(sx * (0.5 + 0.8 * t ^ 1.3), 0.55 - r0 + r * math.cos(phi), 0.1 + r * math.sin(phi))
		end
		local p = pt(0)
		for i = 1, N do
			local t = i / N
			local q, d = pt(t), 0.72 * (1 - 0.75 * t)
			local col = horn:Lerp(hornTip, t * 0.7):Lerp(rgb(0, 0, 0), (i % 2) * 0.12) -- (dark rings: the ridges)
			-- blocks run along -Z of lookAt; overlap a little so the outside of the curl stays closed
			deco("Head", "Horn", V(d, d * 0.85, (q - p).Magnitude + d * 0.35), CFrame.lookAt((p + q) / 2 * s, q * s), col, MAT.Metal)
			p = q
		end
	end
	-- a crown of skulls on the backplate
	for i = -1, 1 do
		deco("Chest", "BackSkull", V(0.5, 0.5, 0.5), at(i * 0.55, ch / 2 + 0.05, cd / 2 + 0.3), bone, MAT.SmoothPlastic, Enum.PartType.Ball)
	end
	-- eyes: direct children named "Eye" (tell() and phase 2 recolour them)
	for _, x in ipairs({ -0.26, 0.26 }) do
		deco("Head", "Eye", V(0.2, 0.1, 0.05), at(x, 0.12, -0.69), rgb(200, 40, 20), MAT.Neon)
	end
end

M.Weapons = {
	-- a great flanged mace: a thick ironbound haft wrapped in leather where he holds it,
	-- a heavy pommel, and a head of six blunt flanges between iron bands, a skull lashed
	-- under it with chain. All blunt. (Sizes are at scale 1; the hit sweep is unchanged.)
	Mace = function(w)
		local mk, add, s = w.mk, w.add, w.scale
		local iron, ironDark = Color3.fromRGB(52, 48, 44), Color3.fromRGB(34, 32, 30)
		local leather, bone = Color3.fromRGB(58, 40, 28), Color3.fromRGB(176, 168, 146)
		local function ball(name, size, color, material, y, rot)
			local p = mk(name, Vector3.new(size, size, size), color, material)
			p.Shape = Enum.PartType.Ball
			add(p, y, rot)
			return p
		end
		local handle = mk("Haft", Vector3.new(0.6, 3.8, 0.6), Color3.fromRGB(40, 30, 22), Enum.Material.Wood)
		-- leather grip, bound in rings around the hand (the hand sits at +1.4)
		for i = 0, 4 do
			add(mk("Wrap", Vector3.new(0.68, 0.2, 0.68), leather, Enum.Material.Fabric), 0.75 + i * 0.28, CFrame.Angles(0, i * 0.4, 0))
		end
		add(mk("Pommel", Vector3.new(0.9, 0.45, 0.9), ironDark, Enum.Material.Metal), 2.05)
		ball("PommelKnob", 0.62, iron, Enum.Material.Metal, 2.4)
		-- iron langets riveted down the haft below the head
		for k = 0, 3 do
			add(mk("Langet", Vector3.new(0.4, 1.5, 0.1), iron, Enum.Material.Metal), -1.0, CFrame.Angles(0, k * math.pi / 2, 0) * CFrame.new(0, 0, 0.33 * s))
		end
		add(mk("Collar", Vector3.new(0.98, 0.32, 0.98), ironDark, Enum.Material.Metal), -1.6)
		-- the head: an iron core, six flanges, bands top and bottom, a capped crown
		add(mk("Head", Vector3.new(1.3, 1.8, 1.3), ironDark, Enum.Material.Metal), -2.4)
		for k = 0, 5 do
			add(mk("Flange", Vector3.new(0.22, 1.6, 0.85), iron, Enum.Material.Metal), -2.4, CFrame.Angles(0, k * math.pi / 3, 0) * CFrame.new(0, 0, 0.85 * s))
		end
		for _, y in ipairs({ -1.55, -3.25 }) do
			add(mk("HeadBand", Vector3.new(1.5, 0.2, 1.5), ironDark, Enum.Material.Metal), y)
		end
		add(mk("Cap", Vector3.new(0.95, 0.4, 0.95), iron, Enum.Material.Metal), -3.5)
		ball("Finial", 0.55, ironDark, Enum.Material.Metal, -3.8)
		-- a skull lashed under the head with a few links of chain
		ball("Skull", 0.62, bone, Enum.Material.SmoothPlastic, -1.2, CFrame.Angles(0, 0.4, 0) * CFrame.new(0, 0, 0.62 * s))
		for i = 0, 2 do
			add(mk("Link", Vector3.new(0.08, 0.24, 0.16), iron, Enum.Material.Metal), -1.35 - i * 0.2, CFrame.Angles(0, 0.4 + (i % 2) * math.pi / 2, 0) * CFrame.new(0, 0, 0.4 * s))
		end
		-- the haft is centred on the hand, the head hangs below it
		return { handle = handle, bladeLen = 3.3, gripC1 = CFrame.new(0, 1.4 * s, 0) }
	end,
}
-- low sweeps: hip-high, wide, and tilted 24 deg down, so a big mace passes through player
-- height and its tip just clears the floor (the Castellan swings through these too)
M.Grips = {
	BSweepBack = { Vector3.new(2.0, -0.6, 1.0), CFrame.Angles(0, math.rad(-45), 0) * CFrame.Angles(0, 0, math.rad(66)) },
	BSweepMid = { Vector3.new(0, -0.6, -2.2), CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(0, 0, math.rad(66)) },
	BSweepEnd = { Vector3.new(-1.6, -0.6, -0.4), CFrame.Angles(0, math.rad(205), 0) * CFrame.Angles(0, 0, math.rad(66)) },
	-- the first beat of a wind-up: hefted up onto the shoulder, head standing behind it
	BHeft = { Vector3.new(1.3, 1.0, 0.7), CFrame.Angles(math.rad(190), 0, math.rad(15)) },
	-- ...or dropped low at his side, head trailing, before a sweep or a charge
	BSweepGather = { Vector3.new(1.4, -0.6, 0.3), CFrame.Angles(0, math.rad(-20), 0) * CFrame.Angles(math.rad(-45), 0, math.rad(55)) },
	-- THE REAPING SWEEP (his alone; the B ones above are shared with the Castellan). Yaw = which way out the haft points,
	-- the second angle how near flat it lies. Let down at his side, dragged round behind him head on the floor, lifted
	-- into the load, then out wide - well past where the old sweep reached - right, front, left, and wrapped round
	WReapLow = { Vector3.new(1.5, -0.8, 0.5), CFrame.Angles(0, math.rad(-25), 0) * CFrame.Angles(math.rad(-35), 0, math.rad(48)) },
	WReapHaul = { Vector3.new(1.6, -0.8, 1.8), CFrame.Angles(0, math.rad(-75), 0) * CFrame.Angles(0, 0, math.rad(52)) },
	WReapLoad = { Vector3.new(1.2, -0.4, 2.3), CFrame.Angles(0, math.rad(-100), 0) * CFrame.Angles(math.rad(8), 0, math.rad(72)) },
	WReapR = { Vector3.new(2.7, -0.7, -0.6), CFrame.Angles(0, math.rad(12), 0) * CFrame.Angles(0, 0, math.rad(68)) },
	WReapFront = { Vector3.new(0.2, -0.7, -2.9), CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(0, 0, math.rad(68)) },
	WReapL = { Vector3.new(-2.5, -0.7, -0.9), CFrame.Angles(0, math.rad(160), 0) * CFrame.Angles(0, 0, math.rad(68)) },
	WReapEnd = { Vector3.new(-1.5, -0.5, 0.9), CFrame.Angles(0, math.rad(215), 0) * CFrame.Angles(0, 0, math.rad(62)) },
	-- the backhand: the swing's weight carried on round behind his left side and lifted, then back across the same way
	WBackLoad = { Vector3.new(-1.0, -0.4, 2.3), CFrame.Angles(0, math.rad(255), 0) * CFrame.Angles(math.rad(-8), 0, math.rad(72)) },
	WBackEnd = { Vector3.new(1.7, -0.5, 1.0), CFrame.Angles(0, math.rad(-35), 0) * CFrame.Angles(0, 0, math.rad(62)) },
}
M.BodyFor = { BSweepBack = "SweepWindup", BSweepEnd = "SweepEnd" }

---------------------------------------------------------------------------
-- server: the fight
---------------------------------------------------------------------------
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Map, EnemiesFolder, FxRemote, states, now, flat, rand, turnTowards, SOUNDS, playSound, burst, fxAnchor, dustCloud, crackLines, fadeAway, shockwave, groundHeave, debrisChunks, SMOKE, SPARK, pose, bodyPose, setTrail, makeRig, findShoulder, aliveChar, damagePlayer, playersInRadius
local dropSplinter

local BOSS_SCALE = 3
local SPEED = 1.1 -- everything he does (moves, turns, wind-ups, swings, recoveries) runs this much faster
local boss: any = {
	state = "none", -- none | dormant | intro | fight | dead
	gen = 0, -- bumps every respawn so stale coroutines stop touching the new boss
	phase2 = false,
	leapReady = 0,
	stompReady = 0,
}
	-- boss.current = the live boss's actor snapshot (weld/tween/root for posing)

-- every boss hit goes through this (difficulty knob: Config.Boss.DamageScale)
local function bossDmg(x)
	return math.max(1, math.floor(x * (Config.Boss.DamageScale or 1) + 0.5))
end

---------------------------------------------------------------------------
-- boss: The Ossuary Warden
---------------------------------------------------------------------------
local bossAI -- forward declaration

local function snapBoss()
	-- one actor table per boss life, shared by every coroutine (so hit-stop can find its tween)
	if boss.current and boss.current.gen == boss.gen then
		return boss.current
	end
	return {
		model = boss.model,
		hum = boss.hum,
		root = boss.root,
		weld = boss.weld,
		scale = BOSS_SCALE,
		shoulder = boss.shoulder,
		c0 = boss.c0,
		gen = boss.gen,
	}
end

local function live(b)
	return boss.gen == b.gen and boss.state == "fight" and b.hum.Parent ~= nil and b.hum.Health > 0
end

local function bossIdleArm(b)
	setTrail(b, false)
	pose(b, "Idle", 0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut) -- settles back, no snap
end

local function leapTo(b, groundPos, duration, damage)
	local root = b.root
	if not root or not root.Parent then
		return
	end
	root.Anchored = true
	local startPos = root.Position
	local height = 3 * BOSS_SCALE
	local endPos = Vector3.new(math.clamp(groundPos.X, -38, 38), height, math.clamp(groundPos.Z, 222, 286))
	local look = flat(endPos - startPos)
	local rot = look.Magnitude > 0.1 and CFrame.lookAt(Vector3.zero, look) or root.CFrame.Rotation
	local t0 = now()
	while true do
		local a = math.min((now() - t0) / duration, 1)
		local across = a * 0.5 + a * a * (3 - 2 * a) * 0.5 -- eases off the ground and into the landing
		local pos = startPos:Lerp(endPos, across) + Vector3.new(0, math.sin(a * math.pi) * 16, 0)
		root.CFrame = CFrame.new(pos) * rot.Rotation
		if a >= 1 then
			break
		end
		RunService.Heartbeat:Wait()
		if boss.gen ~= b.gen or boss.state == "dead" or not root.Parent then
			return
		end
	end
	local ground = Vector3.new(endPos.X, 0.2, endPos.Z)
	shockwave(ground, 14)
	playSound(root, SOUNDS.Impact, 1, 0.5)
	FxRemote:FireAllClients("Shake", ground, 1.4)
	if damage then
		for _, pl in ipairs(playersInRadius(ground, 11, 14)) do
			damagePlayer(pl, bossDmg(damage), ground, "Knockdown")
		end
	end
end

---------------------------------------------------------------------------
-- boss helpers
---------------------------------------------------------------------------
local function tempo()
	return boss.phase2 and 0.85 or 1 -- phase 2 winds up faster
end

local function turnRate()
	return math.rad(boss.phase2 and 170 or 115) * SPEED -- deg/s: slow enough to roll behind it
end

local function walkSpeed()
	return (boss.phase2 and 14 or 11) * SPEED
end

local function bossFree(b)
	return live(b) and now() >= (boss.staggerUntil or 0)
end

-- wind up, turning toward the target for the first trackFrac of it, then commit.
-- Returns false if the boss died, reset or got staggered.
local function windupTrack(b, duration, trackFrac, target)
	duration /= SPEED
	local t0 = now()
	while now() - t0 < duration do
		if not bossFree(b) then
			return false
		end
		local tr = target and target:FindFirstChild("HumanoidRootPart")
		local dt = task.wait()
		if tr and now() - t0 < duration * trackFrac then
			turnTowards(b.root, tr.Position, turnRate() * dt * 1.6)
		end
	end
	return true
end

-- Telegraphs build up instead of snapping: a wind-up eases in and out, and comes in
-- two beats - he gathers his weight with the mace part-way, then makes the full draw -
-- with his body and the mace moving together. gather/full = { grip, body pose, seconds }.
-- Tracks the target for the first `track` seconds. Same false-on-interrupt as windupTrack.
local EASE, INOUT = Enum.EasingStyle.Sine, Enum.EasingDirection.InOut
local function draw(b, grip, body, t)
	pose(b, grip, t, EASE, INOUT)
	if body then
		bodyPose(b, body, t)
	end
end
-- any number of beats: { grip, body pose, seconds, onStart? } each; tracks for the first `track` seconds in all
local function windupBeats(b, target, list, track)
	for _, bt in ipairs(list) do
		draw(b, bt[1], bt[2], bt[3])
		if bt[4] then
			bt[4]()
		end
		if not windupTrack(b, bt[3], math.clamp(track / bt[3], 0, 1), target) then
			return false
		end
		track -= bt[3]
	end
	return true
end
local function windup2(b, target, gather, full, track)
	return windupBeats(b, target, { gather, full }, track)
end

local function waitLive(b, duration)
	duration /= SPEED
	local t0 = now()
	while now() - t0 < duration do
		if not live(b) then
			return false
		end
		task.wait()
	end
	return true
end

local function hitOnce(list, seen, damage, fromPos, level)
	for _, pl in ipairs(list) do
		if not seen[pl] then
			if damagePlayer(pl, bossDmg(damage), fromPos, level) then
				seen[pl] = true
			end
		end
	end
end

local function inArena(pos)
	return pos.X > -43 and pos.X < 43 and pos.Z > 217 and pos.Z < 303
end

-- The mace's real path hurts: sample it every frame (like the player's sword).
local maceParams = OverlapParams.new()
maceParams.FilterType = Enum.RaycastFilterType.Include
maceParams.CollisionGroup = "HitQuery"

local function maceEnds(b)
	local weld = b.weld
	local handle = weld and weld.Parent and weld.Part1
	if not handle or not handle.Parent then
		return nil
	end
	local base, tip = handle:FindFirstChild("BladeBase"), handle:FindFirstChild("BladeTip")
	if base and tip then
		return base.WorldPosition, tip.WorldPosition
	end
	return nil
end

local function maceSweep(b, duration, damage, level, seen, radius)
	duration /= SPEED
	local chars = {}
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character then
			table.insert(chars, pl.Character)
		end
	end
	maceParams.FilterDescendantsInstances = chars
	local t0 = now()
	local pb, pt
	while now() - t0 < duration and live(b) do
		local base, tip = maceEnds(b)
		if base then
			pb, pt = pb or base, pt or tip
			for i = 0, 3 do
				local f = i / 3
				local bb, tt = pb:Lerp(base, f), pt:Lerp(tip, f)
				for j = 0, 6 do
					for _, part in ipairs(workspace:GetPartBoundsInRadius(bb:Lerp(tt, j / 6), radius or 2.2, maceParams)) do
						local pl = Players:GetPlayerFromCharacter(part:FindFirstAncestorOfClass("Model"))
						if pl and not seen[pl] and damagePlayer(pl, bossDmg(damage), b.root.Position, level) then
							seen[pl] = true
						end
					end
				end
			end
			pb, pt = base, tip
		end
		RunService.Heartbeat:Wait()
	end
end
-- Fissures in the floor that glow hotter as a blast builds. Returns a function that fades them.
local function heatCracks(center, radius, dur)
	local list = crackLines(Vector3.new(center.X, center.Y + 0.04, center.Z), radius, 10, Color3.fromRGB(70, 18, 6), Enum.Material.Neon, dur * 0.7)
	for _, seg in ipairs(list) do
		TweenService:Create(seg, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Color = Color3.fromRGB(255, 140, 50) }):Play()
	end
	local glow = fxAnchor(center + Vector3.new(0, 1, 0))
	local l = Instance.new("PointLight")
	l.Color = Color3.fromRGB(255, 120, 50)
	l.Range = radius * 1.6
	l.Brightness = 0
	l.Parent = glow
	TweenService:Create(l, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Brightness = 4 }):Play()
	local embers = Instance.new("ParticleEmitter")
	embers.Texture = SPARK
	embers.Rate = 40
	embers.Lifetime = NumberRange.new(0.8, 1.6)
	embers.Speed = NumberRange.new(2, 6)
	embers.SpreadAngle = Vector2.new(30, 30)
	embers.Size = NumberSequence.new(0.25, 0)
	embers.Color = ColorSequence.new(Color3.fromRGB(255, 150, 60))
	embers.LightEmission = 1
	embers.Acceleration = Vector3.new(0, 4, 0)
	embers.Parent = glow
	return function()
		embers.Enabled = false
		TweenService:Create(l, TweenInfo.new(1), { Brightness = 0 }):Play()
		Debris:AddItem(glow, 1.5)
		for _, seg in ipairs(list) do
			TweenService:Create(seg, TweenInfo.new(1.2), { Color = Color3.fromRGB(30, 26, 24) }):Play()
			seg.Material = Enum.Material.Slate
		end
		fadeAway(list, 3, 1.5)
	end
end

-- Soot-black scorching that creeps across the stone to exactly where a blast
-- will reach, with heat-shimmer smoke rising off it. Returns a function that fades it.
local function scorchSpread(center, radius, dur)
	local disc = Instance.new("Part")
	disc.Name = "Scorch"
	disc.Anchored = true
	disc.CanCollide = false
	disc.CanQuery = false
	disc.CanTouch = false
	disc.CastShadow = false
	disc.Shape = Enum.PartType.Cylinder
	disc.Material = Enum.Material.Slate
	disc.Color = Color3.fromRGB(14, 12, 11)
	disc.Transparency = 0.7
	disc.Size = Vector3.new(0.05, radius * 0.4, radius * 0.4)
	disc.CFrame = CFrame.new(center.X, center.Y + 0.035, center.Z) * CFrame.Angles(0, 0, math.pi / 2)
	disc.Parent = workspace
	local info = TweenInfo.new(dur * 0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(disc, info, { Size = Vector3.new(0.05, radius * 2, radius * 2), Transparency = 0.12 }):Play()
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = SMOKE
	smoke.Rate = math.clamp(radius * 3, 8, 50)
	smoke.Lifetime = NumberRange.new(0.8, 1.5)
	smoke.Speed = NumberRange.new(1.5, 4)
	smoke.EmissionDirection = Enum.NormalId.Right -- the cylinder's axis points up
	smoke.SpreadAngle = Vector2.new(10, 10)
	smoke.Size = NumberSequence.new(0.8, 2.2)
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
	smoke.Color = ColorSequence.new(Color3.fromRGB(30, 27, 25))
	smoke.LightInfluence = 1
	smoke.Parent = disc
	return function()
		smoke.Enabled = false
		task.delay(1, function()
			if disc.Parent then
				TweenService:Create(disc, TweenInfo.new(2), { Transparency = 1 }):Play()
			end
		end)
		Debris:AddItem(disc, 3.2)
	end
end

local function burnPlayer(pl, dmg)
	local st = states[pl]
	local char, hum = aliveChar(pl)
	if not (st and char) then
		return
	end
	local t = now()
	if t >= st.iStart and t <= st.iEnd then
		return
	end
	hum:TakeDamage(bossDmg(dmg))
	FxRemote:FireClient(pl, "Burn")
end

-- burning ground (phase 2): damage over time, no stagger
local function firePatch(pos, radius, duration)
	local p = Instance.new("Part")
	p.Name = "FirePatch"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Shape = Enum.PartType.Cylinder
	p.Material = Enum.Material.Slate
	p.Color = Color3.fromRGB(24, 21, 19) -- scorched stone
	p.Transparency = 0.25
	p.Size = Vector3.new(0.05, radius * 2, radius * 2)
	p.CFrame = CFrame.new(pos.X, pos.Y + 0.02, pos.Z) * CFrame.Angles(0, 0, math.pi / 2)
	p.Parent = workspace
	local embers = Instance.new("ParticleEmitter")
	embers.Texture = SPARK
	embers.Rate = 25
	embers.Lifetime = NumberRange.new(0.6, 1.4)
	embers.Speed = NumberRange.new(1, 4)
	embers.Size = NumberSequence.new(0.2, 0)
	embers.Color = ColorSequence.new(Color3.fromRGB(255, 140, 60))
	embers.LightEmission = 1
	embers.Acceleration = Vector3.new(0, 3, 0)
	embers.Parent = p
	local f = Instance.new("Fire")
	f.Size = radius * 1.4
	f.Heat = 6
	f.Color = Color3.fromRGB(255, 110, 30)
	f.SecondaryColor = Color3.fromRGB(100, 20, 5)
	f.Parent = p
	local l = Instance.new("PointLight")
	l.Color = Color3.fromRGB(255, 120, 50)
	l.Range = radius * 3
	l.Brightness = 1.5
	l.Parent = p
	TweenService:Create(p, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Transparency = 1 }):Play()
	Debris:AddItem(p, duration + 0.1)
	task.spawn(function()
		local t0 = now()
		while now() - t0 < duration do
			for _, pl in ipairs(playersInRadius(pos, radius, 6)) do
				burnPlayer(pl, 5)
			end
			task.wait(0.4)
		end
	end)
end

-- rock spikes bursting out of the floor
local function eruption(pos, radius, damage, level, fiery)
	local color = fiery and Color3.fromRGB(150, 60, 30) or Color3.fromRGB(80, 74, 66)
	for i = 1, 5 do
		local a = i / 5 * math.pi * 2 + math.random()
		local spike = Instance.new("Part")
		spike.Name = "Spike"
		spike.Anchored = true
		spike.CanCollide = false
		spike.CanQuery = false
		spike.CanTouch = false
		spike.Material = Enum.Material.Slate
		spike.Color = color
		local h = radius * rand(1.2, 1.9)
		spike.Size = Vector3.new(0.9, h, 0.9)
		local base = pos + Vector3.new(math.cos(a) * radius * 0.45, 0, math.sin(a) * radius * 0.45)
		local tilt = CFrame.Angles(rand(-0.4, 0.4), rand(0, 6), rand(-0.4, 0.4))
		spike.CFrame = CFrame.new(base - Vector3.new(0, h / 2, 0)) * tilt
		spike.Parent = workspace
		TweenService:Create(spike, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(base + Vector3.new(0, h * 0.3, 0)) * tilt }):Play()
		task.delay(0.7, function()
			TweenService:Create(spike, TweenInfo.new(0.4), { CFrame = CFrame.new(base - Vector3.new(0, h, 0)) * tilt }):Play()
		end)
		Debris:AddItem(spike, 1.2)
	end
	shockwave(pos, radius * 1.2)
	hitOnce(playersInRadius(pos, radius, 8), {}, damage, pos, level)
	if fiery then
		firePatch(pos, radius * 0.8, 2.5)
	end
end

local function stopAndFace(b, target)
	b.hum:MoveTo(b.root.Position)
	b.hum.AutoRotate = false
end

-- Every attack opens with a physical tell: the eyes flare and it growls.
local function tell(b, pitch, hold) -- (hold: seconds the eyes stay lit, 0.35 by default)
	playSound(b.root, SOUNDS.Groan, 0.7, pitch or 0.32)
	for _, d in ipairs(b.model:GetChildren()) do
		if d.Name == "Eye" and d:IsA("BasePart") then
			local base = d.Color
			d.Color = Color3.fromRGB(255, 150, 90)
			task.delay(hold or 0.35, function()
				if d.Parent then
					TweenService:Create(d, TweenInfo.new(0.5), { Color = base }):Play()
				end
			end)
		end
	end
end

-- dust kicked up by a foot (charge wind-up, leap take-off)
local function footDust(b, side, amount)
	local root = b.root
	local p = root.CFrame * Vector3.new(side * 1.6 * BOSS_SCALE * 0.5, -3 * BOSS_SCALE + 0.4, 0.5 * BOSS_SCALE)
	dustCloud(p, 1.6, amount or 6)
end

-- he steps into a blow: a short burst of his own walk toward where he faces, a foot
-- coming down in dust, so the strike travels with his whole weight behind it
local function stepInto(b, dist, dur)
	dur /= SPEED
	local hum, root = b.hum, b.root
	if root.Anchored then
		return
	end
	local fwd = flat(root.CFrame.LookVector)
	if fwd.Magnitude < 0.1 then
		return
	end
	hum.WalkSpeed = dist / dur
	hum:MoveTo(root.Position + fwd.Unit * dist)
	task.delay(dur, function()
		if boss.gen == b.gen and b.hum.Parent then
			hum.WalkSpeed = walkSpeed()
			hum:MoveTo(root.Position)
			footDust(b, 1, 4)
		end
	end)
end

-- stand on the floor exactly (after leaps), whatever happened mid-air
local snapParams = RaycastParams.new()
snapParams.FilterType = Enum.RaycastFilterType.Exclude
local function snapToGround(b)
	local root = b.root
	b.hum.HipHeight = b.model:GetAttribute("HipHeight") or b.hum.HipHeight
	local ignore = { EnemiesFolder }
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character then
			table.insert(ignore, pl.Character)
		end
	end
	snapParams.FilterDescendantsInstances = ignore
	local res = workspace:Raycast(root.Position + Vector3.new(0, 6, 0), Vector3.new(0, -40, 0), snapParams)
	if res then
		root.CFrame = CFrame.new(root.Position.X, res.Position.Y + 3 * BOSS_SCALE, root.Position.Z) * root.CFrame.Rotation
	end
	root.AssemblyLinearVelocity = Vector3.zero
	pcall(function()
		b.hum:ChangeState(Enum.HumanoidStateType.Running)
	end)
end

---------------------------------------------------------------------------
-- boss moves
---------------------------------------------------------------------------
-- Overhead slam: rears back with the mace high. `delayed`: holds at the top.
local function bossSlam(b, target, opts)
	opts = opts or {}
	local m = tempo()
	stopAndFace(b, target)
	tell(b)
	playSound(b.root, SOUNDS.Unsheath, 0.9, 0.45)
	if not windup2(b, target, { "BHeft", "BGather", 0.4 * m }, { "Raise", "BRear", 0.85 * m }, 0.875 * m) then
		return
	end
	if opts.delayed then
		-- leans back even further, creaking, and the drop comes late
		bodyPose(b, "Roar", 0.35)
		playSound(b.root, SOUNDS.Unsheath, 0.7, 0.32)
		if not windupTrack(b, 0.35 + math.random() * 0.3, 0, target) then
			return
		end
	end
	setTrail(b, true)
	stepInto(b, 5, 0.25)
	pose(b, "Mid", 0.06, Enum.EasingStyle.Linear)
	task.delay(0.06, function()
		pose(b, "Strike", 0.08)
		bodyPose(b, "BSlamDrive", 0.12) -- the whole body drives down through it
	end)
	playSound(b.root, SOUNDS.Lunge, 0.9, 0.5)
	local seen = {}
	task.spawn(maceSweep, b, 0.2, 45, "Knockdown", seen, 2.2)
	task.wait(0.13 / SPEED)
	if not live(b) then
		return
	end
	local _, tip = maceEnds(b)
	local impact = tip or (b.root.Position + flat(b.root.CFrame.LookVector).Unit * 15)
	impact = Vector3.new(impact.X, 0.2, impact.Z)
	shockwave(impact, 9)
	playSound(b.root, SOUNDS.Impact, 1, 0.6)
	FxRemote:FireAllClients("Shake", impact, 1.1)
	hitOnce(playersInRadius(impact, 6, 10), seen, 30, impact, "Large")
	if boss.phase2 then
		firePatch(impact, 6, 4)
	end
	if not opts.recover then
		bodyPose(b, "Recover", 0.5) -- bent over the stuck mace: punish it
	end
	if waitLive(b, opts.recover or 1.3 * m) and not opts.recover then
		bossIdleArm(b)
	end
end

-- THE REAPING SWEEP: the move he puts the most into, and gives you the longest look at. He lets the mace down at his
-- side and plants his front foot wide; hauls it round behind him, its head grinding sparks along the floor; then winds
-- all the way - back nearly to you, knees deep, eyes still on you - while the floor cracks out to where it will reach
-- (glowing, in phase 2) and he draws a long breath. He stops turning to follow you for that last beat: that's the read.
-- Then everything lets go at once, from the feet up - a big step in, the hips leading the shoulders through - and the
-- mace goes out wide, much further from him than his other blows, right round to his left. opts.followUp (phase 2):
-- the weight carried on round behind his other side into a second, shorter wind and the backhand back across.
local REACH = 24 -- studs from where he stands that the sweep's cracks run out to (the swing's tip, plus the step)

-- the mace's head dragged on the floor: sparks and grit where it is, every few frames, for dur
local function scrape(b, dur)
	task.spawn(function()
		local t0, gen = now(), b.gen
		while now() - t0 < dur / SPEED and boss.gen == gen and live(b) do
			local _, tip = maceEnds(b)
			if tip then
				local p = Vector3.new(tip.X, 0.3, tip.Z)
				burst(p, Color3.fromRGB(255, 170, 80), 5, 0.25, 18)
				dustCloud(p, 1.2, 2)
			end
			task.wait(0.06)
		end
	end)
end

-- the floor cracking out round him to the sweep's reach while he loads it; returns what fades it
local function sweepCracks(b, dur)
	local fwd = flat(b.root.CFrame.LookVector)
	local c = b.root.Position + (fwd.Magnitude > 0.1 and fwd.Unit * 4 or Vector3.zero)
	c = Vector3.new(c.X, 0.2, c.Z)
	FxRemote:FireAllClients("Shake", c, 0.25)
	if boss.phase2 then
		return heatCracks(c, REACH, dur)
	end
	local list = crackLines(c, REACH, 9, Color3.fromRGB(26, 24, 22), Enum.Material.Slate, dur)
	return function()
		fadeAway(list, 1.5, 1)
	end
end

-- one swing along a chain of grips: { grip, seconds } each, the body following; hurts for as long as the chain runs
-- but its last link (the follow-through). Returns once the hurting part is over
local function reap(b, chain, bodyMid, bodyEnd, damage, step)
	setTrail(b, true)
	stepInto(b, step, 0.32)
	footDust(b, -1, 6)
	bodyPose(b, bodyMid, 0.24)
	playSound(b.root, SOUNDS.Slash, 1, 0.42)
	playSound(b.root, SOUNDS.Lunge, 0.8, 0.45)
	local hurt = 0
	for i = 1, #chain - 1 do
		hurt += chain[i][2]
	end
	task.spawn(function()
		local gen = b.gen
		for i, link in ipairs(chain) do
			if boss.gen ~= gen or not live(b) then
				return
			end
			pose(b, link[1], link[2], i == #chain and Enum.EasingStyle.Quad or Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
			if i == #chain - 1 then
				bodyPose(b, bodyEnd, 0.32)
			end
			task.wait(link[2] / SPEED)
		end
	end)
	maceSweep(b, hurt + 0.04, damage, "Large", {}, 2.8)
	FxRemote:FireAllClients("Shake", b.root.Position, 0.5)
end

local function bossSweep(b, target, opts)
	opts = opts or {}
	local m = tempo()
	stopAndFace(b, target)
	local load = 0.55 * m
	local wind = 0.4 * m + 0.6 * m + load
	tell(b, 0.36, wind / SPEED)
	playSound(b.root, SOUNDS.Unsheath, 0.8, 0.38)
	local fade
	local ok = windupBeats(b, target, {
		{ "WReapLow", "WPlant", 0.4 * m, function()
			footDust(b, -1, 5)
		end },
		{ "WReapHaul", "WHaul", 0.6 * m, function()
			scrape(b, 0.6 * m)
			playSound(b.root, SOUNDS.Unsheath, 0.9, 0.28)
		end },
		{ "WReapLoad", "WLoad", load, function()
			fade = sweepCracks(b, load / SPEED)
			playSound(b.root, SOUNDS.Breath, 0.9, 0.5)
		end },
	}, 0.4 * m + 0.6 * m) -- (tracks you through the plant and the haul; the load is committed)
	if fade then
		fade()
	end
	if not ok then
		return
	end
	reap(b, { { "WReapR", 0.09 }, { "WReapFront", 0.12 }, { "WReapL", 0.12 }, { "WReapEnd", 0.24 } }, "WRelease", "WFinish", 30, 8)
	if opts.followUp and bossFree(b) then
		-- the backhand: the mace's weight carried on round behind his left side, his right foot planted, wound the other
		-- way while the eyes flare again; then back across
		local coil = 0.55 * m
		tell(b, 0.4, coil / SPEED)
		scrape(b, 0.3)
		local fade2
		local ok2 = windupBeats(b, target, {
			{ "WBackLoad", "WBackCoil", coil, function()
				footDust(b, 1, 6)
				playSound(b.root, SOUNDS.Breath, 0.8, 0.6)
				fade2 = sweepCracks(b, coil / SPEED)
			end },
		}, coil * 0.6)
		if fade2 then
			fade2()
		end
		if not ok2 then
			return
		end
		reap(b, { { "WReapL", 0.1 }, { "WReapFront", 0.12 }, { "WReapR", 0.12 }, { "WBackEnd", 0.24 } }, "WBackThrough", "WBackFinish", 28, 6)
	end
	bodyPose(b, "Recover", 0.6) -- (bent over, the mace's weight still pulling him round: the punish window)
	if waitLive(b, opts.recover or 0.95 * m) and not opts.recover then
		bossIdleArm(b)
	end
end

-- Stomp: lifts a leg high, then brings it down.
local function bossStomp(b)
	local m = tempo()
	stopAndFace(b, nil)
	tell(b, 0.45)
	if not windup2(b, nil, { "BHeft", "BStompGather", 0.3 * m }, { "Mid", "StompLift", 0.55 * m }, 0) then
		return
	end
	b.model:SetAttribute("Airborne", true) -- (the boss footing in Core lets him leave the floor)
	task.delay(0.45, function()
		b.model:SetAttribute("Airborne", nil)
	end)
	b.root.AssemblyLinearVelocity = Vector3.new(0, 30, 0)
	bodyPose(b, "Strike", 0.12)
	if not waitLive(b, 0.32) then
		return
	end
	local ground = Vector3.new(b.root.Position.X, 0.2, b.root.Position.Z) + flat(b.root.CFrame.LookVector) * 2
	shockwave(ground, 12)
	playSound(b.root, SOUNDS.Impact, 1, 0.45)
	FxRemote:FireAllClients("Shake", ground, 1)
	hitOnce(playersInRadius(ground, 9.5, 14), {}, 26, ground, "Medium")
	if waitLive(b, 0.8 * m) then
		bossIdleArm(b)
	end
end

-- Shoulder charge: drops low, scrapes a foot twice, then barrels forward.
-- Slamming into a wall or pillar stuns it.
local chargeParams = RaycastParams.new()
chargeParams.FilterType = Enum.RaycastFilterType.Exclude

local function bossCharge(b, target)
	local tr = target:FindFirstChild("HumanoidRootPart")
	if not tr then
		return
	end
	local m = tempo()
	stopAndFace(b, target)
	tell(b, 0.3)
	task.delay(0.3 * m, function()
		if live(b) then
			footDust(b, 1, 6)
			playSound(b.root, SOUNDS.Impact, 0.4, 0.35)
		end
	end)
	task.delay(0.65 * m, function()
		if live(b) then
			footDust(b, 1, 6)
			playSound(b.root, SOUNDS.Impact, 0.4, 0.35)
		end
	end)
	if not windup2(b, target, { "BSweepGather", "BChargeSet", 0.35 * m }, { "BSweepBack", "Charge", 0.65 * m }, 0.85 * m) then
		return
	end
	local root = b.root
	local dir = flat(root.CFrame.LookVector).Unit
	local dist = math.clamp(flat(tr.Position - root.Position).Magnitude + 10, 12, 44)
	local ignore = { EnemiesFolder, Map.Bars }
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character then
			table.insert(ignore, pl.Character)
		end
	end
	chargeParams.FilterDescendantsInstances = ignore
	local hitWall = false
	local res = workspace:Raycast(root.Position, dir * (dist + 4), chargeParams)
	if res then
		dist = math.max(res.Distance - 4, 0)
		hitWall = true
	end
	root.Anchored = true
	local start = root.Position
	local rot = root.CFrame.Rotation
	local dur = math.max(dist / 48, 0.12)
	local seen = {}
	local t0 = now()
	local nextDust = 0
	while live(b) do
		local a = math.min((now() - t0) / dur, 1)
		local eased = a * 0.5 + (1 - math.cos(a * math.pi)) / 4 -- builds up speed, then skids to a stop
		local pos = start + dir * dist * eased
		root.CFrame = CFrame.new(pos) * rot
		for _, pl in ipairs(playersInRadius(pos, 5.5, 12)) do
			if not seen[pl] and damagePlayer(pl, bossDmg(32), pos - dir * 3, "Large") then
				seen[pl] = true
			end
		end
		if now() > nextDust then
			nextDust = now() + 0.07
			dustCloud(Vector3.new(pos.X, 0.6, pos.Z), 1.2, 3)
		end
		if a >= 1 then
			break
		end
		RunService.Heartbeat:Wait()
	end
	if not live(b) then
		return
	end
	root.Anchored = false
	snapToGround(b)
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	if hitWall then
		-- rammed the wall: stunned, wide open
		local wallPoint = Vector3.new(root.Position.X, 0.2, root.Position.Z) + dir * 4
		shockwave(wallPoint, 7)
		playSound(root, SOUNDS.Impact, 1, 0.4)
		FxRemote:FireAllClients("Shake", root.Position, 1.2)
		boss.staggerUntil = now() + 1.6
		pose(b, "Flinch", 0.15)
		bodyPose(b, "Stagger", 0.15)
		task.delay(1.6, function()
			if live(b) then
				bossIdleArm(b)
			end
		end)
		return
	end
	bodyPose(b, "Recover", 0.3) -- skids to a stop, winded
	if waitLive(b, 1.1 * m) then
		bossIdleArm(b)
	end
end

-- Shockline: mace into the floor; the stone heaves and erupts along a line
-- toward you (three lines in a fan in phase 2).
local function bossShockline(b, target)
	local tr = target:FindFirstChild("HumanoidRootPart")
	if not tr then
		return
	end
	local m = tempo()
	stopAndFace(b, target)
	-- The line's direction is committed the moment his body starts the windup:
	-- he no longer turns to follow you, and the fissures run where he faced.
	local aim = flat(b.root.CFrame.LookVector)
	aim = aim.Magnitude > 0.1 and aim.Unit or Vector3.new(0, 0, 1)
	tell(b, 0.28)
	playSound(b.root, SOUNDS.Unsheath, 0.9, 0.38)
	if not windup2(b, nil, { "BHeft", "BGather", 0.35 * m }, { "Raise", "Roar", 0.6 * m }, 0) then
		return
	end
	setTrail(b, true)
	stepInto(b, 3, 0.2)
	pose(b, "Mid", 0.06, Enum.EasingStyle.Linear)
	task.delay(0.06, function()
		pose(b, "Strike", 0.08)
		bodyPose(b, "BSlamDrive", 0.12)
	end)
	task.wait(0.13 / SPEED)
	if not live(b) then
		return
	end
	local _, tip = maceEnds(b)
	local origin = tip or (b.root.Position + flat(b.root.CFrame.LookVector).Unit * 15)
	origin = Vector3.new(origin.X, 0.2, origin.Z)
	shockwave(origin, 6)
	playSound(b.root, SOUNDS.Impact, 1, 0.55)
	FxRemote:FireAllClients("Shake", origin, 0.8)
	local fiery = boss.phase2
	local spread = fiery and { -0.38, 0, 0.38 } or { 0 }
	for _, ang in ipairs(spread) do
		local d = CFrame.Angles(0, ang, 0):VectorToWorldSpace(aim)
		for k = 1, 7 do
			local pos = origin + d * (k * 4.6)
			if not inArena(pos) then
				break
			end
			task.delay(k * 0.13, function()
				if boss.gen ~= b.gen then
					return
				end
				groundHeave(pos, 3.4, 0.45)
				task.delay(0.45, function()
					if boss.gen == b.gen and boss.state == "fight" then
						eruption(pos, 3.4, 22, "Medium", fiery)
					end
				end)
			end)
		end
	end
	bodyPose(b, "Recover", 0.5)
	if waitLive(b, 1.1 * m) then
		bossIdleArm(b)
	end
end

-- Phase 2 gap closer: sinks into a deep crouch, then leaps onto where you stood.
local function bossLeap(b, target)
	local tr = target:FindFirstChild("HumanoidRootPart")
	if not tr then
		return
	end
	stopAndFace(b, target)
	tell(b, 0.3)
	if not windup2(b, target, { "BHeft", "BGather", 0.3 }, { "Raise", "Crouch", 0.55 }, 0.85) then
		return
	end
	local landing = tr.Parent and tr.Position or b.root.Position
	landing = Vector3.new(math.clamp(landing.X, -38, 38), 0, math.clamp(landing.Z, 222, 286))
	footDust(b, 1, 8)
	footDust(b, -1, 8)
	setTrail(b, true)
	pose(b, "Strike", 0.8)
	bodyPose(b, "Air", 0.15)
	leapTo(b, landing, 0.9, 38)
	if not live(b) then
		return
	end
	bodyPose(b, "Strike", 0.06)
	-- (no fire patch on landing: it burned the spot under him right in the punish window)
	b.root.Anchored = false
	snapToGround(b)
	pcall(function()
		b.root:SetNetworkOwner(nil)
	end)
	task.delay(0.25, function()
		if live(b) then
			bodyPose(b, "Recover", 0.4)
		end
	end)
	if waitLive(b, 1.3) then -- landing recovery: punish window
		bossIdleArm(b)
	end
end

-- The delayed blast: he kneels and plants the mace, the floor around him gives way
-- outward to the blast's edge, and the edge itself heaves and spits pebbles - then it
-- all goes off. Run out, or roll as it blows.
--   phase 1: plain stone - dark cracks spreading, dust shaking off the floor, a burst
--            of dust and rubble (radius 15)
--   phase 2: fire - fissures glowing hotter and hotter, the stone blackening, flames
--            gathering on him, a ring of fire (radius 18: 20% wider)
local NOVA_WINDUP = 2.0 / SPEED -- (was 1.7: a beat longer to read it and get clear)
local function bossNova(b)
	local fiery = boss.phase2
	local radius = fiery and 18 or 15
	stopAndFace(b, nil)
	tell(b, 0.25)
	draw(b, "Idle", "Kneel", 0.7)
	playSound(b.root, SOUNDS.Groan, 1, 0.25)
	local ground = Vector3.new(b.root.Position.X, 0.2, b.root.Position.Z)
	local cool, unscorch, gather
	if fiery then
		cool = heatCracks(ground, radius, NOVA_WINDUP)
		unscorch = scorchSpread(ground, radius, NOVA_WINDUP)
		gather = Instance.new("Fire")
		gather.Size = 4
		gather.Heat = 4
		gather.Color = Color3.fromRGB(255, 120, 40)
		gather.SecondaryColor = Color3.fromRGB(120, 30, 5)
		gather.Parent = b.root
		TweenService:Create(gather, TweenInfo.new(NOVA_WINDUP), { Size = 18, Heat = 18 }):Play()
		Debris:AddItem(gather, NOVA_WINDUP + 0.3)
	else
		-- no fire: the stone splits in dark cracks that spread out to the edge, and dust
		-- shakes up off the floor harder and harder
		local cracks = crackLines(Vector3.new(ground.X, ground.Y + 0.04, ground.Z), radius, 10, Color3.fromRGB(24, 22, 20), Enum.Material.Slate, NOVA_WINDUP * 0.7)
		cool = function()
			fadeAway(cracks, 3, 1.5)
		end
		unscorch = function() end
		task.spawn(function()
			for i = 1, 4 do
				if boss.gen ~= b.gen then
					return
				end
				dustCloud(ground + Vector3.new(0, 0.4, 0), radius * (0.25 + i * 0.1), 3 + i)
				task.wait(NOVA_WINDUP / 4)
			end
		end)
	end
	for i = 1, 9 do
		local a = i / 9 * math.pi * 2
		local pos = ground + Vector3.new(math.cos(a), 0, math.sin(a)) * radius * 0.92
		if inArena(pos) then
			groundHeave(pos, 2.6, NOVA_WINDUP)
		end
	end
	local ok = windupTrack(b, NOVA_WINDUP * SPEED, 0, nil) -- windupTrack rescales; the fx above already use the sped-up time
	if gather then
		gather:Destroy()
	end
	cool()
	unscorch()
	if not ok then
		return -- staggered out of it
	end
	bodyPose(b, "Roar", 0.08)
	shockwave(ground, radius)
	for i = 1, 10 do
		local a = i / 10 * math.pi * 2
		local p = ground + Vector3.new(math.cos(a) * radius * 0.6, 2, math.sin(a) * radius * 0.6)
		if fiery then
			burst(p, Color3.fromRGB(255, 120, 40), 18, 1.2, 18)
		else
			burst(p, Color3.fromRGB(96, 90, 82), 16, 1.1, 14)
		end
	end
	if not fiery then
		debrisChunks(ground + Vector3.new(0, 1, 0), 10, 28)
	end
	playSound(b.root, SOUNDS.Impact, 1, 0.35)
	FxRemote:FireAllClients("Shake", ground, 1.5)
	hitOnce(playersInRadius(ground, radius, 14), {}, 40, ground, "Knockdown")
	task.delay(0.4, function()
		if live(b) then
			bodyPose(b, "Recover", 0.5)
		end
	end)
	if waitLive(b, 1.6) then -- spent: big punish window
		bossIdleArm(b)
	end
end

-- Phase 2: slam -> sweep -> backhand, no breathing room until the end.
local function bossString(b, target)
	bossSlam(b, target, { recover = 0.25 })
	if not bossFree(b) then
		return
	end
	bossSweep(b, target, { followUp = true })
end

local function bossPhase2(b)
	boss.phase2 = true
	ReplicatedStorage:SetAttribute("Music", "boss2")
	stopAndFace(b, nil)
	draw(b, "Raise", "Roar", 0.6)
	playSound(b.root, SOUNDS.Groan, 1, 0.28)
	FxRemote:FireAllClients("Shake", b.root.Position, 0.8)
	local weapon = b.model:FindFirstChild("Weapon")
	local head = weapon and weapon:FindFirstChild("Head")
	if head then
		local f = Instance.new("Fire")
		f.Size = 10
		f.Heat = 12
		f.Color = Color3.fromRGB(255, 100, 30)
		f.SecondaryColor = Color3.fromRGB(90, 20, 5)
		f.Parent = head
		local l = Instance.new("PointLight")
		l.Color = Color3.fromRGB(255, 120, 50)
		l.Range = 22
		l.Brightness = 2
		l.Parent = head
	end
	for _, d in ipairs(b.model:GetChildren()) do
		if d.Name == "Eye" and d:IsA("BasePart") then
			d.Color = Color3.fromRGB(255, 60, 20)
		end
	end
	b.hum.WalkSpeed = walkSpeed()
	-- the room answers his roar: the floor heaves, then bursts in a ring around him
	local center = Vector3.new(b.root.Position.X, 0.2, b.root.Position.Z)
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		local pos = center + Vector3.new(math.cos(a), 0, math.sin(a)) * 13
		if inArena(pos) then
			groundHeave(pos, 3.4, 1.2)
			local unscorch = scorchSpread(pos, 3.4, 1.2)
			task.delay(1.2, function()
				unscorch()
				if boss.gen == b.gen and boss.state == "fight" then
					eruption(pos, 3.4, 18, "Medium", true)
				end
			end)
		end
	end
	if waitLive(b, 1.6) then
		bossIdleArm(b)
	end
end

---------------------------------------------------------------------------
-- boss brain
---------------------------------------------------------------------------
-- min/max = distance band (studs). behind = good answer to you being behind it.
-- fast = used to punish you drinking a flask.
local BOSS_MOVES = {
	{ name = "Slam", min = 6, max = 17, weight = 3, cd = 0, fast = false, fn = function(b, t) bossSlam(b, t, { delayed = math.random() < (boss.phase2 and 0.5 or 0.3) }) end },
	{ name = "Sweep", min = 5, max = 21, weight = 3, cd = 0, fast = true, fn = function(b, t) bossSweep(b, t, { followUp = boss.phase2 and math.random() < 0.6 }) end }, -- (the backhand: phase 2 only)
	{ name = "Stomp", min = 0, max = 9, weight = 2, cd = 4, behind = true, fn = function(b) bossStomp(b) end },
	{ name = "Charge", min = 14, max = 42, weight = 3, cd = 6, fast = true, fn = bossCharge },
	{ name = "Shockline", min = 12, max = 50, weight = 2, cd = 7, fn = bossShockline },
	{ name = "Leap", min = 18, max = 70, weight = 3, cd = 9, phase2 = true, fn = bossLeap },
	{ name = "Nova", min = 0, max = 12, weight = 2, cd = 12, behind = true, fn = function(b) bossNova(b) end }, -- (both phases: fire only in phase 2)
	{ name = "String", min = 6, max = 15, weight = 2, cd = 8, phase2 = true, fn = bossString },
}

local function pickMove(dist, behind, healing)
	local list, total = {}, 0
	local t = now()
	for _, mv in ipairs(BOSS_MOVES) do
		if (not mv.phase2 or boss.phase2) and dist >= mv.min and dist <= mv.max and t >= (boss.cd[mv.name] or 0) then
			local w = mv.weight
			if behind then
				w *= mv.behind and 4 or 0.3
			end
			if healing and mv.fast then
				w *= 4
			end
			if mv.name == boss.lastMove then
				w *= 0.25 -- avoid repeating itself
			end
			total += w
			table.insert(list, { mv, w })
		end
	end
	if total <= 0 then
		return nil
	end
	local r = math.random() * total
	for _, e in ipairs(list) do
		r -= e[2]
		if r <= 0 then
			return e[1]
		end
	end
	return list[#list][1]
end

local function bossTarget(b)
	local best, bestD, bestPl
	for _, pl in ipairs(Players:GetPlayers()) do
		local char, _, hrp = aliveChar(pl)
		if char and hrp.Position.Z > 214 then
			local d = flat(hrp.Position - b.root.Position).Magnitude
			if not bestD or d < bestD then
				best, bestD, bestPl = char, d, pl
			end
		end
	end
	return best, bestPl
end

-- between attacks it circles you, always facing you
local function stalk(b, tr)
	local rel = flat(b.root.Position - tr.Position)
	if rel.Magnitude < 0.1 then
		return
	end
	local keep = math.clamp(rel.Magnitude, 9, 16)
	local around = CFrame.Angles(0, boss.stalkSide * 0.55, 0):VectorToWorldSpace(rel.Unit) * keep
	b.hum.WalkSpeed = walkSpeed() * 0.7 -- circles with a heavier, slower step than when he closes in
	b.hum:MoveTo(tr.Position + around)
	boss.faceAt = tr
end

bossAI = function(b)
	boss.cd = boss.cd or {}
	boss.stalkUntil = 0
	boss.stalkSide = 1
	-- Between moves he turns to face you every frame (the brain only decides ten times a
	-- second, which turned him in visible steps). Moves do their own turning: faceAt = nil.
	boss.faceAt = nil
	local turner = RunService.Heartbeat:Connect(function(dt)
		local tr = boss.faceAt
		if tr and tr.Parent and live(b) and now() >= (boss.staggerUntil or 0) and not b.root.Anchored then
			turnTowards(b.root, tr.Position, turnRate() * dt)
		end
	end)
	while live(b) do
		task.wait(0.1)
		if not live(b) then
			break
		end
		if now() < (boss.staggerUntil or 0) then
			continue
		end
		b.hum.AutoRotate = false
		local target, targetPlayer = bossTarget(b)
		if not target then
			b.hum:MoveTo(b.root.Position)
			continue
		end
		if not boss.phase2 and b.hum.Health <= b.hum.MaxHealth * 0.7 then
			bossPhase2(b)
			boss.stalkUntil = now() + 0.3
			continue
		end
		local tr = target:FindFirstChild("HumanoidRootPart")
		if not tr then
			continue
		end
		local rel = flat(tr.Position - b.root.Position)
		local dist = rel.Magnitude
		local facing = dist > 0.1 and flat(b.root.CFrame.LookVector).Unit:Dot(rel.Unit) or 1
		local behind = facing < -0.15
		local st = states[targetPlayer]
		local healing = st and st.healing

		-- breathing room after an attack (cut short if you heal or get behind it)
		if now() < boss.stalkUntil and not healing and not behind then
			stalk(b, tr)
			continue
		end

		local mv = pickMove(dist, behind, healing)
		if mv then
			boss.faceAt = nil
			b.hum.WalkSpeed = walkSpeed()
			boss.lastMove = mv.name
			boss.cd[mv.name] = now() + mv.cd
			local ok, err = pcall(mv.fn, b, target)
			if not ok then
				warn("[DGUS] boss move " .. mv.name .. " error: " .. tostring(err))
			end
			if Config.Debug then
				print("[Boss] " .. mv.name)
			end
			boss.stalkSide = math.random() < 0.5 and -1 or 1
			boss.stalkUntil = now() + (boss.phase2 and rand(0.11, 0.45) or rand(0.26, 0.83)) + (Config.Boss.IdleExtra or 0) -- (25% shorter than it was)
		elseif dist < 7 then
			-- you're hugging it and its close-range tools are on cooldown: back off to make room
			b.hum.WalkSpeed = walkSpeed() * 0.8
			b.hum:MoveTo(b.root.Position - rel.Unit * 8)
			boss.faceAt = tr
		else
			-- nothing in range: close in, turning as it walks
			b.hum.WalkSpeed = walkSpeed()
			b.hum:MoveTo(tr.Position)
			boss.faceAt = tr
		end
	end
	boss.faceAt = nil
	turner:Disconnect()
end

local function onBossDied(b)
	if boss.gen ~= b.gen or boss.state == "dead" then
		return
	end
	boss.state = "dead"
	ReplicatedStorage:SetAttribute("BossActive", false)
	ReplicatedStorage:SetAttribute("Music", "victory")
	FxRemote:FireAllClients("Banner", "WARDEN FELLED", "Victory")
	dropSplinter(b.root.Position, b.model)
	playSound(b.root, SOUNDS.Groan, 1, 0.22)
	for _, d in ipairs(b.model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	task.spawn(function()
		for _ = 1, 6 do
			if b.root.Parent then
				burst(b.root.Position + Vector3.new(math.random(-4, 4), math.random(-4, 6), math.random(-4, 4)), Color3.fromRGB(70, 66, 60), 40, 1, 10)
			end
			task.wait(0.35)
		end
		for _, d in ipairs(b.model:GetDescendants()) do
			if d:IsA("BasePart") then
				TweenService:Create(d, TweenInfo.new(2), { Transparency = 1 }):Play()
			end
		end
		task.wait(2.2)
		b.model:Destroy()
	end)
	-- the fog lifts and the way onward opens
	TweenService:Create(Map.Fog, TweenInfo.new(2), { Transparency = 1 }):Play()
	Map.Fog.CanCollide = false
	Map.FogPrompt.Enabled = false
	local pe = Map.Fog:FindFirstChildOfClass("ParticleEmitter")
	if pe then
		pe.Enabled = false
	end
	TweenService:Create(Map.ExitDoor, TweenInfo.new(4, Enum.EasingStyle.Sine), { CFrame = Map.ExitDoor.CFrame + Vector3.new(0, 15.5, 0) }):Play()
	local glow = Map.ExitLight:FindFirstChildOfClass("PointLight")
	if glow then
		glow.Enabled = true
	end
	-- the veil of light behind the door thins away: the Ruined Township lies beyond
	task.delay(3.5, function()
		TweenService:Create(Map.ExitLight, TweenInfo.new(2.5), { Transparency = 1 }):Play()
		Map.ExitLight.CanCollide = false
		Map.ExitLight.CanQuery = false
	end)
end

local function spawnBoss()
	boss.gen += 1
	local model, hum, weld = makeRig("Warden", "Warden", BOSS_SCALE, "Mace")
	if not model then
		return
	end
	hum.MaxHealth = Config.Boss.HP
	hum.Health = Config.Boss.HP
	hum.WalkSpeed = walkSpeed()
	hum.BreakJointsOnDeath = false
	model:SetAttribute("Radius", 3.6)
	model:SetAttribute("Boss", true)
	local root = model:FindFirstChild("HumanoidRootPart")
	model:PivotTo(Map.BossHome + Vector3.new(0, 3 * BOSS_SCALE - 3, 0))
	-- Pinned (anchored) at his exact standing height while dormant: left to physics, a rig
	-- that isn't moving slowly sinks, and every correction of that jittered on the client.
	-- (The intro's leap carries him from here and lets him go when he lands.)
	root.Anchored = true
	root.AssemblyLinearVelocity = Vector3.zero
	hum.AutoRotate = false
	hum:MoveTo(root.Position)
	pcall(function()
		root:SetNetworkOwner(nil)
		hum:ChangeState(Enum.HumanoidStateType.Running) -- standing, as after the intro leap (snapToGround)
	end)
	local shoulder = findShoulder(model)
	boss.model, boss.hum, boss.root, boss.weld = model, hum, root, weld
	boss.shoulder, boss.c0 = shoulder, shoulder and shoulder.C0
	boss.phase2 = false
	boss.leapReady = 0
	boss.stompReady = 0
	boss.staggerUntil = 0
	boss.poise = nil
	boss.cd = {}
	boss.lastMove = nil
	boss.stalkUntil = 0
	boss.stalkSide = 1
	boss.state = "dormant"
	root.CollisionGroup = "EnemyRoot"
	local b = snapBoss()
	boss.current = b
	ReplicatedStorage:SetAttribute("BossMaxHP", hum.MaxHealth)
	ReplicatedStorage:SetAttribute("BossHP", hum.Health)
	hum.HealthChanged:Connect(function(h)
		if boss.gen == b.gen then
			ReplicatedStorage:SetAttribute("BossHP", math.max(0, h))
		end
	end)
	hum.Died:Connect(function()
		onBossDied(b)
	end)
end

local function startBoss()
	if boss.state ~= "dormant" then
		return
	end
	boss.state = "intro"
	local b = snapBoss()
	ReplicatedStorage:SetAttribute("BossName", Config.Boss.Name)
	ReplicatedStorage:SetAttribute("BossMaxHP", b.hum.MaxHealth) -- (Oculast shares this bar)
	ReplicatedStorage:SetAttribute("BossHP", b.hum.Health)
	ReplicatedStorage:SetAttribute("BossActive", true)
	ReplicatedStorage:SetAttribute("Music", "boss")
	task.spawn(function()
		-- wakes, rears up and roars, then drops into a crouch and leaps down to you
		playSound(b.root, SOUNDS.Groan, 1, 0.3)
		pose(b, "Raise", 0.6)
		bodyPose(b, "Roar", 0.6)
		task.wait(1.2)
		if boss.gen ~= b.gen or boss.state ~= "intro" then
			return
		end
		bodyPose(b, "Crouch", 0.35)
		task.wait(0.4)
		footDust(b, 1, 8)
		footDust(b, -1, 8)
		bodyPose(b, "Air", 0.15)
		leapTo(b, Vector3.new(0, 0, 262), 1.0, nil)
		if boss.gen ~= b.gen or boss.state ~= "intro" then
			return
		end
		bodyPose(b, "Strike", 0.08)
		b.root.Anchored = false
		snapToGround(b)
		pcall(function()
			b.root:SetNetworkOwner(nil)
		end)
		bossIdleArm(b)
		boss.state = "fight"
		task.wait(0.6)
		bossAI(b)
	end)
end

local function resetBoss()
	if boss.state == "dead" or boss.state == "dormant" then
		return
	end
	if boss.model then
		boss.model:Destroy()
	end
	ReplicatedStorage:SetAttribute("BossActive", false)
	ReplicatedStorage:SetAttribute("Music", "none")
	spawnBoss()
end

local function anyoneAliveInArena()
	for _, pl in ipairs(Players:GetPlayers()) do
		local char, _, hrp = aliveChar(pl)
		if char and hrp.Position.Z > 214 then
			return true
		end
	end
	return false
end

function M.init(core)
	Map, EnemiesFolder, FxRemote, states, now, flat, rand, turnTowards, SOUNDS, playSound, burst, fxAnchor, dustCloud, crackLines, fadeAway, shockwave, groundHeave, debrisChunks, SMOKE, SPARK, pose, bodyPose, setTrail, makeRig, findShoulder, aliveChar, damagePlayer, playersInRadius = core.Map, core.EnemiesFolder, core.FxRemote, core.states, core.now, core.flat, core.rand, core.turnTowards, core.SOUNDS, core.playSound, core.burst, core.fxAnchor, core.dustCloud, core.crackLines, core.fadeAway, core.shockwave, core.groundHeave, core.debrisChunks, core.SMOKE, core.SPARK, core.pose, core.bodyPose, core.setTrail, core.makeRig, core.findShoulder, core.aliveChar, core.damagePlayer, core.playersInRadius
	local rawPose, rawBodyPose = pose, bodyPose
	pose = function(b, name, t, ...)
		return rawPose(b, name, t / SPEED, ...)
	end
	bodyPose = function(b, name, t, ...)
		return rawBodyPose(b, name, (t or 0.2) / SPEED, ...)
	end
	dropSplinter = core.dropSplinter
	-- hits on the Warden: his poise breaks into a big stagger (cancels a wind-up)
	core.registerTarget(function(model)
		if boss.model ~= model or not boss.model then
			return nil
		end
		return {
			owner = boss,
			actor = boss.current,
			maxPoise = Config.Boss.Poise,
			freeze = false,
			onBreak = function(player, t)
				if boss.state ~= "fight" then
					return
				end
				local actor = boss.current
				local root = boss.root
				boss.staggerUntil = t + Config.Boss.Stagger
				setTrail(actor, false)
				pose(actor, "Flinch", 0.15)
				bodyPose(actor, "Stagger", 0.12) -- reels back, wide open
				boss.hum:MoveTo(root.Position)
				playSound(root, SOUNDS.Groan, 0.9, 0.5)
				FxRemote:FireAllClients("Shake", root.Position, 0.5)
				local gen = boss.gen
				task.delay(Config.Boss.Stagger, function()
					if boss.gen == gen and boss.state == "fight" then
						pose(actor, "Idle", 0.3)
					end
				end)
			end,
		}
	end)
end

M.spawn = function()
	spawnBoss()
end
M.start = function()
	startBoss()
end
M.reset = function()
	resetBoss()
end
M.state = function()
	return boss.state
end
M.isDead = function()
	return boss.state == "dead"
end
M.model = function()
	return boss.model
end
M.anyoneInArena = anyoneAliveInArena

return M
