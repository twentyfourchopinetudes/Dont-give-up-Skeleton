			<Item class="Script" referent="RBX00000026">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- Overrides the default regen script: no passive healing. Drink from your flask.
]]></ProtectedString>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<token name="RunContext">0</token>
					<string name="ScriptGuid">{81DCD6E2-0800-4F0C-98A2-D51515BBC08E}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Health</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">37103886d8e24c800aefca76000003f6</UniqueId>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX00000027">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- Overrides Roblox's default Animate script: the Puppeteer animates every character.
]]></ProtectedString>
