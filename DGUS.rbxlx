					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Herald</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">9a8d0da1d40b4ff28bbae237149b0ca6</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX93CC4355B50E4C819697CEE6A360AD8B">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE DOWAGER (kind Dowager): a very old lady in a very large gown, who has not missed a ball in three hundred years and sees no reason
-- to start. Tier on tier of lapis silk over a hooped skirt, a standing lace collar, a black veil over no face at all, a tower
-- of hair stuck through with gold. She glides; you never see her feet. A long hatpin in each hand.
--   The Waltz   arms out, spinning, gown belling out, coming at you in sweeping curves. She gets dizzy after: your opening
--   Pins        one, then the other, down from over her shoulder
--   Curtsey     she sinks right down... and comes up under you, both pins upward. Don't stand and watch her bow
--   Hatpins     from further off: a pin drawn out of her hair and thrown, then another, and they bend after you
local K = require(script.Parent.Parent:WaitForChild("GildedKit"))
local M = K.wrap({
	Poses = {
		DWBGlide = { drop = 0.05, lean = 0.05, head = 0.1, footR = -0.1, footL = 0.1, spread = 0.04, breathe = 0.4, freeL = 0 },
		DWBCurtsey = { drop = 1.5, lean = 0.3, head = 0.45, footR = 0.5, footL = -0.9, spread = 0.2, freeL = 0, breathe = 0.5 },
		DWBRise = { drop = -0.05, lean = -0.3, head = -0.4, footR = -0.1, footL = 0.1, freeL = 0 },
	},
	Grips = {
		DWRest = { Vector3.new(1.2, 0.1, -0.7), CFrame.Angles(math.rad(35), 0, 0) },
		DWUp = { Vector3.new(0.8, 2.5, -1.1), CFrame.Angles(math.rad(165), 0, 0) },
		DWOut = { Vector3.new(2.3, 0.9, 0), CFrame.Angles(0, 0, math.rad(82)) },
		DWDown = { Vector3.new(0.9, 0.3, -1.3), CFrame.Angles(math.rad(45), 0, 0) },
	},
})
M.Kind = "Dowager"
M.Proportions = { girth = 0.86, arm = 1.05, hunch = 0.14 }
M.IdlePose = "DWBGlide"
M.BodyFor = { DWRest = "DWBGlide" }
local SILK, SILK_DK, LACE, BLACK = Color3.fromRGB(64, 104, 196), Color3.fromRGB(40, 72, 150), Color3.fromRGB(226, 220, 204), Color3.fromRGB(16, 14, 22)
M.Colors = { skin = BLACK, torso = SILK, legs = SILK, arms = SILK }

function M.Look(k)
	local deco, parts, V, at, rgb, MAT = k.deco, k.parts, k.V, k.at, k.rgb, k.MAT
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	-- THE GOWN: stacked hoops getting wider down to the floor, a gold band on each, hiding her legs altogether
	for i = 0, 5 do
		local d = 2.2 + i * 0.62
		deco("Hips", "Gown", V(0.58, d, d), at(0, 0.05 - i * 0.48, 0.04) * K.UP, i % 2 == 0 and SILK or SILK_DK, MAT.Fabric, Enum.PartType.Cylinder)
		deco("Hips", "GownBand", V(0.08, d + 0.06, d + 0.06), at(0, -0.2 - i * 0.48, 0.04) * K.UP, K.GOLD, MAT.Metal, Enum.PartType.Cylinder)
	end
	for i = 0, 7 do
		local a = i * math.pi / 4
		deco("Hips", "Bow", V(0.3, 0.26, 0.14), at(math.cos(a) * 2.45, -2.38, math.sin(a) * 2.45 + 0.04) * CFrame.Angles(0, -a + math.pi / 2, 0), K.GOLD, MAT.Fabric)
	end
	for _, n in ipairs({ "R", "L" }) do
		for _, pn in ipairs({ "Thigh", "Shin", "Foot" }) do
			parts[n .. pn].Transparency = 1
		end
	end
	-- the bodice, corseted, a lace stomacher; lace standing up behind her head
	deco("Chest", "Bodice", V(cw * 0.96, ch * 0.98, cd * 1.04), at(0, 0, 0), SILK, MAT.Fabric)
	deco("Chest", "Stomacher", V(cw * 0.42, ch * 0.86, 0.06), at(0, -0.04, -cd * 0.54), LACE, MAT.Fabric)
	for i = 0, 4 do
		deco("Chest", "Lacing", V(cw * 0.3, 0.05, 0.04), at(0, ch * (0.3 - i * 0.15), -cd * 0.58), K.GOLD, MAT.Metal)
	end
	for i = -3, 3 do
		deco("Chest", "CollarFan", V(0.26, 1.2 - math.abs(i) * 0.08, 0.05), at(i * 0.26, ch * 0.5 + 0.55, cd * 0.34) * CFrame.Angles(-0.25, 0, -i * 0.18), LACE, MAT.Fabric)
	end
	deco("Chest", "Necklace", V(0.08, 0.72, 0.72), at(0, ch * 0.42, -cd * 0.3) * CFrame.Angles(0.4, math.pi / 2, 0), K.LIGHT, MAT.Neon, Enum.PartType.Cylinder)
	-- THE VEIL over no face, a tower of grey hair over it, gold pins stuck through
	parts.Head.Color = BLACK
	local veil = deco("Head", "Veil", V(1.32, 1.55, 1.32), at(0, -0.08, 0), BLACK, MAT.Fabric)
	veil.Transparency = 0.12
	for _, sx in ipairs({ -1, 1 }) do
		deco("Head", "Eye", V(0.1, 0.05, 0.03), at(sx * 0.24, 0.1, -0.67), K.LIGHT, MAT.Neon)
	end
	for i = 0, 4 do
		local d = 1.28 - i * 0.2
		deco("Head", "Hair", V(d, 0.46, d), at(0, 0.82 + i * 0.36, 0.04 + i * 0.03) * CFrame.Angles(0, i * 0.6, 0), rgb(164, 160, 158), MAT.Sand, Enum.PartType.Ball)
	end
	deco("Head", "HairPin", V(0.06, 0.06, 1.6), at(0, 1.25, 0.05) * CFrame.Angles(0, 0.8, 0.2), K.GOLD, MAT.Metal)
	deco("Head", "HairPin", V(0.06, 0.06, 1.3), at(0, 1.7, 0.05) * CFrame.Angles(0, -0.7, -0.2), K.GOLD, MAT.Metal)
	deco("Head", "Tiara", V(0.2, 1.1, 1.1), at(0, 0.72, 0) * K.UP, K.GOLD, MAT.Metal, Enum.PartType.Cylinder)
	-- long gloves
	for _, n in ipairs({ "R", "L" }) do
		deco(n .. "LowerArm", "Glove", V(aw * 1.02, la * 1.1, aw * 1.02), at(0, -0.05, 0), LACE, MAT.Fabric)
		deco(n .. "UpperArm", "Puff", V(aw * 1.7, ua * 0.6, aw * 1.7), at(0, ua * 0.18, 0), SILK_DK, MAT.Fabric, Enum.PartType.Ball)
		deco(n .. "UpperArm", "PuffBand", V(aw * 1.4, 0.12, aw * 1.4), at(0, -ua * 0.15, 0), K.GOLD, MAT.Metal)
	end
end

M.Weapons = {
	Hatpin = function(w)
		local handle = w.mk("Grip", Vector3.new(0.14, 0.5, 0.14), K.GOLD, Enum.Material.Metal)
		local bead = w.mk("Pearl", Vector3.new(0.42, 0.42, 0.42), K.PORCELAIN, Enum.Material.SmoothPlastic)
		bead.Shape = Enum.PartType.Ball
		w.add(bead, 0.38)
		w.add(w.mk("Pin", Vector3.new(0.06, 3.6, 0.06), Color3.fromRGB(224, 200, 130), Enum.Material.Metal), -2)
		return { handle = handle, bladeLen = 3.8 }
	end,
}

M.Def = K.def({
	HP = 440, Speed = 11.5, Scale = 1.2, Damage = 30, Range = 8, HalfAngle = 45, Lunge = 9, Poise = 55, Stagger = 0.45, StaggerPush = 8,
	Windup = 0.6, Recover = 0.8, Engage = 18, Close = 7, Weapon = "Hatpin", Weapon2 = "Hatpin", IdleGrip = "DWRest", Radius = 1.9, Skin = K.LAPIS, Cloth = K.LAPIS,
})

local function curtsey(e, tRoot)
	K.strike(e, tRoot, {
		set = "DWRest", setBody = "DWBCurtsey", tell = 1.05, swing = "DWUp", swingBody = "DWBRise", time = 0.12,
		range = 9, half = 100, damage = 46, level = "Knockdown", lunge = 2, speed = 0.9,
	})
	return e.alive
end

local function hatpins(e, tRoot)
	K.setGrip(e, "DWUp", 0.4)
	K.setBody(e, "GBSet", 0.4)
	if not K.hold(e, 0.55, tRoot) then
		return false
	end
	for i = 1, 2 do
		if not (e.alive and tRoot.Parent) then
			return false
		end
		K.setGrip(e, "DWDown", 0.1)
		K.setBody(e, "GBFling", 0.1)
		K.sound(e, "Lunge", 0.5, 1.5)
		local from = K.hand(e)
		K.shot(e, {
			from = from, vel = K.aim(from, tRoot, 95, 0.2), damage = 22, level = "Small", radius = 1.2, life = 1.4,
			size = Vector3.new(0.1, 0.1, 1.6), shape = Enum.PartType.Block, color = K.GOLD, trail = K.LIGHT, home = 1.2, homeOn = tRoot,
		})
		if i == 1 then
			K.setGrip(e, "DWUp", 0.2)
			if not K.hold(e, 0.32, tRoot) then
				return false
			end
		end
	end
	return K.hold(e, 0.35, tRoot)
end

M.attack = K.brain(function(e, tRoot, d)
	local roll = math.random()
	if d > e.def.Close and roll < 0.45 then
		return hatpins(e, tRoot), 1
	elseif d > e.def.Close or roll < 0.4 then
		return K.whirl(e, tRoot, { grip = "DWOut", body = "GBSpin", wind = 0.65, time = 2.3, radius = 6.5, damage = 20, every = 0.5, speed = 10, turn = 15 }), 1.5
	elseif roll < 0.72 then
		return K.combo(e, tRoot, {
			{ set = "DWUp", setBody = "GBSet", tell = 0.55, swing = "DWDown", swingBody = "GBStrike", time = 0.12, damage = 26, level = "Medium", speed = 1.1 },
			{ set = "DWUp", setBody = "GBSet", tell = 0.32, swing = "DWDown", swingBody = "GBStrike", time = 0.12, damage = 32, level = "Large", speed = 0.95, quiet = true },
		}), 0.9
	end
	return curtsey(e, tRoot), 1.2
end)

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Dowager</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">a9bc1d79e4694b368c89a26fbb2895ae</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX955CFC5E1BCB4A9CAC5406BAE753960F">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- GILT HALBERDIER (kind GiltHalberdier): the palace guard, long after there was anyone inside the armour. A suit of gilded plate with
-- nothing in it but a little dust, a tall crimson plume, a crimson tabard with the sun on it, and an eight-foot halberd held
-- at exact regulation. Nothing about it hurries.
--   Sweep    the whole length of it swung flat, a wide arc: roll inside it
--   Thrust   drawn back, then a long straight lunge: step off the line
--   Bash     up close, the butt of the haft into your teeth
local K = require(script.Parent.Parent:WaitForChild("GildedKit"))
local M = K.wrap({
	Poses = { GHBStand = { drop = 0.05, lean = -0.02, head = 0.05, footR = -0.1, footL = 0.1, spread = 0.05, breathe = 0.3, la1 = 0.1, la3 = -0.15, lel = 0.2, freeL = 0 } },
	Grips = { GHAttention = { Vector3.new(1.05, 0.5, -0.5), CFrame.Angles(math.rad(176), 0, math.rad(-3)) } },
})
M.Kind = "GiltHalberdier"
M.Proportions = { girth = 1.08, arm = 1.05, hunch = 0 }
M.IdlePose = "GHBStand"
M.BodyFor = { GHAttention = "GHBStand" }
local GOLD, DARK, CAPE = K.GOLD, K.TARNISH, K.RUG
M.Colors = { skin = K.INK, torso = GOLD, legs = DARK, arms = GOLD }

function M.Look(k)
	local deco, parts, V, at, rgb, MAT = k.deco, k.parts, k.V, k.at, k.rgb, k.MAT
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	-- THE HELM: a tall closed sallet, a barred visor with nothing behind it, the plume standing high
	parts.Head.Transparency = 1
	deco("Head", "Helm", V(1.25, 1.35, 1.35), at(0, 0.1, 0.02), GOLD, MAT.Metal)
	deco("Head", "HelmPeak", V(0.2, 0.55, 1.15), at(0, 0.95, 0), DARK, MAT.Metal)
	deco("Head", "Visor", V(0.95, 0.45, 0.06), at(0, 0.12, -0.7), K.INK, MAT.SmoothPlastic)
	for i = -2, 2 do
		deco("Head", "VisorBar", V(0.07, 0.5, 0.07), at(i * 0.18, 0.12, -0.74), GOLD, MAT.Metal)
	end
	for i = 0, 5 do
		deco("Head", "Plume", V(0.3, 0.55 - i * 0.04, 0.42), at(0, 1.3 + i * 0.3, 0.05 + i * i * 0.05) * CFrame.Angles(-0.2 - i * 0.14, 0, 0), CAPE, MAT.Fabric)
	end
	-- the breastplate, its gorget and the tabard over it, sun and all
	deco("Chest", "Breast", V(cw * 1.04, ch * 0.9, cd * 1.1), at(0, 0.05, 0), GOLD, MAT.Metal)
	deco("Chest", "Gorget", V(cw * 0.6, 0.34, cd * 1.15), at(0, ch / 2, 0), DARK, MAT.Metal)
	deco("Chest", "Tabard", V(cw * 0.56, ch * 0.92, 0.07), at(0, -0.02, -cd * 0.58), CAPE, MAT.Fabric)
	deco("Chest", "TabardSun", V(0.06, 0.62, 0.62), at(0, 0.18, -cd * 0.62) * K.FACE, K.LIGHT, MAT.Metal, Enum.PartType.Cylinder)
	deco("Hips", "TabardLow", V(hw * 0.62, 2.1, 0.07), at(0, -0.85, -hd * 0.62), CAPE, MAT.Fabric)
	deco("Hips", "TabardBack", V(hw * 0.62, 2.1, 0.07), at(0, -0.85, hd * 0.62), CAPE, MAT.Fabric)
	deco("Hips", "Fauld", V(hw * 1.15, 0.75, hd * 1.2), at(0, -0.1, 0), DARK, MAT.Metal)
	deco("Hips", "Belt", V(hw * 1.22, 0.2, hd * 1.26), at(0, 0.28, 0), GOLD, MAT.Metal)
	for _, n in ipairs({ "R", "L" }) do
		local sx = n == "R" and 1 or -1
		deco(n .. "UpperArm", "Pauldron", V(aw * 1.9, 0.55, aw * 1.8), at(sx * 0.1, ua / 2 - 0.1, 0) * CFrame.Angles(0, 0, -sx * 0.3), GOLD, MAT.Metal)
		deco(n .. "UpperArm", "PauldronLame", V(aw * 1.7, 0.18, aw * 1.6), at(sx * 0.08, ua / 2 - 0.45, 0) * CFrame.Angles(0, 0, -sx * 0.2), DARK, MAT.Metal)
		deco(n .. "LowerArm", "Vambrace", V(aw * 1.18, la * 0.72, aw * 1.18), at(0, -0.05, 0), GOLD, MAT.Metal)
		deco(n .. "Thigh", "Cuisse", V(lw * 1.16, 0.85, lw * 1.16), at(0, 0.05, 0), GOLD, MAT.Metal)
		deco(n .. "Shin", "Greave", V(lw * 1.14, 0.8, lw * 1.14), at(0, -0.1, 0), GOLD, MAT.Metal)
		deco(n .. "Shin", "Poleyn", V(lw * 1.25, 0.34, lw * 1.3), at(0, 0.5, -0.05), DARK, MAT.Metal)
		deco(n .. "Foot", "Sabaton", V(0.7, 0.3, 1.15), at(0, 0.02, -0.05), DARK, MAT.Metal)
	end
end

M.Weapons = {
	-- a long ash haft, gold-bound; a broad axe blade, a hook behind it, a spike along the top
	GiltHalberd = function(w)
		local gold, steel = K.GOLD, Color3.fromRGB(176, 170, 150)
		local handle = w.mk("Grip", Vector3.new(0.24, 1.1, 0.24), K.RUG, Enum.Material.Fabric)
		w.add(w.mk("Haft", Vector3.new(0.2, 7.2, 0.2), Color3.fromRGB(80, 58, 38), Enum.Material.Wood), -2.2)
		w.add(w.mk("Butt", Vector3.new(0.3, 0.8, 0.3), gold, Enum.Material.Metal), 1.5)
		w.add(w.mk("Band", Vector3.new(0.28, 0.2, 0.28), gold, Enum.Material.Metal), -1)
		w.add(w.mk("Socket", Vector3.new(0.34, 1.3, 0.34), gold, Enum.Material.Metal), -5.5)
		w.add(w.mk("Blade", Vector3.new(0.12, 1.9, 1.5), steel, Enum.Material.Metal), -5.6, nil, -0.75)
		w.add(w.mk("BladeEdge", Vector3.new(0.14, 2.1, 0.22), gold, Enum.Material.Metal), -5.6, nil, -1.55)
		w.add(w.mk("Hook", Vector3.new(0.12, 0.5, 0.95), steel, Enum.Material.Metal), -5.6, nil, 0.6)
		w.add(w.mk("Spike", Vector3.new(0.18, 1.6, 0.18), steel, Enum.Material.Metal), -6.9)
		return { handle = handle, bladeLen = 6.8 }
	end,
}

M.Def = K.def({
	HP = 480, Speed = 9.5, Scale = 1.3, Damage = 42, Range = 12, HalfAngle = 75, Lunge = 7, Poise = 80, Stagger = 0.45,
	Engage = 13, Close = 6, Weapon = "GiltHalberd", IdleGrip = "GHAttention", Radius = 1.6, Skin = K.GOLD, Cloth = K.RUG,
})

M.attack = K.brain(function(e, tRoot, d)
	if d < e.def.Close then
		return K.strike(e, tRoot, { set = "GCock", setBody = "GBSet", tell = 0.5, swing = "GSlam", swingBody = "GBStrike", range = 7, half = 60, damage = 28, level = "Medium", speed = 0.9 }), 0.7
	elseif math.random() < 0.5 then
		return K.strike(e, tRoot, { set = "GBack", setBody = "GBWind", tell = 0.95, swing = "GSweep", swingBody = "GBSweep", time = 0.22, range = 12.5, half = 85, lunge = 0.8, speed = 0.6 }), 1.1
	end
	return K.strike(e, tRoot, { set = "GDraw", setBody = "GBDraw", tell = 0.85, swing = "GThrust", swingBody = "GBLunge", time = 0.14, range = 14, half = 16, lunge = 2.4, speed = 0.8 }), 1
end)

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">GiltHalberdier</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">d4c707e1b36948ba8e326b938ccfa73c</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX99F1A2F6BE21478C883272728734EB4D">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE LAMPLIGHTER (kind Lamplighter): the thin man who went round the Heights at dusk, still going round. Absurdly tall and stooped, a
-- stovepipe hat, a long black coat, hands gone to wax and running down its own pole. On the pole's end hangs a lantern with
-- something living in it: the light's the wrong colour, and it pulls toward you.
--   Trim the Wick   the lantern lifted high, brightening, and then all that light let go in a burst around it. Get clear
--   The Hook        the long pole lashed at you, a jab from further than you'd think
--   Moth            flung out at you, a mote of the light, drifting after you until it finds you or gutters
local K = require(script.Parent.Parent:WaitForChild("GildedKit"))
local M = K.wrap({
	Poses = { LLBStoop = { drop = 0.08, lean = 0.28, head = 0.28, footR = -0.2, footL = 0.25, breathe = 0.8, la1 = 0.35, la3 = -0.4, lel = 1.2, freeL = 0 } },
	Grips = { LLCarry = { Vector3.new(1.1, 0.3, -0.5), CFrame.Angles(math.rad(150), 0, 0) } },
})
M.Kind = "Lamplighter"
M.Proportions = { girth = 0.78, arm = 1.3, hunch = 0.26 }
M.IdlePose = "LLBStoop"
M.BodyFor = { LLCarry = "LLBStoop" }
local COAT, COAT_LT, WAX, FLAME = Color3.fromRGB(28, 26, 34), Color3.fromRGB(46, 44, 56), Color3.fromRGB(226, 214, 180), Color3.fromRGB(180, 240, 210)
M.Colors = { skin = WAX, torso = COAT, legs = COAT, arms = COAT }

function M.Look(k)
	local deco, parts, V, at, rgb, MAT = k.deco, k.parts, k.V, k.at, k.rgb, k.MAT
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	local rng = Random.new()
	-- a long melted face under a tall stovepipe hat
	parts.Head.Material = MAT.SmoothPlastic
	deco("Head", "Jaw", V(0.8, 1.2, 0.8), at(0, -0.55, -0.12), WAX, MAT.SmoothPlastic)
	for i = 0, 3 do
		deco("Head", "Drip", V(0.12, rng:NextNumber(0.35, 0.95), 0.12), at(-0.34 + i * 0.22, -0.92, -0.42), WAX, MAT.SmoothPlastic)
	end
	for _, sx in ipairs({ -1, 1 }) do
		deco("Head", "Eye", V(0.17, 0.26, 0.05), at(sx * 0.25, 0.08, -0.6), K.INK, MAT.SmoothPlastic)
		deco("Head", "Pupil", V(0.05, 0.05, 0.04), at(sx * 0.25, 0.06, -0.63), FLAME, MAT.Neon)
	end
	deco("Head", "Brim", V(0.12, 2.1, 2.1), at(0, 0.62, 0) * K.UP, COAT, MAT.Fabric, Enum.PartType.Cylinder)
	deco("Head", "Crown", V(1.95, 1.32, 1.32), at(0, 1.58, 0.05) * K.UP * CFrame.Angles(0.04, 0, 0), COAT, MAT.Fabric, Enum.PartType.Cylinder)
	deco("Head", "HatBand", V(0.24, 1.36, 1.36), at(0, 0.82, 0.02) * K.UP, K.TARNISH, MAT.Fabric, Enum.PartType.Cylinder)
	-- the long coat, its tails almost to the floor; brass buttons; a rack of spare wicks across its chest
	deco("Chest", "Coat", V(cw * 1.1, ch * 1.02, cd * 1.15), at(0, 0, 0.02), COAT, MAT.Fabric)
	deco("Chest", "Lapel", V(0.36, ch * 0.75, 0.05), at(-cw * 0.2, 0.12, -cd * 0.6) * CFrame.Angles(0, 0, -0.18), COAT_LT, MAT.Fabric)
	deco("Chest", "Lapel", V(0.36, ch * 0.75, 0.05), at(cw * 0.2, 0.12, -cd * 0.6) * CFrame.Angles(0, 0, 0.18), COAT_LT, MAT.Fabric)
	for i = 0, 3 do
		deco("Chest", "Button", V(0.1, 0.1, 0.05), at(0, ch * (0.2 - i * 0.2), -cd * 0.6), K.GOLD, MAT.Metal, Enum.PartType.Ball)
	end
	for i = 0, 5 do
		deco("Chest", "Wick", V(0.08, 0.5, 0.08), at(-cw * 0.32 + i * cw * 0.13, -ch * 0.3, -cd * 0.62), WAX, MAT.SmoothPlastic)
	end
	k.tatter(rng, "Hips", CFrame.new(-hw * 0.3, 0.1, hd * 0.6), hw * 0.55, 3.1, COAT, COAT_LT, 0.3)
	k.tatter(rng, "Hips", CFrame.new(hw * 0.3, 0.1, hd * 0.6), hw * 0.55, 3.2, COAT, COAT_LT, 0.3)
	deco("Hips", "CoatSkirt", V(hw * 1.15, 1.2, hd * 1.2), at(0, -0.3, 0), COAT, MAT.Fabric)
	deco("Hips", "OilTin", V(0.42, 0.62, 0.42), at(-hw * 0.72, -0.4, 0), K.TARNISH, MAT.Metal, Enum.PartType.Cylinder)
	for _, n in ipairs({ "R", "L" }) do
		deco(n .. "LowerArm", "WaxHand", V(aw * 0.95, 0.6, aw * 0.95), at(0, -la / 2 - 0.1, 0), WAX, MAT.SmoothPlastic)
		deco(n .. "LowerArm", "Drip", V(0.12, 0.7, 0.12), at(aw * 0.3, -la / 2 - 0.55, 0), WAX, MAT.SmoothPlastic)
		deco(n .. "Foot", "Boot", V(0.56, 0.3, 1.2), at(0, 0.02, -0.08), K.INK, MAT.Leather)
	end
end

M.Weapons = {
	-- a long pole, a hook at its top, the lantern swinging from it, and whatever it's got in there
	LamplighterPole = function(w)
		local brass = K.TARNISH
		local handle = w.mk("Grip", Vector3.new(0.2, 1, 0.2), Color3.fromRGB(56, 44, 34), Enum.Material.Wood)
		w.add(w.mk("Pole", Vector3.new(0.17, 6.8, 0.17), Color3.fromRGB(56, 44, 34), Enum.Material.Wood), -2.4)
		w.add(w.mk("Foot", Vector3.new(0.26, 0.5, 0.26), brass, Enum.Material.Metal), 1.1)
		w.add(w.mk("Hook", Vector3.new(0.14, 0.14, 1.1), brass, Enum.Material.Metal), -5.7, nil, -0.5)
		w.add(w.mk("HookTip", Vector3.new(0.14, 0.7, 0.14), brass, Enum.Material.Metal), -5.5, nil, -1)
		w.add(w.mk("LanternCap", Vector3.new(1, 0.3, 1), brass, Enum.Material.Metal), -4.75, nil, -0.95)
		w.add(w.mk("LanternBase", Vector3.new(1, 0.2, 1), brass, Enum.Material.Metal), -3.55, nil, -0.95)
		local glass = w.mk("LanternGlass", Vector3.new(0.82, 1, 0.82), FLAME, Enum.Material.Neon)
		w.add(glass, -4.15, nil, -0.95)
		for _, s in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
			local bar = w.mk("LanternBar", Vector3.new(0.09, 1, 0.09), brass, Enum.Material.Metal)
			w.add(bar, -4.15, CFrame.new(s[1] * 0.42 * w.scale, 0, s[2] * 0.42 * w.scale), -0.95)
		end
		local function setup()
			local l = Instance.new("PointLight")
			l.Name = "WickLight"
			l.Color, l.Range, l.Brightness = FLAME, 13, 1.1
			l.Parent = glass
		end
		return { handle = handle, bladeLen = 6.2, setup = setup }
	end,
}

M.Def = K.def({
	HP = 370, Speed = 9.5, Scale = 1.35, Damage = 34, Range = 12, HalfAngle = 22, Lunge = 6, Poise = 50, Stagger = 0.5, StaggerPush = 10,
	Windup = 0.75, Recover = 1, Engage = 20, Close = 11, Weapon = "LamplighterPole", IdleGrip = "LLCarry", Radius = 1.4, Skin = WAX, Cloth = COAT,
})

local function trim(e, tRoot)
	local glass, light = K.partOf(e, "LanternGlass"), K.partOf(e, "WickLight")
	K.sound(e, "FireHit", 0.3, 0.8)
	K.setBody(e, "GBCast", 0.4)
	K.setGrip(e, "GHigh", 0.4)
	local t0, T = os.clock(), 1.15
	while os.clock() - t0 < T do
		if not K.hold(e, 0.05) then
			if light then
				light.Brightness, light.Range = 1.1, 13
			end
			return false
		end
		local g = (os.clock() - t0) / T
		if light then
			light.Brightness, light.Range = 1.1 + 7 * g, 13 + 24 * g
		end
	end
	if light then
		light.Brightness, light.Range = 1.1, 13
	end
	local at = K.feet(e)
	K.area(at, 10, 6, 34, "Large")
	K.flash(glass and glass.Position or e.root.Position, FLAME, 12)
	K.sound(e, "WatchdogBlast", 0.65, 1.3)
	K.shake(at, 0.35)
	return e.alive
end

M.attack = K.brain(function(e, tRoot, d)
	local roll = math.random()
	if d > e.def.Close then
		K.setGrip(e, "GToss", 0.4)
		K.setBody(e, "GBSet", 0.4)
		if not K.hold(e, 0.7, tRoot) then
			return false
		end
		K.setGrip(e, "GTossed", 0.14)
		local from = (K.partOf(e, "LanternGlass") or e.root).Position
		K.shot(e, { from = from, vel = K.aim(from, tRoot, 20, 0), damage = 22, level = "Medium", radius = 1.8, life = 5, size = Vector3.new(0.8, 0.8, 0.8), color = FLAME, material = Enum.Material.Neon, trail = FLAME, home = 2.2, homeOn = tRoot })
		K.sound(e, "Lunge", 0.6, 1.6)
		return true, 1
	elseif roll < 0.45 then
		return trim(e, tRoot), 1.3
	end
	return K.strike(e, tRoot, { set = "GDraw", setBody = "GBDraw", tell = 0.72, swing = "GThrust", swingBody = "GBLunge", time = 0.12, range = 13, half = 18, lunge = 1.4, damage = 36, speed = 0.9 }), 1
end)

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Lamplighter</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">98275c2bfbbe4d929a11850b33f2e64d</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXA245B43A876743338B560A7C9EB22187">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE OATHSWORN (kind Oathsworn): a knight of the Silver Oath, one of the many the Silver Knight never mentions. The same fluted steel and crimson
-- as Caelen, made plainer for the rank and file and gone dull, half the height of his sword; a white surcoat with the sun on it, torn off
-- at the waist, a crimson half-cape. It fights as he was taught them all to fight. If you've beaten him, you've seen this.
--   The Spring   down on its haunches, then a flat leap through you, the blade out in front
--   Oathbreaker  a falling cut, then a rising one, then a straight thrust: never rushed
--   Judgement    from further off: up high over you, and the blade brought down two-handed where you stood
--   Sworn        when it's hurt it plants the sword and kneels for a moment, with its hands on the hilt. It gets a little back
local K = require(script.Parent.Parent:WaitForChild("GildedKit"))
local M = K.wrap({
	Poses = {
		OSBGuard = { drop = 0.4, lean = 0.1, twist = 0.2, head = -0.05, spread = 0.18, footR = -0.5, footL = 0.55, breathe = 0.8, la1 = 0.6, la3 = -0.4, lel = 1, freeL = 0 },
		OSBKneel = { drop = 1.45, lean = 0.3, head = 0.42, footR = 1, footL = -1.3, la1 = 0.9, la3 = -0.15, lel = 0.15, freeL = 0 },
	},
	Grips = {
		OSReady = { Vector3.new(0.9, 0.3, -1.1), CFrame.Angles(math.rad(135), 0, math.rad(-8)) },
		OSPlant = { Vector3.new(0.1, -0.4, -1.3), CFrame.Angles(0, 0, 0) },
	},
})
M.Kind = "Oathsworn"
M.Proportions = { girth = 0.95, arm = 1.08, hunch = 0.05 }
M.IdlePose = "OSBGuard"
M.BodyFor = { OSReady = "OSBGuard" }
local STEEL, STEEL_DK, SURCOAT, CAPE = Color3.fromRGB(162, 166, 174), Color3.fromRGB(110, 114, 124), Color3.fromRGB(212, 208, 196), Color3.fromRGB(112, 22, 22)
M.Colors = { skin = STEEL, torso = STEEL, legs = STEEL_DK, arms = STEEL }

function M.Look(k)
	local deco, parts, V, at, rgb, MAT = k.deco, k.parts, k.V, k.at, k.rgb, k.MAT
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	local rng = Random.new()
	-- the helm, Caelen's shape without the crown: the same T of a slit, a short crest
	deco("Head", "Helm", V(1.15, 1.15, 1.2), at(0, 0.255, 0), STEEL, MAT.Metal)
	deco("Head", "HelmJaw", V(0.75, 0.35, 1.2), at(0, -0.495, 0), STEEL, MAT.Metal)
	deco("Head", "HelmCrest", V(0.14, 0.42, 1.2), at(0, 0.9, 0), STEEL_DK, MAT.Metal)
	deco("Head", "Slit", V(0.9, 0.09, 0.05), at(0, 0.2, -0.62), rgb(6, 6, 8), MAT.SmoothPlastic)
	deco("Head", "SlitDown", V(0.12, 0.6, 0.05), at(0, -0.12, -0.62), rgb(6, 6, 8), MAT.SmoothPlastic)
	deco("Head", "HelmBand", V(1.19, 0.1, 1.24), at(0, 0.62, 0), K.GOLD, MAT.Metal)
	-- the breastplate under a white surcoat cut short, the sun on it; the steel showing at the shoulders
	deco("Chest", "Breastplate", V(cw * 1.02, ch * 0.82, 0.3), at(0, 0.08, -cd / 2 - 0.1), STEEL, MAT.Metal)
	deco("Chest", "Backplate", V(cw, ch * 0.82, 0.24), at(0, 0.08, cd / 2 + 0.08), STEEL, MAT.Metal)
	deco("Chest", "Gorget", V(cw * 0.6, 0.36, cd * 1.15), at(0, ch / 2 - 0.02, 0), STEEL, MAT.Metal)
	deco("Chest", "Surcoat", V(cw * 0.64, ch * 0.88, 0.06), at(0, 0, -cd / 2 - 0.28), SURCOAT, MAT.Fabric)
	deco("Chest", "Sun", V(0.06, 0.56, 0.56), at(0, 0.2, -cd / 2 - 0.33) * K.FACE, K.GOLD, MAT.Metal, Enum.PartType.Cylinder)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		deco("Chest", "SunRay", V(0.07, 0.22, 0.04), at(math.cos(a) * 0.42, 0.2 + math.sin(a) * 0.42, -cd / 2 - 0.33) * CFrame.Angles(0, 0, a - math.pi / 2), K.GOLD, MAT.Metal)
	end
	k.tatter(rng, "Hips", CFrame.new(0, 0.05, -hd * 0.66), hw * 0.72, 1.75, SURCOAT, SURCOAT:Lerp(rgb(60, 50, 40), 0.5), 0.55)
	k.tatter(rng, "Hips", CFrame.new(0, 0.05, hd * 0.66), hw * 0.72, 1.6, SURCOAT, SURCOAT:Lerp(rgb(60, 50, 40), 0.5), 0.55)
	deco("Hips", "Belt", V(hw + 0.16, 0.24, hd + 0.16), at(0, 0.3, 0), rgb(40, 30, 24), MAT.Leather)
	deco("Hips", "Buckle", V(0.32, 0.26, 0.06), at(0, 0.3, -hd / 2 - 0.1), K.GOLD, MAT.Metal)
	-- a torn half-cape off the right shoulder
	K.cloth(deco("Chest", "CapeAnchor", V(0.2, 0.2, 0.2), at(cw * 0.25, ch / 2 - 0.15, cd / 2 + 0.25) * K.BACK, CAPE, MAT.SmoothPlastic), 5, 0.9 * k.s, cw * 0.75 * k.s, CAPE)
	for _, n in ipairs({ "R", "L" }) do
		local sx = n == "R" and 1 or -1
		deco(n .. "UpperArm", "Pauldron", V(aw * 1.75, 0.5, aw * 1.65), at(sx * 0.1, ua / 2 - 0.1, 0) * CFrame.Angles(0, 0, -sx * 0.3), STEEL, MAT.Metal)
		deco(n .. "UpperArm", "PauldronLame", V(aw * 1.55, 0.2, aw * 1.45), at(sx * 0.08, ua / 2 - 0.42, 0) * CFrame.Angles(0, 0, -sx * 0.2), STEEL_DK, MAT.Metal)
		deco(n .. "LowerArm", "Vambrace", V(aw * 1.15, la * 0.65, aw * 1.15), at(0, -0.05, 0), STEEL, MAT.Metal)
		deco(n .. "LowerArm", "Gauntlet", V(aw * 1.25, 0.46, aw * 1.25), at(0, -la / 2 + 0.2, 0), STEEL_DK, MAT.Metal)
		deco(n .. "Thigh", "Cuisse", V(lw * 1.15, 0.86, lw * 1.15), at(0, 0.05, 0), STEEL, MAT.Metal)
		deco(n .. "Shin", "Greave", V(lw * 1.12, 0.74, lw * 1.12), at(0, -0.1, 0), STEEL, MAT.Metal)
		deco(n .. "Shin", "Poleyn", V(lw * 1.25, 0.38, lw * 1.3), at(0, 0.47, -0.05), K.TARNISH, MAT.Metal)
		deco(n .. "Foot", "Sabaton", V(0.66, 0.26, 1.12), at(0, 0.02, -0.05), STEEL_DK, MAT.Metal)
	end
end

M.Weapons = {
	-- Caelen's blade for those who aren't Caelen: straight, broad, plain, as long as its bearer is tall
	OathBlade = function(w)
		local steel, dark, gold = Color3.fromRGB(170, 172, 178), Color3.fromRGB(46, 44, 46), Color3.fromRGB(176, 140, 66)
		local handle = w.mk("Grip", Vector3.new(0.26, 1.3, 0.26), dark, Enum.Material.Leather)
		w.add(w.mk("Pommel", Vector3.new(0.5, 0.5, 0.18), gold, Enum.Material.Metal), 0.78)
		w.add(w.mk("Guard", Vector3.new(2, 0.22, 0.3), gold, Enum.Material.Metal), -0.72)
		w.add(w.mk("Blade", Vector3.new(0.85, 5.2, 0.12), steel, Enum.Material.Metal), -3.4)
		w.add(w.mk("Fuller", Vector3.new(0.24, 4.4, 0.14), Color3.fromRGB(116, 118, 124), Enum.Material.Metal), -3.15)
		w.add(w.mk("Point", Vector3.new(0.6, 0.6, 0.12), steel, Enum.Material.Metal), -6, CFrame.Angles(0, 0, math.pi / 4))
		return { handle = handle, bladeLen = 6, gripC1 = CFrame.Angles(0, math.pi / 2, 0) }
	end,
}

M.Def = K.def({
	HP = 460, Speed = 10.5, Scale = 1.3, Damage = 44, Range = 10, HalfAngle = 55, Lunge = 9, Poise = 75, Stagger = 0.45, StaggerPush = 9,
	Windup = 0.7, Recover = 0.9, Engage = 22, Close = 9, Weapon = "OathBlade", IdleGrip = "OSReady", Radius = 1.6, Skin = STEEL, Cloth = CAPE,
})

local function sworn(e)
	e.swornAt = os.clock()
	K.setGrip(e, "OSPlant", 0.35)
	K.setBody(e, "OSBKneel", 0.35)
	K.sound(e, "Impact", 0.6, 0.6)
	if not K.hold(e, 1.5) then
		return false
	end
	e.hum.Health = math.min(e.hum.MaxHealth, e.hum.Health + e.hum.MaxHealth * 0.12)
	K.flash(e.root.Position, K.LIGHT, 4)
	return true
end

M.attack = K.brain(function(e, tRoot, d)
	if e.hum.Health < e.hum.MaxHealth * 0.45 and (not e.swornAt or os.clock() - e.swornAt > 18) and d > 6 then
		return sworn(e), 0.2
	elseif d > e.def.Close and math.random() < 0.45 then
		return K.leap(e, tRoot, {
			set = "GRaise", setBody = "GBLow", tell = 0.7, air = "GRaise", airBody = "GBAir", land = "GSlam", landBody = "GBLand",
			time = 0.65, height = 14, damage = 46, area = 5.5, level = "Knockdown", color = K.SILVER, boom = 1.05,
		}), 1.2
	elseif d > e.def.Close then
		return K.rush(e, tRoot, { set = "GDraw", setBody = "GBLow", tell = 0.75, drive = "GThrust", driveBody = "GBLunge", speed = 52, time = 0.42, damage = 48, level = "Knockdown", reach = 5, pitch = 0.85 }), 1.15
	end
	return K.combo(e, tRoot, {
		{ set = "GCock", setBody = "GBSet", tell = 0.62, swing = "GCut", swingBody = "GBStrike", time = 0.16, damage = 34, level = "Medium", speed = 0.9 },
		{ set = "GWide", setBody = "GBWind", tell = 0.34, swing = "GRaise", swingBody = "GBCast", time = 0.15, damage = 32, level = "Medium", speed = 1, quiet = true },
		{ set = "GDraw", setBody = "GBDraw", tell = 0.5, swing = "GThrust", swingBody = "GBLunge", time = 0.12, range = 12, half = 20, damage = 44, lunge = 1.7, speed = 0.92, quiet = true },
	}), 1.15
end)

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Oathsworn</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">4fbbcca43369486aa42254cc0e0f22d8</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXA7F329632D84490092739F18EE7ADB6B">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE GILT SERAPH (kind GiltSeraph): off the cathedral's roof. A statue of beaten gold, hollow as a bell, on six huge sheet-gold wings it
-- holds folded round itself when it's waiting. Its face is a smooth blank, a halo fixed behind its head on a rod. Somebody stole
-- its hands long ago and fitted a long gold spear in the stumps.
--   Descent     its wings snap open, it goes up, hangs, and comes down spear-first where you stood
--   Wing Cut    a wing swept right round it, the leading edge sharp
--   Lance       the spear, thrown from the wrist on a short run
--   Featherfall three of its sheet-gold feathers torn loose and flung at you in a fan
local K = require(script.Parent.Parent:WaitForChild("GildedKit"))
local M = K.wrap({
	Poses = {
		GSBHover = { drop = -0.1, lean = 0.1, head = 0.15, footR = -0.25, footL = -0.1, spread = 0.02, breathe = 0.4, la1 = 0.5, la3 = -0.3, lel = 1.2, freeL = 0 },
		GSBDive = { drop = 0.2, lean = 1, head = -0.4, footR = -1, footL = -0.85, spread = 0.03, la1 = -0.5, la3 = -0.1, freeL = 0 },
	},
	Grips = { GSSpear = { Vector3.new(1, 0.1, -0.8), CFrame.Angles(math.rad(165), 0, 0) } },
})
M.Kind = "GiltSeraph"
M.Proportions = { girth = 0.88, arm = 1, hunch = 0 }
M.IdlePose = "GSBHover"
M.BodyFor = { GSSpear = "GSBHover" }
local AU, AU_DK, AU_LT = K.GOLD, K.TARNISH, K.LIGHT
M.Colors = { skin = AU, torso = AU, legs = AU, arms = AU }

function M.Look(k)
	local deco, parts, V, at, rgb, MAT = k.deco, k.parts, k.V, k.at, k.rgb, k.MAT
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	for name, p in pairs(parts) do
		if name ~= "HumanoidRootPart" then
			p.Material = MAT.Metal
		end
	end
	-- a smooth blank mask of a face; a halo behind it on a rod, its rim toothed with little rays
	deco("Head", "Blank", V(1.08, 1.32, 1.05), at(0, 0, -0.06), AU_LT, MAT.Metal, Enum.PartType.Ball)
	deco("Head", "HaloRod", V(0.1, 0.1, 0.72), at(0, 0.1, 0.72), AU_DK, MAT.Metal)
	local rays = 14
	for i = 0, rays - 1 do
		local a = i / rays * math.pi * 2
		deco("Head", "Halo", V(0.2, 0.62, 0.07), at(math.cos(a) * 1.25, 0.1 + math.sin(a) * 1.25, 1.05) * CFrame.Angles(0, 0, a + math.pi / 2), AU_LT, MAT.Metal)
		deco("Head", "HaloRay", V(0.1, 0.38, 0.05), at(math.cos(a + 0.22) * 1.68, 0.1 + math.sin(a + 0.22) * 1.68, 1.05) * CFrame.Angles(0, 0, a + 0.22 - math.pi / 2), AU, MAT.Neon)
	end
	-- a long pleated robe of sheet metal, open to the ankles, hanging clear of the floor
	deco("Chest", "Robe", V(cw * 1.04, ch * 1, cd * 1.08), at(0, 0, 0), AU, MAT.Metal)
	for i = -2, 2 do
		deco("Chest", "Pleat", V(0.14, ch * 0.92, 0.1), at(i * cw * 0.17, 0, -cd * 0.56), AU_LT, MAT.Metal)
		deco("Hips", "RobePleat", V(0.28, 3.1, 0.14), at(i * hw * 0.2, -1.25, -hd * 0.58), i % 2 == 0 and AU or AU_LT, MAT.Metal)
		deco("Hips", "RobePleat", V(0.28, 3.1, 0.14), at(i * hw * 0.2, -1.25, hd * 0.58), i % 2 == 0 and AU_LT or AU, MAT.Metal)
	end
	deco("Chest", "Girdle", V(cw * 0.92, 0.2, cd * 1.15), at(0, -ch * 0.28, 0), K.RUG, MAT.Fabric)
	deco("Chest", "Stole", V(0.32, ch * 1, 0.05), at(0, 0, -cd * 0.62), K.RUG, MAT.Fabric)
	-- THE WINGS: three pairs of long sheet-gold feathers, fanned out from between the shoulders
	for _, sx in ipairs({ -1, 1 }) do
		for pair, wing in ipairs({ { 0.9, 0.62, 1.05 }, { 0.2, 0.36, 0.86 }, { -0.5, 0.18, 0.62 } }) do
			local up, tilt, size = wing[1], wing[2], wing[3]
			for f = 0, 4 do
				local len = (3.7 - f * 0.45) * size
				local a = tilt + f * 0.2 * sx * sx
				deco("Chest", "Feather", V(0.34 - f * 0.02, len, 0.06),
					at(sx * (0.5 + len * 0.4 * math.sin(a + 0.25)), up + ch * 0.1 + len * 0.42 * math.cos(a + 0.25) - f * 0.14, cd * 0.56 + pair * 0.1 + f * 0.03) * CFrame.Angles(0.1, 0, -sx * (a + 0.25)),
					f % 2 == 0 and AU or AU_LT, MAT.Metal)
			end
		end
	end
	for _, n in ipairs({ "R", "L" }) do
		deco(n .. "UpperArm", "Sleeve", V(aw * 1.28, ua * 0.95, aw * 1.28), at(0, 0, 0), AU_LT, MAT.Metal)
		deco(n .. "LowerArm", "Stump", V(aw * 1.1, 0.26, aw * 1.1), at(0, -la / 2 - 0.05, 0), AU_DK, MAT.Metal)
		parts[n .. "Foot"].Transparency = 1
	end
end

M.Weapons = {
	SeraphSpear = function(w)
		local gold = K.GOLD
		local handle = w.mk("Grip", Vector3.new(0.18, 1, 0.18), K.RUG, Enum.Material.Fabric)
		w.add(w.mk("Shaft", Vector3.new(0.14, 7.4, 0.14), gold, Enum.Material.Metal), -2.2)
		w.add(w.mk("Foot", Vector3.new(0.24, 0.5, 0.24), K.TARNISH, Enum.Material.Metal), 1.7)
		w.add(w.mk("Head", Vector3.new(0.5, 2, 0.12), K.LIGHT, Enum.Material.Metal), -6.6)
		w.add(w.mk("Tip", Vector3.new(0.36, 0.36, 0.1), K.LIGHT, Enum.Material.Metal), -7.65, CFrame.Angles(0, 0, math.pi / 4))
		w.add(w.mk("Lug", Vector3.new(1.1, 0.14, 0.14), gold, Enum.Material.Metal), -5.5)
		return { handle = handle, bladeLen = 7.8 }
	end,
}

M.Def = K.def({
	HP = 410, Speed = 11, Scale = 1.3, Damage = 44, Range = 11, HalfAngle = 25, Lunge = 9, Poise = 60, Stagger = 0.5, StaggerPush = 12,
	Windup = 0.75, Recover = 1.05, Engage = 28, Close = 9, Weapon = "SeraphSpear", IdleGrip = "GSSpear", Radius = 1.5, Skin = AU, Cloth = AU,
})

local function featherfall(e, tRoot)
	K.setBody(e, "GBCast", 0.5)
	K.sound(e, "Unsheath", 0.5, 1.3)
	if not K.hold(e, 0.7, tRoot) or not tRoot.Parent then
		return false
	end
	K.setBody(e, "GBFling", 0.12)
	K.sound(e, "Lunge", 0.7, 1.2)
	local from = e.root.Position + Vector3.new(0, 2.2, 0)
	local base = K.aim(from, tRoot, 85, 0.2)
	for i = -1, 1 do
		K.shot(e, {
			from = from + e.root.CFrame.RightVector * i * 1.2, vel = CFrame.Angles(0, math.rad(i * 9), 0):VectorToWorldSpace(base),
			damage = 24, level = "Medium", radius = 1.4, life = 1.6, size = Vector3.new(0.25, 0.08, 1.8), shape = Enum.PartType.Block,
			color = AU_LT, trail = AU_LT,
		})
	end
	return K.hold(e, 0.3, tRoot)
end

M.attack = K.brain(function(e, tRoot, d)
	local roll = math.random()
	if d > e.def.Close and roll < 0.25 then
		return featherfall(e, tRoot), 0.9
	elseif d > e.def.Close and roll < 0.75 then
		return K.leap(e, tRoot, {
			set = "GHigh", setBody = "GBCast", tell = 0.8, air = "GLevel", airBody = "GSBDive", land = "GSlam", landBody = "GBLand",
			time = 0.8, height = 22, damage = 52, area = 6.5, level = "Knockdown", color = AU_LT, boom = 1,
		}), 1.3
	elseif d > e.def.Close then
		return K.rush(e, tRoot, { set = "GDraw", setBody = "GBDraw", tell = 0.7, drive = "GThrust", driveBody = "GSBDive", speed = 48, time = 0.48, damage = 42, level = "Large", pitch = 0.95 }), 1
	end
	if roll < 0.55 then
		return K.strike(e, tRoot, { set = "GBack", setBody = "GBWind", tell = 0.7, swing = "GSweep", swingBody = "GBSweep", time = 0.18, range = 9, half = 120, damage = 38, speed = 0.9 }), 0.9
	end
	return K.strike(e, tRoot, { set = "GDraw", setBody = "GBDraw", tell = 0.68, swing = "GThrust", swingBody = "GBLunge", time = 0.13, range = 12, half = 20, damage = 44, lunge = 1.6, speed = 0.9 }), 1
end)

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">GiltSeraph</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">b0339560aaeb49aba80c48f9bf121f32</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXAE50367821444E08A67ED8A7F33CA003">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- PORCELAIN DUELIST (kind PorcelainDuelist): a courtier fired and glazed, cracked long ago and mended in gold seams. A smooth white face
-- with no features but a painted smile; rose velvet doublet, lace at the throat and wrists, a rapier held out at the end of a
-- very straight arm. Light, quick, and it breaks up fast if you can catch it.
--   Flurry   three quick stabs, walking you back
--   Fleche   a flat dash, the whole body behind the point, straight through you
--   It keeps its distance: once it's stabbed it steps away (M.steer holds it off a little)
local K = require(script.Parent.Parent:WaitForChild("GildedKit"))
local M = K.wrap({
	Poses = { PDBStance = { drop = 0.45, lean = 0.1, twist = 0.5, head = -0.1, footR = -0.65, footL = 0.7, spread = 0.2, breathe = 1, la1 = 1.2, la3 = -0.9, lel = 1.6, freeL = 0 } },
	Grips = { PDEnGarde = { Vector3.new(0.9, 0.4, -1.5), CFrame.Angles(math.rad(98), 0, 0) } },
})
M.Kind = "PorcelainDuelist"
M.Proportions = { girth = 0.82, arm = 1.08, hunch = 0, cadence = 0.7 }
M.IdlePose = "PDBStance"
M.BodyFor = { PDEnGarde = "PDBStance" }
local WHITE, VELVET, LACE, SEAM = K.PORCELAIN, K.ROSE, Color3.fromRGB(240, 232, 216), K.LIGHT
M.Colors = { skin = WHITE, torso = VELVET, legs = Color3.fromRGB(60, 20, 44), arms = VELVET }

function M.Look(k)
	local deco, parts, V, at, rgb, MAT = k.deco, k.parts, k.V, k.at, k.rgb, k.MAT
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	local rng = Random.new()
	-- THE FACE: glazed, oval, a painted mouth and two painted brows; gold seams across it
	parts.Head.Material, parts.Head.Reflectance = MAT.Glass, 0.12
	deco("Head", "Face", V(1.1, 1.4, 1.1), at(0, -0.02, -0.08), WHITE, MAT.SmoothPlastic, Enum.PartType.Ball).Reflectance = 0.2
	deco("Head", "Smile", V(0.5, 0.05, 0.04), at(0, -0.34, -0.63) * CFrame.Angles(0, 0, 0), K.RUG, MAT.SmoothPlastic)
	for _, sx in ipairs({ -1, 1 }) do
		deco("Head", "SmileEnd", V(0.14, 0.05, 0.04), at(sx * 0.3, -0.29, -0.61) * CFrame.Angles(0, 0, sx * 0.6), K.RUG, MAT.SmoothPlastic)
		deco("Head", "Brow", V(0.3, 0.035, 0.04), at(sx * 0.25, 0.22, -0.6) * CFrame.Angles(0, 0, -sx * 0.25), K.INK, MAT.SmoothPlastic)
		deco("Head", "EyeHole", V(0.2, 0.09, 0.04), at(sx * 0.25, 0.08, -0.61), K.INK, MAT.SmoothPlastic)
	end
	for _ = 1, 4 do
		deco("Head", "Seam", V(0.03, rng:NextNumber(0.3, 0.6), 0.03), at(rng:NextNumber(-0.42, 0.42), rng:NextNumber(-0.3, 0.45), -0.58) * CFrame.Angles(0, 0, rng:NextNumber(-1.2, 1.2)), SEAM, MAT.Neon)
	end
	-- a powdered wig, tied back with a bow
	deco("Head", "Wig", V(1.25, 0.8, 1.3), at(0, 0.42, 0.18), rgb(226, 222, 210), MAT.Sand)
	for _, sx in ipairs({ -1, 1 }) do
		deco("Head", "Curl", V(0.42, 0.42, 0.7), at(sx * 0.62, 0.05, 0.22), rgb(220, 216, 204), MAT.Sand, Enum.PartType.Ball)
	end
	deco("Head", "Queue", V(0.28, 0.9, 0.28), at(0, -0.1, 0.72), rgb(220, 216, 204), MAT.Sand)
	deco("Head", "Bow", V(0.8, 0.26, 0.14), at(0, 0.3, 0.72), K.INK, MAT.Fabric)
	-- the doublet, gold frogging down it; lace at the throat and the wrist
	deco("Chest", "Doublet", V(cw * 1.04, ch * 0.98, cd * 1.08), at(0, 0, 0), VELVET, MAT.Fabric)
	for i = 0, 4 do
		deco("Chest", "Frog", V(cw * 0.42, 0.06, 0.05), at(0, ch * (0.32 - i * 0.16), -cd * 0.57), K.GOLD, MAT.Metal)
	end
	for i = 0, 2 do
		deco("Chest", "Jabot", V(0.62 - i * 0.12, 0.2, 0.14), at(0, ch * 0.44 - i * 0.18, -cd * 0.62), LACE, MAT.Fabric)
	end
	deco("Chest", "Collar", V(cw * 0.5, 0.2, cd * 1.05), at(0, ch * 0.52, 0), LACE, MAT.Fabric)
	deco("Hips", "Coatskirt", V(hw * 1.2, 1.4, hd * 1.2), at(0, -0.5, 0.05), VELVET, MAT.Fabric)
	deco("Hips", "Sash", V(hw * 1.24, 0.2, hd * 1.26), at(0, 0.28, 0), K.GOLD, MAT.Fabric)
	for _, n in ipairs({ "R", "L" }) do
		deco(n .. "LowerArm", "Cuff", V(aw * 1.45, 0.42, aw * 1.45), at(0, -la * 0.3, 0), K.GOLD, MAT.Fabric)
		deco(n .. "LowerArm", "Lace", V(aw * 1.3, 0.2, aw * 1.3), at(0, -la * 0.5, 0), LACE, MAT.Fabric)
		deco(n .. "LowerArm", "Hand", V(aw * 0.9, 0.46, aw * 0.9), at(0, -la / 2 - 0.1, 0), WHITE, MAT.SmoothPlastic)
		deco(n .. "Shin", "Stocking", V(lw * 1.02, 1.02, lw * 1.02), at(0, 0, 0), LACE, MAT.Fabric)
		deco(n .. "Thigh", "Breeches", V(lw * 1.14, 1, lw * 1.14), at(0, 0.05, 0), Color3.fromRGB(70, 26, 54), MAT.Fabric)
		deco(n .. "Foot", "Shoe", V(0.56, 0.24, 1), at(0, 0, -0.05), K.INK, MAT.SmoothPlastic)
		deco(n .. "Foot", "Buckle", V(0.26, 0.12, 0.06), at(0, 0.1, -0.36), K.GOLD, MAT.Metal)
	end
	-- a small gold-seamed crack across its chest too
	deco("Chest", "Seam", V(0.04, ch * 0.5, 0.04), at(-cw * 0.3, 0, -cd * 0.56) * CFrame.Angles(0, 0, 0.5), SEAM, MAT.Neon)
end

M.Weapons = {
	PorcelainRapier = function(w)
		local steel, gold = Color3.fromRGB(210, 212, 220), K.GOLD
		local handle = w.mk("Grip", Vector3.new(0.18, 0.7, 0.18), K.INK, Enum.Material.Leather)
		w.add(w.mk("Pommel", Vector3.new(0.26, 0.26, 0.26), gold, Enum.Material.Metal), 0.42)
		local cup = w.mk("Cup", Vector3.new(0.2, 0.74, 0.74), gold, Enum.Material.Metal)
		cup.Shape = Enum.PartType.Cylinder
		w.add(cup, -0.46, CFrame.Angles(0, 0, math.pi / 2))
		w.add(w.mk("Quillon", Vector3.new(1.05, 0.08, 0.08), gold, Enum.Material.Metal), -0.42)
		w.add(w.mk("Blade", Vector3.new(0.07, 4.8, 0.1), steel, Enum.Material.Metal), -2.95)
		return { handle = handle, bladeLen = 5.3 }
	end,
}

M.Def = K.def({
	HP = 290, Speed = 12.5, Scale = 1.1, Damage = 26, Range = 8, HalfAngle = 30, Lunge = 11, Poise = 35, Stagger = 0.6, StaggerPush = 16,
	Windup = 0.45, Recover = 0.7, Engage = 14, Close = 7.5, Weapon = "PorcelainRapier", IdleGrip = "PDEnGarde", Radius = 1.2, Skin = K.PORCELAIN, Cloth = K.ROSE,
})

M.attack = K.brain(function(e, tRoot, d)
	if d > e.def.Close then
		return K.rush(e, tRoot, { set = "GDraw", setBody = "GBDraw", tell = 0.65, drive = "GThrust", driveBody = "GBLunge", speed = 46, time = 0.4, damage = 34, level = "Large", pitch = 1.1 }), 1.05
	end
	local ok = K.combo(e, tRoot, {
		{ set = "GDraw", setBody = "GBDraw", tell = 0.42, swing = "GThrust", swingBody = "GBLunge", time = 0.09, level = "Small", damage = 16, range = 8.5, half = 26, speed = 1.3 },
		{ set = "GDraw", setBody = "GBDraw", tell = 0.2, swing = "GThrust", swingBody = "GBLunge", time = 0.09, level = "Small", damage = 16, range = 8.5, half = 26, speed = 1.4, quiet = true },
		{ set = "GDraw", setBody = "GBDraw", tell = 0.28, swing = "GThrust", swingBody = "GBLunge", time = 0.1, level = "Medium", damage = 24, range = 9, half = 22, speed = 1.2, lunge = 1.4, quiet = true },
	})
	if ok then -- (a neat step back, out of your reach: on guard again)
		e.root.AssemblyLinearVelocity = -e.root.CFrame.LookVector * 22
	end
	return ok, 0.8
end)

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">PorcelainDuelist</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">41a651915c264b1d81a0989056f92f44</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXAE9AFAADE8DF46A9B62A2C2D068D635C">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE WIND-UP FOOTMAN (kind WindupFootman): a footman in powder-blue livery who's clockwork all the way through, a great brass key turning
-- in its back. Its joints tick. It serves one tray of knives, over and over. It winds up to run, runs far too fast, and then,
-- all at once, it runs down and stands there ticking, head on one side, while the key slowly turns itself back.
--   Service!    a wound-up sprint straight at you, tray out, knives flat. It can't turn once it's going
--   Clatter     the tray swung left, right, left, each a little too quick
--   Run Down    it stops dead after a long rush. Hit it
local K = require(script.Parent.Parent:WaitForChild("GildedKit"))
local M = K.wrap({
	Poses = {
		WFBStand = { drop = 0, lean = 0, head = 0.06, footR = 0.02, footL = -0.02, breathe = 0, la1 = 0.05, la3 = -0.05, lel = 1.55, freeL = 0 },
		WFBWinding = { drop = 0.5, lean = 0.45, head = -0.25, spread = 0.14, footR = -0.55, footL = 0.7, la1 = -0.4, la3 = -0.2, lel = 1.2, freeL = 0 },
		WFBRun = { drop = 0.7, lean = 0.95, head = -0.4, footR = 0.9, footL = -0.8, la1 = -0.7, la3 = -0.3, lel = 0.5, freeL = 0 },
		WFBSpent = { drop = 0.3, lean = 0.28, side = 0.22, head = 0.55, footR = -0.1, footL = 0.1, la1 = -0.1, la3 = -0.05, lel = 0.1, freeL = 0 },
	},
	Grips = { WFTray = { Vector3.new(1, 0.5, -1.3), CFrame.Angles(math.rad(90), 0, 0) } },
})
M.Kind = "WindupFootman"
M.Proportions = { girth = 0.92, arm = 1.02, hunch = 0, cadence = 1 }
M.IdlePose = "WFBStand"
M.BodyFor = { WFTray = "WFBStand" }
local LIVERY, CUFF, BRASS, ENAMEL = Color3.fromRGB(116, 150, 184), Color3.fromRGB(232, 228, 212), Color3.fromRGB(190, 150, 70), Color3.fromRGB(240, 236, 226)
M.Colors = { skin = ENAMEL, torso = LIVERY, legs = CUFF, arms = LIVERY }

function M.Look(k)
	local deco, parts, V, at, rgb, MAT = k.deco, k.parts, k.V, k.at, k.rgb, k.MAT
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	local cyl = Enum.PartType.Cylinder
	-- a doll's enamel face with a hinged jaw; round rouge cheeks; two clock-hands for a moustache; a powdered wig
	parts.Head.Material, parts.Head.Color = MAT.SmoothPlastic, ENAMEL
	for _, sx in ipairs({ -1, 1 }) do
		deco("Head", "EyeRing", V(0.07, 0.38, 0.38), at(sx * 0.25, 0.12, -0.59) * K.FACE, BRASS, MAT.Metal, cyl)
		deco("Head", "Eye", V(0.04, 0.26, 0.26), at(sx * 0.25, 0.12, -0.62) * K.FACE, rgb(10, 10, 14), MAT.SmoothPlastic, cyl)
		deco("Head", "Rouge", V(0.03, 0.22, 0.22), at(sx * 0.38, -0.17, -0.58) * K.FACE, rgb(214, 110, 110), MAT.SmoothPlastic, cyl)
		deco("Head", "Hinge", V(0.1, 0.1, 0.1), at(sx * 0.42, -0.42, -0.52), BRASS, MAT.Metal, Enum.PartType.Ball)
		deco("Head", "Moustache", V(0.3, 0.035, 0.03), at(sx * 0.16, -0.14, -0.61) * CFrame.Angles(0, 0, sx * 0.3), K.INK, MAT.Metal)
	end
	deco("Head", "Jaw", V(0.72, 0.28, 0.08), at(0, -0.43, -0.57), rgb(226, 222, 212), MAT.SmoothPlastic)
	deco("Head", "Wig", V(1.22, 0.62, 1.25), at(0, 0.48, 0.12), rgb(236, 234, 226), MAT.Sand)
	deco("Head", "Tricorn", V(1.65, 0.28, 1.45), at(0, 0.82, 0.02), rgb(40, 50, 70), MAT.Fabric)
	deco("Head", "TricornTrim", V(1.7, 0.08, 1.5), at(0, 0.68, 0.02), BRASS, MAT.Metal)
	-- the livery; a window in the chest with the gears going round behind glass
	deco("Chest", "Livery", V(cw * 1.04, ch * 1, cd * 1.08), at(0, 0, 0), LIVERY, MAT.Fabric)
	deco("Chest", "Waistcoat", V(cw * 0.5, ch * 0.92, 0.05), at(0, 0, -cd * 0.56), CUFF, MAT.Fabric)
	deco("Chest", "Dial", V(0.1, 0.92, 0.92), at(0, 0.18, -cd * 0.58) * K.FACE, BRASS, MAT.Metal, cyl)
	deco("Chest", "DialFace", V(0.05, 0.75, 0.75), at(0, 0.18, -cd * 0.62) * K.FACE, ENAMEL, MAT.SmoothPlastic, cyl)
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		deco("Chest", "Tick", V(0.03, 0.1, 0.03), at(math.cos(a) * 0.3, 0.18 + math.sin(a) * 0.3, -cd * 0.65) * CFrame.Angles(0, 0, a - math.pi / 2), K.INK, MAT.SmoothPlastic)
	end
	deco("Chest", "DialHand", V(0.04, 0.34, 0.03), at(0.08, 0.28, -cd * 0.66) * CFrame.Angles(0, 0, -0.8), K.INK, MAT.Metal)
	deco("Chest", "DialHand", V(0.04, 0.22, 0.03), at(-0.07, 0.24, -cd * 0.66) * CFrame.Angles(0, 0, 0.7), K.INK, MAT.Metal)
	for _, sx in ipairs({ -1, 1 }) do
		deco("Chest", "Epaulette", V(0.72, 0.16, 0.62), at(sx * cw * 0.5, ch * 0.5, 0), BRASS, MAT.Metal)
		for i = -1, 1 do
			deco("Chest", "Fringe", V(0.08, 0.34, 0.08), at(sx * cw * 0.72, ch * 0.33, i * 0.2), BRASS, MAT.Metal)
		end
	end
	-- THE KEY in its back, a big butterfly of brass
	deco("Chest", "KeyShaft", V(0.2, 0.2, 1.05), at(0, 0.15, cd * 0.5 + 0.5), BRASS, MAT.Metal)
	for _, sx in ipairs({ -1, 1 }) do
		deco("Chest", "KeyWing", V(0.1, 0.92, 0.68), at(sx * 0.42, 0.15, cd * 0.5 + 1) * CFrame.Angles(0, math.pi / 2, sx * 1.1), BRASS, MAT.Metal, cyl)
	end
	-- coat-tails, white breeches and stockings, and brass ball-joints showing at every limb
	deco("Hips", "CoatTail", V(hw * 0.9, 1.9, 0.08), at(0, -0.65, hd * 0.6), LIVERY, MAT.Fabric)
	deco("Hips", "Waist", V(hw * 1.2, 0.22, hd * 1.24), at(0, 0.3, 0), BRASS, MAT.Metal)
	for _, n in ipairs({ "R", "L" }) do
		deco(n .. "UpperArm", "Joint", V(aw * 1.1, aw * 1.1, aw * 1.1), at(0, -ua / 2, 0), BRASS, MAT.Metal, Enum.PartType.Ball)
		deco(n .. "UpperArm", "ShoulderJoint", V(aw * 1.2, aw * 1.2, aw * 1.2), at(0, ua / 2, 0), BRASS, MAT.Metal, Enum.PartType.Ball)
		deco(n .. "LowerArm", "Cuff", V(aw * 1.34, 0.46, aw * 1.34), at(0, -la * 0.32, 0), CUFF, MAT.Fabric)
		deco(n .. "LowerArm", "Glove", V(aw * 0.98, 0.45, aw * 1), at(0, -la / 2 - 0.1, 0), CUFF, MAT.Fabric)
		deco(n .. "Thigh", "Joint", V(lw * 1.05, lw * 1.05, lw * 1.05), at(0, -0.6, 0), BRASS, MAT.Metal, Enum.PartType.Ball)
		deco(n .. "Foot", "Shoe", V(0.56, 0.24, 1.02), at(0, 0, -0.05), K.INK, MAT.SmoothPlastic)
		deco(n .. "Foot", "Buckle", V(0.28, 0.14, 0.05), at(0, 0.1, -0.38), BRASS, MAT.Metal)
	end
end

M.Weapons = {
	-- a silver salver, its edge sharpened, a row of carving knives standing on it
	ServiceTray = function(w)
		local silver = Color3.fromRGB(210, 212, 216)
		local handle = w.mk("Grip", Vector3.new(0.2, 0.7, 0.2), silver, Enum.Material.Metal)
		local tray = w.mk("Tray", Vector3.new(0.12, 3, 3), silver, Enum.Material.Metal)
		tray.Shape = Enum.PartType.Cylinder
		w.add(tray, -1.8, CFrame.Angles(0, 0, 0), 0)
		local rim = w.mk("Rim", Vector3.new(0.2, 3.1, 3.1), BRASS, Enum.Material.Metal)
		rim.Shape = Enum.PartType.Cylinder
		w.add(rim, -1.8)
		for i = -2, 2 do
			w.add(w.mk("Knife", Vector3.new(0.5, 0.05, 0.1), silver, Enum.Material.Metal), -1.8 + i * 0.5, CFrame.new(-0.5 * w.scale, 0, 1 * w.scale))
		end
		return { handle = handle, bladeLen = 3.2 }
	end,
}

M.Def = K.def({
	HP = 340, Speed = 11, Scale = 1.15, Damage = 34, Range = 8, HalfAngle = 60, Lunge = 9, Poise = 45, Stagger = 0.5, StaggerPush = 12,
	Windup = 0.55, Recover = 0.8, Engage = 16, Close = 7, Weapon = "ServiceTray", IdleGrip = "WFTray", Radius = 1.3, Skin = BRASS, Cloth = LIVERY,
})

M.attack = K.brain(function(e, tRoot, d)
	if d > e.def.Close then
		K.sound(e, "Unsheath", 0.4, 2)
		local ok = K.rush(e, tRoot, { set = "GLevel", setBody = "WFBWinding", tell = 0.85, driveBody = "WFBRun", speed = 44, time = 0.8, damage = 42, level = "Knockdown", reach = 4.5, pitch = 1.3 })
		if not ok then
			return false
		end
		K.setBody(e, "WFBSpent", 0.15)
		K.setGrip(e, "GGuard", 0.15)
		K.sound(e, "Impact", 0.4, 1.8)
		return true, 2.1 -- (run down: stood ticking)
	end
	return K.combo(e, tRoot, {
		{ set = "GBack", setBody = "GBWind", tell = 0.5, swing = "GSweep", swingBody = "GBSweep", time = 0.1, damage = 22, level = "Small", range = 8.5, half = 70, speed = 1.2 },
		{ set = "GWide", setBody = "GBWind", tell = 0.16, swing = "GCut", swingBody = "GBStrike", time = 0.1, damage = 22, level = "Small", range = 8.5, half = 70, speed = 1.35, quiet = true },
		{ set = "GBack", setBody = "GBWind", tell = 0.2, swing = "GSweep", swingBody = "GBSweep", time = 0.12, damage = 30, level = "Medium", range = 9, half = 70, speed = 1.1, quiet = true, lunge = 1.3 },
	}), 0.9
end)

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">WindupFootman</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">e6ec33bc48324279b3aa43390f30afb0</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXAF0DAF7FD8BD46169D9BFDC2EB56B15C">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE ALMONER (kind Almoner): the Almonry's keeper, still giving charity to whoever comes, whether they want it or not. A stooped figure in
-- grey wool and a gold-edged hood, a coin-hole for a mouth, begging bowls hung about its belt. It swings a great sack of
-- gold on a rope, and it throws handfuls of coin hard enough to go through you.
--   Largesse   an arm flung out: a fan of hot coins, flat and fast. Between them, or roll
--   Tithe      the sack up and over, down on your head. It'll drop a few coins where it lands
local K = require(script.Parent.Parent:WaitForChild("GildedKit"))
local M = K.wrap({
	Poses = { ALBStoop = { drop = 0.3, lean = 0.3, head = 0.12, footR = -0.25, footL = 0.3, spread = 0.1, breathe = 1.2, la1 = 0.5, la3 = -0.3, lel = 1.4, freeL = 0 } },
	Grips = { ALHang = { Vector3.new(1.35, -0.2, 0.2), CFrame.Angles(math.rad(6), 0, 0) } },
})
M.Kind = "Almoner"
M.Proportions = { girth = 1.02, arm = 1.12, hunch = 0.3 }
M.IdlePose = "ALBStoop"
M.BodyFor = { ALHang = "ALBStoop" }
local WOOL, WOOL_DK = Color3.fromRGB(156, 150, 138), Color3.fromRGB(116, 110, 100)
M.Colors = { skin = K.INK, torso = WOOL, legs = WOOL_DK, arms = WOOL }

function M.Look(k)
	local deco, parts, V, at, rgb, MAT = k.deco, k.parts, k.V, k.at, k.rgb, k.MAT
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	local rng = Random.new()
	-- THE HOOD, gold-edged, and in it a mask of plain tin with a slot where a mouth would be, as on an alms box
	deco("Head", "Hood", V(1.5, 1.55, 1.5), at(0, 0.08, 0.14), WOOL, MAT.Fabric)
	deco("Head", "HoodPeak", V(1, 0.5, 1), at(0, 0.88, 0.28) * CFrame.Angles(-0.4, 0, 0), WOOL, MAT.Fabric)
	deco("Head", "HoodEdge", V(1.58, 0.14, 0.14), at(0, 0.72, -0.62), K.GOLD, MAT.Metal)
	for _, sx in ipairs({ -1, 1 }) do
		deco("Head", "HoodEdge", V(0.14, 1.3, 0.14), at(sx * 0.76, 0.08, -0.62), K.GOLD, MAT.Metal)
	end
	deco("Head", "Tin", V(1.08, 1.18, 0.1), at(0, 0.02, -0.56), rgb(150, 142, 118), MAT.Metal)
	deco("Head", "Slot", V(0.52, 0.09, 0.05), at(0, -0.24, -0.62), K.INK, MAT.SmoothPlastic)
	for _, sx in ipairs({ -1, 1 }) do
		deco("Head", "Eye", V(0.12, 0.12, 0.05), at(sx * 0.24, 0.16, -0.62), K.LIGHT, MAT.Neon, Enum.PartType.Ball)
		deco("Head", "Rivet", V(0.08, 0.08, 0.04), at(sx * 0.44, -0.42, -0.62), K.GOLD, MAT.Metal, Enum.PartType.Ball)
	end
	-- the robe, a gold stole, patched at the hem; a rope belt strung with begging bowls and a coin-purse or two
	deco("Chest", "Robe", V(cw * 1.1, ch * 1.02, cd * 1.15), at(0, 0, 0.02), WOOL, MAT.Fabric)
	deco("Chest", "Mantle", V(cw * 1.22, 0.7, cd * 1.3), at(0, ch * 0.34, 0.04), WOOL_DK, MAT.Fabric)
	for _, sx in ipairs({ -1, 1 }) do
		deco("Chest", "Stole", V(0.32, ch * 0.92, 0.05), at(sx * cw * 0.22, 0.02, -cd * 0.62), K.GOLD, MAT.Fabric)
		for i = 0, 1 do
			deco("Hips", "StoleFall", V(0.32, 1.05, 0.05), at(sx * hw * 0.32, -0.45 - i * 1.05, -hd * 0.72), i == 0 and K.GOLD or K.TARNISH, MAT.Fabric)
		end
	end
	k.tatter(rng, "Hips", CFrame.new(0, 0.1, -hd * 0.55), hw * 1.1, 2.4, WOOL, WOOL_DK, 0.3)
	k.tatter(rng, "Hips", CFrame.new(0, 0.1, hd * 0.55), hw * 1.1, 2.5, WOOL, WOOL_DK, 0.4)
	deco("Hips", "Rope", V(hw * 1.28, 0.16, hd * 1.32), at(0, 0.3, 0), rgb(138, 118, 78), MAT.Fabric)
	for _, b in ipairs({ { -0.7, -0.5 }, { 0.75, -0.4 }, { -0.5, 0.55 } }) do
		deco("Hips", "Bowl", V(0.14, 0.72, 0.72), at(b[1] * hw * 0.8, -0.1, b[2] * hd * 1.4) * K.UP, K.TARNISH, MAT.Metal, Enum.PartType.Cylinder)
	end
	deco("Hips", "Purse", V(0.48, 0.62, 0.44), at(hw * 0.55, -0.28, -hd * 0.5), K.LEATHER, MAT.Leather, Enum.PartType.Ball)
	for _, n in ipairs({ "R", "L" }) do
		deco(n .. "UpperArm", "Sleeve", V(aw * 1.3, ua, aw * 1.3), at(0, 0, 0), WOOL, MAT.Fabric)
		deco(n .. "LowerArm", "Sleeve", V(aw * 1.55, la * 0.9, aw * 1.55), at(0, 0.05, 0), WOOL_DK, MAT.Fabric)
		deco(n .. "LowerArm", "Hem", V(aw * 1.6, 0.14, aw * 1.6), at(0, -la * 0.42, 0), K.GOLD, MAT.Metal)
		deco(n .. "Foot", "Sandal", V(0.68, 0.2, 1.1), at(0, -0.02, -0.05), K.LEATHER, MAT.Leather)
	end
	-- coins spilling out of the left hand, always
	for i = 0, 3 do
		deco("LLowerArm", "HeldCoin", V(0.06, 0.34, 0.34), at(rng:NextNumber(-0.15, 0.15), -la / 2 - 0.25 - i * 0.05, rng:NextNumber(-0.15, 0.15)) * CFrame.Angles(rng:NextNumber(0, 3), 0, rng:NextNumber(0, 3)), K.GOLD, MAT.Metal, Enum.PartType.Cylinder)
	end
end

M.Weapons = {
	-- a rope, a great canvas sack bulging with coin, gold showing at a split in it
	AlmsSack = function(w)
		local rope, sack = Color3.fromRGB(138, 118, 78), Color3.fromRGB(150, 134, 96)
		local handle = w.mk("Grip", Vector3.new(0.2, 0.9, 0.2), rope, Enum.Material.Fabric)
		w.add(w.mk("Rope", Vector3.new(0.14, 1.9, 0.14), rope, Enum.Material.Fabric), -1.3)
		w.add(w.mk("Neck", Vector3.new(0.5, 0.36, 0.5), K.GOLD, Enum.Material.Metal), -2.3)
		local b = w.mk("Sack", Vector3.new(2.1, 2.5, 2.1), sack, Enum.Material.Fabric)
		b.Shape = Enum.PartType.Ball
		w.add(b, -3.5)
		w.add(w.mk("Split", Vector3.new(0.9, 0.22, 0.4), K.LIGHT, Enum.Material.Metal), -3.7, nil, -0.95)
		for i = -1, 1 do
			local c = w.mk("Coin", Vector3.new(0.08, 0.42, 0.42), K.GOLD, Enum.Material.Metal)
			c.Shape = Enum.PartType.Cylinder
			w.add(c, -3.55 + i * 0.12, CFrame.Angles(0.4 * i, 0.5, 1), -1.05)
		end
		return { handle = handle, bladeLen = 4.5 }
	end,
}

M.Def = K.def({
	HP = 450, Speed = 8.5, Scale = 1.3, Damage = 40, Range = 9, HalfAngle = 55, Lunge = 7, Poise = 70, Stagger = 0.55, StaggerPush = 8,
	Windup = 0.9, Recover = 1.1, Engage = 22, Close = 9, Weapon = "AlmsSack", IdleGrip = "ALHang", Radius = 1.7, Skin = K.TARNISH, Cloth = K.GOLD,
})

local function coin(e, from, vel, damage)
	K.shot(e, { from = from, vel = vel, damage = damage or 16, level = "Small", radius = 1.3, life = 1.6, gravity = 8,
		size = Vector3.new(0.14, 0.75, 0.75), shape = Enum.PartType.Cylinder, color = K.LIGHT, trail = K.GOLD, spin = 16 })
end
-- LARGESSE: the left hand flung out, five coins in a flat fan at you
local function largesse(e, tRoot)
	local root = e.root
	K.sound(e, "Unsheath", 0.4, 1.5)
	K.setBody(e, "GBCast", 0.5)
	if not K.hold(e, 0.7, tRoot) then
		return false
	end
	K.setBody(e, "GBFling", 0.12)
	task.wait(0.1)
	if not e.alive then
		return false
	end
	local from = root.Position + root.CFrame.LookVector * 1.8 * e.scale + Vector3.new(0, 0.9 * e.scale, 0)
	local base = K.aim(from, tRoot, 48, 0.2)
	for i = -2, 2 do
		coin(e, from, CFrame.Angles(0, math.rad(i * 11), 0):VectorToWorldSpace(base))
	end
	K.sound(e, "Lunge", 0.7, 1.5)
	return true
end
local function tithe(e, tRoot)
	return K.slam(e, tRoot, {
		set = "GRaise", setBody = "GBSet", tell = 0.95, swing = "GSlam", swingBody = "GBStrike", time = 0.2, range = 9.5, half = 60, level = "Knockdown",
		area = 6, areaDamage = 18, color = K.GOLD, boom = 0.9, lunge = 1.2,
		after = function(at)
			for i = 1, 6 do
				local a = i * math.pi / 3
				coin(e, at + Vector3.new(0, 1.5, 0), Vector3.new(math.cos(a) * 16, 15, math.sin(a) * 16), 12)
			end
		end,
	})
end

M.attack = K.brain(function(e, tRoot, d)
	if d > e.def.Close or math.random() < 0.3 then
		return largesse(e, tRoot), 0.9
	end
	return tithe(e, tRoot), 1.2
end)

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Almoner</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">4e3a7de211294b44930060b372ed7884</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXB252E4C39F3E48AB8D4C3184A119B42E">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE GILDER (kind Gilder): who put the gold on everything. Bent and burned, working from a little brazier on a yoke across its shoulders, a crucible hung
-- from it either side, gold leaf sticking all over it in flakes. It's gilded its own hands and its own face without noticing, and
-- it's been meaning to do you. A long iron ladle.
--   A Coat of Gold  it fills its mouth from the ladle and blows: a fan of molten gold, spitting
--   The Pour        the ladle up and tipped: it falls in a sheet and pools hot on the floor where it lands
--   Burnisher       a hot iron across the face if you crowd it
local K = require(script.Parent.Parent:WaitForChild("GildedKit"))
local M = K.wrap({
	Poses = { GDBBent = { drop = 0.45, lean = 0.42, head = -0.05, spread = 0.24, footR = -0.35, footL = 0.4, breathe = 1.8, la1 = 0.5, la3 = -0.3, lel = 1.3, freeL = 0 } },
	Grips = { GDLadle = { Vector3.new(1.2, -0.1, -1), CFrame.Angles(math.rad(70), 0, 0) } },
})
M.Kind = "Gilder"
M.Proportions = { girth = 1.05, arm = 1.15, hunch = 0.3 }
M.IdlePose = "GDBBent"
M.BodyFor = { GDLadle = "GDBBent" }
local CHAR, LEATHER, MOLTEN, HOT = Color3.fromRGB(54, 44, 38), Color3.fromRGB(82, 56, 36), Color3.fromRGB(255, 196, 60), Color3.fromRGB(255, 130, 30)
M.Colors = { skin = CHAR, torso = LEATHER, legs = LEATHER, arms = CHAR }

function M.Look(k)
	local deco, parts, V, at, rgb, MAT = k.deco, k.parts, k.V, k.at, k.rgb, k.MAT
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	local rng = Random.new()
	local ball, cyl = Enum.PartType.Ball, Enum.PartType.Cylinder
	-- half of the face has gold running down it, one eye gilded shut; the mouth a hot gap; a leather skullcap
	parts.Head.Material = MAT.SmoothPlastic
	deco("Head", "GiltHalf", V(0.62, 1.28, 1.2), at(0.28, 0, 0), K.GOLD, MAT.Metal)
	deco("Head", "GiltDrip", V(0.14, 0.7, 0.08), at(0.42, -0.72, -0.5), K.LIGHT, MAT.Metal)
	deco("Head", "GiltLid", V(0.32, 0.08, 0.05), at(0.28, 0.1, -0.61), K.TARNISH, MAT.Metal)
	deco("Head", "Eye", V(0.12, 0.12, 0.05), at(-0.27, 0.1, -0.59), rgb(250, 240, 200), MAT.Neon, ball)
	deco("Head", "GrateFire", V(0.46, 0.24, 0.05), at(0, -0.34, -0.61), MOLTEN, MAT.Neon)
	deco("Head", "Skullcap", V(1.24, 0.42, 1.24), at(0, 0.54, 0.02), LEATHER, MAT.Leather)
	-- THE YOKE, across the shoulders: the brazier behind its neck, a crucible hung each side
	deco("Chest", "Yoke", V(cw * 2.2, 0.24, 0.34), at(0, ch * 0.54, 0.25), LEATHER:Lerp(rgb(0, 0, 0), 0.35), MAT.Wood)
	deco("Chest", "Brazier", V(0.8, 1.05, 1.05), at(0, ch * 0.54 + 0.56, 0.48) * K.UP, K.INK, MAT.Metal, cyl)
	local coals = deco("Chest", "Coals", V(0.08, 0.88, 0.88), at(0, ch * 0.54 + 0.98, 0.48) * K.UP, HOT, MAT.Neon, cyl)
	local l = Instance.new("PointLight")
	l.Color, l.Range, l.Brightness = HOT, 12, 1.5
	l.Parent = coals
	local fume = Instance.new("ParticleEmitter")
	fume.Texture = "rbxasset://textures/particles/smoke_main.dds"
	fume.Color = ColorSequence.new(Color3.fromRGB(70, 60, 50), Color3.fromRGB(26, 22, 20))
	fume.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 2.4) })
	fume.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 1) })
	fume.Lifetime, fume.Rate, fume.Speed = NumberRange.new(1.2, 2), 5, NumberRange.new(2, 3)
	fume.EmissionDirection = Enum.NormalId.Right
	fume.Parent = coals
	for _, sx in ipairs({ -1, 1 }) do
		local x = sx * cw * 1.04
		deco("Chest", "HangChain", V(0.1, 0.8, 0.1), at(x, ch * 0.22, 0.25), K.TARNISH, MAT.Metal)
		deco("Chest", "Crucible", V(0.78, 0.82, 0.78), at(x, ch * -0.2, 0.25) * K.UP, K.INK, MAT.Metal, cyl)
		deco("Chest", "Melt", V(0.05, 0.64, 0.64), at(x, ch * 0.03, 0.25) * K.UP, MOLTEN, MAT.Neon, cyl)
	end
	-- a burned leather apron stuck with gold leaf; flakes all over it; books of leaf at the belt
	deco("Chest", "Bib", V(cw * 0.92, ch * 0.92, 0.1), at(0, -0.05, -cd * 0.56), LEATHER, MAT.Leather)
	deco("Hips", "Apron", V(hw * 1.15, 2.4, 0.08), at(0, -0.95, -hd * 0.64), LEATHER, MAT.Leather)
	for _ = 1, 26 do
		local pn = rng:NextNumber() < 0.5 and "Chest" or "Hips"
		local cf = pn == "Chest" and at(rng:NextNumber(-0.45, 0.45) * cw, rng:NextNumber(-0.45, 0.45) * ch, -cd * 0.62) or at(rng:NextNumber(-0.5, 0.5) * hw, rng:NextNumber(-2, 0), -hd * 0.7)
		deco(pn, "Leaf", V(rng:NextNumber(0.12, 0.32), rng:NextNumber(0.12, 0.3), 0.03), cf * CFrame.Angles(0, 0, rng:NextNumber(0, 3)), K.LIGHT, MAT.Metal)
	end
	deco("Hips", "Belt", V(hw * 1.25, 0.26, hd * 1.3), at(0, 0.3, 0), K.INK, MAT.Leather)
	for i = -1, 1 do
		deco("Hips", "LeafBook", V(0.42, 0.56, 0.12), at(i * hw * 0.42, 0, hd * 0.68), K.RUG, MAT.Leather)
	end
	deco("Hips", "Burnisher", V(0.14, 1.15, 0.14), at(-hw * 0.74, -0.45, 0.05), K.LIGHT, MAT.Metal)
	for _, n in ipairs({ "R", "L" }) do
		-- gilded hands, gold to the elbow, and running
		deco(n .. "LowerArm", "GiltArm", V(aw * 1.08, la * 1.02, aw * 1.08), at(0, 0, 0), K.GOLD, MAT.Metal)
		deco(n .. "LowerArm", "GiltHand", V(aw * 1.02, 0.48, aw * 1.04), at(0, -la / 2 - 0.08, 0), K.LIGHT, MAT.Metal)
		deco(n .. "UpperArm", "Burn", V(aw * 1.04, ua * 0.6, aw * 1.04), at(0, -ua * 0.15, 0), HOT:Lerp(CHAR, 0.75), MAT.CrackedLava)
		deco(n .. "Shin", "Boot", V(lw * 1.16, 1.05, lw * 1.16), at(0, 0, 0), K.INK, MAT.Leather)
		deco(n .. "Foot", "Sole", V(0.72, 0.3, 1.15), at(0, 0.02, -0.05), K.INK, MAT.Leather)
		deco(n .. "Foot", "Splash", V(0.3, 0.1, 0.5), at(0.1, 0.16, -0.25), K.GOLD, MAT.Metal)
	end
end

M.Weapons = {
	-- a long iron ladle, its bowl brimming and glowing
	GildersLadle = function(w)
		local iron = Color3.fromRGB(46, 42, 40)
		local handle = w.mk("Grip", Vector3.new(0.22, 1, 0.22), K.LEATHER, Enum.Material.Leather)
		w.add(w.mk("Shaft", Vector3.new(0.17, 3.9, 0.17), iron, Enum.Material.Metal), -2.4)
		local bowl = w.mk("Bowl", Vector3.new(1.35, 0.8, 1.35), iron, Enum.Material.Metal)
		bowl.Shape = Enum.PartType.Ball
		w.add(bowl, -4.65)
		local melt = w.mk("LadleMelt", Vector3.new(1.1, 0.24, 1.1), MOLTEN, Enum.Material.Neon)
		melt.Shape = Enum.PartType.Ball
		w.add(melt, -4.65)
		local function setup()
			local l = Instance.new("PointLight")
			l.Color, l.Range, l.Brightness = MOLTEN, 9, 1.2
			l.Parent = melt
		end
		return { handle = handle, bladeLen = 5.2, setup = setup }
	end,
}

M.Def = K.def({
	HP = 460, Speed = 8.5, Scale = 1.3, Damage = 40, Range = 9, HalfAngle = 55, Lunge = 7, Poise = 70, Stagger = 0.55, StaggerPush = 9,
	Windup = 0.85, Recover = 1.1, Engage = 15, Close = 8, Weapon = "GildersLadle", IdleGrip = "GDLadle", Radius = 1.7, Skin = K.GOLD, Cloth = LEATHER,
})

local function pour(e, tRoot)
	K.setGrip(e, "GHigh", 0.5)
	K.setBody(e, "GBCast", 0.5)
	K.sound(e, "FireHit", 0.3, 0.6)
	if not K.hold(e, 0.85, tRoot) then
		return false
	end
	K.setGrip(e, "GSlam", 0.2)
	K.setBody(e, "GBStrike", 0.2)
	local from = K.hand(e) + Vector3.new(0, 3, 0) + e.root.CFrame.LookVector * 2
	for i = -1, 1 do
		local to = K.ahead(e, 8) + e.root.CFrame.RightVector * i * 2.8
		local T, G = 0.5, 90
		K.shot(e, {
			from = from, vel = (to - from) / T + Vector3.new(0, 0.5 * G * T, 0), gravity = G, damage = 20, level = "Medium", radius = 1.8, life = 2,
			size = Vector3.new(1, 1, 1), color = MOLTEN, material = Enum.Material.Neon, trail = HOT,
			onLand = function(pos)
				K.cloud(pos, { radius = 3.6, life = 3.5, color = MOLTEN, rate = 16, damage = 9, tick = 0.5, texture = "rbxasset://textures/particles/fire_main.dds" })
			end,
		})
	end
	K.sound(e, "FireHit", 0.7, 0.8)
	return K.hold(e, 0.3)
end

M.attack = K.brain(function(e, tRoot, d)
	local roll = math.random()
	if d > e.def.Close or roll < 0.32 then
		K.setGrip(e, "GWide", 0.4)
		return K.breath(e, tRoot, {
			part = K.partOf(e, "GrateFire"), setBody = "GBDraught", draw = 1.05, time = 1.3, reach = 14, half = 24, damage = 12, tick = 0.3,
			c0 = Color3.fromRGB(255, 240, 180), c1 = MOLTEN, c2 = K.TARNISH, glow = 1, spread = 4.5, pitch = 0.75,
			texture = "rbxasset://textures/particles/fire_main.dds",
		}), 1.2
	elseif roll < 0.68 then
		return pour(e, tRoot), 1.1
	end
	return K.strike(e, tRoot, { set = "GBack", setBody = "GBWind", tell = 0.6, swing = "GSweep", swingBody = "GBSweep", time = 0.15, range = 8.5, half = 75, damage = 38, speed = 0.95 }), 0.9
end)

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Gilder</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">58ed2f75bda545b190d361a99615a50b</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXC249C974D1C946459A267F9CA50CE71B">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE CUPBEARER (kind Cupbearer): the king's taster, who has tasted everything, and all of it's still in there. Bloated under a tight jade
-- doublet, its veins standing dark green, its head tipped back, a mouth stained black; a gold ewer in its fist, a towel over its arm.
--   A Toast     the ewer swung over and thrown from the shoulder: a long arc of green wine that splashes and pools where it lands
--   The Tasting it drinks. Then it breathes it back out at you, a short green gout
--   Ewer        close to, it just hits you with the jug
local K = require(script.Parent.Parent:WaitForChild("GildedKit"))
local Config = require(script.Parent.Parent:WaitForChild("Config"))
local M = K.wrap({
	Poses = {
		CBBLoll = { drop = 0.2, lean = -0.12, side = 0.05, head = -0.28, spread = 0.2, footR = -0.2, footL = 0.25, breathe = 1.6, la1 = 0.3, la3 = -0.3, lel = 1.2, freeL = 0 },
		CBBDrink = { drop = 0.3, lean = -0.4, head = -0.85, spread = 0.2, footR = -0.3, footL = 0.3, breathe = 4, la1 = 0.3, la3 = -0.3, lel = 1.2, freeL = 0 },
	},
	Grips = {
		CBHold = { Vector3.new(1.3, -0.1, -0.8), CFrame.Angles(math.rad(35), 0, 0) },
		CBDrink = { Vector3.new(0.4, 2.5, -0.9), CFrame.Angles(math.rad(205), 0, 0) },
	},
})
M.Kind = "Cupbearer"
M.Proportions = { girth = 1.28, arm = 0.95, hunch = 0.05 }
M.IdlePose = "CBBLoll"
M.BodyFor = { CBHold = "CBBLoll" }
local DOUBLET, DOUBLET_LT, SKIN, BILE, WINE = K.JADE, Color3.fromRGB(40, 150, 124), Color3.fromRGB(170, 176, 138), Color3.fromRGB(150, 178, 70), Color3.fromRGB(96, 150, 50)
M.Colors = { skin = SKIN, torso = DOUBLET, legs = Color3.fromRGB(26, 70, 62), arms = DOUBLET }

function M.Look(k)
	local deco, parts, V, at, rgb, MAT = k.deco, k.parts, k.V, k.at, k.rgb, k.MAT
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	local rng = Random.new()
	local ball = Enum.PartType.Ball
	-- a swollen face, its throat bulging; a black mouth hanging open, running green; a jewelled cap
	deco("Head", "Jowl", V(1.3, 0.72, 1.15), at(0, -0.42, -0.05), SKIN, MAT.SmoothPlastic, ball)
	deco("Head", "Mouth", V(0.5, 0.36, 0.08), at(0, -0.42, -0.6), rgb(8, 10, 6), MAT.SmoothPlastic)
	deco("Head", "MouthGlow", V(0.32, 0.12, 0.04), at(0, -0.49, -0.64), BILE, MAT.Neon)
	deco("Head", "Spill", V(0.14, 0.72, 0.05), at(0.08, -0.82, -0.58), BILE, MAT.Neon)
	for _, sx in ipairs({ -1, 1 }) do
		deco("Head", "Eye", V(0.28, 0.14, 0.06), at(sx * 0.26, 0.12, -0.58), rgb(230, 224, 160), MAT.SmoothPlastic)
		deco("Head", "Pupil", V(0.07, 0.07, 0.04), at(sx * 0.26, 0.11, -0.62), rgb(8, 10, 6), MAT.SmoothPlastic)
		for i = 0, 2 do
			deco("Head", "Vein", V(0.03, 0.34, 0.03), at(sx * (0.34 + i * 0.05), -0.08 - i * 0.14, -0.55) * CFrame.Angles(0, 0, sx * (0.3 + i * 0.3)), rgb(60, 90, 40), MAT.SmoothPlastic)
		end
	end
	deco("Head", "Cap", V(1.26, 0.45, 1.26), at(0, 0.62, 0.06), DOUBLET, MAT.Fabric)
	deco("Head", "CapBand", V(1.32, 0.14, 1.32), at(0, 0.46, 0.06), K.GOLD, MAT.Metal)
	deco("Head", "CapJewel", V(0.22, 0.22, 0.08), at(0, 0.5, -0.64), K.ROSE, MAT.Glass, ball)
	-- THE BELLY, tight in the jade doublet, its buttons straining; a towel over one arm; a chain of tiny tasting spoons
	deco("Chest", "Belly", V(cw * 1.12, ch * 1.2, cd * 1.55), at(0, -0.22, -0.18), DOUBLET, MAT.Fabric, ball)
	for i = 0, 4 do
		deco("Chest", "Button", V(0.14, 0.14, 0.06), at(0, ch * (0.35 - i * 0.22), -cd * 0.93 + math.abs(i - 2) * 0.1), K.GOLD, MAT.Metal, ball)
	end
	for _, sx in ipairs({ -1, 1 }) do
		deco("Chest", "Slash", V(0.16, ch * 0.72, 0.05), at(sx * cw * 0.24, 0.05, -cd * 0.8) * CFrame.Angles(0, sx * 0.3, 0), DOUBLET_LT, MAT.Fabric)
	end
	for i = 0, 5 do
		local a = i / 5 * math.pi
		deco("Chest", "SpoonChain", V(0.08, 0.08, 0.08), at(math.cos(a) * cw * 0.32, ch * 0.42 - math.sin(a) * 0.5, -cd * 0.72), K.GOLD, MAT.Metal, ball)
	end
	deco("Chest", "Spoon", V(0.14, 0.42, 0.06), at(0, ch * 0.42 - 0.72, -cd * 0.95), K.LIGHT, MAT.Metal)
	-- green stains down its front
	for _ = 1, 5 do
		local h = rng:NextNumber(0.3, 0.9)
		deco("Chest", "Stain", V(rng:NextNumber(0.1, 0.24), h, 0.04), at(rng:NextNumber(-0.25, 0.25) * cw, ch * 0.25 - h / 2, -cd * 0.92), BILE, MAT.SmoothPlastic).Transparency = 0.2
	end
	deco("Hips", "Trunks", V(hw * 1.35, 1.25, hd * 1.45), at(0, -0.35, 0), Color3.fromRGB(26, 70, 62), MAT.Fabric, ball)
	deco("Hips", "Belt", V(hw * 1.35, 0.22, hd * 1.4), at(0, 0.32, 0), K.GOLD, MAT.Metal)
	deco("LUpperArm", "Towel", V(aw * 1.45, ua * 0.55, aw * 1.45), at(0, 0, 0), K.PORCELAIN, MAT.Fabric)
	deco("LLowerArm", "TowelFall", V(aw * 1.15, la * 1.05, 0.08), at(0, -la * 0.2, aw * 0.55), K.PORCELAIN, MAT.Fabric)
	for _, n in ipairs({ "R", "L" }) do
		deco(n .. "UpperArm", "Puff", V(aw * 1.5, ua * 0.5, aw * 1.5), at(0, ua * 0.2, 0), DOUBLET_LT, MAT.Fabric, ball)
		deco(n .. "LowerArm", "Bare", V(aw * 1.05, la * 0.7, aw * 1.05), at(0, -la * 0.15, 0), SKIN, MAT.SmoothPlastic)
		deco(n .. "Foot", "Shoe", V(0.68, 0.26, 1.12), at(0, 0, -0.05), K.GOLD, MAT.Metal)
		deco(n .. "Shin", "Hose", V(lw * 1.02, 1.05, lw * 1.02), at(0, 0, 0), SKIN, MAT.SmoothPlastic)
	end
end

M.Weapons = {
	-- a gold ewer: a tall belly, a long spout, a handle; a green slop in its neck
	GoldEwer = function(w)
		local gold = K.GOLD
		local handle = w.mk("Grip", Vector3.new(0.24, 0.8, 0.24), gold, Enum.Material.Metal)
		w.add(w.mk("Neck", Vector3.new(0.46, 0.6, 0.46), gold, Enum.Material.Metal), -0.75)
		local b = w.mk("Belly", Vector3.new(1.3, 1.65, 1.3), gold, Enum.Material.Metal)
		b.Shape = Enum.PartType.Ball
		w.add(b, -1.6)
		w.add(w.mk("Band", Vector3.new(1.34, 0.14, 1.34), K.ROSE, Enum.Material.Metal), -1.6)
		w.add(w.mk("Foot", Vector3.new(0.84, 0.18, 0.84), K.TARNISH, Enum.Material.Metal), -2.5)
		local mouth = w.mk("EwerMouth", Vector3.new(0.3, 0.3, 0.3), BILE, Enum.Material.Neon)
		w.add(mouth, -0.45, nil, -0.22)
		w.add(w.mk("Spout", Vector3.new(0.2, 1.3, 0.2), gold, Enum.Material.Metal), -1.1, CFrame.Angles(math.rad(-30), 0, 0), -0.72)
		return { handle = handle, bladeLen = 2.5 }
	end,
}

M.Def = K.def({
	HP = 410, Speed = 8.5, Scale = 1.3, Damage = 34, Range = 7.5, HalfAngle = 60, Lunge = 6, Poise = 55, Stagger = 0.55, StaggerPush = 12,
	Windup = 0.8, Recover = 1.1, Engage = 24, Close = 7, Weapon = "GoldEwer", IdleGrip = "CBHold", Radius = 1.9, Skin = SKIN, Cloth = DOUBLET,
})

local function pool(pos)
	K.cloud(pos, { radius = 6.5, life = 5, color = WINE, rate = 32, poison = Config.Usher.Poison })
end
local function toast(e, tRoot)
	K.setGrip(e, "GToss", 0.5)
	K.setBody(e, "GBSet", 0.5)
	if not K.hold(e, 0.8, tRoot) then
		return false
	end
	K.setGrip(e, "GTossed", 0.14)
	K.setBody(e, "GBFling", 0.14)
	task.wait(0.1)
	if not e.alive then
		return false
	end
	local from = K.hand(e) + Vector3.new(0, 1, 0)
	-- thrown up in an arc to land about where you are: flight time from how far
	local to = tRoot.Position - Vector3.new(0, 2.6, 0)
	local T = math.clamp((to - from).Magnitude / 34, 0.45, 1.1)
	local G = 70
	local vel = (to - from) / T + Vector3.new(0, 0.5 * G * T, 0)
	K.shot(e, { from = from, vel = vel, gravity = G, damage = 18, level = "Medium", radius = 2, life = 3, size = Vector3.new(1.4, 1.4, 1.4), color = BILE, material = Enum.Material.Neon, trail = WINE, onLand = pool })
	K.sound(e, "Lunge", 0.7, 1.2)
	return true
end
local function tasting(e, tRoot)
	K.setGrip(e, "CBDrink", 0.4)
	return K.breath(e, tRoot, {
		part = K.partOf(e, "MouthGlow"), setBody = "CBBDrink", draw = 1.15, time = 1.25, reach = 12, half = 22, damage = 9, tick = 0.3, poison = Config.Usher.Poison,
		c0 = Color3.fromRGB(200, 220, 110), c1 = BILE, c2 = Color3.fromRGB(44, 64, 20), glow = 0.3, spread = 5, pitch = 0.7,
	})
end

M.attack = K.brain(function(e, tRoot, d)
	if d > 9 then
		return toast(e, tRoot), 1
	elseif d > 7 or math.random() < 0.45 then
		return tasting(e, tRoot), 1.2
	end
	return K.strike(e, tRoot, { set = "GCock", setBody = "GBSet", tell = 0.7, swing = "GCut", swingBody = "GBStrike", time = 0.14, range = 7.5, half = 60, damage = 36, speed = 0.8 }), 1
end)

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Cupbearer</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">60471c012dc1476aa48f373cc06e6aff</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX734384205A5344D1BD526C311149A4BA">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE WARDEN, hybrid C: THE LOCKED BELL. The true fusion. Its head is a bell built of cage bars, with a flame shut inside for a
-- clapper, and its great key ends in a bell of its own, so everything the key does now rings. It drives the key into the floor and
-- TURNS it, and the note rolls out from the lock. The floor split ends in a note. The third cut of a run rings where it lands.
-- Phase 2: the flame breaks out, the key burns, the lock turns twice, and the thrown key rings when it comes home.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Fight = require(ReplicatedStorage:WaitForChild("WardenFight"))
local Garb = require(ReplicatedStorage:WaitForChild("WardenGarb"))
local Turnkey = require(script.Parent:WaitForChild("WardenTurnkey"))
local Bell = require(script.Parent:WaitForChild("WardenBell"))

local S = 3.5
local K = S / 1.95
local M = {}
M.Kind = "WardenLockedBell"
M.Proportions = { girth = 1.08, arm = 1.25, hunch = 0.18, twoHand = -0.8, walkRef = 2.8, cadence = 0.85 }
M.IdlePose = "TKIdle"
local COAT, COAT_DK, IRON, IRON_DK, FLAME = Color3.fromRGB(46, 50, 46), Color3.fromRGB(28, 30, 28), Color3.fromRGB(70, 68, 66), Color3.fromRGB(38, 36, 36), Color3.fromRGB(166, 220, 226)
M.Colors = { skin = COAT_DK, torso = COAT, legs = COAT_DK, arms = COAT }
M.FistSkin = true

function M.Look(k)
	Bell.LookRobe(k, COAT, COAT_DK)
	Turnkey.LookKeys(k)
	local deco, parts, V, at, MAT = k.deco, k.parts, k.V, k.at, k.MAT
	parts.Head.Transparency = 1
	-- the bell's true shape, in bars you can see through: lip, waist, shoulder
	local radius = Bell.bellRadius
	local heights = { -1.08, -0.92, -0.62, -0.25, 0.25, 0.62, 0.86 }
	local function bar(p, q, thick)
		deco("Head", "BellBar", V(thick, thick, (q - p).Magnitude + 0.06), at((p.X + q.X) / 2, (p.Y + q.Y) / 2, (p.Z + q.Z) / 2) * CFrame.lookAt(Vector3.zero, q - p), IRON, MAT.Metal)
	end
	local N = 16
	local function point(i, y)
		local a = i / N * 2 * math.pi
		return Vector3.new(math.sin(a) * radius(y), y, math.cos(a) * radius(y))
	end
	for i = 0, N - 1 do
		for j = 1, #heights - 1 do
			bar(point(i, heights[j]), point(i, heights[j + 1]), 0.11)
		end
	end
	-- rim, waist and shoulder hoops
	for _, y in ipairs({ -1.08, -0.92, -0.25, 0.62 }) do
		Garb.hoop(k, "Head", y, radius(y), radius(y), 20, y == -1.08 and 0.16 or 0.09, y == -1.08 and IRON or IRON_DK, MAT.Metal, "BellHoop")
	end
	-- the crown, cast solid
	local y = 0.86
	while y < 1.09 do
		Garb.disc(k, "Head", y, radius(y), 0.07, IRON_DK, MAT.Metal, "BellCrown")
		y += 0.05
	end
	Bell.bellHanger(k, IRON, IRON_DK)
	-- the flame, shut in where the clapper would hang
	local flame = deco("Head", "BellFlame", V(0.85, 1.25, 0.85), at(0, 0, 0), FLAME, MAT.Neon, Enum.PartType.Ball)
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness, light.Shadows = FLAME, 34, 1.4, false
	light.Parent = flame
end

M.Weapons = {
	-- the great key, with a bell for a bit
	BellKey = function(w)
		local mk, add = w.mk, w.add
		local green, dark = Color3.fromRGB(88, 116, 100), Color3.fromRGB(56, 76, 66)
		local handle = Turnkey.keyShank(w)
		local function ring(name, y, h, d, color)
			local p = mk(name, Vector3.new(h, d, d), color, Enum.Material.Metal)
			p.Shape = Enum.PartType.Cylinder
			add(p, y, Garb.UP)
		end
		-- slices of a small true bell, mouth to the end of the key
		ring("BitLip", -5.95, 0.12, 2.55, green)
		ring("Bit", -5.78, 0.2, 2.2, green)
		ring("BitFlare", -5.56, 0.24, 1.72, dark)
		ring("BitWaist", -5.26, 0.36, 1.42, green)
		ring("BitBand", -5.08, 0.06, 1.5, dark)
		ring("BitWaist2", -4.86, 0.36, 1.32, green)
		ring("BitShoulder", -4.62, 0.14, 1.12, dark)
		ring("BitCrown", -4.5, 0.12, 0.72, green)
		return { handle = handle, bladeLen = 5.6, gripC1 = CFrame.new(0, 1.05 * w.scale, 0) }
	end,
}
local R = math.rad
M.Grips = {
	-- the key in the floor, a quarter turn round
	LBTurned = { Vector3.new(0.3, -0.6, -2.3), CFrame.Angles(R(55), 0, 0) * CFrame.Angles(0, R(90), 0) },
}

function M.init(core)
	local F = Fight.init(core)
	local bl = Bell.moves(core)
	local SOUNDS, playSound, pose, burst, FxRemote = core.SOUNDS, core.playSound, core.pose, core.burst, core.FxRemote
	local function ringAt(b, at, reach)
		bl.bellSound(b, 0.9)
		FxRemote:FireAllClients("Shake", at, 0.5)
		burst(at + Vector3.new(0, 1, 0), bl.NOTE, 18, 0.35, 16)
		F.wave(b, at, 22, reach, bl.NoteDamage, "Medium")
	end

	-- THE LOCK: bent over the key where it's stuck, a slow grind, and it turns: the note rolls out from the floor. You can hit it the
	-- whole time, and you get a long opening afterwards, if you got through the note
	local function turnLock(b, _, at)
		for i = 1, F.phase2() and 2 or 1 do
			playSound(b.root, SOUNDS.Unsheath, 0.9, 0.35)
			if not F.hold(b, 0.8 * F.tempo()) then
				return
			end
			pose(b, i == 1 and "LBTurned" or "TKStuck", 0.16)
			playSound(b.root, SOUNDS.Impact, 0.9, 0.7)
			if not F.hold(b, 0.16) then
				return
			end
			ringAt(b, at, 72)
		end
		F.recover(b, 1.5, "TKHaul")
	end
	local tk = Turnkey.moves(core, K, {
		stuck = turnLock,
		splitEnd = function(b, at)
			ringAt(b, at, 34)
		end,
		onCatch = function(b)
			ringAt(b, core.flat(b.root.Position), 72)
		end,
	})

	-- THE RUN: three cuts, the last of them ringing where it lands
	local function run(b, target)
		F.halt(b)
		if not tk.cut(b, target, "TKShoulder", "TKCutMid", "TKCutEnd", "TKUp", "TKCutThrough", 0.85, 5) or not F.hold(b, 0.2) then
			return
		end
		if not tk.cut(b, target, "TKBackSet", "TKBackMid", "TKBackEnd", "TKBackSet", "TKBackThrough", 0.62, 4) or not F.hold(b, 0.2) then
			return
		end
		if not tk.cut(b, target, "TKShoulder", "TKCutMid", "TKCutEnd", "TKUp", "TKCutThrough", 0.62, 4, "Large") then
			return
		end
		ringAt(b, tk.tipFloor(b), 28)
		F.recover(b, 1.4, "TKHaul")
	end

	Fight.define({
		id = "LockedBell",
		label = "The Locked Bell",
		kind = M.Kind,
		scale = S,
		weapon = "BellKey",
		idleGrip = "TKRest",
		hp = 800,
		poise = 175,
		stagger = 2.7,
		radius = 2.4 * K,
		walk = 10,
		turn = 78,
		rest = { 0.6, 1.3 },
		keep = { 15, 25 },
		phase2At = 0.5,
		tempo2 = 0.88,
		restMult2 = 0.75,
		moves = {
			{ name = "Run", fn = run, min = 0, max = 26, weight = 5, cd = 2.5, fast = true },
			{ name = "Lock", fn = tk.thrust, min = 8, max = 40, weight = 4.5, cd = 6 },
			{ name = "Overhead", fn = tk.overhead, min = 0, max = 38, weight = 3.5, cd = 6 },
			{ name = "Spin", fn = tk.spin, min = 0, max = 22, weight = 2, cd = 7, behind = true },
			{ name = "Toll", fn = bl.toll, min = 16, max = 95, weight = 3.5, cd = 8 },
			{ name = "Hook", fn = tk.hook, min = 38, max = 90, weight = 3, cd = 7 },
			{ name = "ThrowKey", fn = tk.throwKey, min = 20, max = 90, weight = 3, cd = 11, phase2 = true },
		},
		idle = tk.idle,
		onStagger = tk.onStagger,
		intro = bl.intro,
		-- phase 2: the flame breaks out of the bars and the key takes fire from it
		phase2 = function(b)
			local flame = b.model:FindFirstChild("BellFlame")
			if flame then
				local e = Instance.new("Fire")
				e.Size, e.Heat, e.Color, e.SecondaryColor = 12, 8, FLAME, Color3.fromRGB(40, 70, 90)
				e.Parent = flame
			end
			tk.ignite(b)
			bl.phase2(b)
		end,
	})
end

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">WardenLockedBell</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">32901a4befc547d0ad08005cf5c51b69</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXC7D12158C99742D6B2EA93364BCBAA1C">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE WARDEN, hybrid B: THE CHAINED BELL. The Bellhead's body and rhythm, with the Turnkey's chain and keys. It still fights to its
-- count, but you can't simply wait the count out at range any more: the chain drags you in, and the next note goes off right on
-- top of you. Phase 2: the bell cracks, and it throws the clapper, which rings out another note when it comes home.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Fight = require(ReplicatedStorage:WaitForChild("WardenFight"))
local Garb = require(ReplicatedStorage:WaitForChild("WardenGarb"))
local Turnkey = require(script.Parent:WaitForChild("WardenTurnkey"))
local Bell = require(script.Parent:WaitForChild("WardenBell"))

local S = 3.7
local M = {}
M.Kind = "WardenChainedBell"
M.Proportions = table.clone(Bell.Proportions)
M.IdlePose = "BLIdle"
M.Colors = Bell.Colors
M.FistSkin = true

function M.Look(k)
	Bell.LookRobe(k)
	Bell.LookBell(k)
	Turnkey.LookKeys(k)
	-- the chain, wound up its left arm and hung across its chest
	local deco, V, at, MAT, aw, la, ch, cd = k.deco, k.V, k.at, k.MAT, k.aw, k.la, k.ch, k.cd
	local iron = Color3.fromRGB(58, 56, 54)
	for i = 0, 4 do
		Garb.hoop(k, "LLowerArm", la / 2 - 0.2 - i * la / 5.5, aw * 0.98, aw * 0.98, 10, 0.15, iron, MAT.Metal, "ChainWrap")
	end
	for i = -3, 3 do
		deco("Chest", "ChainLink", V(0.26, 0.2, 0.1), at(i * 0.3, i * 0.26, -cd * 0.9 - (3 - math.abs(i)) * 0.03) * CFrame.Angles(0, 0, 0.72), iron, MAT.Metal)
	end
	deco("Chest", "ChainHook", V(0.34, 0.5, 0.14), at(0.98, ch * 0.42 - 0.95, -cd * 0.9), iron, MAT.Metal)
end

function M.init(core)
	local bl = Bell.moves(core)
	local F = Fight.init(core)
	local tk = Turnkey.moves(core, S / 1.95, {
		afterHook = bl.toll,
		onCatch = function(b)
			bl.bellSound(b, 1)
			F.wave(b, core.flat(b.root.Position), 22, 72, bl.NoteDamage, "Medium")
		end,
	})
	Fight.define({
		id = "ChainedBell",
		label = "The Chained Bell",
		kind = M.Kind,
		scale = S,
		weapon = "Clapper",
		idleGrip = "BLRest",
		hp = 780,
		poise = 170,
		stagger = 2.8,
		radius = 4.6,
		walk = 9.5,
		turn = 72,
		rest = { 0.65, 1.3 },
		keep = { 15, 24 },
		phase2At = 0.5,
		tempo2 = 0.88,
		restMult2 = 0.75,
		moves = {
			{ name = "Toll", fn = bl.toll, min = 0, max = 95, weight = 3, cd = 5 },
			{ name = "TollThree", fn = bl.tollThree, min = 14, max = 95, weight = 4, cd = 9 },
			{ name = "Swing", fn = bl.swing, min = 0, max = 27, weight = 6, cd = 2.5, fast = true, behind = true },
			{ name = "Down", fn = bl.down, min = 8, max = 30, weight = 4, cd = 4 },
			{ name = "Headlong", fn = bl.headlong, min = 3, max = 30, weight = 3, cd = 10 },
			{ name = "Hook", fn = tk.hook, min = 28, max = 90, weight = 5, cd = 7 },
			{ name = "ThrowClapper", fn = tk.throwKey, min = 20, max = 90, weight = 3, cd = 11, phase2 = true },
		},
		idle = bl.idle,
		onStagger = bl.onStagger,
		intro = bl.intro,
		phase2 = bl.phase2,
	})
end

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">WardenChainedBell</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">dff17a031c5749cca2e4d7c3473faee5</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXF5B25BE5549E416CBE86B1ECFF3782A5">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE BELL WARDEN (id "Tollkeeper"). The tall gaunt jailer in his greatcoat, stooped under a bronze bell, and in both hands the great maul
-- he rings it with: a timber haft as thick as a man and an iron-bound head wider than you are tall. The first boss of the game, so
-- everything is heavy and given a long look first. Up close he heaves it side to side and brings it down; he lunges with it, off
-- balance, and needs a moment to recover; hang back and he comes dragging it at a run, or tolls you back in with a note you roll through.
-- Phase 2 is another fight: he strikes the bell once too hard, it cracks, and the maul falls out of his numbed hands and stays where
-- it lands. Bare handed, he's fast and wants you close, and his only weapon is the bell on his shoulders: he throws it into the floor
-- face first, walks a line of those at you, and leaps the room to do it on top of you. Each one leaves him bent over and open.
-- His maul never goes through the floor: its head stops just above it. Every grip here keeps it so (hands are relative to his root,
-- which stands 3 units up; the head's centre is 4.6 units from the hands, and it's 1.05 in radius and 1.6 either side of the haft).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Fight = require(ReplicatedStorage:WaitForChild("WardenFight"))
local Garb = require(ReplicatedStorage:WaitForChild("WardenGarb"))
local Turnkey = require(script.Parent:WaitForChild("WardenTurnkey"))
local Bell = require(script.Parent:WaitForChild("WardenBell"))

local S = 3.4
local K = S / 1.95
local M = {}
M.Kind = "WardenTollkeeper"
M.Proportions = table.clone(Turnkey.Proportions)
M.IdlePose = "TKIdle"
M.Poses = {
	-- phase 2, the maul gone: bowed under the bell, long arms hanging and swinging
	TP2Stalk = { drop = 0.4, lean = 0.55, head = 0.35, footR = -0.3, footL = 0.35, spread = 0.24, la1 = 0.25, la3 = -0.25, lel = 0.5, ra1 = 0.25, ra3 = 0.25, rel = 0.5, breathe = 5 },
	-- reared right back, arms flung out behind the bell's weight
	TP2Rear = { drop = 0.1, lean = -0.6, head = -0.55, footR = -0.6, footL = 0.5, spread = 0.3, la1 = 1.2, la3 = -0.8, lel = 0.5, ra1 = 1.2, ra3 = 0.8, rel = 0.5, breathe = 6, freeL = 0 },
	-- the whole top of him thrown down, mouth of the bell first
	TP2Slam = { drop = 1.7, lean = 1.4, head = 0.35, footR = 0.9, footL = -1.2, spread = 0.4, la1 = -0.5, la3 = -0.8, lel = 0.1, ra1 = -0.5, ra3 = 0.8, rel = 0.1, breathe = 7, freeL = 0 },
	-- still down there, propped on his hands, ears full of it
	TP2Stuck = { drop = 1.5, lean = 1.15, side = 0.1, head = 0.45, footR = 0.9, footL = -1.1, spread = 0.38, la1 = 0.9, la3 = -0.3, lel = 0.3, ra1 = 0.9, ra3 = 0.3, rel = 0.3, breathe = 7, freeL = 0 },
	-- both hands up on the bell, wrenching at it
	TP2Clutch = { drop = 0.55, lean = 0.3, side = -0.1, head = 0.3, footR = 0.3, footL = -0.4, spread = 0.32, la1 = 2.2, la3 = -0.35, lel = 1.3, ra1 = 2.2, ra3 = 0.35, rel = 1.3, breathe = 7, freeL = 0 },
	-- sunk deep to leap, then knees up in the air
	TP2Crouch = { drop = 1.25, lean = 0.6, head = -0.2, footR = 0.5, footL = -0.5, spread = 0.36, la1 = -0.6, la3 = -0.5, lel = 0.3, ra1 = -0.6, ra3 = 0.5, rel = 0.3, breathe = 6, freeL = 0 },
	TP2Air = { drop = 0.2, lean = -0.2, head = -0.3, tuck = 0.7, la1 = 1.5, la3 = -0.9, lel = 0.4, ra1 = 1.5, ra3 = 0.9, rel = 0.4, freeL = 0 },
}
M.Colors = Turnkey.Colors
M.FistSkin = true

local BRONZE = {
	main = Color3.fromRGB(150, 106, 58),
	dark = Color3.fromRGB(94, 64, 36),
	light = Color3.fromRGB(204, 166, 98),
	streak = Color3.fromRGB(218, 184, 118),
	glow = Color3.fromRGB(240, 206, 150),
}

function M.Look(k)
	Turnkey.LookCoat(k)
	Bell.LookBell(k, BRONZE)
end

M.Weapons = {
	-- the great maul: timber staves bound in iron, a leather grip, and a barrel of an iron head with bronze hoops to match the bell
	TollMaul = function(w)
		local mk, add, s = w.mk, w.add, w.scale
		local iron, dark = Color3.fromRGB(74, 70, 66), Color3.fromRGB(38, 36, 36)
		local timber, timberDk, leather = Color3.fromRGB(78, 56, 38), Color3.fromRGB(50, 36, 26), Color3.fromRGB(58, 42, 30)
		local rng = Random.new(1612)
		local function rod(name, y, long, d, color, mat)
			local p = mk(name, Vector3.new(long, d, d), color, mat or Enum.Material.Metal)
			p.Shape = Enum.PartType.Cylinder
			add(p, y, Garb.UP)
		end
		local handle = mk("Haft", Vector3.new(0.2, 3, 0.2), timber, Enum.Material.Wood)
		handle.Transparency = 1
		-- the haft: a dark core, staves round it, iron bands
		rod("HaftCore", -1.05, 5.5, 0.58, timberDk, Enum.Material.Wood)
		for i = 0, 7 do
			local a = i / 8 * 2 * math.pi
			local stave = mk("Stave", Vector3.new(0.2, 5.4, 0.12), timber:Lerp(timberDk, rng:NextNumber() * 0.6), Enum.Material.Wood)
			add(stave, -1.05, CFrame.new(math.sin(a) * 0.27 * s, 0, math.cos(a) * 0.27 * s) * CFrame.Angles(0, a, 0))
		end
		for _, y in ipairs({ -0.75, -1.5, -2.25 }) do
			rod("HaftBand", y, 0.16, 0.72, dark)
		end
		-- the leather where the hands go, in turns
		for i = 0, 9 do
			rod("GripWrap", 1.25 - i * 0.17, 0.15, 0.68 + (i % 2) * 0.03, leather:Lerp(timberDk, (i % 3) * 0.2), Enum.Material.Leather)
		end
		-- the pommel
		rod("Pommel", 1.68, 0.2, 0.92, iron)
		rod("Pommel", 1.82, 0.14, 0.7, dark)
		-- iron straps running up the haft from the head
		for i = 0, 3 do
			local a = (i + 0.5) / 4 * 2 * math.pi
			add(mk("Langet", Vector3.new(0.2, 0.9, 0.08), iron, Enum.Material.Metal), -2.65, CFrame.new(math.sin(a) * 0.35 * s, 0, math.cos(a) * 0.35 * s) * CFrame.Angles(0, a, 0))
		end
		-- the head, across the haft along x, in thin slices: flared faces, a drawn-in waist
		local function headR(x)
			local t = math.abs(x)
			return t > 1.42 and 1.05 or t > 1.28 and 0.97 or 0.88 + 0.06 * (t / 1.28) ^ 2
		end
		local main
		local x = -1.54
		while x <= 1.55 do
			local p = mk("HeadSlice", Vector3.new(0.14, headR(x) * 2, headR(x) * 2), iron:Lerp(dark, rng:NextNumber() ^ 1.2), Enum.Material.Metal)
			p.Shape = Enum.PartType.Cylinder
			add(p, -3.8, CFrame.new(x * s, 0, 0))
			main = main or p
			x += 0.11
		end
		main.Name = "MaulHead"
		-- bronze hoops, and a boss on each striking face
		for _, hx in ipairs({ -1.3, -0.62, 0.62, 1.3 }) do
			local p = mk("HeadHoop", Vector3.new(0.1, (headR(hx) + 0.05) * 2, (headR(hx) + 0.05) * 2), BRONZE.main, Enum.Material.Metal)
			p.Shape = Enum.PartType.Cylinder
			add(p, -3.8, CFrame.new(hx * s, 0, 0))
		end
		for _, side in ipairs({ -1, 1 }) do
			local p = mk("FaceBoss", Vector3.new(0.12, 1.1, 1.1), dark, Enum.Material.Metal)
			p.Shape = Enum.PartType.Cylinder
			add(p, -3.8, CFrame.new(side * 1.62 * s, 0, 0))
			-- and a ring of rivets round it, so the face isn't one flat disc
			for i = 0, 9 do
				local a = i / 10 * 2 * math.pi
				local r = mk("HeadRivet", Vector3.new(0.16, 0.16, 0.16), BRONZE.light, Enum.Material.Metal)
				r.Shape = Enum.PartType.Ball
				add(r, -3.8, CFrame.new(side * 1.61 * s, math.sin(a) * 0.82 * s, math.cos(a) * 0.82 * s))
			end
		end
		-- rivets round the barrel, two rows either side
		for _, hx in ipairs({ -0.95, 0.95 }) do
			for i = 0, 9 do
				local a = i / 10 * 2 * math.pi
				local p = mk("HeadRivet", Vector3.new(0.14, 0.14, 0.14), BRONZE.light, Enum.Material.Metal)
				p.Shape = Enum.PartType.Ball
				add(p, -3.8, CFrame.new(hx * s, math.sin(a) * headR(hx) * s, math.cos(a) * headR(hx) * s))
			end
		end
		return { handle = handle, bladeLen = 3.2, gripC1 = CFrame.new(0, 0.8 * s, 0) }
	end,
}

-- a grip by what it looks like: hands at pos, the head out along u, its striking faces along v
local function G(x, y, z, u, v)
	u = u.Unit
	local across = (v - u * v:Dot(u)).Unit
	local down = -u
	return { Vector3.new(x, y, z), CFrame.fromMatrix(Vector3.zero, across, down, across:Cross(down)) }
end
local V3 = Vector3.new
M.Grips = {
	TLRest = G(0.7, 0.75, -2.1, V3(0.12, -0.4, -0.9), V3(1, 0, 0.15)), -- (held out before him, the head low and off the floor)
	TLPlant = G(0.3, 0.1, -1.9, V3(0, -0.35, -0.94), V3(1, 0, 0)), -- (held out low, leaning on it)
	TLBroke = G(1.2, 3.2, -0.9, V3(0.1, 0.95, 0.3), V3(1, 0, 0)),
	-- the heave, and back
	TLHeaveSet = G(2.1, 1.0, 0.8, V3(0.75, 0.35, 0.55), V3(0.6, 0, -0.8)),
	TLHeaveMid = G(0.6, -0.1, -2.4, V3(0.05, -0.16, -1), V3(-1, 0, 0)),
	TLHeaveEnd = G(-1.9, 0, -0.7, V3(-1, -0.12, -0.1), V3(0, 0, 1)),
	TLBackSet = G(-1.8, 0.9, 0.2, V3(-0.95, 0.25, 0.25), V3(0, 0, 1)),
	TLBackMid = G(0.3, -0.1, -2.5, V3(-0.05, -0.16, -1), V3(-1, 0, 0)),
	TLBackEnd = G(2.0, 0, -0.6, V3(1, -0.12, -0.1), V3(0, 0, -1)),
	-- the lunge
	TLThrustSet = G(1.3, 1.1, 1.6, V3(0, -0.05, -1), V3(1, 0, 0)),
	TLThrust = G(0.3, -0.2, -2.7, V3(0, -0.16, -1), V3(1, 0, 0)),
	TLStuck = G(0.3, -0.5, -2.2, V3(0, -0.25, -1), V3(1, 0, 0)), -- (dragged down after it, the head just off the floor)
	-- brought down
	TLHigh = G(0.6, 3.4, -1.3, V3(0, 0.95, 0.3), V3(0, 0.3, -0.95)),
	TLDown = G(0.2, 0.05, -2.4, V3(0, -0.22, -0.97), V3(0, -0.97, 0.22)),
	-- the turn
	TLWind = G(1.9, 0.2, 1.5, V3(0.7, -0.1, 0.7), V3(0.7, 0, -0.7)),
	TLSweepR = G(2.5, -0.1, -0.5, V3(1, -0.1, -0.2), V3(0, 0, -1)),
	TLSweepF = G(0, -0.1, -2.8, V3(0, -0.1, -1), V3(-1, 0, 0)),
	TLSweepL = G(-2.5, -0.1, -0.5, V3(-1, -0.1, -0.2), V3(0, 0, 1)),
	TLSweepB = G(-1.3, -0.1, 2.1, V3(-0.4, -0.1, 1), V3(1, 0, 0)),
	-- dragged behind him at a run, then swung up
	TLDrag = G(1.7, -0.1, 1.4, V3(0.35, -0.22, 0.9), V3(0.93, 0, -0.36)),
	TLUpSide = G(2.2, -0.1, -0.4, V3(1, -0.12, -0.1), V3(0, 0, -1)),
	TLUpMid = G(0.7, 0.3, -2.4, V3(0, -0.1, -1), V3(-1, 0, 0)),
	TLUpEnd = G(0.4, 2.7, -1.2, V3(0, 0.85, -0.5), V3(-1, 0, 0)),
	-- his own bell, rung with the head's face
	TLBellSet = G(1.2, 1.2, -2.0, V3(-0.6, 0.5, -0.75), V3(0.75, 0.1, -0.6)),
	TLBellHit = G(1.4, 0.9, -2.7, V3(-4.1, 1.3, 1.7), V3(1, 0, 0)),
}
M.BodyFor = {}

function M.init(core)
	local F = Fight.init(core)
	local bl = Bell.moves(core)
	local SOUNDS, playSound, burst, pose, bodyPose, setTrail, dustCloud, crackLines, fadeAway, debrisChunks, flat, now, FxRemote = core.SOUNDS, core.playSound, core.burst, core.pose, core.bodyPose, core.setTrail, core.dustCloud, core.crackLines, core.fadeAway, core.debrisChunks, core.flat, core.now, core.FxRemote
	local D = { Heave = 18, Lunge = 22, Slam = 22, Blast = 12, Wheel = 20, Charge = 18, Note = 12, Face = 24, Line = 18, Leap = 26, Rattle = 14 }
	local NOTE = Color3.fromRGB(112, 92, 68) -- (old bronze shaken loose)
	local WALK = 10.5
	local REACH = 8 -- (how far ahead of him the bell's mouth comes down when he throws himself headlong)
	local HIT = 4.5 -- (how wide the head's path hurts, either side of the haft)
	local SLAM_AT = 7 * S -- (how far ahead of him the head comes down)

	-- The floor guard. A tween between two grips can swing the head down through the floor even when both grips clear it, so poses
	-- drive a stand-in weld and the real one copies it each frame, lifted by however much the maul would otherwise go under
	local function keepAboveFloor(b)
		local real = b.weld
		local wanted = Instance.new("Weld")
		wanted.Name, wanted.Enabled, wanted.C0, wanted.C1, wanted.Part1 = "GripPose", false, real.C0, real.C1, real.Part1
		wanted.Parent = real.Parent
		b.weld = wanted
		F.wrap(b, function()
			local c = wanted.C0
			local rootCF = b.root.CFrame
			local w = rootCF * c -- (in the world: his root can tilt as he moves, and at this reach a few degrees is over a stud)
			local up, across = w.UpVector.Y, w.RightVector.Y
			local head = up * -4.6 - math.abs(across) * 1.68 - math.sqrt(math.max(1 - across * across, 0)) * 1.1
			local pommel = up * 1.12 - math.sqrt(math.max(1 - up * up, 0)) * 0.46
			local low = w.Y + math.min(head, pommel) * S
			real.C0 = low < 0.3 and c + rootCF:VectorToObjectSpace(Vector3.new(0, 0.3 - low, 0)) or c
			return real.Parent ~= nil
		end)
	end

	local function under(b, dist)
		return flat(b.root.Position) + F.fwd(b) * dist
	end
	local function headFloor(b)
		local _, tip = F.ends(b)
		local p = tip or under(b, SLAM_AT)
		return Vector3.new(p.X, 0.15, p.Z)
	end

	-- one heave of it, side to side, the coil given a long look
	local function heaveOnce(b, target, set, mid, finish, bodySet, bodyThrough, tell, step, level)
		F.draw(b, set, bodySet, tell * 0.5 * F.tempo())
		playSound(b.root, SOUNDS.Unsheath, 0.7, 0.45)
		if not F.track(b, target, tell * F.tempo(), 0.6) then
			return false
		end
		setTrail(b, true)
		F.step(b, step * K, 0.3)
		playSound(b.root, SOUNDS.Lunge, 0.9, 0.5)
		bodyPose(b, bodyThrough, 0.2)
		pose(b, mid, 0.14, Enum.EasingStyle.Linear)
		task.delay(0.14, function()
			pose(b, finish, 0.16, Enum.EasingStyle.Quad)
		end)
		F.sweep(b, 0.3, D.Heave, level or "Medium", {}, HIT)
		setTrail(b, false)
		return F.free(b)
	end

	-- THE MAUL BROUGHT DOWN: up over his head, a held moment at the top, then folded down behind it. It stops a hand above the
	-- floor and the shock goes on without it
	local function slam(b, target)
		F.halt(b)
		if not F.beats(b, target, {
			{ "TLHeaveSet", "TKUp", 0.35 },
			{ "TLHigh", "TKOverhead", 0.6 },
		}, 0.7) then
			return
		end
		playSound(b.root, SOUNDS.Unsheath, 0.9, 0.42)
		if not F.track(b, target, 0.5, 0) then
			return
		end
		setTrail(b, true)
		F.draw(b, "TLDown", "TKFold", 0.12)
		playSound(b.root, SOUNDS.Lunge, 1, 0.42)
		F.sweep(b, 0.14, D.Slam, "Knockdown", {}, HIT)
		setTrail(b, false)
		if not F.live(b) then
			return
		end
		local at = headFloor(b)
		F.quake(b, at, 9, 1.3)
		debrisChunks(at + Vector3.new(0, 0.5, 0), 5, 18)
		dustCloud(at, 2.5, 7)
		fadeAway(crackLines(at, 4, 4, nil, nil, 0.2), 1.5, 1)
		F.hit(F.radius(at, 9, 8), {}, D.Blast, at, "Large")
		if F.free(b) then
			F.recover(b, 1.3, "TKHaul")
		end
	end

	-- THE HEAVE: right across him and back
	local function heave(b, target)
		F.halt(b)
		if not heaveOnce(b, target, "TLHeaveSet", "TLHeaveMid", "TLHeaveEnd", "TKUp", "TKCutThrough", 0.95, 5) or not F.hold(b, 0.25) then
			return
		end
		if not heaveOnce(b, target, "TLBackSet", "TLBackMid", "TLBackEnd", "TKBackSet", "TKBackThrough", 0.7, 4) then
			return
		end
		F.recover(b, 1.25, "TKHaul")
	end

	-- THE LUNGE: drawn right back, a glint down it, then all of him thrown after it, off balance, onto his front foot. He drags it back
	-- and gathers himself: your longest opening
	local function lunge(b, target)
		F.halt(b)
		if not F.beats(b, target, {
			{ "TLThrustSet", "TKThrustSet", 0.55 },
			{ "TLThrustSet", "TKThrustSet", 0.5, function()
				local _, tip = F.ends(b)
				if tip then
					burst(tip, Color3.fromRGB(240, 240, 230), 16, 0.4, 8)
				end
				playSound(b.root, SOUNDS.Unsheath, 0.8, 1.6)
			end },
		}, 0.75) then
			return
		end
		setTrail(b, true)
		F.draw(b, "TLThrust", "TKLunge", 0.1)
		playSound(b.root, SOUNDS.Lunge, 1, 0.55)
		F.step(b, 13 * K, 0.32)
		F.sweep(b, 0.32, D.Lunge, "Large", {}, HIT)
		setTrail(b, false)
		if not F.free(b) then
			return
		end
		F.draw(b, "TLStuck", "TKHaul", 0.14)
		local at = headFloor(b)
		playSound(b.root, SOUNDS.Impact, 0.7, 1.1)
		dustCloud(at, 1.6, 6)
		if F.hold(b, 1.45 * F.tempo()) then
			playSound(b.root, SOUNDS.Unsheath, 0.6, 0.6)
			F.idle(b)
			F.hold(b, 0.2)
		end
	end

	-- THE WHEEL: for when you're behind him. Sunk wide and wound away, then a whole turn on his heel with the maul held out, and he
	-- staggers out of it
	local function wheel(b, target)
		F.halt(b)
		if not F.beats(b, target, {
			{ "TLWind", "TKWind", 0.55 },
			{ "TLWind", "TKWind", 0.5, function()
				playSound(b.root, SOUNDS.Unsheath, 0.9, 0.38)
				dustCloud(F.feet(b), 2, 6)
			end },
		}, 0.55) then
			return
		end
		setTrail(b, true)
		local root = b.root
		root.Anchored = true
		local base = root.CFrame
		bodyPose(b, "TKSpin", 0.1)
		playSound(root, SOUNDS.Lunge, 1, 0.45)
		task.spawn(F.sweep, b, 0.8, D.Wheel, "Large", {}, HIT)
		local grips = { "TLSweepR", "TLSweepF", "TLSweepL", "TLSweepB", "TLSweepR" }
		for i, g in ipairs(grips) do
			if not F.live(b) then
				return
			end
			pose(b, g, 0.15, Enum.EasingStyle.Linear)
			local t0 = now()
			while now() - t0 < 0.16 do
				local a = ((i - 1) + (now() - t0) / 0.16) / #grips
				root.CFrame = base * CFrame.Angles(0, -a * math.pi * 1.5, 0)
				task.wait()
			end
		end
		setTrail(b, false)
		root.Anchored = false
		dustCloud(F.feet(b), 2, 6)
		F.recover(b, 1.3, "TKHaul")
	end

	-- THE DRAG: if you hang off. He hauls it behind him and comes at a run, sparks off the floor under it, and swings it up from
	-- the side when he gets to you. It's slow to turn: step aside as it comes
	local function charge(b, target)
		F.halt(b)
		if not F.beats(b, target, { { "TLDrag", "TKWind", 0.7, function()
			playSound(b.root, SOUNDS.Groan, 0.8, 0.5)
		end } }, 0.7) then
			return
		end
		bodyPose(b, "TKThrustSet", 0.3)
		b.hum.WalkSpeed = 26
		local t0, spark = now(), 0
		while now() - t0 < 1.7 do
			local tr = target:FindFirstChild("HumanoidRootPart")
			if not tr or not F.free(b) then
				b.hum.WalkSpeed = WALK
				return
			end
			if flat(tr.Position - b.root.Position).Magnitude < 19 then
				break
			end
			local dt = task.wait()
			F.turn(b, tr.Position, math.rad(55) * dt)
			b.hum:MoveTo(F.clamp(b.root.Position + F.fwd(b) * 12, 4))
			if now() > spark then
				spark = now() + 0.15
				local at = headFloor(b)
				burst(at + Vector3.new(0, 1, 0), Color3.fromRGB(255, 190, 110), 10, 0.25, 14)
				playSound(b.root, SOUNDS.Unsheath, 0.5, 0.5)
			end
		end
		b.hum.WalkSpeed = WALK
		F.halt(b)
		setTrail(b, true)
		playSound(b.root, SOUNDS.Lunge, 1, 0.5)
		F.step(b, 4 * K, 0.3)
		bodyPose(b, "TKCutThrough", 0.2)
		pose(b, "TLUpSide", 0.1, Enum.EasingStyle.Linear)
		task.delay(0.1, function()
			pose(b, "TLUpMid", 0.1, Enum.EasingStyle.Linear)
		end)
		task.delay(0.2, function()
			pose(b, "TLUpEnd", 0.14, Enum.EasingStyle.Quad)
			bodyPose(b, "TKOverhead", 0.2)
		end)
		F.sweep(b, 0.24, D.Charge, "Large", {}, HIT)
		setTrail(b, false)
		F.recover(b, 1.5, "TKHaul")
	end

	-- THE TOLL: the maul swung into his own bell; the note goes through the floor and you roll through it. It rattles him
	local function toll(b, target)
		F.halt(b)
		F.draw(b, "TLBellSet", "BLDraw", 0.66)
		playSound(b.root, SOUNDS.Unsheath, 0.5, 0.55)
		if not F.track(b, target, 0.95, 0.7) then
			return
		end
		F.draw(b, "TLBellHit", "BLStrike", 0.12)
		if not F.wait(b, 0.12) then
			return
		end
		bl.bellSound(b)
		FxRemote:FireAllClients("Shake", flat(b.root.Position), 0.55)
		burst(b.root.Position + Vector3.new(0, 14, 0), NOTE, 26, 0.45, 20)
		F.wave(b, flat(b.root.Position), 22, 72, D.Note, "Medium")
		F.recover(b, 1.4, "BLReel")
	end

	---------------------------------------------------------------------------
	-- phase 2: the maul's gone, and there's only the bell
	---------------------------------------------------------------------------
	-- it hits the floor where he's facing: the blast there and, if it's a big one, a ripple on out through the stone
	local function bellDown(b, radius, damage, level, ripple)
		local at = under(b, REACH)
		bl.bellSound(b, 1)
		F.quake(b, at, radius, 1.6)
		F.hit(F.radius(at, radius, 8), {}, damage, at, level)
		if ripple then
			F.wave(b, at, 20, ripple, D.Note, "Medium")
		end
	end
	local function throwBell(b, target, tell, step, radius, damage, level, ripple)
		if not F.beats(b, target, { { nil, "TP2Rear", tell, function()
			playSound(b.root, SOUNDS.Groan, 0.8, 0.45)
		end } }, tell * 0.7) then
			return false
		end
		F.draw(b, nil, "TP2Slam", 0.2)
		playSound(b.root, SOUNDS.Lunge, 1, 0.38)
		F.step(b, step, 0.2)
		if not F.wait(b, 0.2) then
			return false
		end
		bellDown(b, radius, damage, level, ripple)
		return F.free(b)
	end

	-- THE FACE SLAM: rocked right back, then the whole top of him thrown down onto you. He stays down a while
	local function faceSlam(b, target)
		F.halt(b)
		if throwBell(b, target, 0.85, 9, 9, D.Face, "Knockdown") then
			F.recover(b, 1.7, "TP2Stuck")
		end
	end

	-- THE PROCESSION: three of them, each from where the last one left him, coming down the room at you. The last rings through the
	-- floor, and then he's spent: your longest opening
	local function procession(b, target)
		F.halt(b)
		if not throwBell(b, target, 0.8, 12, 8, D.Line, "Large") or not throwBell(b, target, 0.5, 12, 8, D.Line, "Large") or not throwBell(b, target, 0.5, 12, 9.5, D.Face, "Knockdown", 34) then
			return
		end
		F.recover(b, 2.5, "TP2Stuck")
	end

	-- THE LEAP: if you run. Sunk right down, then the length of the room in the air, to come down bell first on where you stood
	local function leap(b, target)
		F.halt(b)
		if not F.beats(b, target, { { nil, "TP2Crouch", 0.8, function()
			playSound(b.root, SOUNDS.Groan, 1, 0.4)
			dustCloud(F.feet(b), 2, 6)
		end } }, 0.8) then
			return
		end
		local tr = target:FindFirstChild("HumanoidRootPart")
		if not tr then
			return
		end
		local from = b.root.Position
		local rel = flat(tr.Position - from)
		local to = F.clamp(flat(tr.Position) - (rel.Magnitude > 0.1 and rel.Unit or F.fwd(b)) * REACH, 8)
		playSound(b.root, SOUNDS.Lunge, 1, 0.34)
		dustCloud(F.feet(b), 3, 8)
		bodyPose(b, "TP2Air", 0.15)
		local diving = false
		if not F.arc(b, from, Vector3.new(to.X, from.Y, to.Z), 1, 24, function(t)
			if t > 0.65 and not diving then
				diving = true
				bodyPose(b, "TP2Slam", 0.3)
			end
		end) or not F.live(b) then
			return
		end
		bellDown(b, 10, D.Leap, "Knockdown", 44)
		F.recover(b, 2, "TP2Stuck")
	end

	-- THE RATTLE: get under him or behind him and he seizes the bell in both hands and wrenches it: no reach, little warning
	local function rattle(b, target)
		F.halt(b)
		if not F.beats(b, target, { { nil, "TP2Clutch", 0.55, function()
			playSound(b.root, SOUNDS.Unsheath, 0.9, 0.5)
		end } }, 0.2) then
			return
		end
		bodyPose(b, "BLReel", 0.08)
		local c = flat(b.root.Position)
		bl.bellSound(b, 1)
		FxRemote:FireAllClients("Shake", c, 0.7)
		burst(b.root.Position + Vector3.new(0, 14, 0), NOTE, 26, 0.45, 20)
		dustCloud(c, 3, 8)
		F.hit(F.radius(c, 14, 10), {}, D.Rattle, c, "Large")
		F.recover(b, 1.1, "BLReel")
	end

	local function idle(b)
		if F.phase2() then
			bodyPose(b, "TP2Stalk", 0.5)
			return
		end
		pose(b, "TLRest", 0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		bodyPose(b, "TKIdle", 0.55)
	end
	local function onStagger(b)
		if F.phase2() then
			bodyPose(b, "TP2Clutch", 0.15)
		else
			pose(b, "TLPlant", 0.2)
			bodyPose(b, "TKReel", 0.15)
		end
		bl.bellSound(b, 0.7)
	end
	-- the real weapon goes (his arms are their own again: the Puppeteer only poses hands onto a weapon he has) and a copy falls where
	-- he stood, lying on its haft and head, for the rest of the fight
	local function dropMaul(b)
		local copy, handle = F.cloneWeapon(b)
		local held = b.model:FindFirstChild("Weapon")
		if held then
			held:Destroy()
		end
		b.weld = nil
		if not copy then
			return
		end
		local trail = copy:FindFirstChildWhichIsA("Trail", true)
		if trail then
			trail:Destroy()
		end
		local along = flat(b.root.CFrame.RightVector).Unit -- (from the hands toward the head)
		local up = -(along * math.cos(0.113) + Vector3.yAxis * math.sin(0.113)) -- (the head's fatter than the pommel: lying, it's tilted so)
		local right = along:Cross(Vector3.yAxis)
		local at = F.clamp(flat(b.root.Position) + along * 4, 20)
		TweenService:Create(handle, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = CFrame.fromMatrix(at + Vector3.new(0, 2.35, 0), right, up, right:Cross(up)) }):Play()
		task.delay(0.5, function()
			if F.live(b) then
				F.quake(b, at + along * 3.8 * S, 5, 0.9)
			end
		end)
	end
	-- the entrance: bowed over his maul at the far end. He raises it and rings the fight in
	local function intro(b)
		pose(b, "TLPlant", 0.2)
		bodyPose(b, "TKReel", 0.2)
		task.wait(0.8)
		playSound(b.root, SOUNDS.Groan, 1, 0.4)
		bodyPose(b, "BLDraw", 1.1)
		pose(b, "TLBellSet", 1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		task.wait(1.15)
		pose(b, "TLBellHit", 0.1)
		bodyPose(b, "BLStrike", 0.1)
		task.wait(0.1)
		bl.bellSound(b, 1)
		FxRemote:FireAllClients("Shake", b.root.Position, 0.7)
		task.wait(0.8)
		idle(b)
		task.wait(0.4)
	end
	-- phase 2: he strikes it once too hard. The bell cracks, and the maul falls out of his hands
	local function phase2(b)
		F.halt(b)
		F.draw(b, "TLBellSet", "BLDraw", 0.5)
		if not F.wait(b, 0.65) then
			return
		end
		F.draw(b, "TLBellHit", "BLCracked", 0.1)
		if not F.wait(b, 0.1) then
			return
		end
		bl.bellSound(b, 1)
		FxRemote:FireAllClients("Shake", b.root.Position, 1)
		for _, c in ipairs(b.model:GetChildren()) do
			if c:IsA("BasePart") and c.Name == "BellCrack" then
				c.Transparency = 0
				burst(c.Position, NOTE, 22, 0.45, 18)
			end
		end
		F.wave(b, flat(b.root.Position), 22, 72, D.Note, "Medium")
		if not F.wait(b, 0.5) then
			return
		end
		dropMaul(b)
		bodyPose(b, "TP2Clutch", 0.25)
		playSound(b.root, SOUNDS.Groan, 1, 0.34)
		F.wait(b, 1.3)
		F.idle(b)
	end

	Fight.define({
		id = "Tollkeeper",
		label = "Bell Warden",
		kind = M.Kind,
		scale = S,
		weapon = "TollMaul",
		idleGrip = "TLRest",
		hp = 1200,
		poise = 180,
		stagger = 2.6,
		radius = 2.4 * K,
		walk = WALK,
		walk2 = 16.5,
		turn = 82,
		rest = { 0.55, 1.25 },
		keep = { 15, 25 },
		keep2 = { 7, 11 },
		phase2At = 0.5,
		tempo2 = 0.88,
		restMult2 = 0.5,
		moves = {
			{ name = "Heave", fn = heave, min = 0, max = 26, weight = 5, cd = 1.5, fast = true, phase1 = true },
			{ name = "Slam", fn = slam, min = 0, max = 34, weight = 3.5, cd = 6, phase1 = true },
			{ name = "Lunge", fn = lunge, min = 10, max = 40, weight = 4, cd = 5, phase1 = true },
			{ name = "Wheel", fn = wheel, min = 0, max = 22, weight = 2, cd = 7, behind = true, phase1 = true },
			{ name = "Drag", fn = charge, min = 28, max = 80, weight = 4, cd = 7, phase1 = true },
			{ name = "Toll", fn = toll, min = 18, max = 95, weight = 3.5, cd = 8, phase1 = true },
			{ name = "FaceSlam", fn = faceSlam, min = 0, max = 26, weight = 6, cd = 2.5, fast = true, phase2 = true },
			{ name = "Procession", fn = procession, min = 8, max = 38, weight = 4, cd = 9, phase2 = true },
			{ name = "Leap", fn = leap, min = 26, max = 95, weight = 6, cd = 7, phase2 = true },
			{ name = "Rattle", fn = rattle, min = 0, max = 13, weight = 2, cd = 5, behind = true, phase2 = true },
		},
		onSpawn = keepAboveFloor,
		idle = idle,
		onStagger = onStagger,
		intro = intro,
		phase2 = phase2,
	})
end

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">WardenTollkeeper</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">a7d4b10a35e54b99a25ce4c1fc4c3068</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX40E7CB227ED445068BF8C66F0236E77D">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE WARDEN, candidate 4: THE BELLHEAD. The prison's bell-ringer for so long that the bell has grown down over its shoulders: a
-- huge robed figure with an old green-iron bell where its head should be, and in both hands the bell's own clapper, as long as
-- it's tall. It keeps the prison's hours, and everything it does is in time. It strikes its own head and the note rolls out
-- across the floor as a wall you have to roll through: beat, beat, beat. Learn the count and you can walk right up to it.
-- Phase 1: the toll (one note, then three), the clapper swung low, the clapper brought down, and the bell itself thrown forward.
-- Phase 2 at half health: the bell cracks. Notes come faster and in pairs, and every toll now calls down a ring under your feet.
-- Fight's plumbing: ReplicatedStorage/WardenFight.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Fight = require(ReplicatedStorage:WaitForChild("WardenFight"))
local Garb = require(ReplicatedStorage:WaitForChild("WardenGarb"))

local S = 3.7
local M = {}
M.Kind = "WardenBell"
M.Proportions = { girth = 1.35, arm = 1.25, hunch = 0.2, twoHand = -0.9, walkRef = 2.6, cadence = 0.85 }
M.IdlePose = "BLIdle"
M.Poses = {
	-- at rest: weighed down by its own head, leaning on the clapper
	BLIdle = { drop = 0.35, lean = 0.22, head = 0.3, footR = -0.28, footL = 0.32, spread = 0.26, breathe = 3, freeL = 0 },
	-- the clapper drawn back, rearing the bell away from the blow
	BLDraw = { drop = 0.25, lean = -0.22, twist = -0.55, hip = -0.2, head = -0.2, side = -0.1, footR = -0.55, footL = 0.5, spread = 0.28, breathe = 4, freeL = 0 },
	-- striking its own head, and everything shaken by it
	BLStrike = { drop = 0.7, lean = 0.35, twist = 0.4, head = 0.5, side = 0.14, footR = 0.45, footL = -0.4, spread = 0.34, breathe = 5, freeL = 0 },
	-- reeling from the note
	BLReel = { drop = 0.6, lean = 0.5, side = -0.14, head = 0.55, footR = 0.2, footL = -0.35, spread = 0.36, breathe = 6, freeL = 0 },
	-- the low swing
	BLWind = { drop = 0.75, lean = 0.2, twist = -1.2, hip = -0.55, side = -0.1, look = 0.95, head = 0.05, footR = -0.7, footL = 0.75, spread = 0.4, breathe = 4, freeL = 0 },
	BLThrough = { drop = 0.95, lean = 0.55, twist = 1.1, hip = 0.55, side = 0.12, look = -0.5, head = 0.1, footR = 0.85, footL = -0.6, spread = 0.4, freeL = 0 },
	-- overhead, then folded down after it
	BLHigh = { drop = 0.05, lean = -0.38, head = -0.3, footR = -0.4, footL = 0.42, spread = 0.28, breathe = 4, freeL = 0 },
	BLFold = { drop = 1.3, lean = 1, head = 0.15, footR = 0.8, footL = -0.7, spread = 0.38, freeL = 0 },
	-- THE BELL DROPPED: rocked back, then the whole top of it thrown down forward, mouth first
	BLRock = { drop = 0.2, lean = -0.55, head = -0.5, footR = -0.55, footL = 0.45, spread = 0.3, la1 = 1, la3 = -0.8, lel = 0.5, breathe = 5, freeL = 0 },
	BLHeadlong = { drop = 1.7, lean = 1.4, head = 0.35, footR = 0.9, footL = -1.2, spread = 0.4, la1 = -0.5, la3 = -0.8, lel = 0.1, breathe = 7, freeL = 0 },
	BLDazed = { drop = 1.5, lean = 0.55, side = 0.16, head = 0.6, footR = 0.9, footL = -1.2, spread = 0.36, la1 = -0.2, la3 = -0.5, lel = 0.2, breathe = 7, freeL = 0 },
	BLCracked = { drop = 0.3, lean = -0.3, side = 0.18, head = -0.45, footR = 0.3, footL = -0.45, spread = 0.36, breathe = 6, freeL = 0 },
}
local ROBE, ROBE_DK, BELL, BELL_DK, BELL_LT, ROPE = Color3.fromRGB(84, 76, 66), Color3.fromRGB(52, 46, 40), Color3.fromRGB(88, 116, 100), Color3.fromRGB(56, 76, 66), Color3.fromRGB(128, 156, 136), Color3.fromRGB(128, 112, 82)
M.Colors = { skin = ROBE_DK, torso = ROBE, legs = ROBE_DK, arms = ROBE }
M.FistSkin = true

-- everything below the head, in its own colours or these
function M.LookRobe(k, robe, dark)
	local D, MAT, s = k.D, k.MAT, k.s
	local cw, ch, cd, hw, hd, aw, la, ua, lw = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.la, k.ua, k.lw
	local ROBE, ROBE_DK = robe or ROBE, dark or ROBE_DK
	local rng = Random.new(414)
	Garb.sink(k, { "Chest", "Hips", "RUpperArm", "LUpperArm", "RLowerArm", "LLowerArm", "RThigh", "LThigh", "RShin", "LShin", "RFoot", "LFoot" }, 0.8, ROBE_DK)
	Garb.hideRigFists(k)
	-- the robe: three overlapping tiers of folds round the chest, more round the hips, a mantle of them over the shoulders
	Garb.shell(k, "Chest", rng, { a = cw * 0.68, c = cd * 0.76, top = ch / 2 + 0.05, bottom = -ch / 2 - 0.1, n = 20, tiers = 3, color = ROBE, dark = ROBE_DK })
	Garb.shell(k, "Chest", rng, { a = cw * 0.58, c = cd * 0.62, top = ch / 2 + 0.34, bottom = ch / 2 - 0.1, n = 16, tiers = 1, color = ROBE, dark = ROBE_DK, flare = 0.75, name = "Mantle" })
	local hipY = D.hipsSize.Y / s
	Garb.shell(k, "Hips", rng, { a = hw * 0.72, c = hd * 0.8, top = hipY / 2 + 0.05, bottom = -hipY / 2 - 0.25, n = 16, tiers = 2, color = ROBE, dark = ROBE_DK, flare = 0.14 })
	Garb.skirt(k, "Hips", rng, { a = hw * 0.74, c = hd * 0.84, y = -hipY / 2, n = 14, len = 0.56, color = ROBE, dark = ROBE_DK })
	-- a bell-rope wound round the waist
	for i = 0, 2 do
		Garb.hoop(k, "Hips", 0.34 - i * 0.14, hw * 0.78 + i * 0.015, hd * 0.86 + i * 0.015, 18, 0.14, ROPE:Lerp(ROBE_DK, i * 0.12), MAT.Fabric, "Rope")
	end
	for _, n in ipairs({ "R", "L" }) do
		Garb.shell(k, n .. "UpperArm", rng, { a = aw * 0.82, c = aw * 0.82, top = ua / 2 + 0.05, bottom = -ua / 2, n = 9, tiers = 2, color = ROBE, dark = ROBE_DK })
		Garb.shell(k, n .. "LowerArm", rng, { a = aw * 0.84, c = aw * 0.84, top = la / 2 + 0.05, bottom = -la / 2 + 0.05, n = 9, tiers = 2, color = ROBE, dark = ROBE_DK, flare = 0.2 })
		Garb.hoop(k, n .. "LowerArm", -la / 2 + 0.1, aw * 0.92, aw * 0.92, 10, 0.1, ROPE, MAT.Fabric, "Cuff")
		Garb.fist(k, n .. "LowerArm", -la / 2 - 0.12, aw * 1.05, ROPE, ROBE_DK)
		Garb.wraps(k, n .. "Thigh", rng, D.thigh / s / 2, -D.thigh / s / 2, lw * 0.56, 6, ROBE_DK, ROBE, MAT.Fabric)
		Garb.wraps(k, n .. "Shin", rng, D.shin / s / 2, -D.shin / s / 2, lw * 0.5, 7, ROPE:Lerp(ROBE_DK, 0.6), ROBE_DK, MAT.Fabric)
		Garb.foot(k, n .. "Foot", D.footSize / s, ROBE_DK, ROPE:Lerp(ROBE_DK, 0.5))
	end
end

-- A BELL, as a founder casts one (height above its middle, radius). The lip flares out thick and the waist draws in, then the
-- shoulder rounds over to a flat crown
local PROFILE = { { -1.08, 1.8 }, { -1.0, 1.78 }, { -0.92, 1.66 }, { -0.8, 1.48 }, { -0.62, 1.28 }, { -0.38, 1.13 }, { -0.1, 1.04 }, { 0.25, 0.99 }, { 0.58, 0.98 }, { 0.78, 0.93 }, { 0.92, 0.8 }, { 1.03, 0.58 }, { 1.09, 0.3 } }
function M.bellRadius(y)
	for i = 1, #PROFILE - 1 do
		local a, z = PROFILE[i], PROFILE[i + 1]
		if y <= z[1] then
			return a[2] + (z[2] - a[2]) * math.clamp((y - a[1]) / (z[1] - a[1]), 0, 1)
		end
	end
	return PROFILE[#PROFILE][2]
end

-- what a bell hangs by: cast loops on the crown, and the timber headstock through them
function M.bellHanger(k, iron, dark)
	local deco, V, at, MAT = k.deco, k.V, k.at, k.MAT
	for i = 0, 5 do
		local a = i / 6 * 2 * math.pi
		deco("Head", "Canon", V(0.34, 0.15, 0.15), at(math.sin(a) * 0.17, 1.22, math.cos(a) * 0.17) * CFrame.Angles(0, a, 0) * CFrame.Angles(0, 0, 1.25), iron, MAT.Metal, Enum.PartType.Cylinder)
	end
	deco("Head", "Headstock", V(1.7, 0.3, 0.3), at(0, 1.42, 0), Color3.fromRGB(70, 52, 38), MAT.WoodPlanks, Enum.PartType.Cylinder)
	for _, x in ipairs({ -0.62, -0.3, 0.3, 0.62 }) do
		deco("Head", "HeadstockBand", V(0.08, 0.34, 0.34), at(x, 1.42, 0), dark, MAT.Metal, Enum.PartType.Cylinder)
	end
end

-- THE BELL, where its head would be, its mouth down over its shoulders. pal (optional) recasts it: main, dark, light, streak, glow
function M.LookBell(k, pal)
	pal = pal or {}
	local BELL, BELL_DK, BELL_LT = pal.main or BELL, pal.dark or BELL_DK, pal.light or BELL_LT
	local deco, parts, V, at, MAT = k.deco, k.parts, k.V, k.at, k.MAT
	local rng = Random.new(1612)
	local radius = M.bellRadius
	parts.Head.Transparency = 1
	local function cast()
		return BELL:Lerp(BELL_DK, rng:NextNumber() ^ 1.3)
	end
	-- the flare is left hollow (from below, where you're standing, you look up into it): a ring of curved plates, row on row
	local rows = { -1.08, -0.98, -0.88, -0.76, -0.62 }
	local N = 26
	for r = 1, #rows - 1 do
		local y0, y1 = rows[r], rows[r + 1]
		local r0, r1 = radius(y0), radius(y1)
		local rm, ym = (r0 + r1) / 2, (y0 + y1) / 2
		local slope = math.atan2(r0 - r1, y1 - y0)
		local long = math.sqrt((r0 - r1) ^ 2 + (y1 - y0) ^ 2)
		for i = 0, N - 1 do
			local a = (i + (r % 2) * 0.5) / N * 2 * math.pi
			deco("Head", "BellLip", V(2 * math.pi * rm / N * 1.16, long * 1.1, 0.14), at(math.sin(a) * rm, ym, math.cos(a) * rm) * CFrame.Angles(0, a, 0) * CFrame.Angles(-slope, 0, 0), cast(), MAT.Metal)
		end
	end
	Garb.hoop(k, "Head", -1.07, radius(-1.07) + 0.03, radius(-1.07) + 0.03, 26, 0.13, BELL_LT, MAT.Metal, "BellRim")
	-- the dark up inside it
	Garb.disc(k, "Head", -0.66, radius(-0.66) - 0.04, 0.06, Color3.fromRGB(6, 8, 8), MAT.SmoothPlastic, "BellMouth")
	-- the rest of it, cast solid: thin slices following the profile
	local y = -0.62
	while y < 1.09 do
		Garb.disc(k, "Head", y, radius(y), 0.075, cast(), MAT.Metal, "BellBody")
		y += 0.058
	end
	-- the founder's raised bands, and a line of worn lettering between the pair of them up by the shoulder
	for _, by in ipairs({ -0.5, -0.43, 0.38, 0.62 }) do
		Garb.disc(k, "Head", by, radius(by) + 0.035, 0.045, BELL_LT, MAT.Metal, "BellBand")
	end
	for i = 0, 21 do
		local a = i / 22 * 2 * math.pi
		local r = radius(0.5) + 0.012
		deco("Head", "BellLetter", V(0.07 + (i % 3) * 0.03, 0.09 + (i % 2) * 0.04, 0.03), at(math.sin(a) * r, 0.5, math.cos(a) * r) * CFrame.Angles(0, a, 0), BELL_DK, MAT.Metal)
	end
	-- verdigris run down from the bands
	for i = 0, 15 do
		local a = rng:NextNumber() * 2 * math.pi
		local top = rng:NextNumber() < 0.5 and 0.34 or -0.54
		local long = rng:NextNumber(0.12, 0.3)
		local my = top - long / 2
		local r = radius(my) + 0.012
		deco("Head", "Verdigris", V(rng:NextNumber(0.05, 0.11), long, 0.02), at(math.sin(a) * r, my, math.cos(a) * r) * CFrame.Angles(0, a, 0) * CFrame.Angles(-math.atan2(radius(my - 0.05) - radius(my + 0.05), 0.1), 0, 0), pal.streak or BELL_LT:Lerp(Color3.fromRGB(150, 196, 174), 0.5), MAT.SmoothPlastic)
	end
	M.bellHanger(k, BELL_LT, BELL_DK)
	-- cold light in there
	local pall = Instance.new("PointLight")
	pall.Color, pall.Range, pall.Brightness, pall.Shadows = pal.glow or Color3.fromRGB(190, 220, 200), 34, 1.1, false
	pall.Parent = parts.Chest
	-- the crack (hidden till phase 2), running up its front
	for i, q in ipairs({ { 0.2, 0.55, 0.12 }, { 0.32, 0.15, -0.35 }, { 0.5, -0.25, 0.3 }, { 0.42, -0.62, -0.2 } }) do
		local r = radius(q[2])
		local c = deco("Head", "BellCrack", V(0.1, 0.5, 0.06), at(q[1], q[2], -math.sqrt(r * r - q[1] * q[1]) - 0.02) * CFrame.Angles(0, 0, q[3]), Color3.fromRGB(210, 236, 224), MAT.Neon)
		c.Transparency = 1
		c:SetAttribute("Order", i)
	end
end

function M.Look(k)
	M.LookRobe(k)
	M.LookBell(k)
end

M.Weapons = {
	-- the bell's clapper: a long forged iron rod, its leather strap at the hands, a great iron ball at the end
	Clapper = function(w)
		local mk, add = w.mk, w.add
		local iron, dark, strap = Color3.fromRGB(76, 88, 80), Color3.fromRGB(44, 52, 48), Color3.fromRGB(84, 60, 40)
		local function rod(name, y, long, d, color, mat)
			local p = mk(name, Vector3.new(long, d, d), color, mat or Enum.Material.Metal)
			p.Shape = Enum.PartType.Cylinder
			add(p, y, Garb.UP)
		end
		local handle = mk("Rod", Vector3.new(0.2, 3, 0.2), iron, Enum.Material.Metal)
		handle.Transparency = 1
		rod("RodCore", 0, 3, 0.36, iron)
		rod("Rod2", -2.6, 2.6, 0.4, iron)
		for i = 0, 6 do
			rod("Forged", -1.1 - i * 0.48, 0.14, 0.52 + (i % 2) * 0.05, dark)
		end
		for i = 0, 5 do
			rod("Strap", 0.95 - i * 0.24, 0.2, 0.46 + (i % 2) * 0.04, strap, Enum.Material.Leather)
		end
		rod("Loop", 1.5, 0.3, 0.72, dark)
		local ball = mk("Ball", Vector3.new(1.75, 1.75, 1.75), dark, Enum.Material.Metal)
		ball.Shape = Enum.PartType.Ball
		add(ball, -4.45)
		rod("BallBand", -4.45, 0.16, 1.82, iron)
		rod("BallNeck", -3.6, 0.3, 0.72, iron)
		for i = 0, 7 do
			local a = i / 8 * 2 * math.pi
			local stud = mk("BallStud", Vector3.new(0.22, 0.22, 0.22), iron, Enum.Material.Metal)
			stud.Shape = Enum.PartType.Ball
			add(stud, -4.45, CFrame.new(math.cos(a) * 0.9 * w.scale, 0, math.sin(a) * 0.9 * w.scale))
		end
		return { handle = handle, bladeLen = 4.6, gripC1 = CFrame.new(0, 0.5 * w.scale, 0) }
	end,
}
local R = math.rad
local function out(yaw, tilt)
	return CFrame.Angles(0, R(yaw), 0) * CFrame.Angles(0, 0, R(tilt))
end
M.Grips = {
	BLRest = { Vector3.new(1.1, -0.2, -1.3), CFrame.Angles(R(10), 0, 0) },
	-- drawn back beside the bell, ball behind it
	BLDraw = { Vector3.new(2.2, 2.5, 0.9), out(-25, 110) },
	-- ...and into the side of its own head
	BLStrike = { Vector3.new(2.6, 2.0, -1.5), out(165, 88) },
	BLWind = { Vector3.new(2.1, -0.2, 1.8), out(-65, 64) },
	BLMid = { Vector3.new(0.3, -0.5, -2.7), out(90, 60) },
	BLEnd = { Vector3.new(-2.1, -0.5, -0.6), out(190, 60) },
	BLHigh = { Vector3.new(0.5, 3.1, 0.3), CFrame.Angles(R(205), 0, 0) },
	BLDown = { Vector3.new(0.2, -0.4, -2.5), CFrame.Angles(R(58), 0, 0) },
	BLDragged = { Vector3.new(1.8, -1, 0.5), out(-30, 38) },
}
M.BodyFor = {}

---------------------------------------------------------------------------
-- server: the fight
---------------------------------------------------------------------------
-- every move, for the hybrids to borrow too
function M.moves(core)
	local F = Fight.init(core)
	local SOUNDS, playSound, burst, pose, bodyPose, setTrail, dustCloud, flat, debrisChunks, FxRemote = core.SOUNDS, core.playSound, core.burst, core.pose, core.bodyPose, core.setTrail, core.dustCloud, core.flat, core.debrisChunks, core.FxRemote
	local D = { Note = 12, Swing = 22, Down = 24, Blast = 14, Bell = 26, Echo = 12 }
	local NOTE = Color3.fromRGB(150, 196, 174)
	local BEAT = 1.35 -- seconds between notes (its count: learn this and the fight's easy)

	local function ahead(b, dist)
		return flat(b.root.Position) + F.fwd(b) * dist
	end
	local function bellSound(b, loud)
		playSound(b.root, SOUNDS.Impact, loud or 1, 0.32)
		playSound(b.root, SOUNDS.Deflect or SOUNDS.Unsheath, 0.8, 0.42)
		playSound(b.root, SOUNDS.Unsheath, 0.6, 0.3)
	end
	-- one strike on its own head: the note rolls out, and (phase 2) a ring comes under whoever's nearest
	local function note(b, target)
		F.draw(b, "BLStrike", "BLStrike", 0.1)
		if not F.wait(b, 0.1) then
			return false
		end
		bellSound(b)
		local c = flat(b.root.Position)
		FxRemote:FireAllClients("Shake", c, 0.55)
		burst(b.root.Position + Vector3.new(0, 14, 0), NOTE, 26, 0.45, 20)
		F.wave(b, c, 22, 72, D.Note, "Medium")
		if F.phase2() then
			local tr = target:FindFirstChild("HumanoidRootPart")
			if tr then
				local at = flat(tr.Position)
				F.ring(at, 5, 1.1)
				task.delay(1.1, function()
					if F.live(b) then
						burst(at, NOTE, 18, 0.35, 16)
						dustCloud(at, 2, 5)
						F.hit(F.radius(at, 5, 8), {}, D.Echo, at, "Medium")
					end
				end)
			end
		end
		return true
	end

	-- THE TOLL: drawn back, a long look, and it strikes itself: count them. It's rattled afterwards, right to the end of the last one
	local function toll(b, target, count)
		F.halt(b)
		count = count or 1
		if F.phase2() then
			count += 1
		end
		for i = 1, count do
			local tell = i == 1 and 0.95 or (BEAT - 0.1) * (F.phase2() and 0.8 or 1)
			F.draw(b, "BLDraw", "BLDraw", tell * 0.7)
			playSound(b.root, SOUNDS.Unsheath, 0.5, 0.55)
			if not F.track(b, target, tell, 0.7) then
				return
			end
			if not note(b, target) then
				return
			end
			bodyPose(b, "BLReel", 0.2)
			if not F.hold(b, 0.12) then
				return
			end
		end
		F.recover(b, 1.5, "BLReel")
	end
	local function tollThree(b, target)
		toll(b, target, 3)
	end

	local function swing(b, target)
		F.halt(b)
		if not F.beats(b, target, {
			{ "BLWind", "BLWind", 0.6 },
			{ "BLWind", "BLWind", 0.5, function()
				playSound(b.root, SOUNDS.Unsheath, 0.9, 0.42)
			end },
		}, 0.7) then
			return
		end
		setTrail(b, true)
		F.step(b, 8, 0.3)
		bodyPose(b, "BLThrough", 0.2)
		pose(b, "BLMid", 0.15, Enum.EasingStyle.Linear)
		task.delay(0.15, function()
			pose(b, "BLEnd", 0.17)
		end)
		playSound(b.root, SOUNDS.Lunge, 1, 0.45)
		F.sweep(b, 0.33, D.Swing, "Large", {}, 3.8)
		setTrail(b, false)
		F.recover(b, 1.2, "BLReel")
	end

	local function down(b, target)
		F.halt(b)
		if not F.beats(b, target, { { "BLHigh", "BLHigh", 0.8 } }, 0.65) then
			return
		end
		local at = ahead(b, 19)
		F.ring(at, 10, 0.65)
		playSound(b.root, SOUNDS.Unsheath, 0.9, 0.4)
		if not F.track(b, target, 0.65, 0) then
			return
		end
		setTrail(b, true)
		F.draw(b, "BLDown", "BLFold", 0.14)
		playSound(b.root, SOUNDS.Lunge, 1, 0.42)
		F.sweep(b, 0.15, D.Down, "Knockdown", {}, 3.8)
		setTrail(b, false)
		if not F.live(b) then
			return
		end
		F.quake(b, at, 10, 1.4)
		debrisChunks(at + Vector3.new(0, 0.5, 0), 6, 20)
		F.hit(F.radius(at, 10, 8), {}, D.Blast, at, "Large")
		F.recover(b, 1.3, false)
	end

	-- THE BELL THROWN DOWN: it rocks right back, a strip lights ahead of it, and it throws its whole top half forward onto the
	-- floor. It rings itself senseless doing it, kneeling there, ears full of it: go and take as much as you like
	local function headlong(b, target)
		F.halt(b)
		if not F.beats(b, target, { { "BLDragged", "BLRock", 0.8, function()
			playSound(b.root, SOUNDS.Groan, 1, 0.34)
		end } }, 0.7) then
			return
		end
		local from, to = ahead(b, 3), ahead(b, 28)
		F.strip(from, to, 17, 0.6)
		if not F.track(b, target, 0.6, 0) then
			return
		end
		F.draw(b, "BLDragged", "BLHeadlong", 0.26)
		playSound(b.root, SOUNDS.Lunge, 1, 0.36)
		F.step(b, 6, 0.26)
		if not F.wait(b, 0.25) then
			return
		end
		bellSound(b, 1)
		local seen = {}
		for i = 0, 3 do
			local p = from:Lerp(to, i / 3)
			F.hit(F.radius(p, 8.5, 8), seen, D.Bell, p, "Knockdown")
			dustCloud(p, 3.5, 7)
			debrisChunks(p + Vector3.new(0, 0.5, 0), 3, 18)
		end
		F.quake(b, to, 12, 1.8)
		F.wave(b, to, 22, 44, D.Note, "Medium")
		bodyPose(b, "BLDazed", 0.45)
		if F.hold(b, 2.1) then
			F.idle(b)
		end
	end

	local function idle(b)
		pose(b, "BLRest", 0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		bodyPose(b, "BLIdle", 0.6)
	end
	local function onStagger(b)
		pose(b, "BLDragged", 0.2)
		bodyPose(b, "BLDazed", 0.2)
		bellSound(b, 0.7)
	end
	-- the entrance: stood at the far end with its bell hung low. It raises its weapon and rings the fight in
	local function intro(b)
		pose(b, b.idleGrip, 0.2)
		bodyPose(b, "BLDazed", 0.2)
		task.wait(0.8)
		playSound(b.root, SOUNDS.Groan, 1, 0.4)
		bodyPose(b, "BLDraw", 1.1)
		pose(b, "BLDraw", 1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		task.wait(1.15)
		pose(b, "BLStrike", 0.1)
		bodyPose(b, "BLStrike", 0.1)
		task.wait(0.1)
		bellSound(b, 1)
		FxRemote:FireAllClients("Shake", b.root.Position, 0.7)
		task.wait(0.8)
		pose(b, b.idleGrip, 0.5)
		bodyPose(b, "BLIdle", 0.5)
		task.wait(0.3)
	end
	-- phase 2: it strikes itself once too hard, and the bell cracks
	local function phase2(b)
		F.halt(b)
		F.draw(b, "BLDraw", "BLDraw", 0.5)
		F.wait(b, 0.65)
		F.draw(b, "BLStrike", "BLCracked", 0.1)
		F.wait(b, 0.1)
		bellSound(b, 1)
		FxRemote:FireAllClients("Shake", b.root.Position, 1)
		for _, c in ipairs(b.model:GetChildren()) do
			if c:IsA("BasePart") and c.Name == "BellCrack" then
				c.Transparency = 0
				burst(c.Position, NOTE, 22, 0.45, 18)
			end
		end
		F.wave(b, flat(b.root.Position), 22, 72, D.Note, "Medium")
		F.wait(b, 1.1)
		F.idle(b)
	end

	return { NOTE = NOTE, NoteDamage = D.Note, bellSound = bellSound, toll = toll, tollThree = tollThree, swing = swing, down = down, headlong = headlong, idle = idle, onStagger = onStagger, intro = intro, phase2 = phase2 }
end

function M.init(core)
	local mv = M.moves(core)
	Fight.define({
		id = "Bell",
		label = "The Bellhead",
		kind = M.Kind,
		scale = S,
		weapon = "Clapper",
		idleGrip = "BLRest",
		hp = 780,
		poise = 170,
		stagger = 2.8,
		radius = 4.6,
		walk = 9.5,
		turn = 72,
		rest = { 0.65, 1.3 },
		keep = { 15, 24 },
		phase2At = 0.5,
		tempo2 = 0.88,
		restMult2 = 0.75,
		moves = {
			{ name = "Toll", fn = mv.toll, min = 0, max = 95, weight = 4, cd = 5 },
			{ name = "TollThree", fn = mv.tollThree, min = 14, max = 95, weight = 5, cd = 9 },
			{ name = "Swing", fn = mv.swing, min = 0, max = 27, weight = 6, cd = 2.5, fast = true, behind = true },
			{ name = "Down", fn = mv.down, min = 8, max = 30, weight = 4, cd = 4 },
			{ name = "Headlong", fn = mv.headlong, min = 3, max = 30, weight = 3, cd = 10 },
		},
		idle = mv.idle,
		onStagger = mv.onStagger,
		intro = mv.intro,
		phase2 = mv.phase2,
	})
end

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">WardenBell</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">e1ede45f7e304b16a9136af625e24eca</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXB16D1702710541C48FE4B42D1335E6B5">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE WARDEN, candidate 3: THE BONE COLOSSUS. The hall's a charnel house with shelves of the dead up every wall, and the Warden
-- is what they made of themselves: a skeleton four times the size of a man, built of thousands of smaller bones, a great
-- thighbone for a club. It's a warden still, and it keeps doing the only thing it knows: it locks people up. Cages of
-- bone burst out of the floor around you, spears run along the ground, and all you have to do is keep moving and get under it.
-- Phase 1: the club swing, the overhead, the stomp, the running spears, the cage.
-- Phase 2 at half health: it tears out its own ribs and throws them; two cages at once, and three lines of spears.
-- Fight's plumbing: ReplicatedStorage/WardenFight.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Fight = require(ReplicatedStorage:WaitForChild("WardenFight"))

local S = 4.1
local M = {}
M.Kind = "WardenBones"
M.Proportions = { girth = 0.85, arm = 1.32, hunch = 0.28, twoHand = -0.7, walkRef = 2.5, cadence = 0.9 }
M.IdlePose = "BNIdle"
M.Poses = {
	BNIdle = { drop = 0.3, lean = 0.2, head = 0.05, footR = -0.35, footL = 0.42, spread = 0.26, breathe = 1.2, freeL = 0 },
	-- wound right round for the swing, skull still on you
	BNWind = { drop = 0.7, lean = 0.2, twist = -1.25, hip = -0.6, side = -0.1, look = 1, footR = -0.7, footL = 0.8, spread = 0.38, breathe = 2, freeL = 0 },
	BNThrough = { drop = 0.95, lean = 0.55, twist = 1.15, hip = 0.55, side = 0.12, look = -0.5, footR = 0.9, footL = -0.65, spread = 0.38, freeL = 0 },
	-- the overhead: rattling up to its full height
	BNHigh = { drop = 0.02, lean = -0.4, head = -0.4, footR = -0.4, footL = 0.45, spread = 0.26, breathe = 2, freeL = 0 },
	BNDown = { drop = 1.3, lean = 1, head = -0.15, footR = 0.85, footL = -0.7, spread = 0.38, freeL = 0 },
	BNKnee = { drop = 0.25, lean = 0.12, side = 0.18, lift = 1.5, head = 0.1, footL = -0.05, footR = 0.2, spread = 0.2, freeL = 0 },
	BNStomp = { drop = 0.95, lean = 0.45, side = -0.08, head = 0.25, footR = 0.55, footL = -0.3, spread = 0.36, freeL = 0 },
	-- calling something up out of the floor: free hand driven down at it, skull bent
	BNCall = { drop = 1.0, lean = 0.75, twist = 0.2, head = 0.35, footR = -0.2, footL = 0.55, spread = 0.38, la1 = -0.75, la3 = -0.5, lel = 0.1, breathe = 2, freeL = 0 },
	BNClose = { drop = 0.3, lean = -0.2, head = -0.4, footR = -0.2, footL = 0.3, spread = 0.3, la1 = 1.9, la3 = -0.4, lel = 0.8, freeL = 0 },
	-- the spears: the club driven into the floor, end down
	BNDrive = { drop = 1.2, lean = 0.9, twist = -0.2, head = -0.2, footR = 0.7, footL = -0.55, spread = 0.36, freeL = 0 },
	-- tearing out its own ribs (phase 2's throw): free hand at its chest, then the arm flung out
	BNTear = { drop = 0.45, lean = 0.12, twist = -0.7, head = 0.25, look = 0.5, footR = -0.45, footL = 0.45, spread = 0.3, la1 = 0.85, la2 = 1, la3 = 0.3, lel = 1.9, breathe = 3, freeL = 0 },
	BNThrow = { drop = 0.55, lean = 0.55, twist = 0.75, head = 0, footR = 0.6, footL = -0.55, spread = 0.3, la1 = 1.45, la3 = -0.6, lel = 0.1, freeL = 0 },
	BNCollapse = { drop = 1.6, lean = 0.75, side = 0.15, head = 0.6, footR = 0.8, footL = -1.1, spread = 0.38, la1 = -0.3, la3 = -0.5, lel = 0.1, freeL = 0 },
	BNHowl = { drop = 0.12, lean = -0.55, head = -0.75, footR = 0.35, footL = -0.4, spread = 0.3, la1 = 2.4, la3 = -0.9, lel = 0.4, breathe = 3, freeL = 0 },
}
local BONE, BONE_DK, BONE_LT, EYE = Color3.fromRGB(198, 190, 166), Color3.fromRGB(142, 134, 112), Color3.fromRGB(226, 220, 198), Color3.fromRGB(190, 222, 226)
M.Colors = { skin = BONE, torso = BONE_DK, legs = BONE, arms = BONE }
M.FistSkin = true

function M.Look(k)
	local deco, parts, V, at, MAT, s = k.deco, k.parts, k.V, k.at, k.MAT, k.s
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	local tl, sl = k.D.thigh / s, k.D.shin / s
	local BALL = Enum.PartType.Ball
	local rng = Random.new(19)
	-- no flesh: the trunk's just a spine and a cage of ribs, with air between
	parts.Chest.Transparency, parts.Hips.Transparency = 1, 1
	parts.Head.Transparency = 1
	for i = 0, 5 do
		deco("Chest", "Spine", V(0.34, 0.26, 0.34), at(0, -ch / 2 + 0.14 + i * ch / 5.8, cd * 0.3), BONE_DK, MAT.Pebble)
	end
	for row = 0, 4 do -- five pairs of ribs (named: phase 2 tears them out)
		local y = ch * 0.34 - row * ch * 0.16
		local wide = cw * (0.5 - row * 0.022)
		for _, sx in ipairs({ -1, 1 }) do
			deco("Chest", "Rib", V(0.16, 0.16, cd * 0.86), at(sx * wide, y, 0), BONE, MAT.Pebble)
			deco("Chest", "Rib", V(wide * 0.82, 0.16, 0.16), at(sx * wide * 0.56, y, -cd * 0.43) * CFrame.Angles(0, 0, sx * -0.08), BONE, MAT.Pebble)
			deco("Chest", "Rib", V(wide * 0.92, 0.16, 0.16), at(sx * wide * 0.5, y + 0.05, cd * 0.3), BONE_DK, MAT.Pebble)
		end
	end
	deco("Chest", "Breastbone", V(0.24, ch * 0.62, 0.14), at(0, ch * 0.1, -cd * 0.46), BONE_LT, MAT.Pebble)
	deco("Chest", "Collar", V(cw * 1.1, 0.2, 0.2), at(0, ch / 2 - 0.08, -cd * 0.2), BONE, MAT.Pebble)
	deco("Chest", "Shoulderblades", V(cw * 0.9, ch * 0.3, 0.1), at(0, ch * 0.3, cd * 0.42), BONE_DK, MAT.Pebble)
	-- a pale light caught in the ribs, so it's seen across the dark hall
	local ember = deco("Chest", "HeartLight", V(0.55, 0.55, 0.55), at(0, 0, -0.05), EYE, MAT.Neon, BALL)
	local glow = Instance.new("PointLight")
	glow.Color, glow.Range, glow.Brightness, glow.Shadows = EYE, 36, 1.1, false
	glow.Parent = ember
	-- pelvis
	deco("Hips", "Pelvis", V(hw * 0.92, 0.46, hd * 0.75), at(0, 0.1, 0), BONE_DK, MAT.Pebble)
	deco("Hips", "PelvisWing", V(hw * 1.05, 0.2, hd * 0.3), at(0, 0.34, 0.1), BONE, MAT.Pebble)
	-- the limbs: thin bones, knobbed at the joints, smaller bones stuck all over them
	for _, n in ipairs({ "R", "L" }) do
		parts[n .. "UpperArm"].Size *= Vector3.new(0.5, 1, 0.5)
		parts[n .. "LowerArm"].Size *= Vector3.new(0.42, 1, 0.42)
		parts[n .. "Thigh"].Size *= Vector3.new(0.48, 1, 0.48)
		parts[n .. "Shin"].Size *= Vector3.new(0.42, 1, 0.42)
		for _, p in ipairs({ { "UpperArm", ua, aw }, { "LowerArm", la, aw }, { "Thigh", tl, lw }, { "Shin", sl, lw } }) do
			local on, len, w = n .. p[1], p[2], p[3]
			deco(on, "Knob", V(w * 0.72, w * 0.72, w * 0.72), at(0, len / 2 - 0.05, 0), BONE_LT, MAT.Pebble, BALL)
			deco(on, "Knob", V(w * 0.62, w * 0.62, w * 0.62), at(0, -len / 2 + 0.05, 0), BONE_LT, MAT.Pebble, BALL)
			for _ = 1, 3 do
				local y = rng:NextNumber(-len * 0.35, len * 0.35)
				deco(on, "SmallBone", V(0.1, rng:NextNumber(0.4, 0.8), 0.1), at(rng:NextNumber(-w * 0.26, w * 0.26), y, rng:NextNumber(-w * 0.26, w * 0.26)) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), 0, rng:NextNumber(-0.5, 0.5)), BONE_DK, MAT.Pebble)
			end
		end
		deco(n .. "LowerArm", "HandBones", V(aw * 0.72, 0.42, aw * 0.72), at(0, -la / 2 - 0.2, 0), BONE, MAT.Pebble)
		for i = -1, 1 do
			deco(n .. "LowerArm", "Finger", V(0.09, 0.55, 0.09), at(i * aw * 0.22, -la / 2 - 0.62, 0), BONE_LT, MAT.Pebble)
		end
		deco(n .. "Foot", "FootBones", k.V(k.D.footSize.X / s * 0.8, 0.2, k.D.footSize.Z / s), at(0, -0.02, 0), BONE, MAT.Pebble)
	end
	parts.RFoot.Transparency, parts.LFoot.Transparency = 1, 1
	-- the skull: huge, a jaw hung from it on nothing, two cold points in the sockets, and more small skulls round its neck
	deco("Head", "Skull", V(1.35, 1.35, 1.35), at(0, 0.18, 0), BONE_LT, MAT.Pebble, BALL)
	deco("Head", "Jaw", V(0.84, 0.32, 0.82), at(0, -0.56, -0.16), BONE, MAT.Pebble)
	for i = -2, 2 do
		deco("Head", "Tooth", V(0.11, 0.17, 0.07), at(i * 0.15, -0.34, -0.57), BONE_DK, MAT.Pebble)
	end
	for _, sx in ipairs({ -1, 1 }) do
		deco("Head", "Socket", V(0.42, 0.42, 0.2), at(sx * 0.28, 0.14, -0.54), Color3.fromRGB(8, 8, 10), MAT.SmoothPlastic, BALL)
		deco("Head", "Eye", V(0.15, 0.15, 0.1), at(sx * 0.28, 0.14, -0.64), EYE, MAT.Neon, BALL)
	end
	deco("Head", "Nose", V(0.16, 0.24, 0.08), at(0, -0.1, -0.64), Color3.fromRGB(8, 8, 10), MAT.SmoothPlastic)
	for i = 0, 6 do
		local a = i / 7 * math.pi * 2
		deco("Chest", "SmallSkull", V(0.42, 0.42, 0.42), at(math.cos(a) * 0.72, ch / 2 + 0.1, math.sin(a) * 0.56), BONE, MAT.Pebble, BALL)
	end
end

M.Weapons = {
	-- a thighbone as long as a tree, from something else again, cracked and bound with old iron
	Femur = function(w)
		local mk, add, s = w.mk, w.add, w.scale
		local bone, dark, iron = Color3.fromRGB(198, 190, 166), Color3.fromRGB(142, 134, 112), Color3.fromRGB(58, 56, 54)
		local handle = mk("Shaft", Vector3.new(0.48, 2.4, 0.48), bone, Enum.Material.Pebble)
		add(mk("Shaft2", Vector3.new(0.56, 3.3, 0.56), bone, Enum.Material.Pebble), -2.8)
		local function ball(name, size, y, x)
			local p = mk(name, Vector3.new(size, size, size), dark, Enum.Material.Pebble)
			p.Shape = Enum.PartType.Ball
			add(p, y, CFrame.new((x or 0) * s, 0, 0))
		end
		ball("HandEnd", 0.9, 1.3)
		ball("Head", 1.4, -4.6, 0.25)
		ball("Head", 1.25, -4.85, -0.32)
		for _, y in ipairs({ -1.2, -2.4 }) do
			add(mk("Band", Vector3.new(0.68, 0.22, 0.68), iron, Enum.Material.Metal), y)
		end
		return { handle = handle, bladeLen = 4.8, gripC1 = CFrame.new(0, 0.6 * s, 0) }
	end,
}
local R = math.rad
local function out(yaw, tilt)
	return CFrame.Angles(0, R(yaw), 0) * CFrame.Angles(0, 0, R(tilt))
end
M.Grips = {
	BNRest = { Vector3.new(1.4, -0.4, -0.8), CFrame.Angles(R(15), 0, 0) },
	BNWind = { Vector3.new(2.2, -0.2, 1.8), out(-65, 66) },
	BNMid = { Vector3.new(0.4, -0.6, -2.7), out(90, 58) },
	BNEnd = { Vector3.new(-2.2, -0.6, -0.5), out(190, 58) },
	BNHigh = { Vector3.new(0.5, 2.9, 0.5), CFrame.Angles(R(215), 0, 0) },
	BNDown = { Vector3.new(0.3, -0.5, -2.5), CFrame.Angles(R(55), 0, 0) },
	BNDrive = { Vector3.new(0.4, -0.4, -2.2), CFrame.Angles(R(15), 0, 0) },
	BNCall = { Vector3.new(2.2, 0.4, 0.8), out(-20, 50) },
	BNSlump = { Vector3.new(1.2, -1.2, -1.2), CFrame.Angles(R(15), 0, 0) },
	BNHowl = { Vector3.new(1.3, 3, -0.3), CFrame.Angles(R(160), 0, R(12)) },
}
M.BodyFor = {}

---------------------------------------------------------------------------
-- server: the fight
---------------------------------------------------------------------------
function M.init(core)
	local F = Fight.init(core)
	local SOUNDS, playSound, burst, pose, bodyPose, setTrail, dustCloud, flat, debrisChunks, FxRemote = core.SOUNDS, core.playSound, core.burst, core.pose, core.bodyPose, core.setTrail, core.dustCloud, core.flat, core.debrisChunks, core.FxRemote
	local TweenService = game:GetService("TweenService")
	local D = { Swing = 22, Over = 24, Blast = 14, Stomp = 14, Spear = 14, Cage = 20, Rib = 12 }
	local BONE_C = Color3.fromRGB(198, 190, 166)

	local function ahead(b, dist)
		return flat(b.root.Position) + F.fwd(b) * dist
	end
	-- a spike of bone bursting out of the floor at p, then sinking back
	local function spike(p, h, w)
		local tilt = CFrame.Angles((math.random() - 0.5) * 0.3, math.random() * 6, (math.random() - 0.5) * 0.3)
		local down = CFrame.new(p.X, -h / 2, p.Z) * tilt
		local up = CFrame.new(p.X, h * 0.4, p.Z) * tilt
		local part = F.part({ Name = "BoneSpike", Size = Vector3.new(w, h, w), Material = Enum.Material.Pebble, Color = BONE_C, CFrame = down })
		TweenService:Create(part, TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = up }):Play()
		task.delay(0.7, function()
			if part.Parent then
				TweenService:Create(part, TweenInfo.new(0.4), { CFrame = down }):Play()
				task.delay(0.42, function()
					if part.Parent then
						part:Destroy()
					end
				end)
			end
		end)
		dustCloud(p, 1.4, 3)
	end

	-- THE CLUB: wound right round with the skull still on you, the bone rattling; then all the way across
	local function swing(b, target)
		F.halt(b)
		if not F.beats(b, target, {
			{ "BNWind", "BNWind", 0.6 },
			{ "BNWind", "BNWind", 0.5, function()
				playSound(b.root, SOUNDS.Unsheath, 0.9, 0.45)
			end },
		}, 0.7) then
			return
		end
		setTrail(b, true)
		F.step(b, 9, 0.3)
		bodyPose(b, "BNThrough", 0.2)
		pose(b, "BNMid", 0.15, Enum.EasingStyle.Linear)
		task.delay(0.15, function()
			pose(b, "BNEnd", 0.17)
		end)
		playSound(b.root, SOUNDS.Lunge, 1, 0.5)
		F.sweep(b, 0.33, D.Swing, "Large", {}, 3.5)
		setTrail(b, false)
		F.recover(b, 1.2, "Recover")
	end

	local function over(b, target)
		F.halt(b)
		if not F.beats(b, target, { { "BNHigh", "BNHigh", 0.8 } }, 0.65) then
			return
		end
		local at = ahead(b, 20)
		F.ring(at, 10, 0.65)
		playSound(b.root, SOUNDS.Unsheath, 0.9, 0.42)
		if not F.track(b, target, 0.65, 0) then
			return
		end
		setTrail(b, true)
		F.draw(b, "BNDown", "BNDown", 0.14)
		playSound(b.root, SOUNDS.Lunge, 1, 0.45)
		F.sweep(b, 0.15, D.Over, "Knockdown", {}, 3.5)
		setTrail(b, false)
		if not F.live(b) then
			return
		end
		F.quake(b, at, 10, 1.4)
		debrisChunks(at + Vector3.new(0, 0.5, 0), 6, 20)
		F.hit(F.radius(at, 10, 8), {}, D.Blast, at, "Large")
		for i = 1, 6 do
			local a = i / 6 * math.pi * 2
			spike(at + Vector3.new(math.cos(a) * 8, 0, math.sin(a) * 8), 10, 2)
		end
		F.recover(b, 1.4, false)
	end

	local function stomp(b, target)
		F.halt(b)
		local at = flat(b.root.Position)
		F.draw(b, "BNRest", "BNKnee", 0.55 * F.tempo())
		F.ring(at, 13, 0.9 * F.tempo())
		playSound(b.root, SOUNDS.Groan, 0.8, 0.5)
		if not F.track(b, target, 0.9 * F.tempo(), 0) then
			return
		end
		bodyPose(b, "BNStomp", 0.1)
		playSound(b.root, SOUNDS.Lunge, 0.9, 0.55)
		if not F.hold(b, 0.09) then
			return
		end
		F.quake(b, at, 13, 1.1)
		F.hit(F.radius(at, 13, 8), {}, D.Stomp, at, "Large")
		F.recover(b, 1, false)
	end

	-- one line of spears along the floor, from a to z, each coming up after the last
	local function spears(b, a, z, wid, lead)
		F.strip(a, z, wid, lead)
		local n = math.max(math.floor((z - a).Magnitude / 6), 2)
		local seen = {}
		for i = 1, n do
			task.delay(lead + i * 0.07, function()
				if F.live(b) then
					local p = a:Lerp(z, i / n)
					spike(p + Vector3.new((math.random() - 0.5) * 3, 0, (math.random() - 0.5) * 3), 13, 2.4)
					playSound(b.root, SOUNDS.Impact, 0.3, 1.4)
					F.hit(F.radius(p, wid / 2 + 1, 8), seen, D.Spear, p, "Large")
				end
			end)
		end
		return lead + n * 0.07
	end

	-- THE SPEARS: the club driven into the floor; a strip lights, then it comes up in spears along it, away from him
	local function spearLine(b, target)
		F.halt(b)
		if not F.beats(b, target, { { "BNDrive", "BNDrive", 0.75 } }, 0.65) then
			return
		end
		playSound(b.root, SOUNDS.Impact, 0.8, 0.6)
		dustCloud(ahead(b, 14), 3, 8)
		local a = ahead(b, 10)
		local dir = F.fwd(b)
		local time = 0
		for _, yaw in ipairs(F.phase2() and { -0.42, 0, 0.42 } or { 0 }) do
			local d = CFrame.Angles(0, yaw, 0):VectorToWorldSpace(dir)
			time = math.max(time, spears(b, a, F.clamp(a + d * 56, 3), 7, 0.6))
		end
		F.hold(b, time)
		F.recover(b, 1.1, "Recover")
	end

	-- one cage round p: a circle lit on the floor, bars of rib coming up round it as it closes, then it snaps shut on whatever's inside
	local function cage(b, at, r, lead)
		F.ring(at, r, lead)
		local bars = {}
		local N = 14
		for i = 1, N do
			local a = i / N * 2 * math.pi
			local p = at + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
			local out = CFrame.lookAt(p, at)
			local bar = F.part({ Name = "CageBar", Size = Vector3.new(1.3, 18, 1.3), Material = Enum.Material.Pebble, Color = BONE_C, CFrame = CFrame.new(p.X, -10, p.Z) * out.Rotation })
			table.insert(bars, bar)
			TweenService:Create(bar, TweenInfo.new(lead * 0.8, Enum.EasingStyle.Sine), { CFrame = (CFrame.new(p.X, 8.5, p.Z) * out.Rotation) * CFrame.Angles(-0.12, 0, 0) }):Play()
		end
		playSound(b.root, SOUNDS.Unsheath, 0.9, 0.3)
		task.delay(lead, function()
			if not F.live(b) then
				return
			end
			-- shut: every bar's top slammed in to the middle
			for i, bar in ipairs(bars) do
				if bar.Parent then
					local a = i / N * 2 * math.pi
					local p = at + Vector3.new(math.cos(a) * r * 0.72, 0, math.sin(a) * r * 0.72)
					TweenService:Create(bar, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = CFrame.lookAt(p + Vector3.new(0, 8.5, 0), at) * CFrame.Angles(-0.65, 0, 0) }):Play()
				end
			end
			task.delay(0.1, function()
				if F.live(b) then
					F.quake(b, at, r * 0.7, 1)
					burst(at, BONE_C, 26, 0.45, 16)
					F.hit(F.radius(at, r - 0.5, 9), {}, D.Cage, at, "Knockdown")
				end
				task.delay(0.9, function()
					for _, bar in ipairs(bars) do
						if bar.Parent then
							F.fade(bar, 0.6)
						end
					end
				end)
			end)
		end)
	end

	-- THE CAGE: it drives its free hand at the floor, and a ring of bones comes up round you. Plenty of time to walk out of it.
	local function lockUp(b, target)
		F.halt(b)
		local tr = target:FindFirstChild("HumanoidRootPart")
		if not tr then
			return
		end
		if not F.beats(b, target, { { "BNCall", "BNCall", 0.55, function()
			playSound(b.root, SOUNDS.Groan, 0.9, 0.5)
		end } }, 0.5) then
			return
		end
		local LEAD = 1.5
		cage(b, F.clamp(flat(tr.Position), 12), 11, LEAD)
		if F.phase2() then
			local v = flat(tr.Position - b.root.Position)
			local side = v.Magnitude > 1 and Vector3.new(-v.Unit.Z, 0, v.Unit.X) or Vector3.new(1, 0, 0)
			cage(b, F.clamp(flat(tr.Position) + side * (math.random() < 0.5 and 20 or -20), 12), 11, LEAD + 0.5)
		end
		F.draw(b, "BNRest", "BNClose", 0.4)
		F.hold(b, LEAD)
		F.recover(b, 1.3, "BNIdle")
	end

	-- RIBS (phase 2): it tears them out of itself and throws them, slow long arcs down on rings
	local function ribs(b, target)
		F.halt(b)
		if not F.beats(b, target, { { "BNRest", "BNTear", 0.8, function()
			playSound(b.root, SOUNDS.Unsheath, 1, 0.6)
		end } }, 0.6) then
			return
		end
		F.draw(b, "BNRest", "BNThrow", 0.14)
		playSound(b.root, SOUNDS.Lunge, 1, 0.65)
		local tr = target:FindFirstChild("HumanoidRootPart")
		if not tr then
			return
		end
		local from = b.root.Position + Vector3.new(0, 8, 0)
		for i = 1, 5 do
			local spread = i == 1 and Vector3.zero or Vector3.new(math.random(-15, 15), 0, math.random(-15, 15))
			local to = F.clamp(flat(tr.Position) + spread, 3)
			local dur = 1.05 + i * 0.07
			F.ring(to, 5.5, dur)
			local rib = F.part({ Name = "ThrownRib", Size = Vector3.new(1, 11, 1), Material = Enum.Material.Pebble, Color = BONE_C, CFrame = CFrame.new(from) })
			F.lob(b, rib, from, Vector3.new(to.X, 1, to.Z), dur, 18, function(z)
				debrisChunks(z, 3, 14)
				dustCloud(z, 2, 5)
				spike(z, 10, 1.8)
				playSound(b.root, SOUNDS.Impact, 0.5, 1.1)
				F.hit(F.radius(z, 5.5, 8), {}, D.Rib, z, "Medium")
			end)
		end
		F.recover(b, 1.2, "BNIdle")
	end

	Fight.define({
		id = "Bones",
		label = "The Bone Colossus",
		kind = M.Kind,
		scale = S,
		weapon = "Femur",
		idleGrip = "BNRest",
		hp = 780,
		poise = 160,
		stagger = 2.8,
		radius = 4.2,
		walk = 10.5,
		turn = 78,
		rest = { 0.6, 1.3 },
		keep = { 16, 26 },
		phase2At = 0.5,
		tempo2 = 0.9,
		restMult2 = 0.75,
		moves = {
			{ name = "Swing", fn = swing, min = 0, max = 30, weight = 5, cd = 2.5, fast = true },
			{ name = "Over", fn = over, min = 8, max = 32, weight = 4, cd = 4 },
			{ name = "Stomp", fn = stomp, min = 0, max = 11, weight = 6, cd = 3.5, behind = true },
			{ name = "Spears", fn = spearLine, min = 14, max = 90, weight = 4, cd = 5 },
			{ name = "Cage", fn = lockUp, min = 12, max = 95, weight = 5, cd = 7 },
			{ name = "Ribs", fn = ribs, min = 20, max = 95, weight = 4, cd = 9, phase2 = true },
		},
		idle = function(b)
			pose(b, "BNRest", 0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			bodyPose(b, "BNIdle", 0.6)
		end,
		onStagger = function(b)
			pose(b, "BNSlump", 0.2)
			bodyPose(b, "BNCollapse", 0.2)
			debrisChunks(b.root.Position, 5, 16)
			playSound(b.root, SOUNDS.Impact, 0.8, 0.9)
		end,
		-- the entrance: slumped in a heap at the far end; it pulls itself up, howls without any breath, and comes
		intro = function(b)
			pose(b, "BNSlump", 0.2)
			bodyPose(b, "BNCollapse", 0.2)
			task.wait(0.9)
			playSound(b.root, SOUNDS.Unsheath, 1, 0.4)
			bodyPose(b, "BNHigh", 1.3)
			task.wait(1.1)
			F.draw(b, "BNHowl", "BNHowl", 0.45)
			playSound(b.root, SOUNDS.Groan, 1, 0.38)
			FxRemote:FireAllClients("Shake", b.root.Position, 0.6)
			task.wait(1.1)
			pose(b, "BNRest", 0.5)
			bodyPose(b, "BNIdle", 0.5)
			task.wait(0.3)
		end,
		-- phase 2: the howl again, and spears all round it. Half the ribs go: it's going to throw them
		phase2 = function(b)
			F.halt(b)
			F.draw(b, "BNHowl", "BNHowl", 0.5)
			playSound(b.root, SOUNDS.Groan, 1, 0.3)
			FxRemote:FireAllClients("Shake", b.root.Position, 0.9)
			local n = 0
			for _, p in ipairs(b.model:GetChildren()) do
				if p:IsA("BasePart") and p.Name == "Rib" then
					n += 1
					if n % 2 == 0 then
						p.Transparency = 1
					end
				end
			end
			F.wait(b, 0.5)
			local c = flat(b.root.Position)
			F.ring(c, 16, 0.6)
			F.wait(b, 0.6)
			for i = 1, 10 do
				local a = i / 10 * math.pi * 2
				spike(c + Vector3.new(math.cos(a) * 12, 0, math.sin(a) * 12), 14, 2.4)
			end
			F.hit(F.radius(c, 16, 8), {}, D.Spear, c, "Large")
			F.wait(b, 0.8)
			F.idle(b)
		end,
	})
end

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">WardenBones</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">67a794dd5dfb48b48beb15ac6721b3d9</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXD9310DEA55124BA7B1F53B595A62D5C3">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE WARDEN, candidate 2: THE HOLLOW PLATE. A huge suit of grey armor with nobody in it. There's a pale wisp where a neck
-- should be, a helm drifting a little above it, and dark chain holding the plates loosely together. Because it's empty it
-- can do what no man in armor can: its fist comes off and flies at you on a chain, and it can fall apart with a crash,
-- slither across the floor as a heap of plates and stand up again under your feet.
-- Phase 1: the haymaker, the two-handed hammer blow, the flying fist, falling apart.
-- Phase 2 at half health: the wisp blazes up. Everything above the hips spins round on a pin, and when it reassembles it
-- throws out a wave. Fight's plumbing: ReplicatedStorage/WardenFight.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Fight = require(ReplicatedStorage:WaitForChild("WardenFight"))

local S = 3.9
local M = {}
M.Kind = "WardenPlate"
M.Proportions = { girth = 1.4, arm = 1.25, hunch = 0.1, walkRef = 2.6, cadence = 0.95, elbowOut = 0.35 }
M.IdlePose = "PLIdle"
M.Poses = {
	-- at rest: square and upright, arms hanging heavy and a little out, swaying as if on its chains
	PLIdle = { drop = 0.25, lean = 0.1, head = 0.05, footR = -0.25, footL = 0.3, spread = 0.3, breathe = 1.5, la1 = 0.1, la3 = -0.28, lel = 0.3, freeL = 0.5 },
	-- the haymaker: the whole trunk wound back, the fist drawn behind it
	PLWind = { drop = 0.65, lean = -0.05, twist = -1.15, hip = -0.5, side = -0.1, look = 0.9, footR = -0.8, footL = 0.8, spread = 0.38, breathe = 2, la1 = 0.9, la3 = -0.7, lel = 0.6, freeL = 0 },
	PLThrough = { drop = 1.15, lean = 0.65, twist = 1.05, hip = 0.5, side = 0.14, look = -0.5, footR = 1.0, footL = -0.75, spread = 0.38, la1 = -0.5, la3 = -0.5, lel = 0.5, freeL = 0 },
	-- the hammer: both arms straight up, up on its feet...
	PLOver = { drop = 0, lean = -0.32, head = -0.4, footR = -0.3, footL = 0.35, spread = 0.3, breathe = 2, la1 = 2.9, la3 = -0.15, lel = 0.3, freeL = 0 },
	-- ...and everything down on the blow
	PLHammer = { drop = 1.4, lean = 0.95, head = -0.1, footR = 0.8, footL = -0.65, spread = 0.42, la1 = 1.25, la3 = 0.1, lel = 0.1, freeL = 0 },
	-- sighting along the arm before the fist goes
	PLAim = { drop = 0.45, lean = 0.1, twist = 0.35, look = -0.25, footR = 0.55, footL = -0.65, spread = 0.26, breathe = 2, la1 = -0.2, la3 = -0.6, lel = 0.9, freeL = 0 },
	PLFired = { drop = 0.6, lean = -0.12, twist = -0.3, footR = 0.3, footL = -0.75, spread = 0.26, breathe = 2, la1 = 0.3, la3 = -0.5, lel = 0.5, freeL = 0 },
	-- losing its shape, before it drops: knees going, everything sagging out of true
	PLSag = { drop = 1.3, lean = 0.45, side = 0.22, twist = 0.3, head = 0.55, footR = 0.4, footL = -0.4, spread = 0.45, la1 = -0.1, la3 = -0.6, lel = 0.1, freeL = 0, breathe = 3 },
	-- come together again and straightening up out of the floor
	PLRising = { drop = 1.5, lean = 0.75, head = -0.4, footR = 0.35, footL = -0.4, spread = 0.46, la1 = 0.5, la3 = -1.2, lel = 0.5, freeL = 0 },
	PLSpinSet = { drop = 0.7, twist = -1.45, hip = 0, look = 0.8, footR = -0.25, footL = 0.3, spread = 0.46, la1 = 0.3, la3 = -1.45, lel = 0, breathe = 2, freeL = 0 },
	PLSpin = { drop = 0.7, footR = -0.2, footL = 0.25, spread = 0.46, la1 = 0.1, la3 = -1.5, lel = 0, freeL = 0 },
	-- staggered: slumped forward, chains slack
	PLSlump = { drop = 1.35, lean = 1, side = 0.15, head = 0.6, footR = 0.55, footL = -0.65, spread = 0.42, la1 = -0.25, la3 = -0.3, lel = 0.1, freeL = 0 },
	PLBlaze = { drop = 0.15, lean = -0.4, head = -0.6, footR = 0.4, footL = -0.4, spread = 0.34, la1 = 2.3, la3 = -0.9, lel = 0.4, breathe = 3, freeL = 0 },
}
local STEEL, STEEL_DK, STEEL_LT, VOID, CHAIN, WISP = Color3.fromRGB(116, 120, 126), Color3.fromRGB(76, 80, 86), Color3.fromRGB(150, 154, 160), Color3.fromRGB(10, 10, 14), Color3.fromRGB(36, 36, 40), Color3.fromRGB(196, 226, 232)
M.Colors = { skin = VOID, torso = VOID, legs = VOID, arms = VOID }
M.FistSkin = true

function M.Look(k)
	local deco, parts, V, at, MAT, D, s = k.deco, k.parts, k.V, k.at, k.MAT, k.D, k.s
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	local tl, sl = D.thigh / s, D.shin / s
	local BALL = Enum.PartType.Ball
	-- the plates stand a little off the dark body, gaps showing the nothing inside
	deco("Chest", "Breast", V(cw * 1.04, ch * 0.62, 0.3), at(0, ch * 0.16, -cd / 2 - 0.08), STEEL, MAT.Metal)
	deco("Chest", "BreastRidge", V(0.2, ch * 0.62, 0.12), at(0, ch * 0.16, -cd / 2 - 0.27), STEEL_LT, MAT.Metal)
	deco("Chest", "Plackart", V(cw * 0.86, ch * 0.28, 0.24), at(0, -ch * 0.32, -cd / 2 - 0.05), STEEL_DK, MAT.Metal)
	deco("Chest", "Back", V(cw * 1.02, ch * 0.72, 0.26), at(0, ch * 0.08, cd / 2 + 0.08), STEEL_DK, MAT.Metal)
	deco("Chest", "NeckRing", V(cw * 0.5, 0.26, cd * 0.92), at(0, ch / 2 + 0.05, 0), STEEL_DK, MAT.Metal)
	for i = -1, 1 do -- (loose chain, sewn between the plates)
		deco("Chest", "Stitch", V(0.1, 0.46, 0.1), at(i * 0.5, -ch * 0.12, -cd / 2 - 0.22), CHAIN, MAT.DiamondPlate)
		deco("Hips", "Stitch", V(0.1, 0.5, 0.1), at(i * 0.5, 0.48, -hd / 2 - 0.14), CHAIN, MAT.DiamondPlate)
	end
	-- a skirt of steel lames
	for i = 0, 2 do
		deco("Hips", "Lame", V(hw * (1.1 + i * 0.05), 0.3, hd * (1.15 + i * 0.06)), at(0, 0.18 - i * 0.34, 0), i % 2 == 0 and STEEL or STEEL_DK, MAT.Metal)
	end
	for _, n in ipairs({ "R", "L" }) do
		local sx = n == "R" and 1 or -1
		deco(n .. "UpperArm", "Pauldron", V(aw * 1.75, 0.62, aw * 1.75), at(sx * 0.1, ua / 2 - 0.02, 0) * CFrame.Angles(0, 0, -sx * 0.25), STEEL, MAT.Metal)
		deco(n .. "UpperArm", "PauldronLow", V(aw * 1.55, 0.34, aw * 1.55), at(sx * 0.06, ua / 2 - 0.5, 0) * CFrame.Angles(0, 0, -sx * 0.15), STEEL_DK, MAT.Metal)
		deco(n .. "UpperArm", "Rerebrace", V(aw * 1.12, ua * 0.42, aw * 1.12), at(0, -ua * 0.2, 0), STEEL_DK, MAT.Metal)
		deco(n .. "LowerArm", "Couter", V(aw * 1.15, aw * 1.15, aw * 1.15), at(0, la / 2, 0), STEEL, MAT.Metal, BALL)
		deco(n .. "LowerArm", "Vambrace", V(aw * 1.12, la * 0.56, aw * 1.12), at(0, -la * 0.1, 0), STEEL, MAT.Metal)
		deco(n .. "Thigh", "Cuisse", V(lw * 1.14, tl * 0.62, lw * 1.14), at(0, tl * 0.1, 0), STEEL, MAT.Metal)
		deco(n .. "Thigh", "Poleyn", V(lw * 1.1, lw * 1.1, lw * 1.1), at(0, -tl / 2, -0.08), STEEL_LT, MAT.Metal, BALL)
		deco(n .. "Shin", "Greave", V(lw * 1.1, sl * 0.72, lw * 1.1), at(0, -sl * 0.06, 0), STEEL_DK, MAT.Metal)
		deco(n .. "Foot", "Sabaton", V(D.footSize.X / s * 1.12, D.footSize.Y / s * 1.25, D.footSize.Z / s * 1.08), at(0, 0.03, -0.03), STEEL, MAT.Metal)
	end
	deco("LLowerArm", "LeftGauntlet", V(aw * 1.45, 0.95, aw * 1.45), at(0, -la / 2 - 0.25, 0), STEEL, MAT.Metal)
	for _, c in ipairs(parts.Chest.Parent:GetChildren()) do
		if c.Name == "Fist" then -- (the rig's own: the gauntlets stand in for them)
			c.Transparency = 1
		end
	end
	-- no head: a wisp over the neck hole, and a closed helm hanging in the air above it, on nothing
	parts.Head.Transparency = 1
	local wisp = deco("Chest", "Wisp", V(0.72, 0.72, 0.72), at(0, ch / 2 + 0.25, 0), WISP, MAT.Neon, BALL)
	local glow = Instance.new("PointLight")
	glow.Color, glow.Range, glow.Brightness, glow.Shadows = WISP, 34, 1.3, false
	glow.Parent = wisp
	deco("Head", "Helm", V(1.18, 1.0, 1.25), at(0, 0.42, 0), STEEL, MAT.Metal)
	deco("Head", "HelmCrest", V(0.14, 0.42, 1.25), at(0, 1.02, 0), STEEL_LT, MAT.Metal)
	deco("Head", "Visor", V(1.05, 0.34, 0.14), at(0, 0.3, -0.62), STEEL_DK, MAT.Metal)
	deco("Head", "VisorSlit", V(0.86, 0.07, 0.05), at(0, 0.38, -0.7), VOID, MAT.SmoothPlastic)
end

M.Weapons = {
	-- its right fist, the size of a barrel: it's the one thing it swings, and it comes off
	PlateFist = function(w)
		local mk, add = w.mk, w.add
		local steel, dark, chain = Color3.fromRGB(116, 120, 126), Color3.fromRGB(76, 80, 86), Color3.fromRGB(36, 36, 40)
		local handle = mk("Fist", Vector3.new(1.35, 1.4, 1.35), steel, Enum.Material.Metal)
		add(mk("Cuff", Vector3.new(1.6, 0.55, 1.6), dark, Enum.Material.Metal), 0.85)
		for i = -1, 1, 2 do
			add(mk("Knuckle", Vector3.new(0.55, 0.42, 1.55), dark, Enum.Material.Metal), -0.68, CFrame.new(i * 0.32 * w.scale, 0, 0))
		end
		add(mk("Link", Vector3.new(0.3, 0.7, 0.3), chain, Enum.Material.DiamondPlate), 1.3)
		return { handle = handle, bladeLen = 0.8 }
	end,
}
local R = math.rad
M.Grips = {
	PLRest = { Vector3.new(1.9, -0.75, -0.3), CFrame.Angles(R(6), 0, 0) },
	PLBack = { Vector3.new(2.3, 0.2, 2.1), CFrame.Angles(R(-40), 0, R(20)) },
	PLMid = { Vector3.new(0.9, -1.6, -3.0), CFrame.Angles(R(70), 0, 0) },
	PLEnd = { Vector3.new(-2.2, -1.6, -1.2), CFrame.Angles(R(60), R(70), 0) },
	PLHigh = { Vector3.new(0.5, 3.6, -0.1), CFrame.Angles(R(175), 0, 0) },
	PLLow = { Vector3.new(0.3, -2.1, -3.0), CFrame.Angles(R(40), 0, 0) },
	PLAim = { Vector3.new(1.4, 0.9, -3.0), CFrame.Angles(R(90), 0, 0) },
	PLWide = { Vector3.new(3.3, -0.8, 0), CFrame.Angles(0, 0, R(80)) },
	PLSlump = { Vector3.new(1.3, -1.9, -1.2), CFrame.Angles(R(10), 0, 0) },
}
M.BodyFor = {}

---------------------------------------------------------------------------
-- server: the fight
---------------------------------------------------------------------------
function M.init(core)
	local F = Fight.init(core)
	local SOUNDS, playSound, burst, pose, bodyPose, setTrail, dustCloud, flat, now, debrisChunks, FxRemote = core.SOUNDS, core.playSound, core.burst, core.pose, core.bodyPose, core.setTrail, core.dustCloud, core.flat, core.now, core.debrisChunks, core.FxRemote
	local D = { Hay = 22, Hammer = 26, Blast = 14, Fist = 18, Rise = 22, Spin = 20, Wave = 12 }
	local PLATE = Color3.fromRGB(116, 120, 126)
	local WISP = Color3.fromRGB(196, 226, 232)
	local STAND = 3 * S

	local function ahead(b, dist)
		return flat(b.root.Position) + F.fwd(b) * dist
	end

	-- THE HAYMAKER: wound right round, the fist behind it, a long look; then the whole of it behind one blow
	local function haymaker(b, target)
		F.halt(b)
		if not F.beats(b, target, {
			{ "PLBack", "PLWind", 0.6 },
			{ "PLBack", "PLWind", 0.5, function()
				playSound(b.root, SOUNDS.Unsheath, 0.9, 0.42)
			end },
		}, 0.7) then
			return
		end
		setTrail(b, true)
		F.step(b, 10, 0.3)
		bodyPose(b, "PLThrough", 0.2)
		pose(b, "PLMid", 0.15, Enum.EasingStyle.Linear)
		task.delay(0.15, function()
			pose(b, "PLEnd", 0.16)
		end)
		playSound(b.root, SOUNDS.Lunge, 1, 0.45)
		F.sweep(b, 0.32, D.Hay, "Large", {}, 7)
		setTrail(b, false)
		F.recover(b, 1.25, "PLSlump")
	end

	-- THE HAMMER: fist straight up; a ring where it'll land; down it comes, and it's a moment getting it back out of the floor
	local function hammer(b, target)
		F.halt(b)
		if not F.beats(b, target, { { "PLHigh", "PLOver", 0.7 } }, 0.55) then
			return
		end
		local at = ahead(b, 16)
		F.ring(at, 11, 0.8)
		playSound(b.root, SOUNDS.Unsheath, 0.9, 0.4)
		if not F.track(b, target, 0.8, 0) then
			return
		end
		setTrail(b, true)
		F.draw(b, "PLLow", "PLHammer", 0.14)
		playSound(b.root, SOUNDS.Lunge, 1, 0.42)
		if not F.wait(b, 0.14) then
			return
		end
		setTrail(b, false)
		F.quake(b, at, 11, 1.5)
		debrisChunks(at + Vector3.new(0, 0.5, 0), 7, 20)
		F.hit(F.radius(at, 11, 8), {}, D.Hammer, at, "Knockdown")
		F.recover(b, 1.5, false)
	end

	-- THE FIST: sighted along its arm, a strip down the floor, and off it goes on its chain, there and back. It's one-handed
	-- while it's gone: walk in
	local function fist(b, target)
		F.halt(b)
		local copy
		F.setCleanup(function()
			if copy and copy.Parent then
				copy:Destroy()
			end
			if b.model.Parent then
				F.hideWeapon(b, false)
			end
		end)
		if not F.beats(b, target, { { "PLAim", "PLAim", 0.75, function()
			playSound(b.root, SOUNDS.Unsheath, 0.9, 1.1)
		end } }, 0.6) then
			return
		end
		local dir = F.fwd(b)
		local start = Vector3.new(b.root.Position.X, 3.5, b.root.Position.Z) + dir * 8
		local goal = F.clamp(start + dir * 68, 3)
		F.strip(start, goal, 9, 0.55)
		if not F.track(b, target, 0.55, 0) then
			return
		end
		local handle
		copy, handle = F.cloneWeapon(b)
		F.hideWeapon(b, true)
		if not copy then
			return
		end
		bodyPose(b, "PLFired", 0.1)
		playSound(b.root, SOUNDS.Lunge, 1, 0.5)
		FxRemote:FireAllClients("Shake", start, 0.4)
		local chain = F.part({ Name = "FistChain", Size = Vector3.new(0.9, 0.9, 1), Material = Enum.Material.DiamondPlate, Color = Color3.fromRGB(36, 36, 40) })
		local seen, t0 = {}, now()
		local OUT, HOME, WAIT = (goal - start).Magnitude / 62, (goal - start).Magnitude / 44, 0.4
		while F.free(b) do
			task.wait()
			local el, p = now() - t0, nil
			if el < OUT then
				p = start:Lerp(goal, el / OUT)
			elseif el < OUT + WAIT then
				p = goal
				if not seen.stuck then
					seen.stuck = true
					burst(goal, Color3.fromRGB(230, 225, 205), 18, 0.35, 16)
					playSound(handle, SOUNDS.Impact, 0.8, 0.8)
				end
			else
				local a = math.min((el - OUT - WAIT) / HOME, 1)
				p = goal:Lerp(start, a)
				if not seen.back then
					seen = { back = true, stuck = true } -- (it can catch you coming home too)
				end
				if a >= 1 then
					break
				end
			end
			handle.CFrame = CFrame.lookAt(p, p + dir) * CFrame.Angles(math.rad(90), 0, 0)
			chain.Size = Vector3.new(0.9, 0.9, math.max((p - start).Magnitude, 1))
			chain.CFrame = CFrame.lookAt(start:Lerp(p, 0.5), p)
			F.hit(F.radius(p, 5.5, 9), seen, D.Fist, p, "Large")
		end
		if copy.Parent then
			copy:Destroy()
		end
		chain:Destroy()
		F.hideWeapon(b, false)
		F.setCleanup(nil)
		if F.live(b) then
			playSound(b.root, SOUNDS.Impact, 0.6, 1.1)
			F.recover(b, 0.75, "PLIdle")
		end
	end

	-- FALLING APART: everything sags out of true, a shudder; then it collapses with a crash into a heap of loose plates, and the
	-- heap slides at you along the floor. A ring opens where it's going to stand back up. Get out from under it. It takes a
	-- moment to find its feet again, stood right there in the open
	local function scatter(b, target)
		F.halt(b)
		local plates = {}
		F.setCleanup(function()
			for _, p in ipairs(plates) do
				if p.Parent then
					p:Destroy()
				end
			end
			if b.model.Parent then
				F.hideBody(b, false)
			end
		end)
		F.draw(b, "PLSlump", "PLSag", 0.7 * F.tempo())
		playSound(b.root, SOUNDS.Groan, 0.8, 0.55)
		if not F.hold(b, 0.8 * F.tempo()) then
			return
		end
		local root = b.root
		root.Anchored = true
		local c = flat(root.Position)
		F.hideBody(b, true)
		playSound(root, SOUNDS.Impact, 1, 0.7)
		FxRemote:FireAllClients("Shake", c, 0.9)
		dustCloud(c, 4, 12)
		for i = 1, 16 do
			local size = math.random(3, 7)
			local p = F.part({
				Name = "LoosePlate", Size = Vector3.new(size, 0.9, size * 0.8), Material = Enum.Material.Metal, Color = i % 2 == 0 and PLATE or Color3.fromRGB(76, 80, 86),
				CFrame = CFrame.new(c + Vector3.new(math.random(-9, 9), 0.5, math.random(-9, 9))) * CFrame.Angles(math.random() * 0.5, math.random() * 6, math.random() * 0.5),
			})
			table.insert(plates, p)
		end
		if not F.wait(b, 0.5) then
			return
		end
		local tr = target:FindFirstChild("HumanoidRootPart")
		local to = F.clamp(tr and flat(tr.Position) or c, 12)
		F.ring(to, 12, 1.5)
		playSound(root, SOUNDS.Unsheath, 0.9, 0.35)
		local from = {}
		for i, p in ipairs(plates) do
			from[i] = p.Position
		end
		local t0 = now()
		while F.live(b) do
			local t = math.min((now() - t0) / 1.5, 1)
			local e = t * t * (3 - 2 * t)
			for i, p in ipairs(plates) do
				local g = to + (from[i] - c) * 0.6 * (1 - e)
				p.CFrame = CFrame.new(from[i]:Lerp(g, e) + Vector3.new(0, 0.4 + math.abs(math.sin(t * 16 + i)) * 0.9, 0)) * p.CFrame.Rotation
			end
			if t >= 1 then
				break
			end
			task.wait()
		end
		if not F.live(b) then
			return
		end
		for _, p in ipairs(plates) do
			p:Destroy()
		end
		plates = {}
		root.CFrame = CFrame.new(to.X, STAND, to.Z) * root.CFrame.Rotation
		bodyPose(b, "PLRising", 0.05)
		F.hideBody(b, false)
		F.setCleanup(nil)
		F.quake(b, to, 12, 1.5)
		debrisChunks(to + Vector3.new(0, 0.5, 0), 7, 22)
		F.hit(F.radius(to, 12, 8), {}, D.Rise, to, "Knockdown")
		if F.phase2() then
			F.wave(b, to, 24, 56, D.Wave, "Medium")
		end
		root.Anchored = false
		F.recover(b, 1.7, false)
	end

	-- THE PIN (phase 2): nobody's inside, so nothing stops it: fist flung out wide, then it all goes round and round at the hips
	local function spin(b, target)
		F.halt(b)
		if not F.beats(b, target, { { "PLWide", "PLSpinSet", 0.95, function()
			playSound(b.root, SOUNDS.Unsheath, 0.9, 0.38)
		end } }, 0.5) then
			return
		end
		F.ring(flat(b.root.Position), 22, 0.45)
		if not F.track(b, target, 0.45, 0) then
			return
		end
		local root = b.root
		root.Anchored = true
		setTrail(b, true)
		bodyPose(b, "PLSpin", 0.12)
		playSound(root, SOUNDS.Lunge, 1, 0.42)
		local base, seen, t0 = root.CFrame, {}, now()
		local DUR, TURNS = 1.15, 2
		while F.free(b) do
			local t = math.min((now() - t0) / DUR, 1)
			root.CFrame = base * CFrame.Angles(0, -t * TURNS * 2 * math.pi, 0)
			if math.floor(t * TURNS * 2) ~= (seen.half or 0) then
				seen = { half = math.floor(t * TURNS * 2) } -- (once per half turn, at most)
				playSound(root, SOUNDS.Lunge, 0.7, 0.5)
			end
			F.hit(F.radius(flat(root.Position), 20, 8), seen, D.Spin, root.Position, "Large")
			if t >= 1 then
				break
			end
			task.wait()
		end
		setTrail(b, false)
		root.Anchored = false
		F.recover(b, 1.6, "PLSlump")
	end

	Fight.define({
		id = "Plate",
		label = "The Hollow Plate",
		kind = M.Kind,
		scale = S,
		weapon = "PlateFist",
		idleGrip = "PLRest",
		hp = 820,
		poise = 170,
		stagger = 2.8,
		radius = 4.8,
		walk = 10,
		turn = 75,
		rest = { 0.6, 1.3 },
		keep = { 16, 26 },
		phase2At = 0.5,
		tempo2 = 0.9,
		restMult2 = 0.75,
		moves = {
			{ name = "Haymaker", fn = haymaker, min = 0, max = 27, weight = 5, cd = 2.5, fast = true },
			{ name = "Hammer", fn = hammer, min = 5, max = 28, weight = 5, cd = 4 },
			{ name = "Fist", fn = fist, min = 22, max = 95, weight = 5, cd = 5 },
			{ name = "Scatter", fn = scatter, min = 0, max = 95, weight = 2.5, cd = 13, behind = true },
			{ name = "Spin", fn = spin, min = 0, max = 22, weight = 5, cd = 8, phase2 = true, behind = true },
		},
		idle = function(b)
			pose(b, "PLRest", 0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			bodyPose(b, "PLIdle", 0.6)
		end,
		onStagger = function(b)
			pose(b, "PLSlump", 0.2)
			bodyPose(b, "PLSlump", 0.2)
			playSound(b.root, SOUNDS.Impact, 0.7, 0.9)
		end,
		-- the entrance: a heap of plates at the far end. It rattles, stands up, and the wisp lights
		intro = function(b)
			local root = b.root
			F.hideBody(b, true)
			local c = flat(root.Position)
			local heap = {}
			for i = 1, 16 do
				local size = math.random(3, 7)
				table.insert(heap, F.part({ Name = "LoosePlate", Size = Vector3.new(size, 0.9, size * 0.8), Material = Enum.Material.Metal, Color = i % 2 == 0 and PLATE or Color3.fromRGB(76, 80, 86), CFrame = CFrame.new(c + Vector3.new(math.random(-8, 8), 0.6, math.random(-8, 8))) * CFrame.Angles(math.random() * 0.5, math.random() * 6, math.random() * 0.5) }))
			end
			task.wait(0.7)
			playSound(root, SOUNDS.Unsheath, 1, 0.4)
			FxRemote:FireAllClients("Shake", c, 0.5)
			task.wait(0.9)
			for _, p in ipairs(heap) do
				p:Destroy()
			end
			pose(b, "PLSlump", 0.05)
			bodyPose(b, "PLRising", 0.05)
			F.hideBody(b, false)
			dustCloud(c, 4, 12)
			playSound(root, SOUNDS.Impact, 1, 0.7)
			task.wait(0.35)
			bodyPose(b, "PLBlaze", 0.9)
			playSound(root, SOUNDS.Groan, 1, 0.5)
			task.wait(1)
			bodyPose(b, "PLIdle", 0.5)
			task.wait(0.3)
		end,
		-- phase 2: the wisp blazes up
		phase2 = function(b)
			F.halt(b)
			F.draw(b, "PLHigh", "PLBlaze", 0.5)
			playSound(b.root, SOUNDS.Groan, 1, 0.42)
			FxRemote:FireAllClients("Shake", b.root.Position, 0.8)
			local wisp = b.model:FindFirstChild("Wisp")
			if wisp then
				wisp.Size *= 1.7
				local light = wisp:FindFirstChildOfClass("PointLight")
				if light then
					light.Brightness = 2.4
				end
				local f = Instance.new("Fire")
				f.Size, f.Heat, f.Color, f.SecondaryColor = 14, 12, WISP, Color3.fromRGB(70, 96, 110)
				f.Parent = wisp
				burst(wisp.Position, WISP, 40, 0.6, 22)
			end
			F.wait(b, 1)
			F.wave(b, flat(b.root.Position), 24, 56, D.Wave, "Medium")
			F.wait(b, 0.5)
			F.idle(b)
		end,
	})
end

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
