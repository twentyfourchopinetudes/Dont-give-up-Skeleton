				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE CARYATID (kind Caryatid): a carved woman who held up a portico for a thousand years and has finally stepped out from under it. Solid
-- pale limestone, robes in long carved folds, gilt in the deep of them; a block of the old cornice still on her head. She carries a
-- snapped column under one arm. She is the largest thing in the Heights that walks, and she's very slow, and nothing you do
-- will make her flinch until you've cracked her.
--   Felled    the column up and down, in a line in front of her. Roll aside
--   Foundation  a foot lifted, stamped: the floor bucks around her
--   Topple    with no warning but a creak, she simply falls on you
--   Cornice Stone  from further off: a block wrenched up and heaved in a high arc onto where you stand. You can't just keep away
local K = require(script.Parent.Parent:WaitForChild("GildedKit"))
local M = K.wrap({
	Poses = {
		CABStand = { drop = 0, lean = 0, head = 0.02, spread = 0.05, footR = -0.05, footL = 0.1, breathe = 0.1, la1 = 2.5, la3 = -0.25, lel = 2, freeL = 0 },
		CABStampSet = { drop = 0.05, lean = -0.15, head = 0.1, spread = 0.1, footR = -0.05, footL = 1.4, la1 = 2.5, la3 = -0.25, lel = 2, freeL = 0 },
		CABStamp = { drop = 0.6, lean = 0.2, head = 0.25, spread = 0.2, footR = -0.4, footL = 0.5, la1 = 2.5, la3 = -0.25, lel = 2, freeL = 0 },
		CABTopple = { drop = 1.4, lean = 1.5, head = 0.4, spread = 0.12, footR = -0.3, footL = 0.1, la1 = 0.5, la3 = -0.4, freeL = 0 },
	},
	Grips = { CACarry = { Vector3.new(1.5, -0.1, -0.4), CFrame.Angles(math.rad(20), 0, 0) } },
})
M.Kind = "Caryatid"
M.Proportions = { girth = 1.3, arm = 1.05, hunch = 0, cadence = 0.4 }
M.IdlePose = "CABStand"
M.BodyFor = { CACarry = "CABStand" }
local STONE, STONE_DK, FOLD = Color3.fromRGB(204, 200, 188), Color3.fromRGB(166, 160, 146), Color3.fromRGB(140, 134, 120)
M.Colors = { skin = STONE, torso = STONE, legs = STONE, arms = STONE }

function M.Look(k)
	local deco, parts, V, at, rgb, MAT = k.deco, k.parts, k.V, k.at, k.rgb, k.MAT
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	local rng = Random.new()
	for name, p in pairs(parts) do
		if name ~= "HumanoidRootPart" then
			p.Material = MAT.Limestone
		end
	end
	-- a calm carved face, shut eyes; hair in stone braids; the cornice block on her head, crushed down into it
	deco("Head", "Nose", V(0.14, 0.4, 0.14), at(0, -0.02, -0.6), STONE, MAT.Limestone)
	for _, sx in ipairs({ -1, 1 }) do
		deco("Head", "Lid", V(0.3, 0.05, 0.05), at(sx * 0.27, 0.12, -0.59) * CFrame.Angles(0, 0, sx * 0.08), FOLD, MAT.Limestone)
		for i = 0, 2 do
			deco("Head", "Braid", V(0.28, 0.42, 0.28), at(sx * 0.62, 0.18 - i * 0.38, 0.1), STONE_DK, MAT.Limestone, Enum.PartType.Ball)
		end
	end
	deco("Head", "Lips", V(0.3, 0.05, 0.05), at(0, -0.36, -0.59), FOLD, MAT.Limestone)
	deco("Head", "Capital", V(1.3, 0.3, 1.3), at(0, 0.75, 0), STONE_DK, MAT.Limestone)
	deco("Head", "Capital", V(1.75, 0.3, 1.75), at(0, 1.02, 0), STONE, MAT.Limestone)
	deco("Head", "Cornice", V(3, 0.75, 2.4), at(0.1, 1.5, 0) * CFrame.Angles(0.06, 0, 0.05), STONE, MAT.Limestone)
	deco("Head", "CorniceGilt", V(3.05, 0.14, 2.45), at(0.1, 1.2, 0) * CFrame.Angles(0.06, 0, 0.05), K.GOLD, MAT.Metal)
	deco("Head", "CorniceBreak", V(0.5, 0.55, 2.2), at(-1.45, 1.42, 0) * CFrame.Angles(0, 0, 0.4), STONE_DK, MAT.Limestone)
	-- THE ROBE: long folds cut down from the shoulder to the plinth, gilt still in the deep of them
	for i = -3, 3 do
		deco("Chest", "Fold", V(0.2, ch * 0.92, 0.14), at(i * cw * 0.13, 0, -cd * 0.53) * CFrame.Angles(0, 0, i * 0.04), i % 2 == 0 and FOLD or STONE, MAT.Limestone)
		deco("Hips", "SkirtFold", V(0.34, 3, 0.16), at(i * hw * 0.17, -1.2, -hd * 0.62), i % 2 == 0 and FOLD or STONE, MAT.Limestone)
		deco("Hips", "SkirtFold", V(0.34, 3, 0.16), at(i * hw * 0.17, -1.2, hd * 0.62), i % 2 == 0 and STONE or FOLD, MAT.Limestone)
		if i % 2 ~= 0 then
			deco("Hips", "SkirtGilt", V(0.06, 2.8, 0.06), at(i * hw * 0.17, -1.2, -hd * 0.72), K.GOLD, MAT.Metal)
		end
	end
	deco("Hips", "Skirt", V(hw * 1.25, 3, hd * 1.25), at(0, -1.2, 0), STONE_DK, MAT.Limestone)
	deco("Chest", "Girdle", V(cw * 1, 0.28, cd * 1.1), at(0, -ch * 0.4, 0), K.GOLD, MAT.Metal)
	deco("Chest", "Drape", V(cw * 0.5, ch * 0.92, 0.14), at(-cw * 0.26, 0, -cd * 0.56) * CFrame.Angles(0, 0, -0.32), STONE_DK, MAT.Limestone)
	-- a big crack across her, hairline gold, and chips gone from her
	for i = 0, 4 do
		deco("Chest", "Crack", V(0.05, 0.42, 0.05), at(cw * (0.3 - i * 0.14), ch * (0.3 - i * 0.14), -cd * 0.62) * CFrame.Angles(0, 0, (i % 2 == 0 and 0.6 or -0.3)), K.LIGHT, MAT.Neon)
	end
	for _ = 1, 4 do
		deco("Chest", "Chip", V(0.3, 0.2, 0.2), at(rng:NextNumber(-0.5, 0.5) * cw, rng:NextNumber(-0.4, 0.4) * ch, cd * 0.52), FOLD, MAT.Limestone)
	end
	-- a stone plinth still round her feet (it comes with her)
	for _, n in ipairs({ "R", "L" }) do
		deco(n .. "Foot", "Plinth", V(1.1, 0.55, 1.55), at(0, -0.02, -0.08), STONE_DK, MAT.Limestone)
		deco(n .. "UpperArm", "Armlet", V(aw * 1.2, 0.14, aw * 1.2), at(0, ua * 0.1, 0), K.GOLD, MAT.Metal)
	end
end

M.Weapons = {
	-- a snapped length of fluted column, its capital still on it
	StoneColumn = function(w)
		local st = Color3.fromRGB(204, 200, 188)
		local handle = w.mk("Grip", Vector3.new(0.7, 1.3, 0.7), st, Enum.Material.Limestone)
		local shaft = w.mk("Shaft", Vector3.new(5.4, 1.4, 1.4), st, Enum.Material.Limestone)
		shaft.Shape = Enum.PartType.Cylinder
		w.add(shaft, -3, CFrame.Angles(0, 0, math.pi / 2))
		for i = 0, 7 do
			local a = i * math.pi / 4
			w.add(w.mk("Flute", Vector3.new(0.14, 5.2, 0.14), Color3.fromRGB(150, 146, 132), Enum.Material.Limestone), -3, CFrame.new(math.cos(a) * 0.66 * w.scale, 0, math.sin(a) * 0.66 * w.scale))
		end
		w.add(w.mk("Capital", Vector3.new(2.3, 0.75, 2.3), st, Enum.Material.Limestone), -5.9)
		w.add(w.mk("CapitalGilt", Vector3.new(2.36, 0.14, 2.36), K.GOLD, Enum.Material.Metal), -5.5)
		w.add(w.mk("Break", Vector3.new(1.1, 0.5, 1.1), Color3.fromRGB(166, 160, 146), Enum.Material.Limestone), 0.6, CFrame.Angles(0.4, 0.6, 0.2))
		return { handle = handle, bladeLen = 6.3 }
	end,
}

M.Def = K.def({
	HP = 1050, Speed = 6, Scale = 1.8, Damage = 60, Range = 12, HalfAngle = 26, Lunge = 3, Poise = 220, Stagger = 0.9, StaggerPush = 2,
	Windup = 1.35, Recover = 1.6, HyperArmor = true, Engage = 26, Close = 8, Weapon = "StoneColumn", IdleGrip = "CACarry", Radius = 2.7, Aggro = 34, Skin = STONE, Cloth = STONE_DK,
})

local function stamp(e, tRoot)
	K.setBody(e, "CABStampSet", 0.7)
	K.sound(e, "Unsheath", 0.5, 0.35)
	if not K.hold(e, 0.95, tRoot) then
		return false
	end
	K.setBody(e, "CABStamp", 0.12)
	task.wait(0.12)
	if not e.alive then
		return false
	end
	local at = K.feet(e)
	K.area(at, 11, 3.5, 38, "Knockdown")
	K.flash(at, K.IVORY, 8)
	K.sound(e, "WatchdogSmash", 0.95, 0.65)
	K.shake(at, 0.8)
	return true
end
local function topple(e, tRoot)
	K.sound(e, "Impact", 0.7, 0.3)
	if not K.hold(e, 0.55, tRoot) then
		return false
	end
	K.setBody(e, "CABTopple", 0.45)
	K.step(e, 3.2)
	task.wait(0.46)
	if not e.alive then
		return false
	end
	local at = K.ahead(e, 7)
	K.area(at, 8, 4, 72, "Knockdown")
	K.flash(at, K.IVORY, 10)
	K.sound(e, "WatchdogSmash", 1, 0.55)
	K.shake(at, 1)
	return K.hold(e, 1.6) -- (getting back up: as long an opening as there is)
end

local function corniceStone(e, tRoot)
	K.setGrip(e, "GRaise", 0.8)
	K.setBody(e, "GBCast", 0.8)
	K.sound(e, "Impact", 0.6, 0.4)
	if not K.hold(e, 1.1, tRoot) or not tRoot.Parent then
		return false
	end
	K.setGrip(e, "GSlam", 0.18)
	K.setBody(e, "GBFling", 0.18)
	K.sound(e, "Lunge", 0.9, 0.5)
	local from = e.root.Position + Vector3.new(0, 4.5, 0)
	local at = tRoot.Position - Vector3.new(0, 2.5, 0)
	local T, g = 1.15, 70 -- (in the air this long: a high, slow arc you can see coming)
	K.shot(e, {
		from = from, vel = (at - from) / T + Vector3.new(0, 0.5 * g * T, 0), gravity = g, life = 3, damage = 40, level = "Knockdown",
		radius = 1.8, size = Vector3.new(2.4, 1.8, 2.2), shape = Enum.PartType.Block, color = STONE, material = Enum.Material.Limestone, spin = 4,
		onLand = function(pos)
			K.area(pos, 7, 4, 40, "Knockdown")
			K.flash(pos, K.IVORY, 8)
			K.sound(e, "WatchdogSmash", 0.9, 0.7)
			K.shake(pos, 0.6)
		end,
	})
	return K.hold(e, 0.4, tRoot)
end

M.attack = K.brain(function(e, tRoot, d)
	local roll = math.random()
	if d > 13 then
		return corniceStone(e, tRoot), 2
	elseif d < e.def.Close and roll < 0.35 then
		return stamp(e, tRoot), 1.3
	elseif d < 9 and roll < 0.55 then
		return topple(e, tRoot), 0.6
	end
	return K.slam(e, tRoot, {
		set = "GRaise", setBody = "GBSet", tell = 1.3, swing = "GSlam", swingBody = "GBStrike", time = 0.24, range = 13, half = 22, level = "Knockdown",
		area = 5, areaDamage = 30, lunge = 1, boom = 0.65, shake = 0.7, speed = 0.45,
	}), 1.6
end)

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Caryatid</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">26e3ecd58c094c60be3f3b4d3f7b2447</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX1E3E4B430FA84848A008DE7243C5222A">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE FALCONER (kind Falconer): the royal mews' master, in green and gold with a feathered hat, a gauntlet up to its shoulder and a hunting-horn at
-- its hip. On its fist sits a falcon of clockwork gold, jessed and hooded, and it never takes its eyes off you. The falconer's old
-- and a little stiff. The falcon isn't.
--   Stoop       the hood whipped off, the bird flung: it climbs, turns, and comes for you, following as it comes. Roll at the last
--   Lure        a weighted lure swung on its line, in a wide flat circle
--   Gauntlet    a backhand with all that iron, and a short hunting sword when you're inside it
local K = require(script.Parent.Parent:WaitForChild("GildedKit"))
local M = K.wrap({
	Poses = {
		FCBFist = { drop = 0.1, lean = 0.08, head = 0.02, footR = -0.18, footL = 0.22, spread = 0.1, breathe = 0.7, la1 = 1.15, la2 = 0.1, la3 = -0.35, lel = 1.7, freeL = 0 },
		FCBCast = { drop = 0.35, lean = 0.45, head = -0.2, footR = 0.6, footL = -0.5, la1 = 2.2, la2 = 0, la3 = -0.2, lel = 0.1, freeL = 0 },
	},
	Grips = { FCSide = { Vector3.new(1.2, -0.3, -0.5), CFrame.Angles(math.rad(50), 0, 0) } },
})
M.Kind = "Falconer"
M.Proportions = { girth = 0.98, arm = 1.02, hunch = 0.06 }
M.IdlePose = "FCBFist"
M.BodyFor = { FCSide = "FCBFist" }
local GREEN, GREEN_DK, BUFF, BIRD = Color3.fromRGB(58, 90, 54), Color3.fromRGB(36, 58, 36), Color3.fromRGB(170, 140, 96), K.GOLD
M.Colors = { skin = Color3.fromRGB(150, 118, 96), torso = GREEN, legs = BUFF, arms = GREEN }
-- the bird itself, on any body: its breast, head, wings, tail
local function falcon(deco, on, F, V, MAT, hooded)
	deco(on, "BirdBody", V(0.6, 0.95, 0.72), F * CFrame.new(0, 0.5, 0), BIRD, MAT.Metal, Enum.PartType.Ball)
	deco(on, "BirdHead", V(0.44, 0.44, 0.44), F * CFrame.new(0, 1.05, -0.1), K.LIGHT, MAT.Metal, Enum.PartType.Ball)
	deco(on, "BirdBeak", V(0.12, 0.14, 0.24), F * CFrame.new(0, 1, -0.36), K.TARNISH, MAT.Metal)
	if hooded then
		deco(on, "BirdHood", V(0.48, 0.34, 0.48), F * CFrame.new(0, 1.15, -0.1), K.RUG, MAT.Leather, Enum.PartType.Ball)
		deco(on, "HoodPlume", V(0.05, 0.3, 0.05), F * CFrame.new(0, 1.42, -0.1), K.LIGHT, MAT.Metal)
	end
	for _, sx in ipairs({ -1, 1 }) do
		deco(on, "BirdWing", V(0.1, 0.95, 0.42), F * CFrame.new(sx * 0.34, 0.4, 0.14) * CFrame.Angles(-0.25, 0, sx * 0.12), K.TARNISH, MAT.Metal)
	end
	deco(on, "BirdTail", V(0.3, 0.7, 0.07), F * CFrame.new(0, -0.1, 0.32) * CFrame.Angles(0.4, 0, 0), K.TARNISH, MAT.Metal)
end

function M.Look(k)
	local deco, parts, V, at, rgb, MAT = k.deco, k.parts, k.V, k.at, k.rgb, k.MAT
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	local ball = Enum.PartType.Ball
	-- a dry, grey-bearded face; a green hat with a long pheasant feather
	parts.Head.Material = MAT.SmoothPlastic
	for _, sx in ipairs({ -1, 1 }) do
		deco("Head", "Eye", V(0.18, 0.08, 0.04), at(sx * 0.25, 0.12, -0.59), K.INK, MAT.SmoothPlastic)
		deco("Head", "Brow", V(0.3, 0.08, 0.06), at(sx * 0.25, 0.25, -0.58) * CFrame.Angles(0, 0, sx * 0.2), rgb(190, 186, 176), MAT.Sand)
	end
	deco("Head", "Beard", V(0.92, 0.72, 0.42), at(0, -0.58, -0.32), rgb(186, 182, 172), MAT.Sand)
	deco("Head", "BeardPoint", V(0.5, 0.5, 0.3), at(0, -1, -0.38), rgb(176, 172, 162), MAT.Sand)
	deco("Head", "Moustache", V(0.8, 0.12, 0.1), at(0, -0.16, -0.59), rgb(196, 192, 182), MAT.Sand)
	deco("Head", "Brim", V(1.85, 0.12, 1.75), at(0, 0.56, 0), GREEN_DK, MAT.Fabric)
	deco("Head", "HatCrown", V(1.25, 0.72, 1.2), at(0, 0.92, 0.05) * CFrame.Angles(0.05, 0, 0.04), GREEN, MAT.Fabric)
	deco("Head", "HatBand", V(1.3, 0.14, 1.25), at(0, 0.66, 0.05), K.GOLD, MAT.Metal)
	for i = 0, 3 do
		deco("Head", "Feather", V(0.08, 0.72, 0.2), at(0.62, 0.95 + i * 0.32, 0.3 + i * i * 0.1) * CFrame.Angles(-0.35 - i * 0.2, 0, -0.1), i % 2 == 0 and rgb(160, 110, 60) or K.PORCELAIN, MAT.Fabric)
	end
	-- the hunting coat, its belt of hoods and bells, the horn on its hip
	deco("Chest", "Coat", V(cw * 1.04, ch, cd * 1.08), at(0, 0, 0), GREEN, MAT.Fabric)
	deco("Chest", "Baldric", V(0.3, ch * 1.3, 0.06), at(0, 0, -cd * 0.56) * CFrame.Angles(0, 0, 0.62), K.LEATHER, MAT.Leather)
	deco("Chest", "Baldric", V(0.3, ch * 1.3, 0.06), at(0, 0, cd * 0.56) * CFrame.Angles(0, 0, -0.62), K.LEATHER, MAT.Leather)
	deco("Chest", "Badge", V(0.05, 0.42, 0.42), at(0.1, 0.14, -cd * 0.6) * K.FACE, K.GOLD, MAT.Metal, Enum.PartType.Cylinder)
	for _, x in ipairs({ -1, 1 }) do
		deco("Hips", "CoatSkirt", V(hw * 0.52, 1.7, hd * 1.2), at(x * hw * 0.28, -0.6, 0), GREEN_DK, MAT.Fabric)
	end
	deco("Hips", "Belt", V(hw * 1.24, 0.24, hd * 1.28), at(0, 0.3, 0), K.LEATHER, MAT.Leather)
	for i = -1, 1 do
		deco("Hips", "SpareHood", V(0.26, 0.28, 0.26), at(hw * 0.7 + i * 0.08, 0, -hd * 0.4 + i * 0.3), K.RUG, MAT.Leather, ball)
	end
	for i = 0, 3 do
		deco("Hips", "Horn", V(0.44 - i * 0.08, 0.44 - i * 0.08, 0.42), at(-hw * 0.82, -0.3 + i * 0.16, 0.5 - i * 0.34) * CFrame.Angles(0.5, 0, 0), K.GOLD, MAT.Metal, ball)
	end
	for _, n in ipairs({ "R", "L" }) do
		deco(n .. "Thigh", "Breeches", V(lw * 1.14, 1, lw * 1.14), at(0, 0.03, 0), BUFF, MAT.Leather)
		deco(n .. "Shin", "Boot", V(lw * 1.18, 1.08, lw * 1.18), at(0, 0, 0), K.LEATHER, MAT.Leather)
		deco(n .. "Foot", "BootFoot", V(0.68, 0.3, 1.15), at(0, 0.02, -0.05), K.LEATHER, MAT.Leather)
	end
	deco("RLowerArm", "Cuff", V(aw * 1.25, 0.4, aw * 1.25), at(0, -la * 0.34, 0), K.LEATHER, MAT.Leather)
	-- THE GAUNTLET to the shoulder on its left arm, iron-scaled, and the falcon on the fist
	deco("LUpperArm", "Vambrace", V(aw * 1.45, ua * 1.05, aw * 1.45), at(0, 0, 0), K.LEATHER, MAT.Leather)
	deco("LLowerArm", "GauntletBig", V(aw * 1.55, la * 1.08, aw * 1.55), at(0, -0.04, 0), K.LEATHER, MAT.Leather)
	for i = 0, 3 do
		deco("LLowerArm", "Scale", V(aw * 1.65, 0.14, aw * 1.65), at(0, la * 0.36 - i * la * 0.24, 0), K.TARNISH, MAT.Metal)
	end
	falcon(deco, "LLowerArm", at(0, -la / 2 - 0.15, 0) * CFrame.Angles(math.pi, 0, 0), V, MAT, true) -- (turned over: the bird stands out of the fist, along the forearm)
	for i = 0, 2 do
		deco("LLowerArm", "Jess", V(0.05, 0.3, 0.05), at(0.1, -la / 2 + 0.1 - i * 0.22, -0.16), K.RUG, MAT.Leather)
	end
end

M.Weapons = {
	HuntingSword = function(w)
		local handle = w.mk("Grip", Vector3.new(0.2, 0.8, 0.2), K.LEATHER, Enum.Material.Leather)
		w.add(w.mk("Guard", Vector3.new(0.95, 0.14, 0.2), K.GOLD, Enum.Material.Metal), -0.46)
		w.add(w.mk("Blade", Vector3.new(0.34, 2.9, 0.08), Color3.fromRGB(190, 192, 188), Enum.Material.Metal), -2)
		w.add(w.mk("Tip", Vector3.new(0.24, 0.24, 0.08), Color3.fromRGB(190, 192, 188), Enum.Material.Metal), -3.45, CFrame.Angles(0, 0, math.pi / 4))
		w.add(w.mk("Lure", Vector3.new(0.6, 0.6, 0.6), K.GOLD, Enum.Material.Metal), 0.65)
		return { handle = handle, bladeLen = 3.8 }
	end,
}

M.Def = K.def({
	HP = 380, Speed = 10, Scale = 1.2, Damage = 32, Range = 8, HalfAngle = 60, Lunge = 8, Poise = 55, Stagger = 0.55, StaggerPush = 10,
	Windup = 0.7, Recover = 0.95, Engage = 28, Close = 8, Weapon = "HuntingSword", IdleGrip = "FCSide", Radius = 1.4, Skin = BUFF, Cloth = GREEN,
})

-- THE STOOP: it casts the bird; a gold falcon's body flies up, turns over, and homes in, wings out
local function stoop(e, tRoot)
	K.setBody(e, "GBCast", 0.5)
	K.sound(e, "Unsheath", 0.35, 1.5)
	if not K.hold(e, 0.75, tRoot) then
		return false
	end
	K.setBody(e, "FCBCast", 0.12)
	K.sound(e, "WatchdogBlast", 0.4, 2)
	local body = K.partOf(e, "BirdBody")
	local from = body and body.Position or e.root.Position + Vector3.new(0, 3, 0)
	for _, n in ipairs({ "BirdBody", "BirdHead", "BirdBeak", "BirdHood", "HoodPlume" }) do
		local p = K.partOf(e, n)
		if p then
			p.Transparency = 1
		end
	end
	for _, c in ipairs(e.model:GetDescendants()) do
		if c.Name == "BirdWing" or c.Name == "BirdTail" then
			c.Transparency = 1
		end
	end
	local look = e.root.CFrame.LookVector
	K.shot(e, {
		from = from, vel = look * 22 + Vector3.new(0, 34, 0), damage = 32, level = "Large", radius = 2, life = 4.5, gravity = 0, home = 3.2, homeOn = tRoot,
		size = Vector3.new(0.8, 0.5, 1.5), shape = Enum.PartType.Ball, color = BIRD, trail = K.LIGHT, spin = 0,
		make = function(p)
			for _, s in ipairs({ -1, 1 }) do
				local wing = Instance.new("Part")
				wing.Name = "Wing"
				wing.Anchored, wing.CanCollide, wing.CanQuery, wing.CanTouch, wing.Massless = false, false, false, false, true
				wing.Size, wing.Color, wing.Material = Vector3.new(2.1, 0.08, 0.8), K.TARNISH, Enum.Material.Metal
				wing.CFrame = p.CFrame * CFrame.new(s * 1.2, 0, 0) * CFrame.Angles(0, 0, s * 0.2)
				local wd = Instance.new("WeldConstraint")
				wd.Part0, wd.Part1 = p, wing
				wd.Parent = wing
				wing.Parent = p
			end
		end,
	})
	-- (it's back on the fist a while later: the bird comes home)
	task.delay(5, function()
		if e.alive and e.model.Parent then
			for _, c in ipairs(e.model:GetDescendants()) do
				if c.Name:sub(1, 4) == "Bird" or c.Name == "HoodPlume" then
					c.Transparency = 0
				end
			end
		end
	end)
	return K.hold(e, 0.6, tRoot)
end

M.attack = K.brain(function(e, tRoot, d)
	local roll = math.random()
	if d > e.def.Close or roll < 0.2 then
		return stoop(e, tRoot), 1.1
	elseif roll < 0.55 then
		return K.combo(e, tRoot, {
			{ set = "GCock", setBody = "GBSet", tell = 0.55, swing = "GCut", swingBody = "GBStrike", time = 0.13, damage = 26, level = "Medium", speed = 1.05 },
			{ set = "GBack", setBody = "GBWind", tell = 0.25, swing = "GSweep", swingBody = "GBSweep", time = 0.13, damage = 30, speed = 1, quiet = true },
		}), 0.9
	end
	return K.strike(e, tRoot, { setBody = "GBSpin", set = "GGuard", tell = 0.6, swingBody = "GBFling", time = 0.15, range = 9.5, half = 75, damage = 34, level = "Knockdown", speed = 0.75, lunge = 1.2 }), 1
end)

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Falconer</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">22efe3e3443546859236f8ef9564f69e</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX35B76F77B6064A9D8194A76488D9C15E">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE TALLYMAN (kind Tallyman): the Exchequer's clerk, bent to a question mark, still adding it up, and you're on the list. Ink-black robes,
-- ink to the elbows, spectacles over no eyes, a wig of rolled parchment; a ledger chained to its belt, and quills stuck everywhere.
-- It carries a great gold abacus on a pole.
--   Audit       a volley of quills, one after another, each thrown where you're going
--   Foreclosure the abacus up and down, beads roaring along its rods. A lot heavier than it looks
--   Settled     and it hits you with the ledger on the way past
local K = require(script.Parent.Parent:WaitForChild("GildedKit"))
local M = K.wrap({
	Poses = { TMBStoop = { drop = 0.3, lean = 0.48, head = -0.12, spread = 0.12, footR = -0.25, footL = 0.3, breathe = 0.6, la1 = 0.9, la3 = -0.1, lel = 1.8, freeL = 0 } },
	Grips = { TMPole = { Vector3.new(1.2, 0, -0.8), CFrame.Angles(math.rad(165), 0, 0) } },
})
M.Kind = "Tallyman"
M.Proportions = { girth = 0.88, arm = 1.18, hunch = 0.42 }
M.IdlePose = "TMBStoop"
M.BodyFor = { TMPole = "TMBStoop" }
local INK, INK_LT, PARCH, QUILL = Color3.fromRGB(20, 20, 28), Color3.fromRGB(44, 44, 58), Color3.fromRGB(226, 214, 180), Color3.fromRGB(236, 232, 222)
M.Colors = { skin = Color3.fromRGB(200, 186, 150), torso = INK, legs = INK, arms = INK }

function M.Look(k)
	local deco, parts, V, at, rgb, MAT = k.deco, k.parts, k.V, k.at, k.rgb, k.MAT
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	local rng = Random.new()
	local cyl = Enum.PartType.Cylinder
	-- a dried face, long-nosed; gold spectacles over empty dark, one lens cracked; a wig of curled parchment rolls
	deco("Head", "Nose", V(0.17, 0.56, 0.2), at(0, -0.1, -0.62), Color3.fromRGB(190, 176, 140), MAT.SmoothPlastic)
	for _, sx in ipairs({ -1, 1 }) do
		deco("Head", "Socket", V(0.05, 0.36, 0.36), at(sx * 0.26, 0.12, -0.58) * K.FACE, K.INK, MAT.SmoothPlastic, cyl)
		deco("Head", "Lens", V(0.05, 0.42, 0.42), at(sx * 0.26, 0.12, -0.62) * K.FACE, K.LIGHT, MAT.Glass, cyl).Transparency = 0.35
		deco("Head", "Rim", V(0.04, 0.5, 0.5), at(sx * 0.26, 0.12, -0.6) * K.FACE, K.GOLD, MAT.Metal, cyl)
		for i = 0, 3 do
			deco("Head", "Roll", V(0.42, 0.55, 0.42), at(sx * 0.66, 0.46 - i * 0.34, 0.14), PARCH, MAT.Fabric, cyl)
		end
	end
	deco("Head", "Bridge", V(0.16, 0.04, 0.04), at(0, 0.14, -0.62), K.GOLD, MAT.Metal)
	deco("Head", "WigTop", V(1.3, 0.55, 1.35), at(0, 0.62, 0.1), PARCH, MAT.Fabric)
	-- quills behind its ears and through its wig
	for _, q in ipairs({ { 0.5, 0.86, 0.1, 0.3 }, { -0.42, 0.9, 0.1, -0.36 }, { 0.68, 0.45, 0.3, 0.9 }, { 0.08, 0.98, 0.34, 0.08 } }) do
		deco("Head", "Quill", V(0.1, 1.05, 0.22), at(q[1], q[2] + 0.2, q[3]) * CFrame.Angles(-0.25, 0, -q[4]), QUILL, MAT.Fabric)
	end
	-- the robe, ink staining down its front; a chain of keys and a ledger at the belt, tally-sticks over its back
	deco("Chest", "Robe", V(cw * 1.08, ch * 1.02, cd * 1.12), at(0, 0, 0.02), INK, MAT.Fabric)
	deco("Chest", "Collar", V(cw * 0.72, 0.34, cd * 1.2), at(0, ch * 0.46, 0), INK_LT, MAT.Fabric)
	for _, sx in ipairs({ -1, 1 }) do
		deco("Chest", "Lappet", V(0.18, 0.95, 0.05), at(sx * 0.14, ch * 0.2, -cd * 0.6), K.PORCELAIN, MAT.Fabric)
	end
	for i = 0, 6 do
		deco("Chest", "TallyStick", V(0.1, 2, 0.1), at(-0.6 + i * 0.2, 0.75, cd * 0.56 + 0.1) * CFrame.Angles(0.18, 0, (i - 3) * 0.03), rgb(150, 124, 84), MAT.Wood)
		deco("Chest", "Quill", V(0.08, 1.2, 0.18), at(-0.54 + i * 0.18, 1.6, cd * 0.56 + 0.08) * CFrame.Angles(0.22, 0, (i - 3) * 0.1), QUILL, MAT.Fabric)
	end
	deco("Chest", "Quiver", V(1.5, 1.2, 0.3), at(0, 0.3, cd * 0.56 + 0.1), K.LEATHER, MAT.Leather)
	k.tatter(rng, "Hips", CFrame.new(0, 0.1, -hd * 0.55), hw * 1.1, 2.5, INK, INK_LT, 0.3)
	k.tatter(rng, "Hips", CFrame.new(0, 0.1, hd * 0.55), hw * 1.1, 2.5, INK, INK_LT, 0.3)
	deco("Hips", "Belt", V(hw * 1.25, 0.18, hd * 1.28), at(0, 0.3, 0), K.GOLD, MAT.Metal)
	deco("Hips", "Ledger", V(1.05, 1.35, 0.42), at(-hw * 0.82, -0.3, 0), K.RUG, MAT.Leather)
	deco("Hips", "LedgerPages", V(0.96, 1.26, 0.45), at(-hw * 0.82, -0.3, 0), PARCH, MAT.Fabric)
	deco("Hips", "LedgerClasp", V(1.08, 0.12, 0.47), at(-hw * 0.82, -0.3, 0), K.GOLD, MAT.Metal)
	for i = 0, 3 do
		deco("Hips", "LedgerChain", V(0.1, 0.2, 0.14), at(-hw * 0.62, 0.22 - i * 0.14, 0.04) * CFrame.Angles(0, i % 2 * math.pi / 2, 0), K.GOLD, MAT.Metal)
	end
	for _, n in ipairs({ "R", "L" }) do
		deco(n .. "UpperArm", "Sleeve", V(aw * 1.25, ua, aw * 1.25), at(0, 0, 0), INK_LT, MAT.Fabric)
		deco(n .. "LowerArm", "InkStain", V(aw * 1.06, la * 0.9, aw * 1.06), at(0, -0.1, 0), K.INK, MAT.SmoothPlastic)
		deco(n .. "LowerArm", "Bandcuff", V(aw * 1.3, 0.14, aw * 1.3), at(0, la * 0.32, 0), K.PORCELAIN, MAT.Fabric)
		deco(n .. "Foot", "Shoe", V(0.56, 0.24, 1.02), at(0, -0.02, -0.04), K.INK, MAT.Leather)
	end
end

M.Weapons = {
	-- a great gold abacus on a pole: rods of beads that clatter along, a heavy frame
	GrandAbacus = function(w)
		local gold = K.GOLD
		local handle = w.mk("Grip", Vector3.new(0.22, 1.1, 0.22), K.INK, Enum.Material.Wood)
		w.add(w.mk("Pole", Vector3.new(0.18, 3, 0.18), K.INK, Enum.Material.Wood), -1.9)
		for _, y in ipairs({ -3.3, -6.1 }) do
			w.add(w.mk("FrameBar", Vector3.new(3, 0.26, 0.3), gold, Enum.Material.Metal), y)
		end
		for _, x in ipairs({ -1.5, 1.5 }) do
			w.add(w.mk("FrameSide", Vector3.new(0.26, 3, 0.3), gold, Enum.Material.Metal), -4.7, CFrame.new(x * w.scale, 0, 0))
		end
		for r = 0, 3 do
			local y = -3.85 - r * 0.58
			w.add(w.mk("Rod", Vector3.new(2.9, 0.06, 0.06), Color3.fromRGB(150, 146, 136), Enum.Material.Metal), y)
			for b = 0, 3 do
				local bead = w.mk("Bead", Vector3.new(0.34, 0.34, 0.34), b % 2 == 0 and K.ROSE or K.LAPIS, Enum.Material.Glass)
				bead.Shape = Enum.PartType.Ball
				w.add(bead, y, CFrame.new((-1.1 + r * 0.14 + b * 0.5) * w.scale, 0, 0))
			end
		end
		return { handle = handle, bladeLen = 6 }
	end,
}

M.Def = K.def({
	HP = 360, Speed = 9.5, Scale = 1.25, Damage = 42, Range = 10, HalfAngle = 42, Lunge = 6, Poise = 50, Stagger = 0.55, StaggerPush = 12,
	Windup = 0.8, Recover = 1, Engage = 24, Close = 9, Weapon = "GrandAbacus", IdleGrip = "TMPole", Radius = 1.4, Skin = K.INK, Cloth = INK,
})

local function audit(e, tRoot)
	K.setBody(e, "GBCast", 0.4)
	K.sound(e, "Unsheath", 0.3, 1.8)
	if not K.hold(e, 0.65, tRoot) then
		return false
	end
	for i = 1, 5 do
		K.setBody(e, i % 2 == 0 and "GBCast" or "GBFling", 0.08)
		if not K.hold(e, 0.16, tRoot) then
			return false
		end
		local from = e.root.Position + e.root.CFrame.LookVector * 1.6 * e.scale + Vector3.new(0, 1.3 * e.scale, 0)
		K.shot(e, {
			from = from, vel = K.aim(from, tRoot, 62, 0.28), damage = 14, level = "Small", radius = 1.1, life = 1.4, gravity = 6,
			size = Vector3.new(0.14, 0.14, 1.5), shape = Enum.PartType.Block, color = QUILL, material = Enum.Material.Fabric, trail = INK_LT,
		})
		K.sound(e, "Lunge", 0.45, 1.8)
	end
	return true
end

M.attack = K.brain(function(e, tRoot, d)
	if d > e.def.Close then
		return audit(e, tRoot), 0.9
	elseif math.random() < 0.6 then
		return K.slam(e, tRoot, {
			set = "GRaise", setBody = "GBSet", tell = 0.95, swing = "GSlam", swingBody = "GBStrike", time = 0.18, range = 10.5, half = 38, level = "Knockdown",
			area = 4.5, areaDamage = 18, color = K.GOLD, boom = 1.4, shake = 0.3, speed = 0.8,
		}), 1.1
	end
	return K.strike(e, tRoot, { set = "GBack", setBody = "GBWind", tell = 0.55, swing = "GSweep", swingBody = "GBSweep", time = 0.18, range = 8.5, half = 80, damage = 30, level = "Medium", speed = 1.1 }), 0.8
end)

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Tallyman</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">3029701d660d47fb9ade2fa5dbc9464b</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX456FF3B8EDFE470E979A216857BBF8FF">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE TOPIARIST (kind Topiarist): the terraces' gardener, who has been kept on so long the garden's begun to keep it. A broad straw hat,
-- a green baize apron, and out of its collar and its back the hedge it never finished trimming: clipped leaf, blossom in its
-- shoulders, roots for boots. Great gold-handled shears as long as you are.
--   The Cut      the shears wide open, and SNIP: a wide bite right in front of it, and they're heavy to get open again
--   Dead-Head    three short snips, walking at you
--   Blossom      it shakes itself: a cloud of petals hangs there, and it's sweet, and it's poison
--   Hedge Run    from further off: the shears thrown wide, a charge across the lawn, and SNAP at the end of it
local K = require(script.Parent.Parent:WaitForChild("GildedKit"))
local Config = require(script.Parent.Parent:WaitForChild("Config"))
local M = K.wrap({
	Poses = { TOBWork = { drop = 0.4, lean = 0.32, head = 0.06, spread = 0.22, footR = -0.3, footL = 0.35, breathe = 1, la1 = 0.7, la3 = -0.2, lel = 1.4, freeL = 0 } },
	Grips = { TOHold = { Vector3.new(0.5, 0.2, -1.5), CFrame.Angles(math.rad(105), 0, 0) } },
})
M.Kind = "Topiarist"
M.Proportions = { girth = 1.18, arm = 1.1, hunch = 0.16 }
M.IdlePose = "TOBWork"
M.BodyFor = { TOHold = "TOBWork" }
local BAIZE, HEDGE, HEDGE_DK, STRAW, BARK = Color3.fromRGB(46, 78, 50), K.LEAF, Color3.fromRGB(56, 98, 52), Color3.fromRGB(190, 164, 104), Color3.fromRGB(70, 54, 40)
M.Colors = { skin = BARK, torso = BAIZE, legs = BARK, arms = BARK }

function M.Look(k)
	local deco, parts, V, at, rgb, MAT = k.deco, k.parts, k.V, k.at, k.rgb, k.MAT
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	local rng = Random.new()
	local ball = Enum.PartType.Ball
	-- a knot of wood for a face, moss on it; a wide straw hat, its brim gone at one edge
	parts.Head.Material, parts.Head.Color = MAT.Wood, BARK
	deco("Head", "Brim", V(0.14, 3, 3), at(0, 0.58, 0) * K.UP, STRAW, MAT.Sand, Enum.PartType.Cylinder)
	deco("Head", "HatCrown", V(0.9, 1.35, 1.35), at(0, 0.98, 0) * K.UP, STRAW, MAT.Sand, Enum.PartType.Cylinder)
	deco("Head", "HatBand", V(0.22, 1.4, 1.4), at(0, 0.72, 0) * K.UP, K.RUG, MAT.Fabric, Enum.PartType.Cylinder)
	for _, sx in ipairs({ -1, 1 }) do
		deco("Head", "EyeKnot", V(0.3, 0.3, 0.1), at(sx * 0.26, 0.1, -0.56), K.INK, MAT.Wood, ball)
		deco("Head", "Eye", V(0.09, 0.09, 0.05), at(sx * 0.26, 0.1, -0.62), K.LIGHT, MAT.Neon, ball)
	end
	deco("Head", "Moss", V(0.9, 0.42, 0.14), at(0, -0.5, -0.5), HEDGE_DK, MAT.Grass)
	-- THE HEDGE: round clipped masses out of its shoulders and its back, blossom through them
	for _, q in ipairs({ { 0, 0.8, 0.8, 1.9 }, { -0.95, 0.55, 0.65, 1.5 }, { 0.95, 0.55, 0.65, 1.5 }, { 0, -0.2, 0.95, 1.7 }, { -0.75, -0.55, 0.7, 1.1 }, { 0.75, -0.55, 0.7, 1.15 } }) do
		deco("Chest", "Hedge", V(q[4], q[4], q[4]), at(q[1] * cw * 0.5, q[2], q[3]), rng:NextNumber() < 0.5 and HEDGE or HEDGE_DK, MAT.Grass, ball)
	end
	for _ = 1, 9 do
		local a, b = rng:NextNumber(-1, 1), rng:NextNumber(-0.5, 1.1)
		deco("Chest", "Bloom", V(0.36, 0.36, 0.36), at(a * cw * 0.6, b, cd * 0.5 + rng:NextNumber(0.5, 1.45)), K.BLOSSOM, MAT.SmoothPlastic, ball)
	end
	for _, sx in ipairs({ -1, 1 }) do
		deco("Chest", "ShoulderLeaf", V(0.95, 0.95, 0.95), at(sx * cw * 0.5, ch * 0.5, 0), HEDGE, MAT.Grass, ball)
		deco("Chest", "ShoulderBloom", V(0.3, 0.3, 0.3), at(sx * cw * 0.6, ch * 0.72, -0.2), K.BLOSSOM, MAT.SmoothPlastic, ball)
	end
	-- the baize apron, its pockets, trowel and twine
	deco("Chest", "ApronBib", V(cw * 0.76, ch * 0.78, 0.08), at(0, -0.1, -cd * 0.56), BAIZE, MAT.Fabric)
	deco("Hips", "Apron", V(hw * 1.1, 2.2, 0.08), at(0, -0.9, -hd * 0.62), BAIZE, MAT.Fabric)
	deco("Hips", "Pocket", V(hw * 0.7, 0.55, 0.06), at(0, -0.65, -hd * 0.68), K.TARNISH, MAT.Fabric)
	deco("Hips", "Trowel", V(0.26, 0.6, 0.04), at(-hw * 0.2, -0.45, -hd * 0.73), rgb(160, 156, 140), MAT.Metal)
	deco("Hips", "Twine", V(0.36, 0.3, 0.3), at(hw * 0.68, 0.05, -0.1), STRAW, MAT.Fabric, ball)
	deco("Hips", "Belt", V(hw * 1.25, 0.22, hd * 1.3), at(0, 0.3, 0), K.LEATHER, MAT.Leather)
	-- roots for boots, ivy up its arms
	for _, n in ipairs({ "R", "L" }) do
		for i = 0, 3 do
			local a = i * math.pi / 2 + 0.5
			deco(n .. "Foot", "Root", V(0.22, 0.2, 0.75), at(math.cos(a) * 0.28, -0.04, math.sin(a) * 0.4 - 0.1) * CFrame.Angles(0, -a + math.pi / 2, 0), BARK, MAT.Wood)
		end
		deco(n .. "Shin", "Gaiter", V(lw * 1.14, 1, lw * 1.14), at(0, -0.05, 0), BAIZE:Lerp(rgb(0, 0, 0), 0.25), MAT.Fabric)
		for i = 0, 2 do
			deco(n .. "UpperArm", "Ivy", V(0.34, 0.14, 0.34), at(aw * 0.45, ua * (0.35 - i * 0.3), aw * 0.2), HEDGE_DK, MAT.Grass, ball)
			deco(n .. "LowerArm", "Ivy", V(0.34, 0.14, 0.34), at(-aw * 0.45, la * (0.35 - i * 0.3), -aw * 0.2), HEDGE, MAT.Grass, ball)
		end
		deco(n .. "LowerArm", "Glove", V(aw * 1.2, la * 0.5, aw * 1.2), at(0, -la * 0.25, 0), K.LEATHER, MAT.Leather)
	end
end

M.Weapons = {
	-- a pair of hedge shears the size of a door, its blades a little apart
	GreatShears = function(w)
		local steel, gold = Color3.fromRGB(190, 192, 188), K.GOLD
		local handle = w.mk("Grip", Vector3.new(0.3, 1.5, 0.3), gold, Enum.Material.Metal)
		w.add(w.mk("Pivot", Vector3.new(0.5, 0.42, 0.5), K.TARNISH, Enum.Material.Metal), -0.9)
		for _, s in ipairs({ -1, 1 }) do
			w.add(w.mk("ShearBlade", Vector3.new(0.34, 5.2, 0.1), steel, Enum.Material.Metal), -3.4, CFrame.Angles(0, 0, s * 0.085) * CFrame.new(s * 0.18 * w.scale, 0, s * 0.05 * w.scale))
			w.add(w.mk("ShearEdge", Vector3.new(0.05, 5.1, 0.12), gold, Enum.Material.Metal), -3.4, CFrame.Angles(0, 0, s * 0.085) * CFrame.new(s * 0.02 * w.scale, 0, s * 0.05 * w.scale))
			w.add(w.mk("Bow", Vector3.new(0.14, 0.2, 1.1), gold, Enum.Material.Metal), 0.9, CFrame.new(s * 0.45 * w.scale, 0, 0))
		end
		return { handle = handle, bladeLen = 6 }
	end,
}

M.Def = K.def({
	HP = 500, Speed = 9, Scale = 1.3, Damage = 46, Range = 9, HalfAngle = 45, Lunge = 8, Poise = 80, Stagger = 0.5, StaggerPush = 8,
	Windup = 0.9, Recover = 1.15, Engage = 20, Close = 8, Weapon = "GreatShears", IdleGrip = "TOHold", Radius = 1.8, Skin = BARK, Cloth = BAIZE,
})

local function cut(e, tRoot)
	return K.strike(e, tRoot, { set = "GWide", setBody = "GBDraught", tell = 0.95, swing = "GThrust", swingBody = "GBLunge", time = 0.12, range = 9.5, half = 50, damage = 54, level = "Knockdown", lunge = 1.6, speed = 0.55 })
end
local function snips(e, tRoot)
	return K.combo(e, tRoot, {
		{ set = "GDraw", setBody = "GBDraw", tell = 0.6, swing = "GThrust", swingBody = "GBLunge", time = 0.1, range = 8.5, half = 36, damage = 24, level = "Medium", speed = 1.15 },
		{ set = "GDraw", setBody = "GBDraw", tell = 0.28, swing = "GThrust", swingBody = "GBLunge", time = 0.1, range = 8.5, half = 36, damage = 24, level = "Medium", speed = 1.2, quiet = true },
		{ set = "GDraw", setBody = "GBDraw", tell = 0.36, swing = "GThrust", swingBody = "GBLunge", time = 0.1, range = 9, half = 36, damage = 30, speed = 1.05, quiet = true, lunge = 1.3 },
	})
end
-- BLOSSOM: it shudders; petals go up off its back and hang where they fall
local function blossom(e, tRoot)
	K.setBody(e, "GBLow", 0.4)
	K.sound(e, "Unsheath", 0.3, 1.8)
	if not K.hold(e, 0.8, tRoot) then
		return false
	end
	K.setBody(e, "GBDraught", 0.14)
	local at = K.feet(e) + (tRoot.Parent and (tRoot.Position - e.root.Position) * Vector3.new(1, 0, 1) * 0.45 or Vector3.zero)
	K.cloud(at, { radius = 9, life = 6, color = K.BLOSSOM, rate = 45, poison = Config.Usher.Poison })
	K.flash(e.root.Position + Vector3.new(0, 2, 0), K.BLOSSOM, 6)
	return K.hold(e, 0.35, tRoot)
end

local function hedgeRun(e, tRoot)
	if not K.rush(e, tRoot, { set = "GWide", setBody = "GBLow", tell = 0.8, drive = "GWide", driveBody = "GBLunge", speed = 38, time = 0.55, damage = 30, level = "Medium", reach = 4.5, pitch = 0.8 }) then
		return false
	end
	return K.strike(e, tRoot, { set = "GWide", tell = 0.12, swing = "GThrust", swingBody = "GBLunge", time = 0.1, range = 9, half = 60, damage = 40, level = "Knockdown", lunge = 1.2, speed = 0.8, quiet = true })
end

M.attack = K.brain(function(e, tRoot, d)
	local roll = math.random()
	if roll < 0.25 then
		return blossom(e, tRoot), 0.6
	elseif d > e.def.Close + 1 then
		return hedgeRun(e, tRoot), 1.3
	elseif d < e.def.Close and roll < 0.65 then
		return snips(e, tRoot), 1
	end
	return cut(e, tRoot), 1.3
end)

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Topiarist</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">f93d49594b7149faac3aeaeebc4c61ad</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX4CE2EC6414914BED9B8DA46D5F2E4D84">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE CHANDLER (kind Chandelier): the great hall's lamp-keeper, huge in the shoulders from hauling the chandeliers up and down. It wears a
-- leather hood and a wax-stiffened smock, and over one fist it wraps the chain of a whole gilt chandelier, still lit, which it
-- swings as you'd swing a flail. Fire dripping off it the whole time.
--   Dressing the Hall   round its head and round, faster, walking at you with it. Candles flying off
--   Let It Down         the whole chandelier up, and down on you: gold, wax and glass all over the floor
--   Back-swing          flat across, close in
local K = require(script.Parent.Parent:WaitForChild("GildedKit"))
local M = K.wrap({
	Poses = { CHBHaul = { drop = 0.3, lean = 0.2, spread = 0.26, head = 0.12, footR = -0.3, footL = 0.35, breathe = 1.8, la1 = 0.3, la3 = -0.4, lel = 0.8, freeL = 0 } },
	Grips = {
		CHHang = { Vector3.new(1.5, 0.3, -0.5), CFrame.Angles(math.rad(10), 0, 0) },
		CHOver = { Vector3.new(0.3, 3.4, -0.2), CFrame.Angles(0, 0, math.rad(95)) },
	},
})
M.Kind = "Chandelier"
M.Proportions = { girth = 1.32, arm = 1.18, hunch = 0.18 }
M.IdlePose = "CHBHaul"
M.BodyFor = { CHHang = "CHBHaul" }
local SMOCK, SMOCK_DK, WAX, FLAME = Color3.fromRGB(206, 192, 156), Color3.fromRGB(160, 146, 112), Color3.fromRGB(232, 222, 190), Color3.fromRGB(255, 190, 90)
M.Colors = { skin = Color3.fromRGB(104, 80, 62), torso = SMOCK, legs = K.LEATHER, arms = Color3.fromRGB(104, 80, 62) }

function M.Look(k)
	local deco, parts, V, at, rgb, MAT = k.deco, k.parts, k.V, k.at, k.rgb, k.MAT
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	local rng = Random.new()
	-- the hood, buckled shut, one round glass eye; candle stubs burnt down on its shoulders
	deco("Head", "Hood", V(1.4, 1.42, 1.42), at(0, 0.02, 0.03), K.LEATHER, MAT.Leather)
	for _, y in ipairs({ -0.35, 0.18 }) do
		deco("Head", "Strap", V(1.46, 0.12, 1.46), at(0, y, 0.03), K.TARNISH, MAT.Metal)
	end
	deco("Head", "Goggle", V(0.1, 0.6, 0.6), at(0.22, 0.1, -0.74) * K.FACE, K.GOLD, MAT.Metal, Enum.PartType.Cylinder)
	deco("Head", "Lens", V(0.05, 0.42, 0.42), at(0.22, 0.1, -0.8) * K.FACE, FLAME, MAT.Neon, Enum.PartType.Cylinder)
	deco("Head", "Stitch", V(0.5, 0.05, 0.04), at(0, -0.42, -0.74), K.INK, MAT.SmoothPlastic)
	for _, sx in ipairs({ -1, 1 }) do
		for i = 0, 2 do
			local x = sx * (cw * 0.34 + i * 0.32)
			local h = 0.5 + rng:NextNumber(0, 0.5)
			deco("Chest", "Stub", V(0.26, h, 0.26), at(x, ch * 0.5 + h / 2, -0.15 + i * 0.1), WAX, MAT.SmoothPlastic)
			deco("Chest", "StubFlame", V(0.14, 0.26, 0.14), at(x, ch * 0.5 + h + 0.12, -0.15 + i * 0.1), FLAME, MAT.Neon, Enum.PartType.Ball)
		end
	end
	-- the smock, stiff with years of wax; run down its front in long pale drips
	deco("Chest", "Smock", V(cw * 1.06, ch * 1.02, cd * 1.1), at(0, 0, 0), SMOCK, MAT.Fabric)
	for _ = 1, 9 do
		local h = rng:NextNumber(0.4, 1.3)
		deco("Chest", "WaxRun", V(rng:NextNumber(0.1, 0.22), h, 0.06), at(rng:NextNumber(-0.42, 0.42) * cw, ch * 0.46 - h / 2, -cd * 0.57), WAX, MAT.SmoothPlastic)
	end
	k.tatter(rng, "Hips", CFrame.new(0, 0.1, -hd * 0.55), hw * 1.15, 2, SMOCK, SMOCK_DK, 0.35)
	k.tatter(rng, "Hips", CFrame.new(0, 0.1, hd * 0.55), hw * 1.15, 2.1, SMOCK, SMOCK_DK, 0.35)
	deco("Hips", "Belt", V(hw * 1.26, 0.34, hd * 1.3), at(0, 0.3, 0), K.LEATHER, MAT.Leather)
	deco("Hips", "Buckle", V(0.42, 0.3, 0.06), at(0, 0.3, -hd * 0.68), K.GOLD, MAT.Metal)
	-- spare candles in a quiver on its hip, a snuffer on the other
	deco("Hips", "Quiver", V(0.5, 1, 0.5), at(hw * 0.72, -0.4, 0), K.LEATHER, MAT.Leather)
	for i = -1, 1 do
		deco("Hips", "Candle", V(0.13, 0.9, 0.13), at(hw * 0.72 + i * 0.13, 0.25, i * 0.08), WAX, MAT.SmoothPlastic)
	end
	deco("Hips", "Snuffer", V(0.1, 1.3, 0.1), at(-hw * 0.74, -0.4, 0.05), K.GOLD, MAT.Metal)
	deco("Hips", "SnufferCup", V(0.34, 0.3, 0.34), at(-hw * 0.74, -1.15, 0.05), K.GOLD, MAT.Metal, Enum.PartType.Ball)
	for _, n in ipairs({ "R", "L" }) do
		for i = 0, 3 do
			deco(n .. "LowerArm", "ChainWrap", V(aw * 1.28, 0.12, aw * 1.28), at(0, la * 0.28 - i * la * 0.17, 0) * CFrame.Angles(0, 0, (i % 2 == 0 and 0.18 or -0.18)), K.TARNISH, MAT.Metal)
		end
		deco(n .. "Shin", "Boot", V(lw * 1.2, 1, lw * 1.2), at(0, -0.05, 0), K.LEATHER, MAT.Leather)
		deco(n .. "Foot", "Sole", V(0.82, 0.32, 1.2), at(0, 0.02, -0.05), K.INK, MAT.Leather)
	end
end

M.Weapons = {
	-- a length of chain, and hung from it a whole little chandelier: gold rings, arms, lit candles and glass drops
	ChandelierFlail = function(w)
		local gold, glass = K.GOLD, Color3.fromRGB(226, 236, 240)
		local handle = w.mk("Grip", Vector3.new(0.3, 0.8, 0.3), K.TARNISH, Enum.Material.Metal)
		for i = 1, 5 do
			w.add(w.mk("Link", Vector3.new(0.12, 0.42, 0.28), K.TARNISH, Enum.Material.Metal), -0.5 - i * 0.36, CFrame.Angles(0, (i % 2) * math.pi / 2, 0))
		end
		local Y = -3
		w.add(w.mk("Stem", Vector3.new(0.3, 1.8, 0.3), gold, Enum.Material.Metal), Y)
		local bottom = w.mk("Finial", Vector3.new(0.6, 0.6, 0.6), gold, Enum.Material.Metal)
		bottom.Shape = Enum.PartType.Ball
		w.add(bottom, Y - 1)
		local flames = {}
		for r, ring in ipairs({ { 1.45, Y - 0.35, 8 }, { 0.85, Y + 0.45, 6 } }) do
			local hoop = w.mk("Hoop", Vector3.new(0.12, ring[1] * 2, ring[1] * 2), gold, Enum.Material.Metal)
			hoop.Shape = Enum.PartType.Cylinder
			w.add(hoop, ring[2], CFrame.Angles(0, 0, math.pi / 2))
			for i = 1, ring[3] do
				local a = i / ring[3] * math.pi * 2
				local ox, oz = math.cos(a) * ring[1] * w.scale, math.sin(a) * ring[1] * w.scale
				w.add(w.mk("Candle", Vector3.new(0.14, 0.5, 0.14), Color3.fromRGB(232, 222, 190), Enum.Material.SmoothPlastic), ring[2] + 0.28, CFrame.new(ox, 0, oz))
				local f = w.mk("CandleFlame", Vector3.new(0.14, 0.26, 0.14), FLAME, Enum.Material.Neon)
				w.add(f, ring[2] + 0.62, CFrame.new(ox, 0, oz))
				table.insert(flames, f)
				if r == 1 then
					w.add(w.mk("Drop", Vector3.new(0.14, 0.34, 0.14), glass, Enum.Material.Glass), ring[2] - 0.32, CFrame.new(ox, 0, oz))
				end
			end
		end
		local function setup()
			local l = Instance.new("PointLight")
			l.Color, l.Range, l.Brightness = FLAME, 13, 1.2
			l.Parent = flames[1]
		end
		return { handle = handle, bladeLen = 4.2, setup = setup }
	end,
}

M.Def = K.def({
	HP = 620, Speed = 8.5, Scale = 1.45, Damage = 48, Range = 10.5, HalfAngle = 70, Lunge = 6, Poise = 95, Stagger = 0.55, StaggerPush = 6,
	Windup = 1, Recover = 1.2, Engage = 12, Close = 8, Weapon = "ChandelierFlail", IdleGrip = "CHHang", Radius = 2, Skin = K.TARNISH, Cloth = SMOCK,
})

M.attack = K.brain(function(e, tRoot, d)
	local roll = math.random()
	if d >= e.def.Close or roll < 0.3 then
		return K.slam(e, tRoot, {
			set = "GRaise", setBody = "GBCast", tell = 1.05, swing = "GSlam", swingBody = "GBStrike", time = 0.2, range = 11, half = 50, level = "Knockdown",
			area = 7, areaDamage = 26, color = FLAME, lunge = 0.8, boom = 1.2, shake = 0.6,
		}), 1.5
	elseif roll < 0.68 then
		return K.whirl(e, tRoot, { grip = "CHOver", wind = 0.8, time = 2.4, radius = 8, damage = 24, every = 0.6, speed = 7, turn = 9 }), 1.5
	end
	return K.strike(e, tRoot, { set = "GBack", setBody = "GBWind", tell = 0.7, swing = "GSweep", swingBody = "GBSweep", time = 0.2, range = 9.5, half = 90, damage = 40, speed = 0.65 }), 1.1
end)

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Chandelier</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">27854fcf1fcc441688cae5a327e02f97</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX6774CD9762C5449EA1025337AB04FC91">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE SENESCHAL (kind Seneschal): the steward of the palace, who runs the house, the staff, the seating, and your removal. Enormous and upright in
-- wine-dark velvet and a bishop's width of gold embroidery, a chain of office over a chest like a wardrobe, a long white beard combed flat.
-- It carries the rod of office: a mace of ceremony as tall as you are. Everything it does is slow and formal, and it never misses a step.
--   Decree       left, right, then straight down. Three blows, with a pause for effect between each
--   You May Not  the butt of the rod knocked once on the floor: a jolt runs out, you stagger, and it's already walking at you
--   Dismissed    a two-handed thrust at the chest that throws you across the room
--   Make Way     the rod drawn back, then swept right round it at knee height: getting behind it is no answer
local K = require(script.Parent.Parent:WaitForChild("GildedKit"))
local M = K.wrap({
	Poses = {
		SNBUpright = { drop = 0, lean = -0.08, head = -0.1, footR = -0.1, footL = 0.12, spread = 0.12, breathe = 0.5, la1 = 0.18, la3 = -0.15, lel = 1.2, freeL = 0 },
		SNBKnock = { drop = 0.2, lean = -0.05, head = 0.1, spread = 0.14, footR = -0.1, footL = 0.14, la1 = 0.18, la3 = -0.15, lel = 1.2, freeL = 0 },
	},
	Grips = {
		SNStaff = { Vector3.new(1.15, 0.3, -0.7), CFrame.Angles(math.rad(178), 0, math.rad(-2)) },
		SNKnockUp = { Vector3.new(1, 1.8, -1), CFrame.Angles(math.rad(180), 0, 0) },
		SNKnock = { Vector3.new(0.9, 0.3, -1.3), CFrame.Angles(math.rad(180), 0, 0) },
	},
})
M.Kind = "Seneschal"
M.Proportions = { girth = 1.3, arm = 1.08, hunch = 0, cadence = 0.42 }
M.IdlePose = "SNBUpright"
M.BodyFor = { SNStaff = "SNBUpright" }
local WINE, WINE_DK, BEARD = Color3.fromRGB(132, 32, 64), Color3.fromRGB(94, 24, 48), Color3.fromRGB(226, 222, 212)
M.Colors = { skin = Color3.fromRGB(182, 158, 136), torso = WINE, legs = WINE_DK, arms = WINE }

function M.Look(k)
	local deco, parts, V, at, rgb, MAT = k.deco, k.parts, k.V, k.at, k.rgb, k.MAT
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	local ball = Enum.PartType.Ball
	-- an old, severe face, eyes dark and sunk, a beard to the waist, a tall flat velvet hat of office with a gold band
	parts.Head.Material = MAT.SmoothPlastic
	for _, sx in ipairs({ -1, 1 }) do
		deco("Head", "Socket", V(0.28, 0.14, 0.05), at(sx * 0.26, 0.14, -0.58), K.INK, MAT.SmoothPlastic)
		deco("Head", "Eye", V(0.1, 0.05, 0.04), at(sx * 0.26, 0.14, -0.6), K.LIGHT, MAT.Neon)
		deco("Head", "Brow", V(0.34, 0.1, 0.1), at(sx * 0.27, 0.27, -0.58) * CFrame.Angles(0, 0, -sx * 0.2), BEARD, MAT.Sand)
	end
	deco("Head", "Nose", V(0.2, 0.4, 0.14), at(0, -0.04, -0.6), rgb(170, 146, 124), MAT.SmoothPlastic)
	deco("Head", "Moustache", V(0.84, 0.14, 0.1), at(0, -0.26, -0.58), BEARD, MAT.Sand)
	deco("Head", "Beard", V(0.98, 0.9, 0.3), at(0, -0.72, -0.42), BEARD, MAT.Sand)
	deco("Chest", "BeardFall", V(0.74, ch * 0.72, 0.14), at(0, ch * 0.08, -cd * 0.74), BEARD, MAT.Sand)
	deco("Chest", "BeardPoint", V(0.44, 0.5, 0.12), at(0, -ch * 0.36, -cd * 0.74), BEARD, MAT.Sand)
	deco("Head", "Hat", V(1.3, 1.1, 1.3), at(0, 1.05, 0.02), WINE, MAT.Fabric)
	deco("Head", "HatBand", V(1.38, 0.22, 1.38), at(0, 0.58, 0.02), K.GOLD, MAT.Metal)
	deco("Head", "HatTop", V(1.46, 0.14, 1.46), at(0, 1.62, 0.02), K.GOLD, MAT.Metal)
	deco("Head", "HatJewel", V(0.26, 0.26, 0.08), at(0, 0.6, -0.72), K.LAPIS, MAT.Glass, ball)
	-- the great gown, wide-shouldered; broad bands of gold embroidery; ermine on the shoulders; its chain of office
	deco("Chest", "Gown", V(cw * 1.08, ch * 1.02, cd * 1.15), at(0, 0, 0), WINE, MAT.Fabric)
	deco("Chest", "Yoke", V(cw * 1.32, 0.62, cd * 1.5), at(0, ch * 0.32, 0), Color3.fromRGB(236, 232, 222), MAT.Fabric)
	for i = 0, 11 do
		deco("Chest", "Ermine", V(0.08, 0.2, 0.06), at(-cw * 0.62 + i * cw * 0.113, ch * 0.32, -cd * 0.76), K.INK, MAT.Fabric)
	end
	for _, sx in ipairs({ -1, 1 }) do
		deco("Chest", "GoldBand", V(0.42, ch * 0.72, 0.05), at(sx * cw * 0.32, -ch * 0.08, -cd * 0.6), K.GOLD, MAT.Fabric)
		deco("Hips", "SkirtBand", V(0.42, 3.05, 0.05), at(sx * hw * 0.34, -1.3, -hd * 0.72), K.GOLD, MAT.Fabric)
		for i = 0, 4 do
			deco("Hips", "Embroider", V(0.26, 0.26, 0.05), at(sx * hw * 0.34, -0.2 - i * 0.56, -hd * 0.74) * CFrame.Angles(0, 0, math.pi / 4), K.ROSE, MAT.Fabric)
		end
	end
	for i = 0, 8 do
		local a = i / 8 * math.pi
		deco("Chest", "ChainLink", V(0.2, 0.2, 0.1), at(math.cos(a) * cw * 0.44, ch * 0.2 - math.sin(a) * ch * 0.5, -cd * 0.88), K.LIGHT, MAT.Metal, ball)
	end
	deco("Chest", "Medal", V(0.08, 0.7, 0.7), at(0, ch * -0.32, -cd * 0.92) * K.FACE, K.GOLD, MAT.Metal, Enum.PartType.Cylinder)
	deco("Chest", "MedalStone", V(0.05, 0.3, 0.3), at(0, ch * -0.32, -cd * 0.97) * K.FACE, K.RUG, MAT.Glass, Enum.PartType.Cylinder)
	deco("Hips", "Skirt", V(hw * 1.4, 3.1, hd * 1.45), at(0, -1.3, 0), WINE_DK, MAT.Fabric)
	deco("Hips", "SkirtHem", V(hw * 1.44, 0.2, hd * 1.5), at(0, -2.72, 0), K.GOLD, MAT.Fabric)
	deco("Hips", "Sash", V(hw * 1.42, 0.3, hd * 1.48), at(0, 0.28, 0), K.GOLD, MAT.Fabric)
	-- keys of every door, on a great ring at its belt
	deco("Hips", "KeyRing", V(0.08, 0.62, 0.62), at(hw * 0.7, -0.05, -hd * 0.4) * K.UP * CFrame.Angles(0, 0, math.pi / 2), K.LIGHT, MAT.Metal, Enum.PartType.Cylinder)
	for i = 0, 4 do
		deco("Hips", "Key", V(0.09, 0.62, 0.17), at(hw * 0.7 + (i - 2) * 0.08, -0.5, -hd * 0.4), K.GOLD, MAT.Metal)
	end
	for _, n in ipairs({ "R", "L" }) do
		deco(n .. "UpperArm", "Sleeve", V(aw * 1.45, ua * 1.02, aw * 1.45), at(0, 0, 0), WINE, MAT.Fabric)
		deco(n .. "LowerArm", "WideSleeve", V(aw * 1.75, la * 1.02, aw * 1.75), at(0, 0.05, 0), WINE_DK, MAT.Fabric)
		deco(n .. "LowerArm", "SleeveBand", V(aw * 1.82, 0.22, aw * 1.82), at(0, -la * 0.42, 0), K.GOLD, MAT.Fabric)
	end
end

M.Weapons = {
	-- the rod of office: gold and ebony, an orb-and-flange head, weighted at its foot too
	RodOfOffice = function(w)
		local handle = w.mk("Grip", Vector3.new(0.3, 1.2, 0.3), K.INK, Enum.Material.Wood)
		w.add(w.mk("Rod", Vector3.new(0.26, 5.6, 0.26), K.INK, Enum.Material.Wood), -2)
		for _, y in ipairs({ -0.8, -2, -3.2 }) do
			w.add(w.mk("RodBand", Vector3.new(0.36, 0.2, 0.36), K.GOLD, Enum.Material.Metal), y)
		end
		w.add(w.mk("Ferrule", Vector3.new(0.46, 1, 0.46), K.GOLD, Enum.Material.Metal), 1.2)
		local orb = w.mk("Orb", Vector3.new(1.45, 1.45, 1.45), K.GOLD, Enum.Material.Metal)
		orb.Shape = Enum.PartType.Ball
		w.add(orb, -5.3)
		for i = 0, 5 do
			local a = i * math.pi / 3
			w.add(w.mk("Flange", Vector3.new(0.14, 1.1, 0.55), K.LIGHT, Enum.Material.Metal), -5.3, CFrame.Angles(0, a, 0) * CFrame.new(0, 0, 0.82 * w.scale))
		end
		w.add(w.mk("Cross", Vector3.new(0.18, 0.95, 0.18), K.LIGHT, Enum.Material.Metal), -6.5)
		w.add(w.mk("Cross", Vector3.new(0.6, 0.18, 0.18), K.LIGHT, Enum.Material.Metal), -6.6)
		return { handle = handle, bladeLen = 6.2 }
	end,
}

M.Def = K.def({
	HP = 700, Speed = 7.5, Scale = 1.5, Damage = 52, Range = 11, HalfAngle = 55, Lunge = 6, Poise = 130, Stagger = 0.65, StaggerPush = 5,
	Windup = 1, Recover = 1.25, HyperArmor = true, Engage = 12, Close = 8, Weapon = "RodOfOffice", IdleGrip = "SNStaff", Radius = 2.1, Skin = WINE, Cloth = WINE,
})

local function decree(e, tRoot)
	return K.combo(e, tRoot, {
		{ set = "GCock", setBody = "GBSet", tell = 0.8, swing = "GCut", swingBody = "GBStrike", time = 0.18, damage = 38, speed = 0.8 },
		{ set = "GBack", setBody = "GBWind", tell = 0.7, swing = "GSweep", swingBody = "GBSweep", time = 0.18, damage = 38, speed = 0.78, quiet = true },
		{ set = "GRaise", setBody = "GBCast", tell = 0.9, swing = "GSlam", swingBody = "GBStrike", time = 0.2, damage = 54, level = "Knockdown", speed = 0.7, quiet = true, lunge = 1.3 },
	})
end
local function youMayNot(e, tRoot)
	K.setGrip(e, "SNKnockUp", 0.5)
	K.setBody(e, "SNBUpright", 0.5)
	if not K.hold(e, 0.8, tRoot) then
		return false
	end
	K.setGrip(e, "SNKnock", 0.09, Enum.EasingStyle.Quad)
	K.setBody(e, "SNBKnock", 0.09)
	task.wait(0.09)
	if not e.alive then
		return false
	end
	local at = K.feet(e)
	K.area(at, 13, 3.5, 24, "Large")
	K.flash(at, K.LIGHT, 6)
	K.sound(e, "WatchdogSmash", 0.8, 1.3)
	K.shake(at, 0.5)
	return true
end
local function dismissed(e, tRoot)
	local ok, hit = K.strike(e, tRoot, { set = "GDraw", setBody = "GBDraw", tell = 0.95, swing = "GThrust", swingBody = "GBLunge", time = 0.13, range = 12, half = 20, damage = 48, level = "Knockdown", lunge = 1.8, speed = 0.7 })
	return ok, hit
end

local function makeWay(e, tRoot)
	return K.whirl(e, tRoot, { grip = "GBack", body = "GBSpin", wind = 1, time = 0.55, radius = 10.5, damage = 40, every = 1, speed = 0.1, turn = 16 })
end

M.attack = K.brain(function(e, tRoot, d)
	local roll = math.random()
	if d > e.def.Close and roll < 0.55 then
		return dismissed(e, tRoot), 1.2
	elseif roll < 0.25 then
		return youMayNot(e, tRoot), 0.7
	elseif d > e.def.Close then
		return youMayNot(e, tRoot), 0.5
	elseif roll < 0.5 then
		return makeWay(e, tRoot), 1.4
	end
	return decree(e, tRoot), 1.5
end)

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Seneschal</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">293eae597f0b4ea78cb46cd120c88127</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX68067B3C77194C4D9A135329DC1C71A5">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE LOOKING-GLASS KNIGHT (kind MirrorGuard): the queen's own guard, in plate polished so bright it's forgotten what it looks like, behind a
-- tower-shield that's a whole dressing-mirror in a gold frame. Slim, patient, faceless: its visor's one more mirror, and what looks
-- back from it's you. It waits for you to swing.
--   Reflection  it plants the mirror and stands behind it, unbudgeable; hit it there, and the blade's answered from behind the glass
--   Glare       the mirror turned to the light: a flash, and a thin line of it flung at you
--   Shield Wall the frame driven forward in a shove, then a cut over the top
local K = require(script.Parent.Parent:WaitForChild("GildedKit"))
local M = K.wrap({
	Poses = {
		MGBGuard = { drop = 0.45, lean = 0.12, twist = 0.14, head = 0.05, spread = 0.2, footR = -0.45, footL = 0.5, breathe = 0.5, la1 = 1.1, la2 = 0.4, la3 = -0.1, lel = 1.5, freeL = 0 },
		MGBPlant = { drop = 0.9, lean = 0.2, twist = 0.1, head = 0.1, spread = 0.3, footR = -0.8, footL = 0.85, la1 = 1.05, la2 = 0.45, la3 = -0.1, lel = 1.5, freeL = 0 },
	},
	Grips = { MGLow = { Vector3.new(1.15, 0.1, -0.5), CFrame.Angles(math.rad(70), 0, 0) } },
})
M.Kind = "MirrorGuard"
M.Proportions = { girth = 0.98, arm = 1.05, hunch = 0 }
M.IdlePose = "MGBGuard"
M.BodyFor = { MGLow = "MGBGuard" }
local PLATE, PLATE_DK, GLASS = Color3.fromRGB(216, 222, 230), Color3.fromRGB(150, 156, 170), Color3.fromRGB(224, 236, 244)
M.Colors = { skin = PLATE_DK, torso = PLATE, legs = PLATE_DK, arms = PLATE }
local function mirror(p)
	p.Reflectance = 0.65
	return p
end

function M.Look(k)
	local deco, parts, V, at, rgb, MAT = k.deco, k.parts, k.V, k.at, k.rgb, k.MAT
	local cw, ch, cd, hw, hd, aw, lw, la, ua = k.cw, k.ch, k.cd, k.hw, k.hd, k.aw, k.lw, k.la, k.ua
	-- THE HELM: tall and slim, and in its front a single oval mirror where a face would be
	deco("Head", "Helm", V(1.24, 1.4, 1.28), at(0, 0.08, 0.02), PLATE, MAT.Metal).Reflectance = 0.2
	deco("Head", "HelmCrest", V(0.1, 0.8, 1.3), at(0, 0.88, 0.02), K.GOLD, MAT.Metal)
	mirror(deco("Head", "FaceGlass", V(0.05, 0.98, 0.72), at(0, 0.05, -0.66) * K.FACE, GLASS, MAT.Glass, Enum.PartType.Cylinder))
	deco("Head", "FaceFrame", V(0.04, 1.08, 0.82), at(0, 0.05, -0.64) * K.FACE, K.GOLD, MAT.Metal, Enum.PartType.Cylinder)
	-- the cuirass, its plates each their own small mirror
	deco("Chest", "Cuirass", V(cw * 1.04, ch * 0.96, cd * 1.1), at(0, 0.02, 0), PLATE, MAT.Metal).Reflectance = 0.15
	for ix = -1, 1 do
		for iy = 0, 2 do
			mirror(deco("Chest", "Pane", V(cw * 0.26, ch * 0.24, 0.05), at(ix * cw * 0.3, ch * (0.28 - iy * 0.28), -cd * 0.58), GLASS, MAT.Glass))
			deco("Chest", "Leading", V(cw * 0.3, 0.04, 0.05), at(ix * cw * 0.3, ch * (0.14 - iy * 0.28), -cd * 0.57), K.GOLD, MAT.Metal)
		end
	end
	deco("Chest", "Gorget", V(cw * 0.6, 0.32, cd * 1.15), at(0, ch * 0.5, 0), K.GOLD, MAT.Metal)
	deco("Hips", "Fauld", V(hw * 1.2, 0.85, hd * 1.2), at(0, -0.12, 0), PLATE_DK, MAT.Metal)
	for i = 0, 3 do
		deco("Hips", "Tasset", V(hw * 0.4, 1.1, 0.08), at((i - 1.5) * hw * 0.42, -0.95, -hd * 0.6), PLATE, MAT.Metal).Reflectance = 0.2
	end
	deco("Hips", "Belt", V(hw * 1.26, 0.18, hd * 1.28), at(0, 0.3, 0), K.GOLD, MAT.Metal)
	for _, n in ipairs({ "R", "L" }) do
		local sx = n == "R" and 1 or -1
		deco(n .. "UpperArm", "Pauldron", V(aw * 1.8, 0.48, aw * 1.7), at(sx * 0.08, ua / 2 - 0.08, 0) * CFrame.Angles(0, 0, -sx * 0.28), PLATE, MAT.Metal).Reflectance = 0.2
		deco(n .. "UpperArm", "PauldronTrim", V(aw * 1.85, 0.07, aw * 1.75), at(sx * 0.08, ua / 2 - 0.3, 0) * CFrame.Angles(0, 0, -sx * 0.28), K.GOLD, MAT.Metal)
		deco(n .. "LowerArm", "Vambrace", V(aw * 1.18, la * 0.75, aw * 1.18), at(0, -0.05, 0), PLATE, MAT.Metal).Reflectance = 0.15
		deco(n .. "Thigh", "Cuisse", V(lw * 1.15, 0.9, lw * 1.15), at(0, 0.05, 0), PLATE, MAT.Metal)
		deco(n .. "Shin", "Greave", V(lw * 1.12, 0.85, lw * 1.12), at(0, -0.08, 0), PLATE, MAT.Metal).Reflectance = 0.15
		deco(n .. "Shin", "Knee", V(lw * 1.22, 0.3, lw * 1.25), at(0, 0.5, -0.05), K.GOLD, MAT.Metal)
		deco(n .. "Foot", "Sabaton", V(0.66, 0.26, 1.12), at(0, 0.02, -0.05), PLATE_DK, MAT.Metal)
	end
	-- THE MIRROR on its left arm: a tall oval glass in a gold frame, a little cherub at its crown (it covers it knee to chin)
	local F = at(-0.06, -0.15, -0.55) * CFrame.Angles(0, 0, 0)
	mirror(deco("LLowerArm", "ShieldGlass", V(2.5, 4.6, 0.1), F, GLASS, MAT.Glass))
	deco("LLowerArm", "ShieldBack", V(2.64, 4.74, 0.14), F * CFrame.new(0, 0, 0.1), K.TARNISH, MAT.Metal)
	deco("LLowerArm", "ShieldCrown", V(1.5, 0.34, 0.2), F * CFrame.new(0, 2.3, -0.02), K.GOLD, MAT.Metal)
	deco("LLowerArm", "ShieldFoot", V(1.1, 0.3, 0.2), F * CFrame.new(0, -2.3, -0.02), K.GOLD, MAT.Metal)
	deco("LLowerArm", "ShieldBoss", V(0.42, 0.42, 0.2), F * CFrame.new(0, 2.56, -0.02), K.LIGHT, MAT.Metal, Enum.PartType.Ball)
	for _, sx in ipairs({ -1, 1 }) do
		deco("LLowerArm", "ShieldSide", V(0.18, 2.4, 0.2), F * CFrame.new(sx * 1.24, 0, -0.02), K.GOLD, MAT.Metal)
	end
end

M.Weapons = {
	-- a long clean sword with a gold ribbon of a guard
	GlassSword = function(w)
		local handle = w.mk("Grip", Vector3.new(0.22, 1, 0.22), K.INK, Enum.Material.Leather)
		w.add(w.mk("Guard", Vector3.new(1.5, 0.16, 0.24), K.GOLD, Enum.Material.Metal), -0.55)
		local blade = w.mk("Blade", Vector3.new(0.36, 4.3, 0.09), PLATE, Enum.Material.Metal)
		blade.Reflectance = 0.3
		w.add(blade, -2.85)
		w.add(w.mk("Fuller", Vector3.new(0.08, 3.8, 0.1), K.GOLD, Enum.Material.Metal), -2.7)
		w.add(w.mk("Pommel", Vector3.new(0.26, 0.26, 0.26), K.GOLD, Enum.Material.Metal), 0.58)
		return { handle = handle, bladeLen = 5 }
	end,
}

M.Def = K.def({
	HP = 500, Speed = 9, Scale = 1.3, Damage = 38, Range = 9, HalfAngle = 55, Lunge = 8, Poise = 85, Stagger = 0.4, StaggerPush = 6,
	Windup = 0.75, Recover = 1, Engage = 20, Close = 9, Weapon = "GlassSword", IdleGrip = "MGLow", Radius = 1.7, Skin = PLATE, Cloth = PLATE_DK,
})

-- REFLECTION: planted. Anything that lands on it in that time is paid back as a cut, at once. Nothing gets paid back if you wait it out
local function reflection(e, tRoot)
	K.setBody(e, "MGBPlant", 0.25)
	K.setGrip(e, "GDraw", 0.3)
	K.sound(e, "Unsheath", 0.35, 1.3)
	local hum = e.hum
	local hp0, t0 = hum.Health, os.clock()
	e.def = table.clone(e.def)
	e.def.HyperArmor = true
	local answered = false
	while os.clock() - t0 < 1.8 do
		task.wait()
		if not e.alive then
			return false
		end
		if tRoot.Parent then
			K.face(e, tRoot.Position)
		end
		if hum.Health < hp0 - 0.5 then
			answered = true
			break
		end
	end
	e.def.HyperArmor = false
	if not answered then
		return true
	end
	K.flash(e.root.Position + Vector3.new(0, 2, 0), GLASS, 7)
	return K.strike(e, tRoot, { set = "GDraw", tell = 0.08, swing = "GThrust", swingBody = "GBLunge", time = 0.08, range = 9.5, half = 40, damage = 44, level = "Large", lunge = 1.8, speed = 1.2, quiet = true })
end
-- GLARE: the mirror turned up, then a line of light across the room
local function glare(e, tRoot)
	K.setBody(e, "GBCast", 0.4)
	K.sound(e, "Unsheath", 0.3, 2)
	if not K.hold(e, 0.75, tRoot) then
		return false
	end
	K.setBody(e, "MGBGuard", 0.12)
	local gl = K.partOf(e, "ShieldGlass")
	local from = (gl and gl.Position or e.root.Position) + e.root.CFrame.LookVector * 1.5
	K.flash(from, GLASS, 5)
	K.shot(e, {
		from = from, vel = K.aim(from, tRoot, 90, 0.05), damage = 28, level = "Medium", radius = 1.5, life = 0.7,
		size = Vector3.new(0.25, 0.25, 6), shape = Enum.PartType.Block, color = GLASS, material = Enum.Material.Neon, trail = GLASS,
	})
	K.sound(e, "WatchdogBlast", 0.5, 1.8)
	return true
end

M.attack = K.brain(function(e, tRoot, d)
	local roll = math.random()
	if d > e.def.Close then
		return glare(e, tRoot), 1
	elseif roll < 0.45 then
		return reflection(e, tRoot), 0.9
	end
	return K.combo(e, tRoot, {
		{ setBody = "MGBPlant", tell = 0.55, swingBody = "GBLunge", time = 0.14, range = 6.5, half = 70, damage = 22, level = "Medium", lunge = 2.2, speed = 0.6 },
		{ set = "GCock", setBody = "GBSet", tell = 0.28, swing = "GCut", swingBody = "GBStrike", time = 0.13, range = 9, half = 55, damage = 38, speed = 1, quiet = true },
	}), 1
end)

return M
]]></ProtectedString>
					<string name="ScriptGuid">{10EC006C-5DD7-410D-A850-A442367AA198}</string>
