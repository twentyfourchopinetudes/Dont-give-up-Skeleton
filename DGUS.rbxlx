					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE CARRIER, server half: what answers the prison's bell. The first time someone rings it,
-- the thing (its look and its path: ReplicatedStorage/Carrier, drawn by every client) hauls
-- itself up the outside of the battlements and comes for them. They back away from it,
-- arm up, but it takes them anyway, and flies them off over the township to drop them on
-- the ground beyond its north edge (Map.NewArea). (A bonfire there lets them wake there.)
-- Here: the plan, and the player - held, resisting, carried along its path, let go.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = require(ReplicatedStorage:WaitForChild("Carrier"))

local M = {}
local Core, Map

local busy = false
function M.take(player)
	local char, hum, hrp = Core.aliveChar(player)
	local st = Core.states[player]
	if busy or not (char and st) or player:GetAttribute("Taken") then
		return
	end
	busy = true
	local function pose(name, blend)
		char:SetAttribute("BP", name)
		char:SetAttribute("BPT", blend)
		char:SetAttribute("BPN", (char:GetAttribute("BPN") or 0) + 1)
	end
	local function hold(seconds)
		Core.setAction(st, Core.now(), seconds, seconds, seconds)
		Core.FxRemote:FireClient(player, "Grabbed", seconds)
	end
	local function alive()
		return hrp.Parent and hum.Health > 0 and player.Parent ~= nil
	end
	local ok, err = pcall(function()
		task.wait(2.2) -- (the bell's first tolls)
		if not alive() then
			return
		end
		local ktop = Map.CastellanArena.Center.Y
		local wallX = 196 -- the north arm's outer east face
		local z = math.clamp(hrp.Position.Z - 8, 228, 276)
		local start = hrp.Position
		local away = Vector3.new(start.X - (wallX - 4), 0, start.Z - z)
		away = away.Magnitude > 0.5 and away.Unit or Vector3.new(-1, 0, 0)
		local back = 4
		local plan = {
			wallX = wallX, z = z, ktop = ktop, start = start, back = away,
			held = start + away * back, landing = Map.NewArea.Landing.Position,
			seed = math.random(1, 1e6),
		}
		local tCrawl = Shared.CLIMB + Shared.CREST
		local tGrab = tCrawl + Shared.crawlTime(plan)
		local tFly = tGrab + Shared.GRAB
		local tDrop = tFly + Shared.FLY
		hold(tDrop + 1)
		hrp.Anchored = true
		Core.FxRemote:FireAllClients("Carrier", plan)
		local t0 = os.clock()
		local lastPose, poseN = 0, 0
		local RESIST = { "Deflect", "Flinch", "Stagger", "Deflect", "Recover" }
		local STRUGGLE = { "Air", "Stagger", "Air", "Flinch" }
		while true do
			RunService.Heartbeat:Wait()
			if not alive() then
				error("gone", 0)
			end
			local t = os.clock() - t0
			local cf = Shared.at(plan, math.min(t, tDrop))
			if t < tGrab then
				-- it comes: you face it and give ground, stumbling, an arm up against it
				local k = math.clamp((t - Shared.CLIMB) / (tGrab - Shared.CLIMB), 0, 1)
				local pos = start + away * back * (1 - (1 - k) ^ 2)
				local look = Vector3.new(cf.Position.X, pos.Y, cf.Position.Z)
				hrp.CFrame = (look - pos).Magnitude > 0.1 and CFrame.lookAt(pos, look) or CFrame.new(pos) * hrp.CFrame.Rotation
				if t > Shared.CLIMB * 0.5 and t - lastPose > 0.55 then
					lastPose, poseN = t, poseN + 1
					pose(RESIST[(poseN - 1) % #RESIST + 1], 0.2)
				end
			elseif t < tFly then
				-- its arms close on you: you thrash
				if t - lastPose > 0.25 then
					lastPose, poseN = t, poseN + 1
					pose(poseN % 2 == 0 and "Stagger" or "Flinch", 0.12)
					if poseN % 3 == 0 then
						Core.playSound(hrp, Core.SOUNDS.Impact, 0.5, 0.6)
					end
				end
			elseif t < tDrop then
				-- carried, kicking
				local wr = CFrame.Angles(0.5 + math.sin(t * 11) * 0.25, math.sin(t * 7) * 0.3, math.sin(t * 13) * 0.25)
				hrp.CFrame = cf * Shared.HANG * wr
				if t - lastPose > 0.45 then
					lastPose, poseN = t, poseN + 1
					pose(STRUGGLE[(poseN - 1) % #STRUGGLE + 1], 0.2)
				end
			else
				break
			end
		end
		-- let go
		hrp.Anchored = false
		hrp.AssemblyLinearVelocity = Vector3.new(0, -10, 0)
		pcall(function()
			hrp:SetNetworkOwner(player)
		end)
		pose("Idle", 0.4)
		player:SetAttribute("Taken", true)
		hold(0)
	end)
	if not ok then
		-- (they died or left mid-way, or something broke: never leave anyone pinned)
		if hrp.Parent then
			hrp.Anchored = false
			pcall(function()
				hrp:SetNetworkOwner(player)
			end)
		end
		if player.Parent then
			hold(0)
		end
		if err ~= "gone" and Core.Config.Debug then
			warn("[Carrier] " .. tostring(err))
		end
	end
	busy = false
end

function M.init(core)
	Core, Map = core, core.Map
end

return M
]]></ProtectedString>
					<string name="ScriptGuid">{400370DF-DD34-4E12-A668-40C9461EE50D}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Carrier</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">d50e2f57e67340bdb01d025c21904c83</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX6CC58EBD9C484DFF9BA43BFD89451308">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- MIMIC: a chest that isn't. It waits in the far corner of the Prison Ramparts' yard walk
-- looking like any other chest (same prompt, same planks). Open it and it bites; then it
-- fights - hopping after you, snapping its lid, leaping on you from range.
--
-- Not a rig: a chest model (body + a lid hinged on a weld) around an anchored root, with
-- a Humanoid for health so blades and lock-on treat it like any enemy once it's awake.
-- While it's pretending it lives outside the EnemiesFolder, so nothing can target it.
-- Killed, it stays dead. If it loses you, it goes back to its corner, shuts, heals, waits.
-- Numbers: Config.Mimic. Where it sits and how far it may hop: Map.Mimic (MapBuilder).
local Mimic = {}

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local W, H, DP = 4, 2, 2.6 -- the same box as the Usher's chest

function Mimic.init(core)
	local Config, where = core.Config, core.Map.Mimic -- { CFrame = its corner, Min/Max = how far it may hop }
	if not where then
		return
	end
	local spot = where.CFrame
	local CFG = Config.Mimic
	local now, flat, playSound, SOUNDS = core.now, core.flat, core.playSound, core.SOUNDS
	local burst, dustCloud, damagePlayer = core.burst, core.dustCloud, core.damagePlayer
	local playersInSector, playersInRadius, aliveChar = core.playersInSector, core.playersInRadius, core.aliveChar

	---------------------------------------------------------------------------
	-- the chest
	---------------------------------------------------------------------------
	local model = Instance.new("Model")
	model.Name = "Mimic"
	local rng = Random.new(7)
	local rust = Color3.fromRGB(78, 52, 36)
	local function plankColor()
		return Color3.fromRGB(72, 52, 36):Lerp(Color3.fromRGB(58, 56, 50), rng:NextNumber(0.2, 0.75))
	end
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(W, H, DP)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = true
	root.Parent = model
	model.PrimaryPart = root

	local function piece(name, size, cf, color, mat, attachTo)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Color = color or plankColor()
		p.Material = mat or Enum.Material.WoodPlanks
		p.CanCollide = false
		p.Massless = true
		p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		p.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0, w.Part1 = attachTo, p
		w.Parent = p
		return p
	end
	-- everything is built at the spot, then welded; the root's CFrame moves the lot
	root.CFrame = spot * CFrame.new(0, H / 2, 0)
	local base = spot
	-- body: four plank walls, a dark inside, straps, corner caps, lock plate
	piece("Inside", Vector3.new(W - 0.4, H - 0.3, DP - 0.4), base * CFrame.new(0, H / 2 - 0.1, 0), Color3.fromRGB(28, 18, 16), Enum.Material.SmoothPlastic, root)
	for _, s in ipairs({ { 0, -(DP - 0.22) / 2, W, 0.22 }, { 0, (DP - 0.22) / 2, W, 0.22 }, { -(W - 0.22) / 2, 0, 0.22, DP - 0.44 }, { (W - 0.22) / 2, 0, 0.22, DP - 0.44 } }) do
		for k = 0, 1 do
			piece("ChestPlank", Vector3.new(s[3], H / 2 - 0.05, s[4]), base * CFrame.new(s[1], H / 4 + k * H / 2, s[2]), nil, nil, root)
		end
	end
	for _, bx in ipairs({ -1.3, 1.3 }) do
		for _, sz in ipairs({ -1, 1 }) do
			piece("ChestStrap", Vector3.new(0.3, H + 0.04, 0.06), base * CFrame.new(bx, H / 2, sz * (DP / 2 + 0.03)), rust, Enum.Material.CorrodedMetal, root)
		end
	end
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			piece("ChestCorner", Vector3.new(0.3, H + 0.04, 0.3), base * CFrame.new(sx * (W / 2 - 0.1), H / 2, sz * (DP / 2 - 0.1)), Color3.fromRGB(46, 42, 38), Enum.Material.CorrodedMetal, root)
		end
	end
	piece("ChestLock", Vector3.new(0.55, 0.6, 0.08), base * CFrame.new(0, H - 0.35, -(DP / 2 + 0.05)), rust, Enum.Material.CorrodedMetal, root)
	-- the lid hangs off a hinge at the back top edge; its weld's C0 opens it
	local hinge = Instance.new("Part")
	hinge.Name = "Hinge"
	hinge.Size = Vector3.new(0.2, 0.2, 0.2)
	hinge.Transparency = 1
	hinge.CanCollide, hinge.CanQuery, hinge.Massless = false, false, true
	hinge.CFrame = base * CFrame.new(0, H, DP / 2)
	hinge.Parent = model
	local lidWeld = Instance.new("Weld")
	lidWeld.Part0, lidWeld.Part1 = root, hinge
	lidWeld.C0 = CFrame.new(0, H / 2, DP / 2)
	lidWeld.Parent = hinge
	local LD = DP + 0.1
	for k = 0, 2 do
		piece("LidPlank", Vector3.new(W + 0.1, 0.18, LD / 3 - 0.04), base * CFrame.new(0, H + 0.33, -LD / 2 + LD / 3 * (k + 0.5)), nil, nil, hinge)
	end
	piece("LidRim", Vector3.new(W + 0.1, 0.24, 0.22), base * CFrame.new(0, H + 0.12, -(LD - 0.22) / 2), nil, nil, hinge)
	for _, bx in ipairs({ -1.3, 1.3 }) do
		piece("LidStrap", Vector3.new(0.3, 0.05, LD + 0.04), base * CFrame.new(bx, H + 0.44, 0), rust, Enum.Material.CorrodedMetal, hinge)
	end
	piece("LidHasp", Vector3.new(0.4, 0.5, 0.06), base * CFrame.new(0, H + 0.05, -(LD / 2 + 0.04)), rust, Enum.Material.CorrodedMetal, hinge)
	-- what's inside: teeth along both front edges, a tongue, a glint deep in the dark
	local hidden = {}
	local function mouth(p)
		p.Transparency = 1
		table.insert(hidden, p)
		return p
	end
	for i = -4, 4 do
		local x = i * 0.42
		mouth(piece("Tooth", Vector3.new(0.18, 0.45, 0.18), base * CFrame.new(x, H + 0.05, -DP / 2 + 0.32) * CFrame.Angles(0, 0, rng:NextNumber(-0.2, 0.2)), Color3.fromRGB(214, 204, 176), Enum.Material.SmoothPlastic, root))
		mouth(piece("Tooth", Vector3.new(0.18, 0.4, 0.18), base * CFrame.new(x + 0.2, H + 0.05, -LD / 2 + 0.34) * CFrame.Angles(0, 0, rng:NextNumber(-0.2, 0.2)), Color3.fromRGB(214, 204, 176), Enum.Material.SmoothPlastic, hinge))
	end
	mouth(piece("Tongue", Vector3.new(1.0, 0.25, DP * 0.9), base * CFrame.new(0.2, H - 0.2, -0.3) * CFrame.Angles(0.25, 0.15, 0), Color3.fromRGB(120, 30, 34), Enum.Material.SmoothPlastic, root))
	for _, x in ipairs({ -0.5, 0.5 }) do
		mouth(piece("Eye", Vector3.new(0.22, 0.22, 0.22), base * CFrame.new(x, H - 0.55, 0.4), Color3.fromRGB(255, 200, 90), Enum.Material.Neon, root))
	end

	local hum = Instance.new("Humanoid")
	hum.RequiresNeck = false -- no head on a chest
	hum.BreakJointsOnDeath = false
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.MaxHealth, hum.Health = CFG.HP, CFG.HP
	hum.Parent = model
	model:SetAttribute("Radius", 2)
	model.Parent = workspace

	local promptAt = Instance.new("Attachment")
	promptAt.Position = Vector3.new(0, 0, -0.5)
	promptAt.Parent = root
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText, pp.ObjectText = "Open", "Chest" -- (just like the real one)
	pp.HoldDuration, pp.MaxActivationDistance, pp.RequiresLineOfSight = 0.5, 7, false
	pp.Parent = promptAt

	---------------------------------------------------------------------------
	-- state + small helpers
	---------------------------------------------------------------------------
	local M = { awake = false, alive = true, poise = nil, staggerUntil = 0, gen = 0 }
	local actor = { root = root } -- (for hit-stop: there's no tween to pause, and its root stays anchored)

	local function setLid(angle, t, style)
		TweenService:Create(lidWeld, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { C0 = CFrame.new(0, H / 2, DP / 2) * CFrame.Angles(angle, 0, 0) }):Play()
	end
	local function showMouth(on)
		for _, p in ipairs(hidden) do
			p.Transparency = on and 0 or 1
		end
	end
	local function free()
		return M.alive and M.awake and now() >= M.staggerUntil
	end
	local function hold(d) -- false if it was staggered, killed or put to sleep meanwhile
		local g, t0 = M.gen, now()
		while now() - t0 < d do
			if not free() or M.gen ~= g then
				return false
			end
			task.wait()
		end
		return true
	end
	local function ground(p) -- keep it on the walk
		return Vector3.new(math.clamp(p.X, where.Min.X, where.Max.X), root.Position.Y, math.clamp(p.Z, where.Min.Z, where.Max.Z))
	end
	local function face(pos)
		local d = flat(pos - root.Position)
		if d.Magnitude > 0.1 then
			root.CFrame = CFrame.lookAt(root.Position, root.Position + d)
		end
	end
	local function target()
		local best, bestD
		for _, pl in ipairs(Players:GetPlayers()) do
			local char, _, hrp = aliveChar(pl)
			if char then
				local d = (hrp.Position - root.Position).Magnitude
				if d < CFG.Aggro and (not bestD or d < bestD) then
					best, bestD = hrp, d
				end
			end
		end
		return best, bestD
	end
	-- an arcing hop from where it is to `to` (clamped onto the walk)
	local function hop(to, dur, height)
		local a, b = root.Position, ground(to)
		local rot = root.CFrame.Rotation
		local t0 = now()
		while true do
			local k = math.min((now() - t0) / dur, 1)
			root.CFrame = CFrame.new(a:Lerp(b, k) + Vector3.new(0, math.sin(k * math.pi) * height, 0)) * rot
			if k >= 1 or not M.alive then
				break
			end
			RunService.Heartbeat:Wait()
		end
		dustCloud(Vector3.new(root.Position.X, root.Position.Y - H / 2 + 0.3, root.Position.Z), 0.8, 4)
	end

	---------------------------------------------------------------------------
	-- its moves
	---------------------------------------------------------------------------
	-- CHOMP: gapes wide (slowly - the tell), then lunges a few studs and snaps shut
	local function chomp(tr)
		face(tr.Position)
		setLid(1.7, 0.45)
		playSound(root, SOUNDS.Unsheath, 0.5, 0.5)
		if not hold(0.5) then
			return
		end
		local fwd = flat(root.CFrame.LookVector)
		setLid(0.05, 0.08, Enum.EasingStyle.Linear)
		playSound(root, SOUNDS.Impact, 0.9, 0.7)
		hop(root.Position + fwd * 3, 0.14, 0.4)
		for _, pl in ipairs(playersInSector(root.CFrame, 4.5, 55, 5)) do
			damagePlayer(pl, CFG.ChompDamage, root.Position, "Large")
		end
		setLid(0.5, 0.3) -- left hanging open: the punish window
		hold(0.8)
	end

	-- POUNCE: from range, crouches (rattling), leaps high onto you and slams down
	local function pounce(tr)
		face(tr.Position)
		setLid(0.3, 0.2)
		playSound(root, SOUNDS.Unsheath, 0.45, 0.35)
		root.CFrame *= CFrame.new(0, -0.25, 0) -- squats
		if not hold(0.55) then
			return
		end
		root.CFrame *= CFrame.new(0, 0.25, 0)
		local land = tr.Position
		setLid(1.2, 0.15)
		hop(land, 0.5, 6)
		setLid(0.05, 0.06, Enum.EasingStyle.Linear)
		playSound(root, SOUNDS.Impact, 1, 0.5)
		core.FxRemote:FireAllClients("Shake", root.Position, 0.5)
		for _, pl in ipairs(playersInRadius(root.Position, 4.5, 6)) do
			damagePlayer(pl, CFG.PounceDamage, root.Position, "Knockdown")
		end
		hold(0.9)
	end

	---------------------------------------------------------------------------
	-- waking, sleeping, the fight
	---------------------------------------------------------------------------
	local function sleep()
		-- lost you: back to its corner, shut, healed, pretending again
		M.awake = false
		M.gen += 1
		model.Parent = workspace
		hop(spot.Position, 0.6, 1.5)
		root.CFrame = spot * CFrame.new(0, H / 2, 0)
		setLid(0, 0.3)
		showMouth(false)
		hum.Health = hum.MaxHealth
		M.poise = nil
		pp.Enabled = true
	end

	local function brain()
		local g = M.gen
		local lostSince
		while M.alive and M.awake and M.gen == g do
			if now() < M.staggerUntil then
				task.wait(0.1)
				continue
			end
			local tr, d = target()
			if not tr then
				lostSince = lostSince or now()
				if now() - lostSince > 6 then
					sleep()
					return
				end
				task.wait(0.2)
				continue
			end
			lostSince = nil
			if d <= 5 then
				chomp(tr)
			elseif d <= 13 and math.random() < 0.45 then
				pounce(tr)
			else
				-- hops after you, a few studs at a time, snapping
				face(tr.Position)
				setLid(0.4, 0.1)
				local step = flat(tr.Position - root.Position)
				hop(root.Position + step.Unit * math.min(step.Magnitude - 3, CFG.HopLength), 0.32, 1.6)
				setLid(0, 0.1)
				playSound(root, SOUNDS.Impact, 0.4, 1.3)
				hold(0.25)
			end
			task.wait()
		end
	end

	-- the opener's body pose (the client's animator reads these, as for every rig)
	local function playerPose(char, name, blend)
		char:SetAttribute("BP", name)
		char:SetAttribute("BPT", blend)
		char:SetAttribute("BPN", (char:GetAttribute("BPN") or 0) + 1)
	end

	-- THE GRAB: you crouch and lift the lid... it creaks open a crack, a glint... then it
	-- gapes, yanks you in head-first (legs kicking out of the top), chews you a few times
	-- and spits you out across the walk. Your character is pinned (anchored) throughout.
	local function grab(player)
		local char, phum, hrp = aliveChar(player)
		local st = core.states[player]
		if not (char and st) or (hrp.Position - root.Position).Magnitude > 8 then
			return
		end
		local G = CFG.Grab
		local total = 0.8 + 0.35 + 0.3 + G.Chews * G.ChewTime + 0.4
		local t = now()
		core.setAction(st, t, total, total, total) -- no rolling, swinging or drinking your way out
		st.healing = false
		core.cancelSwing(st)
		core.FxRemote:FireClient(player, "Grabbed", total)
		M.grabbing = true
		local floorY = spot.Position.Y
		local front = flat(root.CFrame.LookVector).Unit
		local stand = Vector3.new(root.Position.X, floorY + 3, root.Position.Z) + front * 3.3
		local lookAt = Vector3.new(root.Position.X, floorY + 3, root.Position.Z)
		hrp.Anchored = true
		hrp.CFrame = CFrame.lookAt(stand, lookAt)
		local function held()
			local c, h = aliveChar(player)
			return c == char and h == phum and M.alive
		end
		local function release()
			M.grabbing = false
			if hrp.Parent then
				hrp.Anchored = false
				pcall(function()
					hrp:SetNetworkOwner(player)
				end)
			end
		end

		-- 1) you crouch and lift the lid a crack. something glints inside
		playerPose(char, "Crouch", 0.3)
		task.wait(0.35)
		setLid(0.35, 0.45, Enum.EasingStyle.Sine)
		playSound(root, SOUNDS.Unsheath, 0.5, 0.35) -- the creak
		for _, p in ipairs(hidden) do
			if p.Name == "Eye" then
				p.Transparency = 0
			end
		end
		task.wait(0.45)
		if not held() then
			return release()
		end

		-- 2) it gapes: teeth, tongue, the lid flung back
		showMouth(true)
		setLid(1.9, 0.1, Enum.EasingStyle.Back)
		playSound(root, SOUNDS.Unsheath, 1, 0.4)
		playSound(root, SOUNDS.Impact, 1, 0.45)
		burst(root.Position + Vector3.new(0, 1.2, 0), Color3.fromRGB(70, 20, 22), 18, 0.35, 12)
		core.FxRemote:FireClient(player, "Message", "It's a mimic!")
		playerPose(char, "Flinch", 0.08)
		task.wait(0.35)
		if not held() then
			return release()
		end

		-- 3) yanked in head-first, legs out of the top; the lid clamps down on you
		local mouth = root.Position + Vector3.new(0, H / 2 + 1.3, 0) + front * 0.2
		local dive = CFrame.new(mouth) * CFrame.lookAt(stand, lookAt).Rotation * CFrame.Angles(math.rad(-160), 0, 0)
		local from = hrp.CFrame
		playerPose(char, "Stagger", 0.1)
		for i = 1, 8 do
			hrp.CFrame = from:Lerp(dive, i / 8)
			task.wait(1 / 30)
		end
		setLid(0.75, 0.08, Enum.EasingStyle.Linear)
		playSound(root, SOUNDS.Impact, 1, 0.6)
		core.FxRemote:FireAllClients("Shake", root.Position, 0.7)
		task.wait(0.3 - 8 / 30 + 0.1)

		-- 4) chewed: the box heaves, the lid works up and down, you kick
		local rest = root.CFrame
		for i = 1, G.Chews do
			if not held() then
				break
			end
			setLid(1.15, G.ChewTime * 0.4)
			root.CFrame = rest * CFrame.new(0, 0.35, 0) * CFrame.Angles(math.rad(math.random(-6, 6)), 0, math.rad(math.random(-6, 6)))
			playerPose(char, i % 2 == 0 and "Stagger" or "Flinch", 0.1)
			task.wait(G.ChewTime * 0.45)
			setLid(0.7, G.ChewTime * 0.12, Enum.EasingStyle.Linear)
			root.CFrame = rest
			playSound(root, SOUNDS.Impact, 0.9, 0.5 + i * 0.08)
			burst(mouth, Color3.fromRGB(46, 66, 34), 14, 0.3, 10) -- (dark green: no blood)
			core.FxRemote:FireAllClients("Shake", root.Position, 0.45)
			damagePlayer(player, G.ChewDamage, root.Position, "Small")
			-- (a hit's stun would free your inputs early: pin them again)
			local left = (G.Chews - i + 0.55) * G.ChewTime + 0.4
			core.setAction(st, now(), left, left, left)
			core.FxRemote:FireClient(player, "Grabbed", left)
			task.wait(G.ChewTime * 0.55)
		end
		root.CFrame = rest

		-- 5) spat out across the walk (or, if it finished you, what's left of you)
		setLid(1.9, 0.1, Enum.EasingStyle.Back)
		playSound(root, SOUNDS.Lunge, 1, 0.6)
		if hrp.Parent then
			hrp.CFrame = CFrame.lookAt(stand + front * 0.5, lookAt)
		end
		release()
		if held() then
			damagePlayer(player, G.SpitDamage, root.Position, "Knockdown")
		end
		task.wait(0.3)
		setLid(0.4, 0.3)
	end

	local function wake(player)
		if M.awake or not M.alive then
			return
		end
		M.awake = true
		M.gen += 1
		pp.Enabled = false
		model.Parent = core.EnemiesFolder -- now blades and lock-on find it
		local ok, err = pcall(grab, player)
		if not ok then
			warn("[DGUS] Mimic grab error: " .. tostring(err))
			local _, _, hrp = aliveChar(player)
			if hrp then
				hrp.Anchored = false -- never leave anyone pinned
			end
			M.grabbing = false
			showMouth(true)
			setLid(1.2, 0.2)
		end
		task.wait(0.8)
		task.spawn(brain)
	end
	pp.Triggered:Connect(wake)

	-- hits: poise, and when it breaks it tips over gasping, lid flopped open
	core.registerTarget(function(m)
		if m ~= model then
			return nil
		end
		return {
			owner = M,
			actor = actor,
			maxPoise = CFG.Poise,
			freeze = false,
			onBreak = function()
				if M.grabbing then
					return -- (mid-meal: it doesn't let go for anyone)
				end
				M.staggerUntil = now() + CFG.Stagger
				setLid(2.2, 0.2)
				local cf = root.CFrame
				root.CFrame = cf * CFrame.Angles(0, 0, 0.35) + Vector3.new(0, 0.3, 0)
				playSound(root, SOUNDS.Impact, 0.7, 0.9)
				task.delay(CFG.Stagger, function()
					if M.alive and root.Parent then
						root.CFrame = CFrame.new(root.Position.X, cf.Position.Y, root.Position.Z) * cf.Rotation
						setLid(0, 0.2)
					end
				end)
			end,
		}
	end)

	hum.Died:Connect(function()
		M.alive = false
		M.awake = false
		model.Parent = workspace -- (out of the enemies: no locking onto a corpse)
		setLid(2.4, 0.4, Enum.EasingStyle.Bounce)
		playSound(root, SOUNDS.Impact, 0.8, 0.4)
		burst(root.Position + Vector3.new(0, 1, 0), Color3.fromRGB(70, 66, 60), 24, 0.5, 8)
		task.delay(1.5, function()
			for _, p in ipairs(hidden) do
				TweenService:Create(p, TweenInfo.new(1.5), { Transparency = 1 }):Play()
			end
		end)
	end)
end

return Mimic
]]></ProtectedString>
					<string name="ScriptGuid">{3053B39D-D605-40CA-ACA0-F2F76DCB8BB8}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Mimic</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">156a6427d25a4fe0a9ae6015d5f5d456</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000016">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- MapDetail: wall dressing, floor work, arches and props for the Don'tGiveUpSkeleton.
--
-- Walls are dressed through "faces": a CFrame sitting on the wall surface at
-- floor level, whose LookVector points out into the room. In face space,
-- X runs along the wall, Y is up, and "out" is distance from the wall.
--
-- Small decoration is non-colliding, not queryable (the camera and hit checks
-- ignore it) and casts no shadow, to keep things cheap and snag-free.
local CollectionService = game:GetService("CollectionService")

local Detail = {}

local MAT = Enum.Material
local C = {
	Stone = Color3.fromRGB(70, 67, 61),
	StoneLight = Color3.fromRGB(98, 94, 86),
	Mortar = Color3.fromRGB(30, 29, 27),
	Grime = Color3.fromRGB(22, 21, 19),
	Moss = Color3.fromRGB(58, 68, 40),
	MossDark = Color3.fromRGB(36, 46, 28),
	Iron = Color3.fromRGB(42, 39, 36),
	Rust = Color3.fromRGB(88, 56, 36),
	Wood = Color3.fromRGB(58, 43, 31),
	WoodDark = Color3.fromRGB(36, 28, 21),
	Bone = Color3.fromRGB(186, 178, 154),
	BoneDark = Color3.fromRGB(130, 122, 104),
	Cloth = Color3.fromRGB(84, 22, 20),
	ClothDark = Color3.fromRGB(44, 16, 14),
	Void = Color3.fromRGB(9, 9, 11),
	Wax = Color3.fromRGB(214, 204, 176),
	Rock = Color3.fromRGB(56, 58, 54),
	Ossuary = Color3.fromRGB(104, 98, 86),
}
Detail.Colors = C

local rng = Random.new(4242)
local parent: Instance
local avoid = {}
-- Doorways cut through already-dressed walls: { min = Vector3, max = Vector3 }.
-- A detail part whose centre falls inside a cutout's X/Y range is trimmed along
-- Z to stop at the opening (or dropped if it lies wholly inside). The random
-- stream is untouched, so everything else dresses exactly as before.
local cutouts = {}

function Detail.init(folder)
	parent = folder
end

-- world points (torches, levers...) that wall features must not cover
function Detail.setAvoid(points)
	avoid = points
end

function Detail.setCutouts(list)
	cutouts = list or {}
end

-- swap the random stream (new areas get their own, so older areas never shift)
function Detail.useRng(r)
	local old = rng
	rng = r
	return old
end

---------------------------------------------------------------------------
-- primitives
---------------------------------------------------------------------------
local d
local function trimmed(size, cf, mat, color, o)
	local pos = cf.Position
	for _, c in ipairs(cutouts) do
		-- axis = the direction the wall runs (the part is trimmed along it); "Z" by default
		local ax = c.axis or "Z"
		local u = ax == "Z" and "X" or "Z" -- the other horizontal axis
		local pu, pa = pos[u], pos[ax]
		if pu >= c.min[u] and pu <= c.max[u] and pos.Y >= c.min.Y and pos.Y <= c.max.Y then
			local axes = { cf.RightVector, cf.UpVector, -cf.LookVector }
			local dims = { size.X, size.Y, size.Z }
			local best, bi = 0, 1
			for i = 1, 3 do
				if math.abs(axes[i][ax]) > best then
					best, bi = math.abs(axes[i][ax]), i
				end
			end
			local half = (best > 0.97) and dims[bi] / 2 or 0
			local lo, hi = pa - half, pa + half
			if hi > c.min[ax] and lo < c.max[ax] then
				local first
				for _, seg in ipairs({ { lo, c.min[ax] }, { c.max[ax], hi } }) do
					if seg[2] - seg[1] > 0.3 then
						local nd = table.clone(dims)
						nd[bi] = seg[2] - seg[1]
						local mid = (seg[1] + seg[2]) / 2
						local shift = ax == "Z" and Vector3.new(0, 0, mid - pa) or Vector3.new(mid - pa, 0, 0)
						local p = d(Vector3.new(nd[1], nd[2], nd[3]), cf + shift, mat, color, o)
						first = first or p
					end
				end
				return true, first
			end
		end
	end
	return false, nil
end

d = function(size, cf, mat, color, o)
	o = o or {}
	if #cutouts > 0 then
		local cut, piece = trimmed(size, cf, mat, color, o)
		if cut then
			return piece
		end
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if o.shape then
		p.Shape = o.shape
	end
	p.Size = size
	p.CFrame = cf
	p.Material = mat
	p.Color = color
	local solid = o.collide == true
	p.CanCollide = solid
	p.CanQuery = solid or o.query == true
	p.CanTouch = false
	p.CastShadow = solid or o.shadow == true
	if o.transparency then
		p.Transparency = o.transparency
	end
	if o.reflectance then
		p.Reflectance = o.reflectance
	end
	p.Name = o.name or "Detail"
	p.Parent = o.parent or parent
	return p
end
Detail.part = d

local function vary(c, amt)
	local k = rng:NextNumber(-amt, amt)
	if k < 0 then
		return c:Lerp(Color3.new(0, 0, 0), -k)
	end
	return c:Lerp(Color3.new(1, 1, 1), k)
end
Detail.vary = vary

local function at(cf, x, y, out)
	return cf * CFrame.new(x, y, -out)
end

function Detail.face(px, pz, nx, nz, y)
	y = y or 0
	return CFrame.lookAt(Vector3.new(px, y, pz), Vector3.new(px + nx, y, pz + nz))
end

local function blocked(cf, x, halfW)
	for _, p in ipairs(avoid) do
		local l = cf:PointToObjectSpace(p)
		if math.abs(l.Z) < 4 and math.abs(l.X - x) < halfW + 1.5 then
			return true
		end
	end
	return false
end

---------------------------------------------------------------------------
-- wall features (all in face space)
---------------------------------------------------------------------------
local function plinth(cf, w, h, depth, color, mat)
	d(Vector3.new(w, h, depth), at(cf, 0, h / 2, depth / 2), mat or MAT.Cobblestone, color, { collide = true, name = "Plinth" })
	-- worn top edge
	d(Vector3.new(w, 0.18, depth + 0.12), at(cf, 0, h + 0.05, depth / 2), MAT.Slate, vary(C.StoneLight, 0.05), { name = "PlinthCap" })
end

local function band(cf, w, y, h, depth, color, mat)
	d(Vector3.new(w, h, depth), at(cf, 0, y, depth / 2), mat or MAT.Slate, color, { shadow = true, name = "Course" })
end

local function stones(cf, w, h, y0, density, color, mat)
	local rowH = 1.6
	local y = y0 + rowH / 2
	local row = 0
	while y < h - 0.6 do
		local x = -w / 2 + 1.4 + (row % 2) * 1.5
		while x < w / 2 - 1.4 do
			local bw = rng:NextNumber(2.3, 3.4)
			local r = rng:NextNumber()
			if r < density then
				d(Vector3.new(bw - 0.16, rowH - 0.16, rng:NextNumber(0.12, 0.3)), at(cf, x, y, 0.06), mat or MAT.Cobblestone, vary(color, 0.18), { name = "Stone" })
			elseif r < density * 1.3 then
				d(Vector3.new(bw - 0.35, rowH - 0.35, 0.05), at(cf, x, y, 0.025), MAT.Slate, C.Void, { name = "MissingStone" })
			end
			x += bw
		end
		y += rowH
		row += 1
	end
end

local function cracks(cf, w, h, n)
	for _ = 1, n do
		local x = rng:NextNumber(-w / 2 + 1, w / 2 - 1)
		local y = rng:NextNumber(h * 0.35, h * 0.9)
		local ang = rng:NextNumber(-2.2, -0.9) -- running downward
		for _ = 1, rng:NextInteger(3, 6) do
			local len = rng:NextNumber(0.7, 1.6)
			local nx, ny = x + math.cos(ang) * len, y + math.sin(ang) * len
			if ny < 0.5 or math.abs(nx) > w / 2 - 0.3 then
				break
			end
			d(Vector3.new(len + 0.08, 0.12, 0.06), at(cf, (x + nx) / 2, (y + ny) / 2, 0.03) * CFrame.Angles(0, 0, ang), MAT.Slate, C.Mortar, { name = "Crack" })
			x, y = nx, ny
			ang += rng:NextNumber(-0.7, 0.7)
		end
	end
end

local function streaks(cf, w, h, n, wet)
	for _ = 1, n do
		local len = rng:NextNumber(h * 0.2, h * 0.6)
		local top = h - rng:NextNumber(0, h * 0.25)
		d(Vector3.new(rng:NextNumber(0.35, 1.2), len, 0.04), at(cf, rng:NextNumber(-w / 2 + 0.8, w / 2 - 0.8), top - len / 2, 0.025),
			MAT.SmoothPlastic, C.Grime, { transparency = 0.55, reflectance = wet and 0.25 or 0, name = "Streak" })
	end
end

local function moss(cf, w, n, maxH)
	for _ = 1, n do
		local s = rng:NextNumber(0.8, 2.6)
		d(Vector3.new(s, rng:NextNumber(0.4, 1.4), 0.18), at(cf, rng:NextNumber(-w / 2 + 0.5, w / 2 - 0.5), rng:NextNumber(0.3, maxH), 0.08),
			MAT.Grass, vary(C.Moss, 0.15), { name = "Moss" })
	end
end

local function ivy(cf, x, height)
	local y = 0.3
	while y < height do
		x += rng:NextNumber(-0.7, 0.7)
		for _ = 1, 2 do
			local s = rng:NextNumber(0.5, 1.3)
			d(Vector3.new(s, s, s * 0.5), at(cf, x + rng:NextNumber(-0.6, 0.6), y + rng:NextNumber(-0.3, 0.3), 0.2) * CFrame.Angles(0, 0, rng:NextNumber(0, 1.5)),
				MAT.Grass, vary(C.MossDark, 0.2), { name = "Ivy" })
		end
		y += rng:NextNumber(0.6, 1.1)
	end
end

local function shackles(cf, x, y)
	d(Vector3.new(1.6, 0.5, 0.14), at(cf, x, y, 0.07), MAT.Metal, C.Iron, { name = "ShacklePlate" })
	for _, sx in ipairs({ -0.6, 0.6 }) do
		for i = 0, 2 do
			d(Vector3.new(0.14, 0.4, 0.14), at(cf, x + sx, y - 0.45 - i * 0.42, 0.18) * CFrame.Angles(0, (i % 2) * math.pi / 2, 0), MAT.Metal, C.Iron, { name = "Chain" })
		end
		d(Vector3.new(0.18, 0.62, 0.62), at(cf, x + sx, y - 1.75, 0.22) * CFrame.Angles(0, 0, math.pi / 2), MAT.Metal, C.Rust, { shape = Enum.PartType.Cylinder, name = "Cuff" })
	end
end

-- An arch of wedge-ish blocks in the face plane. springY = where the curve starts.
local function archRib(cf, cx, springY, halfW, rise, thick, depth, out, segs, mat, color, collide)
	for i = 0, segs - 1 do
		local a0, a1 = math.pi * i / segs, math.pi * (i + 1) / segs
		local x0, y0 = cx + halfW * math.cos(a0), springY + rise * math.sin(a0)
		local x1, y1 = cx + halfW * math.cos(a1), springY + rise * math.sin(a1)
		local len = math.sqrt((x1 - x0) ^ 2 + (y1 - y0) ^ 2) + 0.12
		d(Vector3.new(len, thick, depth), at(cf, (x0 + x1) / 2, (y0 + y1) / 2, out) * CFrame.Angles(0, 0, math.atan2(y1 - y0, x1 - x0)),
			mat or MAT.Cobblestone, vary(color or C.Stone, 0.06), { collide = collide, shadow = true, name = "Arch" })
	end
	-- keystone
	d(Vector3.new(0.9, thick + 0.5, depth + 0.2), at(cf, cx, springY + rise + 0.1, out), mat or MAT.Cobblestone, vary(color or C.StoneLight, 0.04), { shadow = true, name = "Keystone" })
end
Detail.archRib = archRib

local function window(cf, x, y, w, h, lit)
	-- y = bottom of the opening
	d(Vector3.new(w, h, 0.08), at(cf, x, y + h / 2, 0.04), lit and MAT.Neon or MAT.Slate, lit and Color3.fromRGB(34, 40, 54) or C.Void, { name = "WindowVoid" })
	d(Vector3.new(w, w / 2, 0.08), at(cf, x, y + h + w / 4 - 0.1, 0.04), lit and MAT.Neon or MAT.Slate, lit and Color3.fromRGB(34, 40, 54) or C.Void, { name = "WindowVoid" })
	archRib(cf, x, y + h, w / 2 + 0.35, w / 2 + 0.35, 0.7, 0.7, 0.35, 7, MAT.Cobblestone, C.StoneLight, false)
	for _, sx in ipairs({ -1, 1 }) do
		d(Vector3.new(0.7, h, 0.7), at(cf, x + sx * (w / 2 + 0.35), y + h / 2, 0.35), MAT.Cobblestone, vary(C.StoneLight, 0.05), { shadow = true, name = "Jamb" })
	end
	d(Vector3.new(w + 1.4, 0.45, 1.0), at(cf, x, y - 0.2, 0.5), MAT.Slate, vary(C.StoneLight, 0.05), { shadow = true, name = "Sill" })
	for i = 1, 3 do
		local bx = x - w / 2 + w * i / 4
		d(Vector3.new(h + w / 2, 0.2, 0.2), at(cf, bx, y + (h + w / 2) / 2, 0.15) * CFrame.Angles(0, 0, math.pi / 2), MAT.Metal, C.Iron, { shape = Enum.PartType.Cylinder, name = "WindowBar" })
	end
	d(Vector3.new(w, 0.18, 0.18), at(cf, x, y + h * 0.55, 0.15), MAT.Metal, C.Iron, { name = "WindowBar" })
end

Detail.window = window

local function banner(cf, x, top, len, w, color)
	d(Vector3.new(w + 1.2, 0.3, 0.3), at(cf, x, top, 0.7) * CFrame.Angles(0, 0, math.pi / 2) * CFrame.Angles(0, 0, -math.pi / 2), MAT.Wood, C.WoodDark, { name = "BannerPole" })
	for _, sx in ipairs({ -1, 1 }) do
		d(Vector3.new(0.2, 0.2, 0.7), at(cf, x + sx * (w / 2 + 0.4), top, 0.35), MAT.Metal, C.Iron, { name = "BannerBracket" })
	end
	local body = len * 0.72
	local tilt = CFrame.Angles(rng:NextNumber(-0.04, 0.04), 0, rng:NextNumber(-0.03, 0.03))
	d(Vector3.new(w, body, 0.1), at(cf, x, top - body / 2 - 0.15, 0.7) * tilt, MAT.Fabric, vary(color, 0.08), { name = "Banner" })
	-- ragged tails of uneven length
	local strips = 4
	for i = 1, strips do
		local sw = w / strips
		local sl = len * rng:NextNumber(0.12, 0.3)
		d(Vector3.new(sw - 0.06, sl, 0.1), at(cf, x - w / 2 + sw * (i - 0.5), top - body - 0.15 - sl / 2, 0.7) * tilt, MAT.Fabric, vary(color, 0.12), { name = "BannerTail" })
	end
	-- faded emblem: a bone-white diamond with a dark eye
	d(Vector3.new(w * 0.4, w * 0.4, 0.04), at(cf, x, top - body * 0.42, 0.77) * tilt * CFrame.Angles(0, 0, math.pi / 4), MAT.Fabric, C.BoneDark, { name = "Emblem" })
	d(Vector3.new(w * 0.14, w * 0.14, 0.05), at(cf, x, top - body * 0.42, 0.79) * tilt, MAT.Fabric, C.ClothDark, { name = "Emblem" })
end

Detail.banner = banner

local function buttress(cf, x, h)
	d(Vector3.new(3, h * 0.62, 2.6), at(cf, x, h * 0.31, 1.3), MAT.Cobblestone, vary(C.Stone, 0.08), { collide = true, name = "Buttress" })
	d(Vector3.new(3.3, 0.5, 2.9), at(cf, x, h * 0.62 + 0.25, 1.45), MAT.Slate, vary(C.StoneLight, 0.05), { shadow = true, name = "ButtressLedge" })
	d(Vector3.new(2.4, h * 0.28, 1.5), at(cf, x, h * 0.62 + 0.5 + h * 0.14, 0.75), MAT.Cobblestone, vary(C.Stone, 0.08), { shadow = true, name = "Buttress" })
	d(Vector3.new(2.7, 0.45, 1.8), at(cf, x, h * 0.9 + 0.75, 0.9), MAT.Slate, vary(C.StoneLight, 0.05), { shadow = true, name = "ButtressLedge" })
end

local function pilaster(cf, x, h, w)
	d(Vector3.new(w, h - 3, 1.0), at(cf, x, h / 2, 0.5), MAT.Limestone, vary(C.Ossuary, 0.05), { collide = true, name = "Pilaster" })
	d(Vector3.new(w + 0.9, 1.6, 1.6), at(cf, x, 0.8, 0.8), MAT.Limestone, vary(C.Ossuary, 0.04), { collide = true, name = "PilasterBase" })
	d(Vector3.new(w + 0.9, 1.1, 1.5), at(cf, x, h - 1.6, 0.75), MAT.Limestone, vary(C.Ossuary, 0.04), { shadow = true, name = "PilasterCap" })
	for _, gx in ipairs({ -w * 0.22, w * 0.22 }) do
		d(Vector3.new(0.16, h - 5, 0.06), at(cf, x + gx, h / 2, 1.02), MAT.Slate, C.Mortar, { name = "Fluting" })
	end
end

local function niche(cf, x, y, w, h)
	-- y = bottom of the niche
	d(Vector3.new(w, h, 0.06), at(cf, x, y + h / 2, 0.03), MAT.Slate, C.Void, { name = "NicheVoid" })
	d(Vector3.new(w + 0.4, 0.3, 0.7), at(cf, x, y - 0.15, 0.35), MAT.Limestone, vary(C.Ossuary, 0.05), { name = "NicheLedge" })
	local roll = rng:NextNumber()
	if roll < 0.55 then
		d(Vector3.new(0.85, 0.85, 0.85), at(cf, x + rng:NextNumber(-0.3, 0.3), y + 0.43, 0.5), MAT.SmoothPlastic, vary(C.Bone, 0.08), { shape = Enum.PartType.Ball, name = "Skull" })
	elseif roll < 0.8 then
		for i = 0, 1 do
			d(Vector3.new(0.75, 0.75, 0.75), at(cf, x - 0.45 + i * 0.9, y + 0.38, 0.45), MAT.SmoothPlastic, vary(C.Bone, 0.08), { shape = Enum.PartType.Ball, name = "Skull" })
		end
	elseif roll < 0.95 then
		for i = 0, 2 do
			d(Vector3.new(w - 0.3, 0.16, 0.16), at(cf, x, y + 0.12 + i * 0.17, 0.35 + rng:NextNumber(-0.05, 0.05)) * CFrame.Angles(0, rng:NextNumber(-0.15, 0.15), 0), MAT.SmoothPlastic, vary(C.Bone, 0.1), { name = "Bone" })
		end
	end
end

local function rockOutcrops(cf, w, h, n)
	for _ = 1, n do
		local s = rng:NextNumber(1.2, 3)
		d(Vector3.new(s, s * rng:NextNumber(0.6, 1.3), s * rng:NextNumber(0.5, 0.9)),
			at(cf, rng:NextNumber(-w / 2 + 1, w / 2 - 1), rng:NextNumber(0.5, h - 0.8), rng:NextNumber(0.05, 0.35)) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(-0.5, 0.5), rng:NextNumber(-0.8, 0.8)),
			MAT.Rock, vary(C.Rock, 0.12), { name = "Outcrop" })
	end
end

---------------------------------------------------------------------------
-- wall styles
---------------------------------------------------------------------------
local STYLES = {}

STYLES.cell = function(cf, w, h)
	plinth(cf, w, 1.0, 0.45, vary(C.Stone, 0.1))
	stones(cf, w, h, 1.2, 0.13, C.Stone)
	cracks(cf, w, h, rng:NextInteger(1, 2))
	streaks(cf, w, h, rng:NextInteger(1, 3), false)
	moss(cf, w, rng:NextInteger(1, 4), 1.6)
	if w >= 8 and rng:NextNumber() < 0.45 and not blocked(cf, 0, 1.5) then
		shackles(cf, rng:NextNumber(-w / 4, w / 4), rng:NextNumber(6, 7.5))
	end
end

STYLES.corridor = function(cf, w, h)
	plinth(cf, w, 1.2, 0.6, vary(C.Stone, 0.08))
	stones(cf, w, h, 1.4, 0.16, C.Stone)
	cracks(cf, w, h, 2)
	streaks(cf, w, h, 3, false)
	moss(cf, w, 5, 2)
end

STYLES.tunnel = function(cf, w, h)
	rockOutcrops(cf, w, h, math.floor(w / 2.5))
	streaks(cf, w, h, math.floor(w / 5), true)
	moss(cf, w, math.floor(w / 3), 3)
end

STYLES.yard = function(cf, w, h)
	plinth(cf, w, 1.6, 0.8, vary(C.Stone, 0.06))
	stones(cf, w, h, 1.8, 0.08, C.Stone, MAT.Brick)
	band(cf, w, 13, 0.6, 0.45, vary(C.StoneLight, 0.04))
	band(cf, w, h - 1.2, 1.2, 0.9, vary(C.StoneLight, 0.04))
	-- buttresses every ~12 studs, with a window or banner in each bay
	local bays = math.max(1, math.floor(w / 12))
	local bayW = w / bays
	for i = 0, bays do
		local bx = -w / 2 + i * bayW
		if i > 0 and i < bays and not blocked(cf, bx, 1.5) then
			buttress(cf, bx, h)
		end
		if i < bays then
			local cx = bx + bayW / 2
			local roll = rng:NextNumber()
			if roll < 0.55 and not blocked(cf, cx, 1.8) then
				window(cf, cx, 16.5, 3, 5.5, rng:NextNumber() < 0.5)
			elseif roll < 0.85 and not blocked(cf, cx, 2) then
				banner(cf, cx, 25, 10, 3.2, rng:NextNumber() < 0.5 and C.Cloth or C.ClothDark)
			end
			if rng:NextNumber() < 0.5 then
				ivy(cf, cx + rng:NextNumber(-bayW / 3, bayW / 3), rng:NextNumber(6, 16))
			end
		end
	end
	cracks(cf, w, h, math.floor(w / 20))
	streaks(cf, w, h, math.floor(w / 8), false)
	moss(cf, w, math.floor(w / 6), 2.5)
end

-- the Castellan's keep: dressed brick, a skirting plinth and a cornice band; kept, not rotting
STYLES.keep = function(cf, w, h)
	plinth(cf, w, 1.0, 0.5, vary(C.Stone, 0.06))
	stones(cf, w, h, 1.4, 0.1, C.Stone, MAT.Brick)
	band(cf, w, h - 0.8, 0.8, 0.6, vary(C.StoneLight, 0.04))
	cracks(cf, w, h, math.max(1, math.floor(w / 16)))
	streaks(cf, w, h, math.floor(w / 10), false)
end

STYLES.ossuary = function(cf, w, h)
	plinth(cf, w, 1.4, 0.8, vary(C.Ossuary, 0.05), MAT.Limestone)
	band(cf, w, h - 2, 1.4, 1.1, vary(C.Ossuary, 0.04), MAT.Limestone)
	band(cf, w, 15.5, 0.6, 0.6, vary(C.Ossuary, 0.04), MAT.Limestone)
	local bays = math.max(1, math.floor(w / 11))
	local bayW = w / bays
	for i = 0, bays do
		local bx = -w / 2 + i * bayW
		if not blocked(cf, bx, 1.5) then
			pilaster(cf, bx, h, 2.2)
		end
		if i < bays then
			local cx = bx + bayW / 2
			-- three rows of skull niches
			local cols = math.max(1, math.floor((bayW - 2.6) / 2.7))
			local span = cols * 2.7
			for r = 0, 2 do
				for c = 0, cols - 1 do
					local nx = cx - span / 2 + 1.35 + c * 2.7
					if not blocked(cf, nx, 1.1) then
						niche(cf, nx, 2.6 + r * 4.2, 2, 2.6)
					end
				end
			end
			-- tall gothic window every other bay, banners between
			if i % 2 == 0 and not blocked(cf, cx, 2) then
				window(cf, cx, 20, 3.2, 9, true)
			elseif not blocked(cf, cx, 2) and rng:NextNumber() < 0.7 then
				banner(cf, cx, 33, 12, 3.4, C.ClothDark)
			end
		end
	end
	cracks(cf, w, h, math.floor(w / 18))
	streaks(cf, w, h, math.floor(w / 10), false)
end

---------------------------------------------------------------------------
-- the rot: the Vanguard's daughter's weeping, grown into the stone
---------------------------------------------------------------------------
local ROT = {
	Flesh = Color3.fromRGB(98, 82, 58),
	FleshDark = Color3.fromRGB(62, 48, 38),
	Vein = Color3.fromRGB(44, 30, 30),
	VeinLight = Color3.fromRGB(68, 50, 40),
	Glow = Color3.fromRGB(178, 172, 98),
	Mold = Color3.fromRGB(64, 70, 42),
	Slime = Color3.fromRGB(38, 44, 32),
	Stone = Color3.fromRGB(54, 54, 48),
}
Detail.Rot = ROT

-- a wet boil. glow = a faint sickly light inside it
local function boil(cf, s, glow)
	if glow then
		d(Vector3.new(s, s, s), cf, MAT.Neon, vary(ROT.Glow, 0.06), { shape = Enum.PartType.Ball, transparency = 0.35, name = "GlowBoil" })
	else
		d(Vector3.new(s, s * rng:NextNumber(0.75, 1), s), cf, MAT.SmoothPlastic, vary(rng:NextNumber() < 0.5 and ROT.Flesh or ROT.FleshDark, 0.1), { shape = Enum.PartType.Ball, reflectance = 0.14, name = "Boil" })
	end
end

-- a cluster of boils half-sunk into the floor
function Detail.boils(pos, n, spread, glowChance)
	for _ = 1, n do
		local s = rng:NextNumber(0.35, 1.3)
		local a, r = rng:NextNumber(0, 6.28), rng:NextNumber(0, spread)
		boil(CFrame.new(pos + Vector3.new(math.cos(a) * r, s * 0.18, math.sin(a) * r)), s, rng:NextNumber() < (glowChance or 0))
	end
end

-- a segment of vein lying from a to b
local function veinSeg(a, b, thick, color)
	local len = (b - a).Magnitude
	if len < 0.05 then
		return
	end
	d(Vector3.new(len + thick * 0.45, thick, thick), CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.pi / 2, 0), MAT.SmoothPlastic, vary(color or ROT.Vein, 0.08), { shape = Enum.PartType.Cylinder, reflectance = 0.1, name = "Vein" })
end

-- A branching vein crawling over a floor (or under a ceiling: hang = true).
-- bounds = { x1, z1, x2, z2 } keeps it out of the walls.
function Detail.rotVein(p, ang, len, thick, depth, bounds, hang)
	local travelled = 0
	local y = p.Y
	while travelled < len and thick > 0.1 do
		local l = rng:NextNumber(1.3, 2.5)
		ang += rng:NextNumber(-0.45, 0.45)
		local q = p + Vector3.new(math.cos(ang), 0, math.sin(ang)) * l
		if bounds and (q.X < bounds[1] or q.X > bounds[3] or q.Z < bounds[2] or q.Z > bounds[4]) then
			local cx, cz = (bounds[1] + bounds[3]) / 2, (bounds[2] + bounds[4]) / 2
			ang = math.atan2(cz - p.Z, cx - p.X) + rng:NextNumber(-0.7, 0.7)
			q = p + Vector3.new(math.cos(ang), 0, math.sin(ang)) * l
		end
		local lift = hang and -thick * 0.22 or thick * 0.22
		veinSeg(Vector3.new(p.X, y + lift, p.Z), Vector3.new(q.X, y + lift, q.Z), thick, thick > 0.5 and ROT.Vein or ROT.VeinLight)
		if depth > 0 and rng:NextNumber() < 0.3 then
			Detail.rotVein(Vector3.new(q.X, y, q.Z), ang + (rng:NextNumber() < 0.5 and -1 or 1) * rng:NextNumber(0.5, 1.1), (len - travelled) * rng:NextNumber(0.3, 0.6), thick * 0.6, depth - 1, bounds, hang)
		end
		if not hang and thick > 0.35 and rng:NextNumber() < 0.1 then
			boil(CFrame.new(q.X, y + thick * 0.4, q.Z), thick * rng:NextNumber(1.2, 2), rng:NextNumber() < 0.25)
		end
		thick *= rng:NextNumber(0.9, 0.97)
		p = q
		travelled += l
	end
end

-- a vein climbing a wall (face space), branching sideways as it goes
local function wallVein(cf, x, y, height, thick, depth)
	local ang = math.pi / 2 + rng:NextNumber(-0.3, 0.3)
	local top = y + height
	while y < top and thick > 0.1 do
		local l = rng:NextNumber(1.0, 2.0)
		ang = math.clamp(ang + rng:NextNumber(-0.5, 0.5), 0.3, math.pi - 0.3)
		local nx, ny = x + math.cos(ang) * l, y + math.sin(ang) * l
		local a, b = (cf * CFrame.new(x, y, -thick * 0.3)).Position, (cf * CFrame.new(nx, ny, -thick * 0.3)).Position
		veinSeg(a, b, thick, ROT.Vein)
		if depth > 0 and rng:NextNumber() < 0.25 then
			wallVein(cf, nx, ny, (top - ny) * rng:NextNumber(0.3, 0.6), thick * 0.6, depth - 1)
		end
		thick *= 0.93
		x, y = nx, ny
	end
end
Detail.wallVein = wallVein

-- slime strands hanging from a ceiling, a drop at the end of each
function Detail.strands(x1, z1, x2, z2, ceilY, n)
	for _ = 1, n do
		local x, z = rng:NextNumber(x1, x2), rng:NextNumber(z1, z2)
		local len = rng:NextNumber(1, 4.5)
		d(Vector3.new(0.07, len, 0.07), CFrame.new(x, ceilY - len / 2, z) * CFrame.Angles(rng:NextNumber(-0.06, 0.06), 0, rng:NextNumber(-0.06, 0.06)), MAT.Glass, ROT.Slime, { transparency = 0.25, reflectance = 0.3, name = "Strand" })
		d(Vector3.new(0.2, 0.26, 0.2), CFrame.new(x, ceilY - len - 0.1, z), MAT.Glass, ROT.Slime, { shape = Enum.PartType.Ball, transparency = 0.2, reflectance = 0.35, name = "Drop" })
	end
end

-- diseased flagstones: the stone itself gone soft and veined
function Detail.rotPatches(x1, z1, x2, z2, n, y)
	for _ = 1, n do
		-- a few overlapping, turned slabs so the edge reads as a blot, not a tile
		local cx, cz = rng:NextNumber(x1, x2), rng:NextNumber(z1, z2)
		local mat = rng:NextNumber() < 0.6 and MAT.CrackedLava or MAT.Mud
		local col = rng:NextNumber() < 0.5 and ROT.FleshDark or ROT.Slime
		for k = 1, rng:NextInteger(2, 4) do
			local s = rng:NextNumber(1.0, 3.2)
			local ox, oz = rng:NextNumber(-1.2, 1.2), rng:NextNumber(-1.2, 1.2)
			if cx + ox > x1 - 0.5 and cx + ox < x2 + 0.5 and cz + oz > z1 - 0.5 and cz + oz < z2 + 0.5 then
				d(Vector3.new(s, 0.05, s * rng:NextNumber(0.5, 1.1)), CFrame.new(cx + ox, (y or 0) + 0.02 + k * 0.006, cz + oz) * CFrame.Angles(0, rng:NextNumber(0, 6), 0),
					mat, vary(col, 0.1), { name = "RotPatch" })
			end
		end
	end
end

-- pools of standing filth
function Detail.puddle(pos, w, l, yaw)
	d(Vector3.new(w, 0.06, l), CFrame.new(pos + Vector3.new(0, 0.04, 0)) * CFrame.Angles(0, yaw or 0, 0), MAT.Glass, Color3.fromRGB(34, 40, 28), { transparency = 0.3, reflectance = 0.3, name = "Puddle" })
end

-- k = how far the rot has got (0 = barely, 1 = everywhere)
STYLES.rot = function(cf, w, h, k)
	k = k or 1
	plinth(cf, w, 1.2, 0.6, vary(ROT.Stone, 0.08))
	stones(cf, w, h, 1.4, 0.15, ROT.Stone)
	cracks(cf, w, h, math.max(1, math.floor(w / 14)))
	streaks(cf, w, h, math.floor(w / 4 * (0.4 + k)), true)
	moss(cf, w, math.floor(w / 3 * (0.3 + k)), 2 + 3 * k)
	for _ = 1, math.floor(w / 7 * k + 0.5) do
		local x = rng:NextNumber(-w / 2 + 1, w / 2 - 1)
		if not blocked(cf, x, 1) then
			wallVein(cf, x, 0.2, rng:NextNumber(h * 0.3, h * 0.9) * (0.5 + k * 0.5), rng:NextNumber(0.35, 0.75) * (0.6 + k * 0.4), 2)
		end
	end
	for _ = 1, math.floor(w / 9 * k) do
		local x, y = rng:NextNumber(-w / 2 + 1, w / 2 - 1), rng:NextNumber(0.4, h * 0.5)
		if not blocked(cf, x, 1.2) then
			for _ = 1, rng:NextInteger(3, 7) do
				local s = rng:NextNumber(0.35, 1.2)
				boil(at(cf, x + rng:NextNumber(-1.1, 1.1), y + rng:NextNumber(-0.8, 0.8), s * 0.25), s, rng:NextNumber() < 0.2 * k)
			end
		end
	end
end

function Detail.dressWall(cf, w, h, style, k)
	local f = STYLES[style]
	if f then
		f(cf, w, h, k)
	end
end

---------------------------------------------------------------------------
-- floors
---------------------------------------------------------------------------
function Detail.floorSeams(x1, z1, x2, z2, step, color)
	color = color or C.Mortar
	for z = z1 + step, z2 - 0.01, step do
		d(Vector3.new(x2 - x1, 0.04, 0.14), CFrame.new((x1 + x2) / 2, 0.02, z), MAT.Slate, color, { name = "Seam" })
	end
	for x = x1 + step, x2 - 0.01, step do
		d(Vector3.new(0.14, 0.04, z2 - z1), CFrame.new(x, 0.02, (z1 + z2) / 2), MAT.Slate, color, { name = "Seam" })
	end
end

function Detail.floorTiles(x1, z1, x2, z2, step, chance, color, mat)
	for x = x1, x2 - step + 0.01, step do
		for z = z1, z2 - step + 0.01, step do
			if rng:NextNumber() < chance then
				local cx, cz = x + step / 2, z + step / 2
				if rng:NextNumber() < 0.25 then
					-- cracked flagstone: two halves at slightly different heights
					d(Vector3.new(step - 0.3, 0.07, step / 2 - 0.2), CFrame.new(cx, 0.035, cz - step / 4), mat or MAT.Slate, vary(color, 0.12), { name = "Flagstone" })
					d(Vector3.new(step - 0.3, 0.1, step / 2 - 0.2), CFrame.new(cx, 0.05, cz + step / 4) * CFrame.Angles(0.03, 0, 0), mat or MAT.Slate, vary(color, 0.12), { name = "Flagstone" })
				else
					d(Vector3.new(step - 0.25, 0.07, step - 0.25), CFrame.new(cx, 0.035, cz), mat or MAT.Slate, vary(color, 0.12), { name = "Flagstone" })
				end
			end
		end
	end
end

function Detail.gutter(x, z1, z2)
	d(Vector3.new(0.9, 0.05, z2 - z1), CFrame.new(x, 0.025, (z1 + z2) / 2), MAT.Slate, C.Void, { name = "Gutter" })
	d(Vector3.new(0.9, 0.06, z2 - z1), CFrame.new(x, 0.02, (z1 + z2) / 2), MAT.Glass, Color3.fromRGB(20, 26, 26), { transparency = 0.5, reflectance = 0.3, name = "GutterWater" })
	for z = z1 + 6, z2 - 1, 12 do
		for i = -1, 1 do
			d(Vector3.new(1.4, 0.08, 0.16), CFrame.new(x, 0.05, z + i * 0.35), MAT.Metal, C.Rust, { name = "Grate" })
		end
	end
end

function Detail.ritualCircle(center, r)
	for _, rr in ipairs({ r, r * 0.78 }) do
		local segs = 32
		for i = 0, segs - 1 do
			local a = (i + 0.5) / segs * math.pi * 2
			local len = 2 * math.pi * rr / segs + 0.1
			d(Vector3.new(len, 0.05, 0.35), CFrame.new(center + Vector3.new(math.cos(a) * rr, 0.03, math.sin(a) * rr)) * CFrame.Angles(0, -a + math.pi / 2, 0),
				MAT.Slate, C.BoneDark, { transparency = 0.25, name = "Rune" })
		end
	end
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local mid = (r * 0.78 + r * 0.3) / 2
		d(Vector3.new(0.3, 0.05, r * 0.48), CFrame.new(center + Vector3.new(math.cos(a) * mid, 0.03, math.sin(a) * mid)) * CFrame.Angles(0, -a + math.pi / 2, 0) * CFrame.Angles(0, math.pi / 2, 0),
			MAT.Slate, C.BoneDark, { transparency = 0.3, name = "Rune" })
	end
	d(Vector3.new(r * 0.5, 0.05, r * 0.5), CFrame.new(center + Vector3.new(0, 0.03, 0)) * CFrame.Angles(0, math.pi / 4, 0), MAT.Slate, C.Mortar, { transparency = 0.2, name = "Sigil" })
end

---------------------------------------------------------------------------
-- props
---------------------------------------------------------------------------
function Detail.bonePile(pos, n)
	for _ = 1, n do
		d(Vector3.new(0.18, 0.18, rng:NextNumber(0.9, 1.8)), CFrame.new(pos + Vector3.new(rng:NextNumber(-1.6, 1.6), rng:NextNumber(0.1, 0.5), rng:NextNumber(-1.6, 1.6)))
			* CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 6), rng:NextNumber(-0.3, 0.3)), MAT.SmoothPlastic, vary(C.Bone, 0.12), { name = "Bone" })
	end
	for _ = 1, rng:NextInteger(1, 3) do
		d(Vector3.new(0.85, 0.85, 0.85), CFrame.new(pos + Vector3.new(rng:NextNumber(-1.2, 1.2), 0.45, rng:NextNumber(-1.2, 1.2))), MAT.SmoothPlastic, vary(C.Bone, 0.1), { shape = Enum.PartType.Ball, name = "Skull" })
	end
end

function Detail.bucket(pos)
	d(Vector3.new(1.1, 1.0, 1.0), CFrame.new(pos + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, 0, math.pi / 2), MAT.WoodPlanks, C.Wood, { shape = Enum.PartType.Cylinder, name = "Bucket" })
	d(Vector3.new(0.12, 1.05, 1.05), CFrame.new(pos + Vector3.new(0, 0.85, 0)) * CFrame.Angles(0, 0, math.pi / 2), MAT.Metal, C.Iron, { shape = Enum.PartType.Cylinder, name = "BucketBand" })
end

function Detail.stool(pos, tipped)
	local cf = CFrame.new(pos) * (tipped and CFrame.Angles(math.pi / 2, rng:NextNumber(0, 6), 0) * CFrame.new(0, 0, -0.9) or CFrame.Angles(0, rng:NextNumber(0, 6), 0))
	d(Vector3.new(1.6, 0.25, 1.6), cf * CFrame.new(0, 1.4, 0), MAT.WoodPlanks, C.Wood, { name = "Stool" })
	for _, o in ipairs({ { 0.6, 0.6 }, { -0.6, 0.6 }, { 0.6, -0.6 }, { -0.6, -0.6 } }) do
		d(Vector3.new(0.2, 1.3, 0.2), cf * CFrame.new(o[1], 0.65, o[2]), MAT.Wood, C.WoodDark, { name = "StoolLeg" })
	end
end

function Detail.barrel(pos, onSide)
	local cf = CFrame.new(pos + Vector3.new(0, onSide and 1.1 or 1.5, 0)) * (onSide and CFrame.Angles(0, rng:NextNumber(0, 6), 0) or CFrame.Angles(0, 0, math.pi / 2))
	d(Vector3.new(3, 2.2, 2.2), cf, MAT.WoodPlanks, vary(C.Wood, 0.1), { collide = true, shape = Enum.PartType.Cylinder, name = "Barrel" })
	for _, x in ipairs({ -1.0, 1.0 }) do
		d(Vector3.new(0.18, 2.28, 2.28), cf * CFrame.new(x, 0, 0), MAT.Metal, C.Iron, { shape = Enum.PartType.Cylinder, name = "Hoop" })
	end
end

function Detail.gravestone(pos, yaw)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(rng:NextNumber(-0.15, 0.15), 0, rng:NextNumber(-0.12, 0.12))
	local kind = rng:NextNumber()
	if kind < 0.6 then
		d(Vector3.new(2, 2.6, 0.5), cf * CFrame.new(0, 1.1, 0), MAT.Slate, vary(C.StoneLight, 0.1), { collide = true, name = "Headstone" })
		d(Vector3.new(0.5, 2, 2), cf * CFrame.new(0, 2.4, 0) * CFrame.Angles(0, 0, math.pi / 2), MAT.Slate, vary(C.StoneLight, 0.1), { collide = true, shape = Enum.PartType.Cylinder, name = "Headstone" })
	else
		d(Vector3.new(0.6, 3.4, 0.5), cf * CFrame.new(0, 1.5, 0), MAT.Slate, vary(C.StoneLight, 0.1), { collide = true, name = "Cross" })
		d(Vector3.new(2, 0.5, 0.5), cf * CFrame.new(0, 2.4, 0), MAT.Slate, vary(C.StoneLight, 0.1), { collide = true, name = "Cross" })
	end
	d(Vector3.new(2.4, 0.3, 4.2), CFrame.new(pos + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, yaw, 0) * CFrame.new(0, 0, -2.3), MAT.Ground, Color3.fromRGB(46, 40, 34), { name = "Grave" })
end

function Detail.well(pos)
	local r = 2.6
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		d(Vector3.new(1.5, 2.4, 1.1), CFrame.new(pos + Vector3.new(math.cos(a) * r, 1.2, math.sin(a) * r)) * CFrame.Angles(0, -a, 0), MAT.Cobblestone, vary(C.Stone, 0.1), { collide = true, name = "WellStone" })
	end
	d(Vector3.new(0.1, r * 2, r * 2), CFrame.new(pos + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, 0, math.pi / 2), MAT.Slate, C.Void, { shape = Enum.PartType.Cylinder, name = "WellVoid" })
	for _, sx in ipairs({ -1, 1 }) do
		d(Vector3.new(0.5, 6, 0.5), CFrame.new(pos + Vector3.new(sx * (r + 0.2), 3, 0)), MAT.Wood, C.WoodDark, { collide = true, name = "WellPost" })
	end
	d(Vector3.new(r * 2 + 1.4, 0.4, 0.4), CFrame.new(pos + Vector3.new(0, 5.6, 0)), MAT.Wood, C.WoodDark, { name = "WellBeam" })
	d(Vector3.new(r * 2 + 2, 0.3, 3.6), CFrame.new(pos + Vector3.new(0, 6.6, 0.9)) * CFrame.Angles(0.5, 0, 0), MAT.WoodPlanks, C.Wood, { shadow = true, name = "WellRoof" })
	d(Vector3.new(r * 2 + 2, 0.3, 3.6), CFrame.new(pos + Vector3.new(0, 6.6, -0.9)) * CFrame.Angles(-0.5, 0, 0), MAT.WoodPlanks, C.Wood, { shadow = true, name = "WellRoof" })
	d(Vector3.new(0.1, 3.5, 0.1), CFrame.new(pos + Vector3.new(0, 3.8, 0)), MAT.Fabric, Color3.fromRGB(96, 84, 52), { name = "Rope" })
	Detail.bucket(pos + Vector3.new(0, 1.2, 0))
end

function Detail.weeds(pos, n)
	for _ = 1, n do
		local h = rng:NextNumber(0.4, 1.2)
		d(Vector3.new(0.12, h, 0.5), CFrame.new(pos + Vector3.new(rng:NextNumber(-0.8, 0.8), h / 2, rng:NextNumber(-0.8, 0.8))) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 6), rng:NextNumber(-0.4, 0.4)),
			MAT.Grass, vary(C.Moss, 0.2), { name = "Weed" })
	end
end

function Detail.chandelier(pos, topY, dim)
	local r = 3.2
	for i = 0, math.floor((topY - pos.Y) / 0.6) do
		d(Vector3.new(0.2, 0.55, 0.2), CFrame.new(pos + Vector3.new(0, 0.6 + i * 0.6, 0)) * CFrame.Angles(0, (i % 2) * math.pi / 2, 0), MAT.Metal, C.Iron, { name = "Chain" })
	end
	for i = 0, 11 do
		local a = (i + 0.5) / 12 * math.pi * 2
		d(Vector3.new(2 * math.pi * r / 12 + 0.1, 0.35, 0.35), CFrame.new(pos + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)) * CFrame.Angles(0, -a + math.pi / 2, 0), MAT.Metal, C.Iron, { name = "ChandelierRing" })
	end
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2
		local tip = pos + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		local top = pos + Vector3.new(0, 3, 0)
		d(Vector3.new(0.15, 0.15, (top - tip).Magnitude), CFrame.lookAt((tip + top) / 2, top), MAT.Metal, C.Iron, { name = "ChandelierArm" })
	end
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local cpos = pos + Vector3.new(math.cos(a) * r, 0.65, math.sin(a) * r)
		d(Vector3.new(0.3, 0.9, 0.3), CFrame.new(cpos), MAT.SmoothPlastic, vary(C.Wax, 0.06), { name = "Candle" })
		d(Vector3.new(0.12, 0.25, 0.12), CFrame.new(cpos + Vector3.new(0, 0.6, 0)), MAT.Neon, Color3.fromRGB(255, 170, 80), { name = "Flame" })
	end
	local core = d(Vector3.new(0.2, 0.2, 0.2), CFrame.new(pos + Vector3.new(0, 0.8, 0)), MAT.SmoothPlastic, C.Iron, { transparency = 1, name = "ChandelierLight" })
	local l = Instance.new("PointLight")
	l.Color = Color3.fromRGB(255, 170, 100)
	l.Range = 30
	l.Brightness = 1.3 * (dim or 1)
	l.Shadows = true
	l.Parent = core
	l:SetAttribute("Base", l.Brightness)
	CollectionService:AddTag(l, "Flicker")
end

-- a dead prisoner slumped against a wall. facing = direction it looks (away from the wall)
function Detail.slumpedSkeleton(pos, facing)
	local cf = CFrame.lookAt(pos, pos + facing)
	d(Vector3.new(1.4, 1.6, 0.6), cf * CFrame.new(0, 1.2, 0.2) * CFrame.Angles(-0.25, 0, 0), MAT.Fabric, Color3.fromRGB(60, 52, 42), { name = "Rags" })
	for i = 0, 3 do
		d(Vector3.new(1.1, 0.12, 0.12), cf * CFrame.new(0, 0.7 + i * 0.32, -0.1), MAT.SmoothPlastic, vary(C.Bone, 0.1), { name = "Rib" })
	end
	d(Vector3.new(0.85, 0.85, 0.85), cf * CFrame.new(0.2, 2.2, -0.1), MAT.SmoothPlastic, C.Bone, { shape = Enum.PartType.Ball, name = "Skull" })
	for _, sx in ipairs({ -0.4, 0.4 }) do
		d(Vector3.new(0.18, 0.18, 2.1), cf * CFrame.new(sx, 0.15, -1.0) * CFrame.Angles(0, sx * 0.3, 0), MAT.SmoothPlastic, vary(C.Bone, 0.08), { name = "LegBone" })
	end
	d(Vector3.new(0.16, 0.16, 1.6), cf * CFrame.new(0.8, 0.5, -0.5) * CFrame.Angles(0.6, 0.3, 0), MAT.SmoothPlastic, vary(C.Bone, 0.08), { name = "ArmBone" })
end

function Detail.timberFrame(a, b, h)
	-- a, b = floor points on opposite walls
	for _, p in ipairs({ a, b }) do
		d(Vector3.new(0.9, h, 0.9), CFrame.new(p + Vector3.new(0, h / 2, 0)), MAT.Wood, vary(C.WoodDark, 0.1), { collide = true, name = "Post" })
	end
	local top = (a + b) / 2 + Vector3.new(0, h - 0.4, 0)
	d(Vector3.new(0.9, 0.9, (b - a).Magnitude + 0.6), CFrame.lookAt(top, top + (b - a)), MAT.Wood, vary(C.WoodDark, 0.1), { shadow = true, name = "Lintel" })
	for _, p in ipairs({ a, b }) do
		local s = p + Vector3.new(0, h - 2.6, 0)
		local e = p + (top - p - Vector3.new(0, h - 0.4, 0)).Unit * 2.2 + Vector3.new(0, h - 0.6, 0)
		d(Vector3.new(0.5, 0.5, (e - s).Magnitude), CFrame.lookAt((s + e) / 2, e), MAT.Wood, vary(C.WoodDark, 0.1), { name = "Brace" })
	end
end

function Detail.stalactites(x1, z1, x2, z2, ceilingY, n)
	for _ = 1, n do
		local x, z = rng:NextNumber(x1, x2), rng:NextNumber(z1, z2)
		local len = rng:NextNumber(0.8, 2.4)
		local w = rng:NextNumber(0.4, 0.9)
		local y = ceilingY
		for k = 0, 2 do
			local seg = len / 3
			d(Vector3.new(w * (1 - k * 0.3), seg, w * (1 - k * 0.3)), CFrame.new(x, y - seg / 2, z) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), MAT.Rock, vary(C.Rock, 0.1), { name = "Stalactite" })
			y -= seg
		end
	end
end

function Detail.pipe(a, b)
	local len = (b - a).Magnitude
	d(Vector3.new(len, 0.8, 0.8), CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.pi / 2, 0), MAT.CorrodedMetal, C.Rust, { shape = Enum.PartType.Cylinder, shadow = true, name = "Pipe" })
	local dir = (b - a).Unit
	for t = 4, len - 1, 8 do
		local p = a + dir * t
		d(Vector3.new(1.0, 1.0, 0.3), CFrame.lookAt(p, p + dir), MAT.Metal, C.Iron, { name = "PipeBracket" })
	end
	for _ = 1, 3 do
		local p = a + dir * rng:NextNumber(2, len - 2)
		d(Vector3.new(0.12, rng:NextNumber(1.5, 4), 0.06), CFrame.new(p - Vector3.new(0, 2.2, 0)), MAT.SmoothPlastic, C.Rust, { transparency = 0.4, name = "RustDrip" })
	end
end

-- a chapel pew. broken = split and slumped, half sunk into the rot
function Detail.pew(pos, yaw, len, broken)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	if broken then
		cf = cf * CFrame.Angles(rng:NextNumber(-0.12, 0.12), 0, rng:NextNumber(0.1, 0.25)) * CFrame.new(0, -0.3, 0)
	end
	local wood = vary(C.WoodDark, 0.12)
	d(Vector3.new(len, 0.3, 1.5), cf * CFrame.new(0, 1.5, 0), MAT.WoodPlanks, wood, { collide = not broken, name = "PewSeat" })
	d(Vector3.new(len, 1.6, 0.25), cf * CFrame.new(0, 2.5, 0.7) * CFrame.Angles(-0.1, 0, 0), MAT.WoodPlanks, wood, { collide = not broken, name = "PewBack" })
	for _, x in ipairs({ -len / 2 + 0.3, len / 2 - 0.3 }) do
		d(Vector3.new(0.3, 1.5, 1.5), cf * CFrame.new(x, 0.75, 0), MAT.Wood, wood, { collide = not broken, name = "PewEnd" })
	end
	-- the rot has climbed it
	for _ = 1, rng:NextInteger(1, 4) do
		boil(cf * CFrame.new(rng:NextNumber(-len / 2, len / 2), rng:NextNumber(0.4, 1.8), rng:NextNumber(-0.6, 0.6)), rng:NextNumber(0.3, 0.8), false)
	end
end

-- a reading stand. returns the open book (for an examine prompt)
function Detail.lectern(pos, facing)
	local cf = CFrame.lookAt(pos, pos + facing)
	d(Vector3.new(1.6, 0.3, 1.6), cf * CFrame.new(0, 0.15, 0), MAT.Wood, C.WoodDark, { collide = true, name = "LecternFoot" })
	d(Vector3.new(0.45, 3.1, 0.45), cf * CFrame.new(0, 1.7, 0), MAT.Wood, C.WoodDark, { collide = true, name = "LecternPost" })
	d(Vector3.new(1.9, 0.18, 1.4), cf * CFrame.new(0, 3.35, 0) * CFrame.Angles(-0.45, 0, 0), MAT.Wood, C.Wood, { name = "LecternTop" })
	local book = d(Vector3.new(1.5, 0.12, 1.05), cf * CFrame.new(0, 3.5, 0.02) * CFrame.Angles(-0.45, 0, 0), MAT.Fabric, Color3.fromRGB(186, 170, 134), { query = true, name = "Register" })
	d(Vector3.new(0.08, 0.14, 1.06), cf * CFrame.new(0, 3.52, 0.02) * CFrame.Angles(-0.45, 0, 0), MAT.Fabric, C.ClothDark, { name = "Spine" })
	-- mould has crept up the post and over one page
	for _ = 1, 4 do
		boil(cf * CFrame.new(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0.3, 2.6), rng:NextNumber(-0.3, 0.3)), rng:NextNumber(0.25, 0.5), false)
	end
	d(Vector3.new(0.6, 0.13, 0.7), cf * CFrame.new(0.4, 3.52, 0.1) * CFrame.Angles(-0.45, 0, 0), MAT.Mud, ROT.FleshDark, { name = "Mould" })
	return book
end

-- a corpse the rot has half swallowed
function Detail.overgrownCorpse(pos, facing)
	Detail.slumpedSkeleton(pos, facing)
	local cf = CFrame.lookAt(pos, pos + facing)
	for _ = 1, rng:NextInteger(4, 8) do
		boil(cf * CFrame.new(rng:NextNumber(-0.9, 0.9), rng:NextNumber(0.2, 1.8), rng:NextNumber(-1.2, 0.5)), rng:NextNumber(0.35, 0.9), rng:NextNumber() < 0.15)
	end
end

return Detail
]]></ProtectedString>
					<string name="ScriptGuid">{8F361B48-93D3-4EC9-9B8E-6EC91946717D}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">MapDetail</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">37103886d8e24c800aefca76000003ec</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000017">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- RigBuilder: builds every character as a classic Motor6D rig (see PuppetMath).
-- These rigs are fully animated by the client Puppeteer. Each character's dress,
-- colours and proportions come from its file in ReplicatedStorage/Characters.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PM = require(ReplicatedStorage:WaitForChild("PuppetMath"))

local RigBuilder = {}

local MAT = Enum.Material
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local Roster = require(ReplicatedStorage:WaitForChild("Roster"))
local Armor = require(script.Parent:WaitForChild("Armor"))
local DEFAULT_COLORS = { skin = rgb(150, 128, 108), torso = rgb(66, 58, 50), legs = rgb(58, 52, 46), arms = rgb(66, 58, 50) }

local ORDER = { "Root", "Waist", "Neck", "RShoulder", "RElbow", "LShoulder", "LElbow", "RHip", "RKnee", "RAnkle", "LHip", "LKnee", "LAnkle", "RWrist", "LWrist", "RToe", "LToe" }

function RigBuilder.build(kind, s)
	s = s or 1
	local D = PM.dims(kind, s)
	local J = PM.joints(D)
	local char = Roster.byKind[kind]
	local look = (char and char.Colors) or DEFAULT_COLORS

	local model = Instance.new("Model")
	model.Name = kind
	local parts = {}

	local function mk(name, size, color, mat)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = mat or MAT.SmoothPlastic
		p.CanCollide = false
		p.Massless = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		parts[name] = p
		return p
	end

	local root = mk("HumanoidRootPart", D.rootSize, rgb(255, 255, 255))
	root.Transparency = 1
	root.CanCollide = true
	root.Massless = false
	mk("Hips", D.hipsSize, look.legs, MAT.Fabric)
	mk("Chest", D.chestSize, look.torso, MAT.Fabric)
	mk("Head", D.headSize, look.skin)
	for _, n in ipairs({ "R", "L" }) do
		mk(n .. "UpperArm", Vector3.new(D.armW, D.upperArm, D.armW), look.arms, MAT.Fabric)
		mk(n .. "LowerArm", Vector3.new(D.armW * 0.9, D.lowerArm, D.armW * 0.9), look.arms, MAT.Fabric)
		mk(n .. "Thigh", Vector3.new(D.legW, D.thigh, D.legW), look.legs, MAT.Fabric)
		mk(n .. "Shin", Vector3.new(D.legW * 0.9, D.shin, D.legW * 0.9), look.legs, MAT.Fabric)
		mk(n .. "Foot", D.footSize, rgb(40, 32, 26), MAT.Fabric)
		if J[n .. "Wrist"] then -- (limbs rigs: the fist and the toes on joints of their own)
			mk(n .. "Hand", D.handSize, (char and char.FistSkin) and look.skin or rgb(46, 36, 28), MAT.Fabric)
			mk(n .. "Toe", D.toeSize, rgb(40, 32, 26), MAT.Fabric)
		end
	end

	-- rest pose + joints
	root.CFrame = CFrame.new(0, D.rootY, 0)
	for _, jn in ipairs(ORDER) do
		local j = J[jn]
		if not j then
			continue -- (the limbs-only joints)
		end
		local p0, p1 = parts[j.p0], parts[j.p1]
		p1.CFrame = p0.CFrame * j.C0 * j.C1:Inverse()
		local m = Instance.new("Motor6D")
		m.Name = jn
		m.Part0 = p0
		m.Part1 = p1
		m.C0 = j.C0
		m.C1 = j.C1
		m.Parent = p0
	end

	-- decoration welded onto a body part. offset is in the part's local space.
	local function deco(onPart, name, size, offset, color, mat, shape)
		local base = parts[onPart]
		local d = Instance.new("Part")
		d.Name = name
		if shape then
			d.Shape = shape
		end
		d.Size = size
		d.Color = color
		d.Material = mat or MAT.SmoothPlastic
		d.CanCollide = false
		d.Massless = true
		d.CastShadow = true
		d.TopSurface = Enum.SurfaceType.Smooth
		d.BottomSurface = Enum.SurfaceType.Smooth
		d.CFrame = base.CFrame * offset
		local w = Instance.new("WeldConstraint")
		w.Part0 = base
		w.Part1 = d
		w.Parent = d
		d.Parent = model
		return d
	end
	local V = function(x, y, z)
		return Vector3.new(x, y, z) * s
	end
	local at = function(x, y, z)
		return CFrame.new(x * s, y * s, z * s)
	end
	local cw, ch, cd = D.chestSize.X / s, D.chestSize.Y / s, D.chestSize.Z / s
	local hw, hd = D.hipsSize.X / s, D.hipsSize.Z / s
	local aw, lw = D.armW / s, D.legW / s
	local la, ua = D.lowerArm / s, D.upperArm / s

	-- hands shared by everyone
	for _, n in ipairs(parts.RHand and {} or { "R", "L" }) do
		deco(n .. "LowerArm", "Fist", V(aw * 0.95, 0.42, aw * 1.0), at(0, -la / 2 - 0.08, 0), (char and char.FistSkin) and look.skin or rgb(46, 36, 28), MAT.Fabric)
	end

	-- the character's own look (its file in ReplicatedStorage/Characters, M.Look)
	if char and char.Look then
		char.Look({
			deco = deco, parts = parts, V = V, at = at, rgb = rgb, MAT = MAT, D = D, s = s, look = look,
			-- Armor.tatter, given unscaled like V/at and scaled up to this rig
			tatter = function(rng, onPart, top, w, l, color, hem, rough)
				Armor.tatter(function(on, name, size, cf, ...)
					return deco(on, name, size * s, cf.Rotation + cf.Position * s, ...)
				end, rng, onPart, top, w, l, color, hem, rough)
			end,
			cw = cw, ch = ch, cd = cd, hw = hw, hd = hd, aw = aw, lw = lw, la = la, ua = ua,
		})
	end

	local hum = Instance.new("Humanoid")
	-- turn auto-scaling off FIRST: R15 auto-scaling recomputes HipHeight from
	-- leg parts it expects by name, which this rig doesn't have (-> sinking)
	pcall(function()
		hum.AutomaticScalingEnabled = false
	end)
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = D.hipHeight
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	local animator = Instance.new("Animator")
	animator.Parent = hum
	hum.Parent = model

	model.PrimaryPart = root
	model:SetAttribute("PrisonRig", kind)
	model:SetAttribute("RigScale", s)
	model:SetAttribute("HipHeight", D.hipHeight) -- the server re-asserts this (see rig guard)
	model:SetAttribute("StandHeight", D.rootY) -- root-part centre above the floor when standing
	return model, hum, D
end

return RigBuilder
]]></ProtectedString>
					<string name="ScriptGuid">{00CD44A4-CF2F-477B-847C-798B83675C44}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">RigBuilder</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">37103886d8e24c800aefca76000003ed</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000018">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Core: the shared toolkit every character uses. Nothing in here belongs to one
-- character; each character's own behaviour lives in ReplicatedStorage/Characters.
--
-- WHAT A CHARACTER CAN USE (Core.<name>)
--   world      Config, P (Config.Player), Map, EnemiesFolder, FxRemote, ActionRemote, states (per-player state)
--   time/math  now(), flat(v), rand(lo, hi), turnTowards(root, pos, maxRad)
--   sound      SOUNDS (Slash, Lunge, Unsheath, Groan, Breath, Impact), playSound(parent, id, volume, speed)
--   effects    burst(pos, color, count, size, speed), fxAnchor(pos), dustCloud(pos, size, count),
--              debrisChunks(pos, n, power), crackLines(center, radius, n, color?, material?, reveal?),
--              fadeAway(parts, delay, time), crater(pos, radius), shockwave(pos, radius), flash(model),
--              groundHeave(pos, radius, lead)
--   poses      POSES (weapon grip poses), pose(actor, gripName, time, style?, direction?) (also sets the
--              matching body pose), bodyPose(actor, bodyPoseName, blend), setTrail(actor, on),
--              hitStopActor(actor, duration, freezeRoot), faceTowards(root, pos), poseCF(name, scale),
--              steerYaw(root, yaw) (turn a rig without teleporting it: see the note above faceTowards)
--   rigs       makeRig(name, kind, scale, weaponName) -> model, humanoid, gripWeld
--              giveWeapon(char, weaponName, scale) -> gripWeld, makeCorpse(model), ragdoll(model), applyLimbGroup(model)
--   players    aliveChar(player) -> char, hum, hrp, damagePlayer(player, amount, fromPos, level)
--              (level = "Small" | "Medium" | "Large" | "Knockdown" | "Launch"; returns true if it landed),
--              playersInSector(cf, range, halfAngle, height), playersInRadius(pos, radius, height),
--              spend(st, amount), setAction(st, t, total, dodgeAfter, attackAfter), cancelSwing(st),
--              syncStamina(player, st), equipWeapon(player, weaponName) (one of Config.Weapons)
--   enemies    enemiesInSector(cf, range, halfAngle), damageEnemy(model, amount, player, poise, hitStop),
--              registerTarget(fn): fn(model) -> nil or { owner, actor, maxPoise, freeze, armor,
--              onHit(player), onBreak(player, t, hitStop) }  (how hits find a character's poise)
--   status     poisonPlayer(player, opts), clearPoison(player), clearAllPoison()  (see POISON below)
--
-- An "actor" is { model, weld (the GripWeld), scale, root, ... }: anything pose() can animate.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local PhysicsService = game:GetService("PhysicsService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

-- Only the HumanoidRootPart touches the world; limbs/torsos/weapons don't.
-- This keeps the procedural roll from shoving the character into the floor.
pcall(function()
	PhysicsService:RegisterCollisionGroup("Limbs")
end)
PhysicsService:CollisionGroupSetCollidable("Limbs", "Default", false)
PhysicsService:CollisionGroupSetCollidable("Limbs", "Limbs", false)

-- Character root parts: players and enemies never physically touch each other.
-- That is what stops you climbing onto (or getting stuck on top of) enemies.
-- Spacing between them is handled by a soft push-apart on the client instead.
for _, g in ipairs({ "PlayerRoot", "EnemyRoot", "HitQuery" }) do
	pcall(function()
		PhysicsService:RegisterCollisionGroup(g)
	end)
end
PhysicsService:CollisionGroupSetCollidable("PlayerRoot", "EnemyRoot", false)
PhysicsService:CollisionGroupSetCollidable("PlayerRoot", "PlayerRoot", false)
PhysicsService:CollisionGroupSetCollidable("PlayerRoot", "Limbs", false)
PhysicsService:CollisionGroupSetCollidable("EnemyRoot", "Limbs", false)
-- HitQuery is only used by the sword's hit detection; it "sees" every group.
pcall(function()
	PhysicsService:RegisterCollisionGroup("Debris")
end)
for _, g in ipairs({ "PlayerRoot", "EnemyRoot", "Limbs", "Debris" }) do
	PhysicsService:CollisionGroupSetCollidable("Debris", g, false) -- rubble only bounces off the level
end
-- the dead are immaterial: corpses lie on the level, and the living walk straight through them
pcall(function()
	PhysicsService:RegisterCollisionGroup("Corpse")
end)
-- (nor each other: a ragdoll's own limbs and armour would otherwise fight it)
for _, g in ipairs({ "PlayerRoot", "EnemyRoot", "Limbs", "Debris", "Corpse" }) do
	PhysicsService:CollisionGroupSetCollidable("Corpse", g, false)
end
-- invisible walls only enemies bump into (the Consul's landing: nothing follows you up to him)
pcall(function()
	PhysicsService:RegisterCollisionGroup("EnemyWard")
end)
for _, g in ipairs(PhysicsService:GetRegisteredCollisionGroups()) do
	PhysicsService:CollisionGroupSetCollidable("EnemyWard", g.name, g.name == "EnemyRoot")
end

local function setLimbGroup(part)
	if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
		part.CollisionGroup = "Limbs"
	end
end

local function applyLimbGroup(model)
	for _, d in ipairs(model:GetDescendants()) do
		setLimbGroup(d)
	end
	model.DescendantAdded:Connect(setLimbGroup)
end
local MapBuilder = require((script.Parent :: any):WaitForChild("MapBuilder"))
local RigBuilder = require((script.Parent :: any):WaitForChild("RigBuilder"))
local Roster = require(ReplicatedStorage:WaitForChild("Roster"))

local P = Config.Player

---------------------------------------------------------------------------
-- remotes, folders, map
---------------------------------------------------------------------------
local Remotes = Instance.new("Folder")
Remotes.Name = "Remotes"
local ActionRemote = Instance.new("RemoteEvent")
ActionRemote.Name = "Action" -- client -> server
ActionRemote.Parent = Remotes
local FxRemote = Instance.new("RemoteEvent")
FxRemote.Name = "Fx" -- server -> client
FxRemote.Parent = Remotes
Remotes.Parent = ReplicatedStorage

local EnemiesFolder = Instance.new("Folder")
EnemiesFolder.Name = "Enemies"
EnemiesFolder.Parent = workspace

local Map = MapBuilder.build()
if workspace.StreamingEnabled then
	warn("[DGUS] Workspace.StreamingEnabled is ON. Turn it off (Workspace properties): streamed custom rigs sink into the floor on clients.")
end

ReplicatedStorage:SetAttribute("BossActive", false)
ReplicatedStorage:SetAttribute("BossName", Config.Boss.Name)
ReplicatedStorage:SetAttribute("Music", "none") -- none | boss | boss2 | victory (played by the Music client script)
---------------------------------------------------------------------------
-- helpers
---------------------------------------------------------------------------
local function now()
	return os.clock()
end

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

-- Built-in Roblox sounds (swap these for your own asset ids for better audio).
local SOUNDS = {
	Slash = "rbxasset://sounds/swordslash.wav",
	Lunge = "rbxasset://sounds/swordlunge.wav",
	Unsheath = "rbxasset://sounds/unsheath.wav",
	-- (was Roblox's "uuhhh" injury groan - removed everywhere: deaths, boss growls,
	-- Oculast's hisses. Paste a growl/hiss asset id here to give them a voice again.)
	Groan = "",
	-- Oculast's breathing while she lies fallen. "" = a built-in wind sample shaped
	-- into breaths; paste a breathing asset id here for a real one.
	Breath = "",
	Impact = "rbxasset://sounds/collide.wav",
	WatchdogSmash = "rbxassetid://74149238738530", -- the Malformed Watchdog's twisting leap landing
	WatchdogBlast = "rbxassetid://94138990589559", -- its tail slash letting go
	Deflect = "rbxassetid://8820780818", -- crisp parry / deflect clash
	-- the Old Book's fireball: its cast (a whoosh; "" = silent - paste a fire-whoosh asset id
	-- here) and its burst (Roblox's built-in explosion)
	FireCast = "",
	FireHit = "rbxasset://sounds/impact_explosion_03.mp3",
	-- the Gozen Tachi's crackles: [1] on its draw, [2] and [3] by turns on its other cuts
	Lightning = { "rbxassetid://132801826635544", "rbxassetid://118075222341359", "rbxassetid://118156993756758" },
}

local function playSound(parent, id, volume, speed)
	if not parent or not parent.Parent or not id or id == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.6
	s.PlaybackSpeed = speed or 1
	s.RollOffMaxDistance = 160
	s.Parent = parent
	s:Play()
	Debris:AddItem(s, 6)
end

local function burst(pos, color, count, size, speed)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.Position = pos
	p.Parent = workspace
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 0
	pe.Lifetime = NumberRange.new(0.3, 0.7)
	pe.Speed = NumberRange.new((speed or 12) * 0.6, speed or 12)
	pe.SpreadAngle = Vector2.new(80, 80)
	pe.Acceleration = Vector3.new(0, -35, 0)
	pe.Color = ColorSequence.new(color)
	pe.Size = NumberSequence.new(size or 0.25, 0)
	pe.LightInfluence = 1
	pe.Parent = p
	pe:Emit(count or 12)
	Debris:AddItem(p, 1.5)
end

local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local function fxAnchor(pos)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.Position = pos
	p.Parent = workspace
	return p
end

-- a billowing cloud of dust
local function dustCloud(pos, size, count)
	local a = fxAnchor(pos)
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = SMOKE
	pe.Rate = 0
	pe.Lifetime = NumberRange.new(1.4, 2.6)
	pe.Speed = NumberRange.new(size * 0.8, size * 2)
	pe.EmissionDirection = Enum.NormalId.Top
	pe.SpreadAngle = Vector2.new(85, 85)
	pe.Drag = 4
	pe.Acceleration = Vector3.new(0, 1.5, 0)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.35), NumberSequenceKeypoint.new(1, size * 1.1) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(0.6, 0.65), NumberSequenceKeypoint.new(1, 1) })
	pe.Color = ColorSequence.new(Color3.fromRGB(105, 98, 88))
	pe.Rotation = NumberRange.new(0, 360)
	pe.RotSpeed = NumberRange.new(-30, 30)
	pe.LightInfluence = 1
	pe.Parent = a
	pe:Emit(math.floor(count))
	Debris:AddItem(a, 3.2)
end

-- chunks of floor thrown into the air (they bounce off the level, never players)
local function debrisChunks(pos, n, power)
	for _ = 1, n do
		local c = Instance.new("Part")
		local sz = 0.35 + math.random() * 0.8
		c.Size = Vector3.new(sz, sz * (0.5 + math.random() * 0.6), sz * (0.6 + math.random() * 0.6))
		c.Material = Enum.Material.Slate
		c.Color = Color3.fromRGB(70, 66, 60):Lerp(Color3.fromRGB(30, 28, 26), math.random())
		c.CanQuery = false
		c.CanTouch = false
		c.CollisionGroup = "Debris"
		c.CFrame = CFrame.new(pos + Vector3.new(math.random() - 0.5, 0.4, math.random() - 0.5) * 2) * CFrame.Angles(math.random() * 6, math.random() * 6, 0)
		c.Parent = workspace
		local dir = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5)
		dir = dir.Magnitude > 0.01 and dir.Unit or Vector3.new(1, 0, 0)
		c.AssemblyLinearVelocity = dir * power * (0.3 + math.random() * 0.5) + Vector3.new(0, power * (0.5 + math.random() * 0.5), 0)
		c.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 20
		task.delay(1.8, function()
			if c.Parent then
				TweenService:Create(c, TweenInfo.new(0.7), { Transparency = 1 }):Play()
			end
		end)
		Debris:AddItem(c, 2.6)
	end
end

-- zigzag cracks radiating along the floor. reveal = seconds to spread out (0 = at once)
local function crackLines(center, radius, n, color, material, reveal)
	local list = {}
	for _ = 1, n do
		local ang = math.random() * math.pi * 2
		local prev = center + Vector3.new(math.cos(ang), 0, math.sin(ang)) * radius * 0.08
		local segs = math.random(3, 5)
		for k = 1, segs do
			local len = radius / segs * (0.8 + math.random() * 0.4)
			ang += (math.random() - 0.5) * 1.0
			local nxt = prev + Vector3.new(math.cos(ang), 0, math.sin(ang)) * len
			local seg = Instance.new("Part")
			seg.Name = "Crack"
			seg.Anchored = true
			seg.CanCollide = false
			seg.CanQuery = false
			seg.CanTouch = false
			seg.CastShadow = false
			seg.Material = material or Enum.Material.Slate
			seg.Color = color or Color3.fromRGB(20, 19, 18)
			seg.Size = Vector3.new(len + 0.1, 0.05, math.max(0.08, 0.3 * (1 - k / (segs + 1))))
			seg.CFrame = CFrame.new((prev + nxt) / 2) * CFrame.Angles(0, -ang, 0)
			if reveal and reveal > 0 then
				seg.Transparency = 1
				task.delay(reveal * (k - 1) / segs, function()
					seg.Transparency = 0
				end)
			end
			seg.Parent = workspace
			table.insert(list, seg)
			prev = nxt
		end
	end
	return list
end

local function fadeAway(list, delay, time)
	task.delay(delay, function()
		for _, p in ipairs(list) do
			if p.Parent then
				TweenService:Create(p, TweenInfo.new(time), { Transparency = 1 }):Play()
			end
		end
		task.wait(time + 0.1)
		for _, p in ipairs(list) do
			p:Destroy()
		end
	end)
end

-- the aftermath of a heavy blow: a cracked, dark dent in the stone
local function crater(pos, radius)
	local stain = Instance.new("Part")
	stain.Name = "Crater"
	stain.Anchored = true
	stain.CanCollide = false
	stain.CanQuery = false
	stain.CanTouch = false
	stain.CastShadow = false
	stain.Shape = Enum.PartType.Cylinder
	stain.Material = Enum.Material.Slate
	stain.Color = Color3.fromRGB(30, 28, 26)
	stain.Transparency = 0.35
	stain.Size = Vector3.new(0.05, radius * 1.4, radius * 1.4)
	stain.CFrame = CFrame.new(pos.X, pos.Y - 0.15, pos.Z) * CFrame.Angles(0, 0, math.pi / 2)
	stain.Parent = workspace
	local list = crackLines(Vector3.new(pos.X, pos.Y - 0.14, pos.Z), radius, 7)
	table.insert(list, stain)
	fadeAway(list, 5, 2)
end

-- physical impact: dust cloud, thrown rubble, cracked crater (no rings)
local function shockwave(pos, radius)
	dustCloud(pos + Vector3.new(0, 0.6, 0), radius * 0.55, 14 + radius * 1.5)
	debrisChunks(pos + Vector3.new(0, 0.5, 0), math.clamp(math.floor(radius * 0.7), 3, 12), 25 + radius * 1.5)
	crater(pos, radius * 0.6)
end

local function flash(model)
	local h = Instance.new("Highlight")
	h.FillColor = Color3.new(1, 1, 1)
	h.FillTransparency = 0.55
	h.OutlineTransparency = 1
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Parent = model
	Debris:AddItem(h, 0.08)
end
---------------------------------------------------------------------------
-- weapons + attack poses
--
-- Weapons are welded to the HumanoidRootPart and every attack is animated by
-- tweening that ONE weld. This works identically on R6, R15 and Roblox's newer
-- AnimationConstraint-based avatar joints (which have no Motor6D.C0 to animate).
-- The arm is posed too, but only best-effort: if the rig uses the new joints
-- the arm simply stays put and the weapon still swings.
---------------------------------------------------------------------------
local bodyPose -- defined below with pose()
local R = math.rad
local SIDE = CFrame.Angles(0, 0, R(90)) -- blade pointing out to the right

-- Grip position (studs, relative to the root at scale 1) + grip orientation.
-- The blade extends along the grip's -Y axis.
local POSES = {
	-- shared grips (every one-handed weapon swings through these)
	Idle = { Vector3.new(1.3, -0.4, -0.5), CFrame.Angles(R(60), 0, 0) },
	Raise = { Vector3.new(1.0, 2.4, 0.4), CFrame.Angles(R(233), 0, R(8)) },
	Mid = { Vector3.new(0.6, 2.2, -1.4), CFrame.Angles(R(135), 0, 0) },
	Strike = { Vector3.new(0.2, -0.2, -1.8), CFrame.Angles(0, R(15), 0) * CFrame.Angles(R(50), 0, 0) },
	SweepBack = { Vector3.new(1.6, 0.8, 0.8), CFrame.Angles(0, R(-40), 0) * SIDE },
	SweepMid = { Vector3.new(0, 0.8, -1.8), CFrame.Angles(0, R(90), 0) * SIDE },
	SweepEnd = { Vector3.new(-1.0, 0.8, -0.8), CFrame.Angles(0, R(200), 0) * SIDE },
	Flinch = { Vector3.new(1.4, 0.3, 0.3), CFrame.Angles(R(100), 0, R(25)) },
	Drink = { Vector3.new(1.5, -0.6, 0.6), CFrame.Angles(R(20), 0, 0) },
}
-- each character adds its own grips (see Characters/*.lua, M.Grips)
for name, g in pairs(Roster.grips) do
	POSES[name] = g
end

local function poseCF(name, scale)
	local p = POSES[name]
	return CFrame.new(p[1] * scale) * p[2]
end
-- a dual-wielder's left sword: its own grip "L<name>" if the pose has one, else the right's mirrored
local function poseCFLeft(name, scale)
	if POSES["L" .. name] then
		return poseCF("L" .. name, scale)
	end
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = poseCF(name, scale):GetComponents()
	return CFrame.new(-x, y, z, r00, -r01, -r02, -r10, r11, r12, -r20, r21, r22)
end

-- Only classic, enabled Motor6Ds can be posed this way; anything else is skipped.
local function findShoulder(char)
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("Motor6D") and d.Enabled and d.Part1 and (d.Part1.Name == "RightUpperArm" or d.Part1.Name == "Right Arm") then
			return d
		end
	end
	return nil
end

local BODY_FOR = {
	Idle = "Idle", Raise = "Windup", Strike = "Strike", SweepBack = "SweepWindup", SweepEnd = "SweepEnd",
	Flinch = "Flinch", Drink = "Drink",
}
for name, b in pairs(Roster.bodyFor) do
	BODY_FOR[name] = b
end

bodyPose = function(actor, name, blend)
	local m = actor and (actor.model or (actor.root and actor.root.Parent))
	if not m or not m.Parent then
		return
	end
	m:SetAttribute("BP", name)
	m:SetAttribute("BPT", blend or 0.2)
	m:SetAttribute("BPN", (m:GetAttribute("BPN") or 0) + 1)
end

local function pose(actor, name, t, style, direction)
	if not actor then
		return
	end
	local toIdle = name == "Idle"
	if toIdle and actor.idleGrip then
		name = actor.idleGrip -- each weapon rests in its own grip (Config.Weapons)
	end
	local info = TweenInfo.new(math.max(t, 0.01), style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local weld = actor.weld
	if weld and weld.Parent then
		pcall(function()
			local tw = TweenService:Create(weld, info, { C0 = poseCF(name, actor.scale or 1) })
			actor.tween = tw
			tw:Play()
		end)
	end
	local weld2 = actor.weld2
	if weld2 and weld2.Parent then
		pcall(function()
			TweenService:Create(weld2, info, { C0 = poseCFLeft(name, actor.scale or 1) }):Play()
		end)
	end
	-- the body follows: each weapon pose has a matching full-body pose
	local body = BODY_FOR[name] or (toIdle and "Idle") -- (back to guard: the body too, not just the weapon)
	if body then
		bodyPose(actor, body, t)
	end
end

local function setTrail(actor, on)
	for _, weld in ipairs({ actor and actor.weld or false, actor and actor.weld2 or false }) do
		local weapon = weld and weld.Parent and weld.Parent.Parent
		if weapon then
			local trail = weapon:FindFirstChildWhichIsA("Trail", true)
			if trail then
				trail.Enabled = on
			end
		end
	end
end

-- Hit-stop: freeze an actor's swing (and, for regular enemies, their body) for an instant.
local function hitStopActor(actor, duration, freezeRoot)
	if not actor or not duration or duration <= 0 then
		return
	end
	local tw = actor.tween
	if tw and tw.PlaybackState == Enum.PlaybackState.Playing then
		tw:Pause()
		task.delay(duration, function()
			if actor.tween == tw and tw.PlaybackState == Enum.PlaybackState.Paused then
				tw:Play()
			end
		end)
	end
	local root = freezeRoot and actor.root
	if root and root.Parent and not root.Anchored then
		root.Anchored = true
		task.delay(duration, function()
			if root.Parent then
				root.Anchored = false
				pcall(function()
					root:SetNetworkOwner(nil)
				end)
			end
		end)
	end
end

-- Turning a standing (unanchored) rig by writing its root's CFrame teleports it, and a
-- Humanoid teleported every frame keeps losing its footing: it dips into the floor and
-- the rig guard pops it back up, several times a second (the long-running flicker). So
-- unanchored roots are turned by an AlignOrientation - a physical twist, no teleport -
-- and only anchored roots (mid-leap, mid-charge) are still set directly. The aligner lets
-- go a moment after nothing steers it, so the Humanoid's own AutoRotate takes over again.
local aligners = {} -- [root] = { ao = AlignOrientation, hold = time it lets go }
local function steerYaw(root, yaw)
	if root.Anchored then
		root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
		return
	end
	local a = aligners[root]
	if not (a and a.ao.Parent) then
		local att = Instance.new("Attachment")
		att.Name = "SteerAttachment"
		att.Parent = root
		local ao = Instance.new("AlignOrientation")
		ao.Name = "Steer"
		ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
		ao.Attachment0 = att
		ao.MaxTorque = math.huge
		ao.Responsiveness = 60
		ao.Parent = root
		a = { ao = ao }
		aligners[root] = a
	end
	a.ao.CFrame = CFrame.Angles(0, yaw, 0)
	a.ao.Enabled = true
	a.hold = now() + 0.25
end
game:GetService("RunService").Heartbeat:Connect(function()
	local t = now()
	for root, a in pairs(aligners) do
		if not root.Parent or not a.ao.Parent then
			aligners[root] = nil
		elseif a.ao.Enabled and t > a.hold then
			a.ao.Enabled = false
		end
	end
end)
local function yawOf(v)
	return math.atan2(-v.X, -v.Z)
end

local function faceTowards(root, pos)
	local want = flat(pos - root.Position)
	if want.Magnitude > 0.1 then
		steerYaw(root, yawOf(want))
	end
end
-- Builds a weapon welded to the root. Returns the animated Weld (or nil).
-- The weapon's shape comes from the character file that defines it (M.Weapons).
local function giveWeapon(char, kind, scale, second)
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	scale = scale or 1
	local modelName = second and "Weapon2" or "Weapon" -- (a dual-wielder's left sword)
	local old = char:FindFirstChild(modelName)
	if old then
		old:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = modelName

	local function mk(name, size, color, material)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size * scale
		p.Color = color
		p.Material = material
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end

	local parts = {} -- { part, offsetY, rotation?, offsetZ? } relative to the handle
	local build = Roster.weapons[kind]
	assert(build, "[DGUS] no character file defines the weapon '" .. tostring(kind) .. "'")
	local spec = build({
		mk = mk,
		add = function(p, offsetY, rot, offsetZ)
			table.insert(parts, { p, offsetY, rot, offsetZ })
		end,
		R = R,
		scale = scale,
		wood = Color3.fromRGB(52, 38, 28),
		iron = Color3.fromRGB(46, 42, 38),
	})
	local handle, bladeLen = spec.handle, spec.bladeLen or 3

	-- the one weld that animates everything
	local grip = Instance.new("Weld")
	grip.Name = "GripWeld"
	grip.Part0 = root
	grip.Part1 = handle
	grip.C0 = second and poseCFLeft("Idle", scale) or poseCF("Idle", scale)
	if spec.gripC1 then
		grip.C1 = spec.gripC1 -- where along the handle the hand holds it
	end
	grip.Parent = handle
	handle.CFrame = root.CFrame * grip.C0 * grip.C1:Inverse()

	for _, entry in ipairs(parts) do
		local p, offsetY = entry[1], entry[2]
		local w = Instance.new("Weld")
		w.Part0 = handle
		w.Part1 = p
		w.C0 = CFrame.new(0, offsetY * scale, (entry[4] or 0) * scale) * (entry[3] or CFrame.new())
		w.Parent = p
		p.CFrame = handle.CFrame * w.C0
	end

	-- swing trail along the blade (enabled only during strikes)
	local a0 = Instance.new("Attachment")
	a0.Name = "BladeBase"
	a0.Position = Vector3.new(0, -0.6 * scale, 0)
	a0.Parent = handle
	local a1 = Instance.new("Attachment")
	a1.Name = "BladeTip"
	a1.Position = Vector3.new(0, -(0.6 + bladeLen) * scale, 0)
	a1.Parent = handle
	if spec.setup then
		spec.setup(handle, a0, a1) -- extra attachments, emitters...
	end
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.16
	trail.MinLength = 0
	trail.FaceCamera = true
	trail.LightEmission = 0.3
	trail.Color = ColorSequence.new(Color3.fromRGB(235, 225, 205))
	trail.Transparency = NumberSequence.new(0.35, 1)
	trail.Enabled = false
	trail.Parent = handle

	model.Parent = char
	return grip
end

---------------------------------------------------------------------------
-- player state
---------------------------------------------------------------------------
local states = {}

local function aliveChar(player)
	local char = player.Character
	if not char then
		return nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hum and hrp and hum.Health > 0 then
		return char, hum, hrp
	end
	return nil
end

local function syncStamina(player, st)
	local v = math.floor(st.stamina + 0.5)
	if player:GetAttribute("Stamina") ~= v then
		player:SetAttribute("Stamina", v)
	end
end

local function spend(st, amount)
	-- like the souls games: any stamina above zero lets you act
	if st.stamina <= 0 then
		return false
	end
	st.stamina = math.max(0, st.stamina - amount)
	st.lastSpend = now()
	return true
end

-- What the player is doing right now, as three timestamps:
--   dodgeAt  - from when a roll may cancel it
--   attackAt - from when an attack (or flask) may cancel it
--   busyUntil- when it is fully over (stamina regen waits for this)
local function setAction(st, t, total, dodgeAfter, attackAfter)
	st.busyUntil = t + total
	st.dodgeAt = t + (dodgeAfter or total)
	st.attackAt = t + (attackAfter or total)
end

local function cancelSwing(st)
	st.attackId = (st.attackId or 0) + 1 -- stops the swing's visuals and its hit sweep
	setTrail(st, false)
	pose(st, "Idle", 0.15)
end

local targets = {}
local function registerTarget(fn)
	table.insert(targets, fn)
end

local REACT = Config.HitReactions

local damageEnemy -- defined below; the scythe deflect hits back with it

---------------------------------------------------------------------------
-- STATUS BADGES: a status's name over a bar, on the player's screen (Poison's, Break's)
---------------------------------------------------------------------------
-- built into gui at pos; col = its bar and outline. Returns the bar's fill (and its label).
local function statusBadge(gui, text, pos, col, textCol, backCol, bgCol)
	local badge = Instance.new("Frame")
	badge.Name = "Badge"
	badge.Size = UDim2.fromOffset(200, 44)
	badge.AnchorPoint = Vector2.new(0.5, 0.5)
	badge.Position = pos
	badge.BackgroundColor3 = bgCol
	badge.BackgroundTransparency = 0.2
	badge.BorderSizePixel = 0
	badge.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = badge
	local stroke = Instance.new("UIStroke")
	stroke.Color = col
	stroke.Thickness = 1.5
	stroke.Transparency = 0.2
	stroke.Parent = badge
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.new(1, -20, 0, 20)
	label.Position = UDim2.fromOffset(10, 4)
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = textCol
	label.Font = Enum.Font.Garamond
	label.TextSize = 20
	label.Parent = badge
	local back = Instance.new("Frame")
	back.Name = "BarBack"
	back.Size = UDim2.new(1, -20, 0, 8)
	back.Position = UDim2.fromOffset(10, 28)
	back.BackgroundColor3 = backCol
	back.BorderSizePixel = 0
	back.Parent = badge
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = col
	fill.BorderSizePixel = 0
	fill.Parent = back
	return fill, label
end

---------------------------------------------------------------------------
-- BREAK (Config.Break): breakPlayer(player, amount) builds it (the dogs' bites). The meter
-- shows on a badge above Poison's while it's up; full, you're BROKEN and every hit on you
-- does DamageMult times as much (damagePlayer), the badge counting it down.
---------------------------------------------------------------------------
local BREAK = {} -- [player] = { value, last, brokenUntil, char, gui, fill, label }
local BCOL = Color3.fromRGB(196, 92, 64) -- a raw, bruised orange-red
local function clearBreak(pl)
	local b = BREAK[pl]
	BREAK[pl] = nil
	pl:SetAttribute("Broken", nil) -- (the client lets you walk again)
	if b and b.gui and b.gui.Parent then
		b.gui:Destroy()
	end
end
local function breakMult(pl)
	local b = BREAK[pl]
	return (b and now() < b.brokenUntil) and Config.Break.DamageMult or 1
end
local function breakPlayer(pl, amount)
	local char, _, hrp = aliveChar(pl)
	if not char then
		return
	end
	local CFG = Config.Break
	local b = BREAK[pl]
	if not b or b.char ~= char then
		clearBreak(pl)
		local pg = pl:FindFirstChildOfClass("PlayerGui")
		if not pg then
			return
		end
		local gui = Instance.new("ScreenGui")
		gui.Name = "Break"
		gui.ResetOnSpawn = true
		gui.IgnoreGuiInset = true
		gui.DisplayOrder = 5
		local fill, label = statusBadge(gui, "BREAK", CFG.HudPosition, BCOL, Color3.fromRGB(240, 196, 170), Color3.fromRGB(44, 24, 20), Color3.fromRGB(22, 12, 10))
		gui.Parent = pg
		b = { value = 0, last = now(), brokenUntil = 0, char = char, gui = gui, fill = fill, label = label }
		BREAK[pl] = b
	end
	b.last = now()
	if now() < b.brokenUntil then
		return -- (broken already: it can't fill any further)
	end
	b.value = math.min(CFG.Max, b.value + amount)
	if b.value >= CFG.Max then
		b.brokenUntil = now() + CFG.Duration
		b.label.Text = "BROKEN"
		pl:SetAttribute("Broken", true) -- (the client roots you while it's set)
		burst(hrp.Position + Vector3.new(0, 1, 0), BCOL, 30, 0.45, 18)
		playSound(hrp, SOUNDS.Impact, 0.9, 0.6)
	end
end
-- the meter drains when it's left alone; broken, the badge counts down, then it's gone
game:GetService("RunService").Heartbeat:Connect(function(dt)
	local CFG = Config.Break
	for pl, b in pairs(BREAK) do
		if not pl.Parent or aliveChar(pl) ~= b.char then
			clearBreak(pl)
		elseif now() < b.brokenUntil then
			b.fill.Size = UDim2.fromScale((b.brokenUntil - now()) / CFG.Duration, 1)
		elseif b.brokenUntil > 0 then
			clearBreak(pl) -- (it's run its course)
		else
			if now() - b.last > CFG.DrainDelay then
				b.value -= CFG.DrainPerSec * dt
			end
			if b.value <= 0 then
				clearBreak(pl)
			else
				b.fill.Size = UDim2.fromScale(b.value / CFG.Max, 1)
			end
		end
	end
end)

-- level: "Small" | "Medium" | "Large" | "Knockdown" | "Launch" (Config.HitReactions)
local function damagePlayer(player, amount, fromPos, level)
	local st = states[player]
	local char, hum, hrp = aliveChar(player)
	if not st or not char then
		return false
	end
	level = REACT[level] and level or "Medium"
	local t = now()
	if t >= st.iStart and t <= st.iEnd then
		if Config.Debug then
			print(string.format("[Deflect] hit absorbed by i-frames (%.2fs left)", st.iEnd - t))
		end
		return false -- rolled through it (or still down from a knockdown, or deflect i-frames)
	end
	if t < st.hurtImmuneUntil then
		if Config.Debug then
			print("[Deflect] hit absorbed: just hurt (0.4s grace)")
		end
		return false
	end
	if Config.Debug and (st.deflectEnd or 0) > 0 then
		print(string.format("[Deflect] hit at %+.2fs from the window opening", t - (st.deflectStart or 0)))
	end

	-- LIES OF P STYLE DEFLECT (SCYTHE EXCLUSIVE):
	-- If the player hit deflect and then a few frames later they WOULD have taken an instance of damage,
	-- deflect the hit completely: 0 damage, crisp deflect sound instantly, and i-frames for 2/3rds of a dodgeroll
	-- without moving like a dodge.
	local isScythe = player:GetAttribute("Weapon") == "Scythe"
	if isScythe and st.deflectEnd and (st.deflectEnd > 0) and t >= (st.deflectStart or 0) and t <= st.deflectEnd then
		st.deflectEnd = 0 -- consume deflect window
		local CFG = Config.ScytheDeflect
		local iDur = CFG.IFrameDuration -- 2/3rds of dodgeroll (~0.26s)
		st.iStart = t
		st.iEnd = t + iDur

		-- Sound: crisp deflect sound instantly on hrp
		playSound(hrp, SOUNDS.Deflect, 1.0, 1.0)
		playSound(hrp, CFG.Sound2, 0.9, 1.3)
		playSound(hrp, SOUNDS.Unsheath, 0.7, 1.8)

		-- Sparks burst towards the incoming attack
		local dir = flat(fromPos - hrp.Position)
		dir = dir.Magnitude > 0.01 and dir.Unit or hrp.CFrame.LookVector
		local sparkPos = hrp.Position + dir * 1.5 + Vector3.new(0, 1.2, 0)
		burst(sparkPos, Color3.fromRGB(255, 235, 140), 25, 0.35, 18)
		burst(sparkPos, Color3.fromRGB(255, 255, 255), 15, 0.2, 12)

		-- Client feedback: screen shake & instant confirm
		FxRemote:FireClient(player, "DeflectConfirm", sparkPos)
		FxRemote:FireAllClients("Shake", sparkPos, 0.45)

		-- Deflect parry pose hold, then return to Idle
		pose(st, "UDeflect", 0.04)
		task.delay(iDur, function()
			pose(st, "Idle", 0.15)
		end)

		-- the deflect cuts back: damage + 1.5x posture to every enemy within a scythe's length
		for _, enemy in ipairs(EnemiesFolder:GetChildren()) do
			local eroot = enemy:FindFirstChild("HumanoidRootPart")
			if eroot and flat(eroot.Position - hrp.Position).Magnitude <= CFG.Radius + (enemy:GetAttribute("Radius") or 0) then
				damageEnemy(enemy, CFG.Damage, player, CFG.Poise, 0.12)
			end
		end

		return false
	end

	local r = REACT[level]
	st.hurtImmuneUntil = t + 0.4
	hum:TakeDamage(amount * breakMult(player)) -- (broken: Config.Break)
	st.healing = false
	st.lastKind = nil
	st.deflectEnd = 0 -- hit mid-twirl: that deflect is lost
	cancelSwing(st)
	setAction(st, t, r.Stun, r.RollOut or r.Stun, r.Stun)
	if r.Down then
		st.iStart, st.iEnd = t + r.IFrom, t + r.ITo
	end
	local dir = flat(hrp.Position - fromPos)
	dir = dir.Magnitude > 0.01 and dir.Unit or -flat(hrp.CFrame.LookVector).Unit
	FxRemote:FireClient(player, "Hurt", dir, level)
	burst(hrp.Position + Vector3.new(0, 1, 0), Color3.fromRGB(110, 10, 10), 16, 0.3, 14)
	playSound(hrp, SOUNDS.Impact, 0.35, 1.4)
	return true
end

local function playersInSector(cf, range, halfAngle, height)
	local out = {}
	local look = flat(cf.LookVector).Unit
	for _, pl in ipairs(Players:GetPlayers()) do
		local char, _, hrp = aliveChar(pl)
		if char then
			local rel = hrp.Position - cf.Position
			local fl = flat(rel)
			if fl.Magnitude <= range + 1 and math.abs(rel.Y) <= height then
				if fl.Magnitude < 2 or math.deg(math.acos(math.clamp(fl.Unit:Dot(look), -1, 1))) <= halfAngle then
					table.insert(out, pl)
				end
			end
		end
	end
	return out
end

local function playersInRadius(pos, radius, height)
	local out = {}
	for _, pl in ipairs(Players:GetPlayers()) do
		local char, _, hrp = aliveChar(pl)
		if char then
			local rel = hrp.Position - pos
			if flat(rel).Magnitude <= radius + 1 and math.abs(rel.Y) <= height then
				table.insert(out, pl)
			end
		end
	end
	return out
end

local function enemiesInSector(cf, range, halfAngle)
	local out = {}
	local look = flat(cf.LookVector).Unit
	for _, m in ipairs(EnemiesFolder:GetChildren()) do
		local hum = m:FindFirstChildOfClass("Humanoid")
		local root = m:FindFirstChild("HumanoidRootPart")
		if hum and root and hum.Health > 0 then
			local rel = root.Position - cf.Position
			local fl = flat(rel)
			local radius = m:GetAttribute("Radius") or 1.2
			if fl.Magnitude - radius <= range and math.abs(rel.Y) <= 14 then
				if fl.Magnitude <= radius + 1.5 or math.deg(math.acos(math.clamp(fl.Unit:Dot(look), -1, 1))) <= halfAngle then
					table.insert(out, m)
				end
			end
		end
	end
	return out
end
local function makeRig(name, kind, scale, weaponKind)
	local model, hum = RigBuilder.build(kind, scale)
	model.Name = name
	pcall(function()
		-- never streamed in piece by piece (that is what sinks custom rigs on clients)
		model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	end)
	local weld = weaponKind and giveWeapon(model, weaponKind, scale) or nil -- (a dog has no weapon)
	applyLimbGroup(model)
	model.Parent = EnemiesFolder
	hum.HipHeight = model:GetAttribute("HipHeight") -- again, after parenting
	return model, hum, weld
end

-- RIG GUARD: keeps every rig standing at its true height. Re-asserts HipHeight
-- (Roblox can recompute it) and lifts any unanchored, server-owned rig whose
-- root has sunk toward the floor back onto it.
local guardParams = RaycastParams.new()
guardParams.FilterType = Enum.RaycastFilterType.Exclude
guardParams.RespectCanCollide = true -- (else a rig walking under a hanging chain or banner is lifted onto it)
local function guardRig(model, serverOwned)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	local want = model:GetAttribute("HipHeight")
	local stand = model:GetAttribute("StandHeight")
	if not (hum and root and want and stand) or hum.Health <= 0 then
		return
	end
	if math.abs(hum.HipHeight - want) > 0.01 then
		hum.HipHeight = want
	end
	if serverOwned and not root.Anchored then
		-- a player's client must never simulate a rig (its posed legs and HipHeight differ there)
		local okOwner, owner = pcall(function()
			return root:GetNetworkOwner()
		end)
		if okOwner and owner ~= nil then
			pcall(function()
				root:SetNetworkOwner(nil)
			end)
		end
		guardParams.FilterDescendantsInstances = { EnemiesFolder }
		guardParams.CollisionGroup = root.CollisionGroup -- (the Castellan walks through props: don't stand him on them)
		local res = workspace:Raycast(root.Position + Vector3.new(0, stand, 0), Vector3.new(0, -stand * 3, 0), guardParams)
		if res and root.Position.Y - res.Position.Y < stand - 0.6 then
			-- it has stopped holding itself up: lift it, and put its Humanoid back into its
			-- standing state (a waiting rig that isn't "Running" just sinks, again and again)
			local state = hum:GetState()
			root.CFrame = root.CFrame + Vector3.new(0, res.Position.Y + stand - root.Position.Y, 0)
			root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
			pcall(function()
				hum:ChangeState(Enum.HumanoidStateType.Running)
			end)
			if Config.Debug and os.clock() - (model:GetAttribute("GuardLog") or 0) > 2 then
				model:SetAttribute("GuardLog", os.clock())
				print(string.format("[RigGuard] lifted %s out of the floor (state %s, owner %s, HipHeight %.2f)", model.Name, state.Name, okOwner and tostring(owner) or "?", hum.HipHeight))
			end
		end
	end
end
task.spawn(function()
	while true do
		for _, m in ipairs(EnemiesFolder:GetChildren()) do
			guardRig(m, true)
		end
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl.Character then
				guardRig(pl.Character, false)
			end
		end
		task.wait(0.1)
	end
end)
-- BOSS FOOTING: a boss's height is held on the floor under it every frame. (The rig guard
-- above only steps in once a rig has sunk well into the floor and then pops it back up;
-- for the heavy bosses that dip-and-pop read as bouncing.) Skipped while the root is
-- anchored (leaps, charges, her floating moves: those carry it themselves) or while the
-- model is flagged "Airborne" (a move that throws it into the air, e.g. the Warden's stomp).
local footParams = RaycastParams.new()
footParams.FilterType = Enum.RaycastFilterType.Exclude
footParams.RespectCanCollide = true
game:GetService("RunService").Heartbeat:Connect(function()
	local ignore
	for _, m in ipairs(EnemiesFolder:GetChildren()) do
		local root, hum, stand = m:FindFirstChild("HumanoidRootPart"), m:FindFirstChildOfClass("Humanoid"), m:GetAttribute("StandHeight")
		if m:GetAttribute("Boss") and not m:GetAttribute("Airborne") and root and hum and stand and hum.Health > 0 and not root.Anchored then
			if not ignore then
				ignore = { EnemiesFolder }
				for _, pl in ipairs(Players:GetPlayers()) do
					if pl.Character then
						table.insert(ignore, pl.Character)
					end
				end
				footParams.FilterDescendantsInstances = ignore
			end
			footParams.CollisionGroup = root.CollisionGroup
			local res = workspace:Raycast(root.Position, Vector3.new(0, -stand * 2, 0), footParams)
			if res then
				local dy = res.Position.Y + stand - root.Position.Y
				if math.abs(dy) > 0.03 and math.abs(dy) < stand then
					root.CFrame += Vector3.new(0, dy, 0)
					local v = root.AssemblyLinearVelocity
					root.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
				end
			end
		end
	end
end)

local function makeCorpse(model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = "Corpse"
			d.CanCollide = d.Name ~= "HumanoidRootPart"
			d.Massless = false
		end
	end
end
-- Go limp (call after makeCorpse; the rig needs BreakJointsOnDeath = false): every body
-- joint becomes a loose ball socket, the root rides along with the hips, and the weapon
-- drops out of the hand, so the body crumples to the floor.
local function ragdoll(model)
	local root = model:FindFirstChild("HumanoidRootPart")
	for _, m in ipairs(model:GetDescendants()) do
		if m:IsA("Motor6D") and m.Part0 and m.Part1 then
			if m.Part0 == root then
				local w = Instance.new("WeldConstraint")
				w.Part0, w.Part1 = root, m.Part1
				w.Parent = root
			else
				local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
				a0.CFrame, a1.CFrame = m.C0, m.C1
				a0.Parent, a1.Parent = m.Part0, m.Part1
				local bs = Instance.new("BallSocketConstraint")
				bs.Attachment0, bs.Attachment1 = a0, a1
				bs.LimitsEnabled = true
				bs.UpperAngle = 60
				bs.TwistLimitsEnabled = true
				bs.TwistLowerAngle, bs.TwistUpperAngle = -40, 40
				bs.Parent = m.Part1
			end
			m.Enabled = false
		end
	end
	local grip = model:FindFirstChild("GripWeld", true)
	if grip then
		grip:Destroy()
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("AlignOrientation") then
			d:Destroy() -- (the steering twist: a corpse falls however it falls)
		end
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
			pcall(function()
				d:SetNetworkOwner(nil) -- the server drops them, so every client sees the same fall
			end)
		end
	end
end
-- turn at most maxRad toward pos (no instant snapping)
local function turnTowards(root, pos, maxRad)
	local p = root.Position
	local want = flat(pos - p)
	if want.Magnitude < 0.1 then
		return
	end
	-- step from where it's already being steered (the aligner lags the real facing a touch)
	local a = aligners[root]
	local curYaw = (a and a.ao.Enabled and not root.Anchored) and select(2, a.ao.CFrame:ToOrientation()) or yawOf(flat(root.CFrame.LookVector))
	local d = (yawOf(want) - curYaw + math.pi) % (2 * math.pi) - math.pi
	steerYaw(root, curYaw + math.clamp(d, -maxRad, maxRad))
end
local function rand(lo, hi)
	return lo + math.random() * (hi - lo)
end
-- The floor heaves before something bursts out of it: spreading cracks,
-- puffs of dust, hopping pebbles and a low rumble. No markers.
local function groundHeave(pos, radius, lead)
	local cracks = crackLines(Vector3.new(pos.X, pos.Y + 0.03, pos.Z), radius, 5, nil, nil, lead * 0.8)
	fadeAway(cracks, lead + 2, 1.5)
	local rumble = fxAnchor(pos + Vector3.new(0, 1, 0))
	playSound(rumble, SOUNDS.Impact, 0.35, 0.25)
	Debris:AddItem(rumble, lead + 1)
	for i = 0, 1 do
		task.delay(lead * i * 0.5, function()
			dustCloud(pos + Vector3.new(0, 0.3, 0), radius * 0.22, 4)
			for _ = 1, 4 do
				local pb = Instance.new("Part")
				pb.Size = Vector3.new(0.25, 0.2, 0.25)
				pb.Material = Enum.Material.Slate
				pb.Color = Color3.fromRGB(80, 76, 70)
				pb.CanQuery = false
				pb.CanTouch = false
				pb.CollisionGroup = "Debris"
				pb.Position = pos + Vector3.new((math.random() - 0.5) * radius, 0.3, (math.random() - 0.5) * radius)
				pb.Parent = workspace
				pb.AssemblyLinearVelocity = Vector3.new(0, 10 + math.random() * 8, 0)
				Debris:AddItem(pb, 1.2)
			end
		end)
	end
end

-- BONE SPLINTER: every boss leaves one on the floor where it fell (ignore = its model).
-- Taken once, by whoever gets there first ("Splinters" attribute); each one raises a stat
-- by 1 at a bonfire (the "LevelUp" action, init.server).
local function dropSplinter(pos, ignore)
	task.delay(3, function()
		local params = RaycastParams.new()
		params.FilterDescendantsInstances = { ignore }
		local hit = workspace:Raycast(pos, Vector3.new(0, -60, 0), params)
		local at = (hit and hit.Position or pos) + Vector3.new(0, 0.8, 0)
		local p = Instance.new("Part")
		p.Name = "BoneSplinter"
		p.Size = Vector3.new(0.3, 1.3, 0.3)
		p.Color = Color3.fromRGB(226, 214, 186)
		p.Material = Enum.Material.SmoothPlastic
		p.Anchored, p.CanCollide, p.CanTouch = true, false, false
		p.CFrame = CFrame.new(at) * CFrame.Angles(0.5, math.random() * 6, 0.3)
		local l = Instance.new("PointLight")
		l.Color, l.Range, l.Brightness = Color3.fromRGB(255, 226, 170), 8, 1.2
		l.Parent = p
		local pp = Instance.new("ProximityPrompt")
		pp.ActionText = "Take"
		pp.ObjectText = "Bone Splinter"
		pp.HoldDuration = 0.3
		pp.MaxActivationDistance = 10
		pp.RequiresLineOfSight = false
		pp.Parent = p
		p.Parent = workspace
		burst(at, Color3.fromRGB(255, 226, 170), 16, 0.3, 8)
		pp.Triggered:Connect(function(pl)
			if not pp.Enabled then
				return
			end
			pp.Enabled = false
			p:Destroy()
			pl:SetAttribute("Splinters", (pl:GetAttribute("Splinters") or 0) + 1)
			FxRemote:FireClient(pl, "Message", "Bone Splinter. Rest at a bonfire to grow stronger.")
		end)
	end)
end

---------------------------------------------------------------------------
-- hits on enemies: every character registers how to find its poise/actor
---------------------------------------------------------------------------
-- (targets and registerTarget declared above)

function damageEnemy(model, amount, player, poiseDamage, hitStop)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then
		return
	end
	local info
	for _, fn in ipairs(targets) do
		info = fn(model)
		if info then
			break
		end
	end
	if info and info.evade and info.evade(player) then
		return -- slipped the blow (e.g. Oculast's counter stance)
	end
	if info and info.damageMult then
		amount *= info.damageMult(player)
	end
	hum:TakeDamage(amount)
	flash(model)
	burst(root.Position + Vector3.new(0, (model:GetAttribute("Radius") or 1) * 0.5, 0), Color3.fromRGB(90, 12, 10), 14, 0.3, 14)
	playSound(root, SOUNDS.Impact, 0.5, 1.6 + math.random() * 0.3)
	FxRemote:FireClient(player, "HitConfirm", hitStop or 0)
	if hum.Health <= 0 then
		player:SetAttribute("Kills", (player:GetAttribute("Kills") or 0) + 1) -- (Giles counts them: Config.Taylor)
		-- a kill with the Usher's harvest-blade may leave a Bone Splinter (Config.ScytheSplinter)
		local S = Config.ScytheSplinter
		if player:GetAttribute("Weapon") == "Scythe" and math.random() < S.Chance + S.PerDarkness * Config.statOf(player, "Darkness") then
			dropSplinter(root.Position, model)
		end
		return
	end
	if not info then
		return
	end
	if info.onHit then
		info.onHit(player)
	end
	-- hit-stop: the target's swing freezes too (regular enemies freeze in place)
	hitStopActor(info.actor, hitStop, info.freeze == true)
	-- poise: chip it down; when it breaks, the target staggers
	local owner = info.owner
	local t = now()
	if not owner.poise or t - (owner.lastPoiseHit or 0) > 5 then
		owner.poise = info.maxPoise -- poise recovers if left alone for a few seconds
	end
	owner.lastPoiseHit = t
	local dmg = poiseDamage or 10
	if info.armor then
		dmg *= 0.5 -- hyper armor: tougher to interrupt mid-swing
	end
	owner.poise -= dmg
	if owner.poise > 0 then
		return
	end
	owner.poise = info.maxPoise
	if info.onBreak then
		info.onBreak(player, t, hitStop)
	end
end

-- STATS (Config.Stats): each a "Stat_<name>" player attribute, 0 until levelled at a bonfire
local function stat(pl, name)
	return pl:GetAttribute("Stat_" .. name) or 0
end

-- put one of Config.Weapons in a player's hands. The "Weapon" attribute keeps it
-- across deaths (onCharacter re-arms from it); with no character it waits for one.
-- false (and nothing changes) if they lack the weapon's Strength (armor's counts)
local function equipWeapon(pl, kind)
	local st, def = states[pl], Config.Weapons[kind]
	if not (st and def) or Config.statOf(pl, "Strength") < (def.Strength or 0) or Config.statOf(pl, "Fire") < (def.FireReq or 0) then
		return false
	end
	pl:SetAttribute("Weapon", kind)
	local char = pl.Character
	if not (char and char:FindFirstChild("HumanoidRootPart")) then
		return
	end
	st.attackId = (st.attackId or 0) + 1 -- drop any swing in progress
	local g = char:GetAttribute("Grow") or 1 -- (armor that makes you bigger: so does your weapon)
	st.scale = g ~= 1 and g or nil -- (the grips are measured from your root)
	st.weld = giveWeapon(char, kind, def.Scale * g)
	if def.Dual then
		st.weld2 = giveWeapon(char, kind, def.Scale * g, true)
	else
		st.weld2 = nil
		local old = char:FindFirstChild("Weapon2")
		if old then
			old:Destroy()
		end
	end
	st.idleGrip = def.Idle
	char:SetAttribute("TwoHand", def.TwoHand) -- read by the Puppeteer (left hand on the haft)
	pose(st, "Idle", 0.2)
	return true
end

---------------------------------------------------------------------------
-- POISON: a status anything can inflict (Oculast's breath, the township fog).
-- poisonPlayer(player, opts) with opts = { Total, DPS, TickTime?, Label?, HudPosition? }:
-- it eats away opts.Total health over time, no matter what you do; poisoning someone
-- already poisoned tops it back up (it doesn't stack). A badge with a draining bar
-- shows on their HUD (centred, low on the screen), the screen goes faintly sickly, and green wisps rise off them so
-- other players can see it too. It ends when it has done all its damage, when they die,
-- or on clearPoison(player) / clearAllPoison(). Built on the server: no client changes.
---------------------------------------------------------------------------
local POISON = {} -- [player] = { left, opts, char, gui, fill, tint, wisps, hl }
local PCOL = Color3.fromRGB(150, 178, 70)

local function poisonHud(pl, opts)
	local pg = pl:FindFirstChildOfClass("PlayerGui")
	if not pg then
		return nil
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "Poison"
	gui.ResetOnSpawn = true
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 5
	-- a faint sick tint over the whole screen, pulsing with each tick
	local tint = Instance.new("Frame")
	tint.Name = "Tint"
	tint.Size = UDim2.fromScale(1, 1)
	tint.BackgroundColor3 = PCOL
	tint.BackgroundTransparency = 0.93
	tint.BorderSizePixel = 0
	tint.Active = false
	tint.Parent = gui
	local fill = statusBadge(gui, opts.Label or "POISONED", opts.HudPosition or UDim2.fromScale(0.5, 0.8), PCOL, Color3.fromRGB(205, 220, 150), Color3.fromRGB(36, 40, 24), Color3.fromRGB(18, 20, 12))
	gui.Parent = pg
	return gui, fill, tint
end

local function clearPoison(pl)
	local p = POISON[pl]
	if not p then
		return
	end
	POISON[pl] = nil
	for _, x in ipairs({ p.gui, p.wisps, p.hl }) do
		if x and x.Parent then
			x:Destroy()
		end
	end
end

local function clearAllPoison()
	for pl in pairs(POISON) do
		clearPoison(pl)
	end
end

local function poisonPlayer(pl, opts)
	if not opts or (opts.Total or 0) <= 0 then
		return
	end
	local char, _, hrp = aliveChar(pl)
	if not char then
		return
	end
	local cur = POISON[pl]
	if cur and cur.char == char then
		cur.left = math.max(cur.left, opts.Total) -- poisoned again: topped back up
		cur.opts = opts
		return
	end
	clearPoison(pl)
	local gui, fill, tint = poisonHud(pl, opts)
	local wisps = Instance.new("ParticleEmitter")
	wisps.Name = "PoisonWisps"
	wisps.Texture = "rbxasset://textures/particles/smoke_main.dds"
	wisps.Rate = 7
	wisps.Lifetime = NumberRange.new(0.8, 1.4)
	wisps.Speed = NumberRange.new(1, 2.5)
	wisps.SpreadAngle = Vector2.new(30, 30)
	wisps.EmissionDirection = Enum.NormalId.Top
	wisps.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1.4) })
	wisps.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
	wisps.Color = ColorSequence.new(PCOL)
	wisps.LightEmission = 0.3
	wisps.Parent = hrp
	local hl = Instance.new("Highlight")
	hl.Name = "PoisonTint"
	hl.FillColor = PCOL
	hl.FillTransparency = 0.82
	hl.OutlineTransparency = 1
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.Parent = char
	POISON[pl] = { left = opts.Total, opts = opts, char = char, gui = gui, fill = fill, tint = tint, wisps = wisps, hl = hl }
	playSound(hrp, SOUNDS.Groan, 0.45, 1.7)
end

task.spawn(function()
	local pulse = false
	local STEP = 0.5
	while true do
		task.wait(STEP)
		pulse = not pulse
		for pl, p in pairs(POISON) do
			local hum = p.char and p.char:FindFirstChildOfClass("Humanoid")
			if not pl.Parent or pl.Character ~= p.char or not hum or hum.Health <= 0 then
				clearPoison(pl)
			else
				local d = math.min(p.opts.DPS * STEP, p.left)
				hum.Health = math.max(0, hum.Health - d)
				p.left -= d
				if p.fill and p.fill.Parent then
					p.fill.Size = UDim2.fromScale(math.clamp(p.left / p.opts.Total, 0, 1), 1)
				end
				if p.tint and p.tint.Parent then
					p.tint.BackgroundTransparency = pulse and 0.9 or 0.94
				end
				if p.left <= 0.001 then
					clearPoison(pl)
				end
			end
		end
	end
end)

return {
	Config = Config, P = P, Map = Map, EnemiesFolder = EnemiesFolder, FxRemote = FxRemote, ActionRemote = ActionRemote,
	states = states, REACT = REACT, Roster = Roster, RigBuilder = RigBuilder,
	now = now, flat = flat, rand = rand, turnTowards = turnTowards,
	SOUNDS = SOUNDS, playSound = playSound,
	burst = burst, fxAnchor = fxAnchor, dustCloud = dustCloud, debrisChunks = debrisChunks, crackLines = crackLines,
	fadeAway = fadeAway, crater = crater, shockwave = shockwave, flash = flash, groundHeave = groundHeave,
	SMOKE = SMOKE, SPARK = SPARK, R = R, SIDE = SIDE,
	POSES = POSES, poseCF = poseCF, pose = pose, bodyPose = bodyPose, setTrail = setTrail, hitStopActor = hitStopActor,
	faceTowards = faceTowards, steerYaw = steerYaw, findShoulder = findShoulder,
	makeRig = makeRig, giveWeapon = giveWeapon, makeCorpse = makeCorpse, ragdoll = ragdoll, applyLimbGroup = applyLimbGroup, guardRig = guardRig,
	aliveChar = aliveChar, damagePlayer = damagePlayer, playersInSector = playersInSector, playersInRadius = playersInRadius,
	spend = spend, setAction = setAction, cancelSwing = cancelSwing, syncStamina = syncStamina, equipWeapon = equipWeapon, stat = stat, dropSplinter = dropSplinter,
	enemiesInSector = enemiesInSector, damageEnemy = damageEnemy, registerTarget = registerTarget,
	poisonPlayer = poisonPlayer, clearPoison = clearPoison, clearAllPoison = clearAllPoison, breakPlayer = breakPlayer,
}
]]></ProtectedString>
					<string name="ScriptGuid">{97E2EB34-5078-4DEF-B85A-0C97D1512668}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Core</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">37103886d8e24c800aefca76000003ee</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000019">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Enemies: the shared brain for regular enemies (Hollow, Skeleton, Jailer...).
-- Seeing you, chasing (straight or by pathfinding), giving up past the leash,
-- walking home, healing, dying and respawning all live here. What a KIND of
-- enemy is (stats, looks, weapon, attacks) lives in its own character file:
--   ReplicatedStorage/Characters/<Kind>.lua  ->  M.Def (stats) and M.attack(e, target)
-- To add a new kind: write its character file and add spawns in MapBuilder.
local Enemies = {}

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local PathfindingService = game:GetService("PathfindingService")
local Map, EnemiesFolder, Roster
local now, flat, playSound, SOUNDS, burst, pose, setTrail, faceTowards, findShoulder, makeRig, makeCorpse, ragdoll, aliveChar

local enemyList = {}
local enemyByModel = {}
local losParams = RaycastParams.new()
losParams.FilterType = Enum.RaycastFilterType.Exclude
local navParams = RaycastParams.new()
navParams.FilterType = Enum.RaycastFilterType.Exclude

local function defOf(kind)
	local c = Roster.byKind[kind]
	return c and c.Def, c
end

local function canSee(fromPos, char)
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return false
	end
	local res = workspace:Raycast(fromPos, hrp.Position - fromPos, losParams)
	return res == nil or res.Instance:IsDescendantOf(char)
end

local function findTarget(e)
	local best, bestD
	for _, pl in ipairs(Players:GetPlayers()) do
		local char, _, hrp = aliveChar(pl)
		if char then
			local d = (hrp.Position - e.root.Position).Magnitude
			local range = e.aggro and e.def.Aggro * 1.6 or e.def.Aggro
			if d <= range and (bestD == nil or d < bestD) then
				if e.aggro or canSee(e.root.Position + Vector3.new(0, 1.5, 0), char) then
					best, bestD = char, d
				end
			end
		end
	end
	return best, bestD
end
local function navigate(e, goal, targetChar)
	local root, hum = e.root, e.hum
	local from = root.Position
	if math.abs(goal.Y - from.Y) < 2.5 then
		navParams.FilterDescendantsInstances = targetChar and { EnemiesFolder, Map.Bars, targetChar } or { EnemiesFolder, Map.Bars }
		if not workspace:Raycast(from, goal - from, navParams) then
			e.path = nil
			hum:MoveTo(goal)
			return
		end
	end
	local t = now()
	if not e.path or t > (e.pathExpire or 0) or (e.pathGoal - goal).Magnitude > 8 then
		e.pathExpire = t + 1
		e.pathGoal = goal
		if not e.pathObj then
			e.pathObj = PathfindingService:CreatePath({
				AgentRadius = 1.6 * e.def.Scale,
				AgentHeight = 5 * e.def.Scale,
				AgentCanJump = false,
				WaypointSpacing = 4,
			})
		end
		local ok = pcall(function()
			e.pathObj:ComputeAsync(from, goal)
		end)
		if ok and e.pathObj.Status == Enum.PathStatus.Success then
			e.path = e.pathObj:GetWaypoints()
			e.wp = 2
		else
			e.path = nil
			hum:MoveTo(goal) -- best effort
			return
		end
	end
	local wps = e.path
	from = root.Position
	while e.wp <= #wps and flat(wps[e.wp].Position - from).Magnitude < 2.5 do
		e.wp += 1
	end
	hum:MoveTo(e.wp <= #wps and wps[e.wp].Position or goal)
end

local function enemyAI(e)
	local def = e.def
	while e.alive and e.model.Parent do
		task.wait(0.1)
		if not e.alive then
			break
		end
		if now() < e.staggerUntil then
			continue
		end
		local hum, root = e.hum, e.root
		if e.spec.Ledge and root.Position.Y < e.home.Position.Y - 30 then -- (walked off its spire into the lava: gone, not stranded below)
			hum.Health = 0
			break
		end
		local homeDist = flat(root.Position - e.home.Position).Magnitude
		local target = findTarget(e)
		if target and homeDist > def.Leash then
			target = nil
			e.returning = true
		end
		if e.returning and homeDist < 4 then
			e.returning = false
		end
		if target and not e.returning then
			e.aggro = true
			local tRoot = target:FindFirstChild("HumanoidRootPart")
			if tRoot then
				local d = flat(tRoot.Position - root.Position).Magnitude
				-- NoticeRange: hands it to the character file from further out until it has
				-- noticed you once (the dog turns, sees you, and leaps from there)
				local engage = (def.NoticeRange and not e.noticed) and def.NoticeRange or def.Engage or def.Range - 0.5
				if d <= engage and not (e.char.crowded and e.char.crowded(e)) then
					local ok, err = pcall(e.char.attack, e, target)
					if not ok then
						warn("[DGUS] enemy attack error: " .. tostring(err))
						e.attacking = false
						hum.AutoRotate = true
					end
				else
					navigate(e, e.char.steer and e.char.steer(e, tRoot.Position) or tRoot.Position, target) -- (the Tillers keep apart)
				end
			end
		else
			e.aggro = false
			if homeDist > 2 then
				navigate(e, e.home.Position, nil)
			else
				hum:MoveTo(root.Position)
				faceTowards(root, root.Position + e.home.LookVector)
				if hum.Health < hum.MaxHealth then
					hum.Health = math.min(hum.MaxHealth, hum.Health + hum.MaxHealth * 0.02)
				end
			end
		end
	end
end
local function onEnemyDied(e)
	if not e.alive then
		return
	end
	e.alive = false
	if e.char and e.char.onDied then -- (the Tillers: both down opens the Citadel's gate)
		local ok, err = pcall(e.char.onDied, e)
		if not ok then
			warn("[DGUS] onDied error: " .. tostring(err))
		end
	end
	makeCorpse(e.model)
	ragdoll(e.model) -- limp, down to the floor
	local root = e.root
	if root and root.Parent then
		playSound(root, SOUNDS.Groan, 0.4, 0.6)
		burst(root.Position, Color3.fromRGB(70, 66, 60), 20, 0.5, 8)
	end
	local model = e.model
	task.delay(3, function()
		if not model.Parent then
			return
		end
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				TweenService:Create(d, TweenInfo.new(1.2), { Transparency = 1 }):Play()
			end
		end
		task.wait(1.3)
		model:Destroy()
	end)
end

local function spawnEnemy(spec)
	local def, char = defOf(spec.Type)
	if not def then
		warn("[DGUS] no character file for enemy kind " .. tostring(spec.Type))
		return nil
	end
	if spec.Elite then -- (the prison roof's: stouter, quicker, bigger and harder-hitting than the kind's own)
		def = table.clone(def)
		def.HP *= 2.2
		def.Speed *= 1.35
		def.Windup *= 0.75
		def.Recover *= 0.8
		def.Damage *= 1.2
		def.Scale *= 1.15
		def.Radius *= 1.15
	end
	local model, hum, weld = makeRig(spec.Type, spec.Type, def.Scale, def.Weapon)
	if not model then
		return nil
	end
	hum.MaxHealth = def.HP
	hum.Health = def.HP
	hum.WalkSpeed = def.Speed
	hum.BreakJointsOnDeath = false -- keep the joints: onEnemyDied turns them into a ragdoll
	model:SetAttribute("Radius", def.Radius)
	model:SetAttribute("Enemy", true)
	local root = model:FindFirstChild("HumanoidRootPart")
	root.CollisionGroup = "EnemyRoot"
	hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
	model:PivotTo(spec.CFrame + Vector3.new(0, 3 * def.Scale - 3, 0))
	pcall(function()
		root:SetNetworkOwner(nil)
		hum:ChangeState(Enum.HumanoidStateType.Running) -- start standing (a waiting rig not "Running" sinks)
	end)
	local shoulder = findShoulder(model)
	local e = {
		def = def,
		char = char, -- its character file (attack, onStagger...)
		spec = spec,
		model = model,
		hum = hum,
		root = root,
		weld = weld,
		scale = def.Scale,
		shoulder = shoulder,
		c0 = shoulder and shoulder.C0,
		home = spec.CFrame,
		alive = true,
		aggro = false,
		attacking = false,
		returning = false,
		staggerUntil = 0,
	}
	enemyByModel[model] = e
	hum.Died:Connect(function()
		onEnemyDied(e)
	end)
	task.spawn(enemyAI, e)
	return e
end

local function respawnEnemies()
	for _, e in ipairs(enemyList) do
		e.alive = false
		enemyByModel[e.model] = nil
		if e.model then
			e.model:Destroy()
		end
	end
	table.clear(enemyList)
	for _, spec in ipairs(Map.EnemySpawns) do
		local _, c = defOf(spec.Type)
		if c and c.Defeated then -- (a gate keeper, once down, stays down)
			continue
		end
		local ok, e = pcall(spawnEnemy, spec)
		if ok and e then
			table.insert(enemyList, e)
		elseif not ok then
			warn("[DGUS] failed to spawn " .. tostring(spec.Type) .. ": " .. tostring(e))
		end
	end
end

function Enemies.respawn()
	respawnEnemies()
end
function Enemies.count()
	return #enemyList
end
function Enemies.byModel(model)
	return enemyByModel[model]
end

function Enemies.init(core)
	Map, EnemiesFolder, Roster = core.Map, core.EnemiesFolder, core.Roster
	now, flat, playSound, SOUNDS, burst, pose, setTrail = core.now, core.flat, core.playSound, core.SOUNDS, core.burst, core.pose, core.setTrail
	faceTowards, findShoulder = core.faceTowards, core.findShoulder
	makeRig, makeCorpse, ragdoll, aliveChar = core.makeRig, core.makeCorpse, core.ragdoll, core.aliveChar
	losParams.FilterDescendantsInstances = { EnemiesFolder, Map.Bars }
	-- hits on a regular enemy: poise, a stagger (any hit staggers the weak ones), knockback
	core.registerTarget(function(model)
		local e = enemyByModel[model]
		if not e then
			return nil
		end
		return {
			owner = e,
			actor = e,
			maxPoise = e.def.Poise,
			freeze = true,
			armor = e.def.HyperArmor and e.attacking,
			onHit = function()
				e.aggro = true
			end,
			onBreak = function(player, t, hitStop)
				local root = e.root
				e.staggerUntil = t + e.def.Stagger
				setTrail(e, false)
				pose(e, "Flinch", 0.1)
				if e.char and e.char.onStagger then
					e.char.onStagger(e)
				end
				task.delay(e.def.Stagger, function()
					if e.alive and not e.attacking then
						pose(e, "Idle", 0.25)
					end
				end)
				local pl = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				if pl then
					local push = flat(root.Position - pl.Position)
					if push.Magnitude > 0.01 then
						task.delay(hitStop or 0, function()
							if root.Parent and not root.Anchored then
								root.AssemblyLinearVelocity = push.Unit * (e.def.StaggerPush or 16) + Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
							end
						end)
					end
				end
			end,
		}
	end)
end

return Enemies
]]></ProtectedString>
					<string name="ScriptGuid">{B40595B6-01FB-4EBD-ACA5-962803C42CE6}</string>
