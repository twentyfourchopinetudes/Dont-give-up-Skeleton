		<Item class="ModuleScript" referent="RBX3786D63241CF4FD99EDE8B627C72EDE7">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- GildedKit: what the Gilded Heights' twenty minor enemies share (Characters/Gilt*.luau and friends): their palette, a set of
-- weapon grips and body poses, and the pieces their fights are made of. Each enemy's own file holds its look, its weapon, its
-- stats and which of these it strings together, and how. The shared brain's still GameServer/Enemies.
-- No ground markings anywhere in here: every attack's read off the body, as the Pyralis brutes' are.
local K = {}

local R = math.rad
local rgb = Color3.fromRGB
K.IVORY, K.CREAM, K.PORCELAIN = rgb(218, 216, 208), rgb(202, 198, 188), rgb(236, 234, 228)
K.GOLD, K.LIGHT, K.TARNISH = rgb(201, 160, 74), rgb(235, 200, 120), rgb(112, 88, 48)
K.RUG, K.LAPIS, K.ROSE, K.JADE, K.AMBER = rgb(120, 24, 44), rgb(30, 70, 150), rgb(150, 40, 90), rgb(24, 120, 100), rgb(170, 100, 30)
K.SILVER, K.SILVER_DK, K.INK, K.LEATHER = rgb(190, 194, 202), rgb(138, 142, 152), rgb(26, 24, 30), rgb(70, 46, 30)
K.BLOSSOM, K.LEAF = rgb(206, 150, 170), rgb(86, 140, 74)

-- the weapon's head along the grip's -Y (Core's convention): 0 hangs it, 90 levels it forward, 180 stands it up
K.Grips = {
	GGuard = { Vector3.new(1.3, -0.6, -0.4), CFrame.Angles(R(18), 0, 0) }, -- hanging at the side
	GReady = { Vector3.new(1.0, 0.1, -1.2), CFrame.Angles(R(120), 0, R(-8)) }, -- held up in front, en garde
	GLevel = { Vector3.new(1.0, 0.3, -0.9), CFrame.Angles(R(88), 0, 0) }, -- levelled at you
	GPort = { Vector3.new(1.0, 0.2, -0.7), CFrame.Angles(R(172), 0, R(-6)) }, -- stood upright before it
	GRaise = { Vector3.new(0.7, 2.6, 0.5), CFrame.Angles(R(215), 0, 0) }, -- overhead, the head behind
	GSlam = { Vector3.new(0.6, -0.8, -2.0), CFrame.Angles(R(55), 0, 0) }, -- brought down into the floor in front
	GDraw = { Vector3.new(1.3, 0.6, 1.1), CFrame.Angles(R(90), 0, 0) }, -- drawn back to thrust
	GThrust = { Vector3.new(0.4, 0.5, -2.7), CFrame.Angles(R(90), 0, 0) }, -- driven through
	GCock = { Vector3.new(1.4, 1.9, 0.2), CFrame.Angles(R(210), 0, R(30)) }, -- up and back over the right shoulder
	GCut = { Vector3.new(-0.4, 0.2, -1.8), CFrame.Angles(R(68), 0, R(-37)) }, -- cut through, across to the left
	GBack = { Vector3.new(2.0, 0.7, 0.5), CFrame.Angles(0, R(-120), 0) * CFrame.Angles(R(90), 0, 0) }, -- flat, round behind to the right
	GSweep = { Vector3.new(-1.1, 0.5, -1.4), CFrame.Angles(0, R(60), 0) * CFrame.Angles(R(90), 0, 0) }, -- flat, swept through to the left
	GWide = { Vector3.new(1.9, 0.3, 0.1), CFrame.Angles(R(10), 0, R(70)) }, -- thrown out wide
	GHigh = { Vector3.new(0.9, 3.1, -0.6), CFrame.Angles(R(170), 0, 0) }, -- held up high in the air
	GToss = { Vector3.new(1.3, 1.5, 0.9), CFrame.Angles(R(150), 0, R(10)) }, -- wound back at the ear, to throw
	GTossed = { Vector3.new(0.7, 1.1, -2.0), CFrame.Angles(R(95), 0, 0) }, -- the arm thrown out after it
}
K.Poses = {
	GBSet = { drop = 0.25, lean = -0.32, twist = 0.3, head = -0.15, footR = -0.45, footL = 0.5, la1 = 0.5, la3 = -0.5, lel = 0.6, freeL = 0 },
	GBStrike = { drop = 0.7, lean = 0.6, twist = -0.25, head = 0.2, footR = 0.75, footL = -0.6, la1 = -0.3, la3 = -0.3, lel = 0.3, freeL = 0 },
	GBDraw = { drop = 0.55, lean = 0.1, twist = 0.6, head = -0.05, footR = -0.7, footL = 0.7, spread = 0.2, la1 = 0.8, la3 = -0.6, lel = 0.6, freeL = 0 },
	GBLunge = { drop = 0.75, lean = 0.75, twist = -0.4, head = -0.15, footR = 1.1, footL = -1.0, spread = 0.18, la1 = -0.6, la3 = -0.5, lel = 0.2, freeL = 0 },
	GBWind = { drop = 0.4, lean = 0.12, twist = 0.95, hip = 0.35, footR = -0.45, footL = 0.45, la1 = 0.6, la3 = -0.9, lel = 0.5, freeL = 0 },
	GBSweep = { drop = 0.5, lean = 0.32, twist = -0.95, hip = -0.35, footR = 0.5, footL = -0.3, la1 = -0.4, la3 = -0.6, lel = 0.3, freeL = 0 },
	GBLow = { drop = 1.1, lean = 0.55, head = -0.2, spread = 0.3, footR = 0.45, footL = -0.45, la1 = 0.3, la3 = -0.5, freeL = 0, breathe = 3 },
	GBAir = { drop = 0.2, lean = 0.4, tuck = 0.7, la1 = 0.6, la3 = -0.7, freeL = 0 },
	GBLand = { drop = 1.3, lean = 0.75, head = -0.2, spread = 0.4, footR = 0.9, footL = -1.0, la1 = -0.6, la3 = -1.0, lel = 0.3, freeL = 0, breathe = 4 },
	GBCast = { drop = 0.2, lean = -0.22, head = -0.3, footR = -0.35, footL = 0.4, la1 = 2.0, la3 = -0.6, lel = 0.5, freeL = 0, breathe = 3 },
	GBFling = { drop = 0.5, lean = 0.55, twist = -0.5, head = 0.05, footR = 0.75, footL = -0.6, la1 = 1.3, la2 = 0.3, la3 = -0.2, lel = 0.2, freeL = 0 },
	GBSpin = { drop = 0.45, lean = -0.05, head = -0.08, spread = 0.36, footR = -0.25, footL = 0.25, la1 = 1.2, la3 = -1.1, lel = 0.3, freeL = 0 },
	GBDraught = { drop = 0.45, lean = -0.32, head = -0.4, spread = 0.4, footR = -0.4, footL = 0.4, breathe = 7, freeL = 0 },
	GBBlow = { drop = 0.55, lean = 0.38, head = 0.12, spread = 0.42, footR = -0.45, footL = 0.5, freeL = 0, breathe = 1 },
	GBBrace = { drop = 0.6, lean = 0.18, head = 0.05, spread = 0.32, footR = -0.6, footL = 0.65, la1 = 1.1, la2 = 0.4, la3 = -0.1, lel = 1.4, freeL = 0 },
}

-- every enemy's Def starts from these; a file's own table goes over the top
function K.def(over)
	local d = {
		HP = 420, Speed = 10.5, Scale = 1.25, Damage = 38, Range = 9.5, HalfAngle = 55,
		Windup = 0.85, Recover = 1, Aggro = 38, Leash = 55, Stagger = 0.5, StaggerPush = 10,
		HyperArmor = false, Radius = 1.6, Lunge = 9, Poise = 65, HitLevel = "Large", Engage = 12, Close = 8,
		IdleGrip = "GGuard", Skin = K.IVORY, Cloth = K.RUG,
	}
	for key, v in pairs(over) do
		d[key] = v
	end
	return d
end
-- fills in a character file: the shared poses and grips under its own, the kit's init
function K.wrap(M)
	local function merged(base, own)
		local t = table.clone(base)
		for key, v in pairs(own or {}) do
			t[key] = v
		end
		return t
	end
	M.Poses, M.Grips = merged(K.Poses, M.Poses), merged(K.Grips, M.Grips)
	M.init = K.init
	return M
end
-- a strip of cloth hung off an anchor (Carrier.cloth, on every client), as the Silver Knight's cape is
function K.cloth(p, segs, len, width, color, phys)
	p.Transparency = 1
	for key, v in pairs(phys or {}) do
		p:SetAttribute(key, v)
	end
	p:SetAttribute("Segs", segs)
	p:SetAttribute("Len", len)
	p:SetAttribute("Width", width)
	p:SetAttribute("Color", color)
	game:GetService("CollectionService"):AddTag(p, "ClothChain")
	return p
end
K.BACK = CFrame.Angles(0, math.pi, 0) -- (a cape anchor's turn: hanging out behind)
K.UP = CFrame.Angles(0, 0, math.pi / 2) -- (a cylinder stood on end)
K.FACE = CFrame.Angles(0, math.pi / 2, 0) -- (a cylinder's end turned to the front: a disc)

---------------------------------------------------------------------------
-- server: the pieces of a fight
---------------------------------------------------------------------------
local core
local pose, bodyPose, playSound, SOUNDS, now, faceTowards, setTrail, flat, playersInSector, playersInRadius, damagePlayer, burst, dustCloud, FxRemote
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

function K.init(c)
	if core then
		return
	end
	core = c
	pose, bodyPose, playSound, SOUNDS, now, faceTowards, setTrail, flat = c.pose, c.bodyPose, c.playSound, c.SOUNDS, c.now, c.faceTowards, c.setTrail, c.flat
	playersInSector, playersInRadius, damagePlayer, burst, dustCloud, FxRemote = c.playersInSector, c.playersInRadius, c.damagePlayer, c.burst, c.dustCloud, c.FxRemote
end

local function hold(e, duration, target) -- (false if it's staggered or slain in the meantime)
	local t0 = now()
	while now() - t0 < duration do
		if not e.alive or now() < e.staggerUntil then
			return false
		end
		if target and target.Parent then
			faceTowards(e.root, target.Position)
		end
		task.wait()
	end
	return true
end
K.hold = hold
local function feet(e)
	return e.root.Position - Vector3.new(0, 3 * e.def.Scale - 0.2, 0)
end
K.feet = feet
local function step(e, k)
	local v = e.root.AssemblyLinearVelocity
	e.root.AssemblyLinearVelocity = flat(e.root.CFrame.LookVector) * e.def.Lunge * (k or 1) + Vector3.new(0, v.Y, 0)
end
K.step = step
local function ahead(e, d) -- on the floor, d out in front
	return feet(e) + flat(e.root.CFrame.LookVector) * d
end
K.ahead = ahead
function K.partOf(e, name)
	return e.model:FindFirstChild(name, true)
end
function K.shake(pos, amount)
	FxRemote:FireAllClients("Shake", pos, amount)
end
function K.sound(e, name, vol, speed)
	playSound(e.root, SOUNDS[name] or name, vol or 0.6, speed or 1)
end
function K.face(e, pos)
	faceTowards(e.root, pos)
end
function K.setGrip(e, name, t, style)
	pose(e, name, t or 0.3, style or Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
end
function K.setBody(e, name, t)
	bodyPose(e, name, t or 0.3)
end
-- everyone on the floor round a point
function K.area(at, radius, height, damage, level)
	for _, pl in ipairs(playersInRadius(at, radius, height or 4)) do
		damagePlayer(pl, damage, at, level or "Medium")
	end
end
-- everyone in a straight line out in front of a frame, length long and width to each side
function K.line(cf, length, width, height)
	local out = {}
	for _, pl in ipairs(playersInSector(cf, length, 90, height)) do
		local hrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
		if hrp then
			local rel = cf:PointToObjectSpace(hrp.Position)
			if math.abs(rel.X) <= width and rel.Z <= 1 then
				table.insert(out, pl)
			end
		end
	end
	return out
end
function K.hurt(pl, damage, from, level, push)
	return damagePlayer(pl, damage, from, level, push)
end
-- sparks and a dying light at a point: what a burst of something looks like
function K.flash(pos, color, size)
	burst(pos, color, 30, 0.6, (size or 10) * 2)
	local p = Instance.new("Part")
	p.Name = "GildedFlash"
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Transparency, p.Size, p.CFrame = 1, Vector3.one, CFrame.new(pos)
	p.Parent = workspace
	local l = Instance.new("PointLight")
	l.Color, l.Range, l.Brightness = color, (size or 10) * 3, 6
	l.Parent = p
	game:GetService("TweenService"):Create(l, TweenInfo.new(0.5), { Brightness = 0 }):Play()
	Debris:AddItem(p, 0.6)
end

-- wound up, then a blow in front of it. o: set, setBody, tell, swing, swingBody, time, range, half, damage, level, lunge, speed
function K.strike(e, tRoot, o)
	local def, root = e.def, e.root
	local tell = o.tell or def.Windup
	if o.set then
		pose(e, o.set, tell * 0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	end
	if o.setBody then
		bodyPose(e, o.setBody, tell * 0.8)
	end
	if not o.quiet then
		playSound(root, SOUNDS.Unsheath, 0.4, o.speed or 0.7)
	end
	if not hold(e, tell, tRoot) then
		return false
	end
	setTrail(e, true)
	playSound(root, SOUNDS.Slash, 0.65, o.speed or 0.7)
	local t = o.time or 0.16
	if o.swing then
		pose(e, o.swing, t, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	if o.swingBody then
		bodyPose(e, o.swingBody, t)
	end
	step(e, o.lunge or 1)
	task.wait(t * 0.8)
	if not e.alive then
		return false
	end
	local hit = false
	for _, pl in ipairs(playersInSector(root.CFrame, o.range or def.Range, o.half or def.HalfAngle, 6 * def.Scale)) do
		if damagePlayer(pl, o.damage or def.Damage, root.Position, o.level or def.HitLevel) then
			hit = true
		end
	end
	if o.after then
		o.after(ahead(e, (o.range or def.Range) * 0.55), hit)
	end
	task.wait(0.08)
	setTrail(e, false)
	return e.alive, hit
end
-- a blow into the floor, and the stone jumping round it (a shudder and dust: no ring, no marking)
function K.slam(e, tRoot, o)
	local after = o.after
	o = table.clone(o)
	o.after = function(at, hit)
		for _, pl in ipairs(playersInRadius(at, o.area or 6, 3.5)) do
			damagePlayer(pl, o.areaDamage or (o.damage or e.def.Damage) * 0.6, at, "Medium")
		end
		burst(at, o.color or K.IVORY, 26, 0.6, 20)
		dustCloud(at, o.area or 6, 12)
		playSound(e.root, SOUNDS.WatchdogSmash, 0.75, o.boom or 0.9)
		K.shake(at, o.shake or 0.45)
		if after then
			after(at, hit)
		end
	end
	return K.strike(e, tRoot, o)
end
function K.combo(e, tRoot, list)
	for _, o in ipairs(list) do
		if not K.strike(e, tRoot, o) then
			return false
		end
	end
	return true
end

-- a straight rush at where you stood when the tell ended, stopping at any wall. Hits once. o: set, setBody, tell, drive, driveBody,
-- speed, time, reach, damage, level, onDone(hit)
function K.rush(e, tRoot, o)
	local def, root, hum = e.def, e.root, e.hum
	local tell = o.tell or def.Windup
	if o.set then
		pose(e, o.set, tell * 0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	end
	if o.setBody then
		bodyPose(e, o.setBody, tell * 0.8)
	end
	if not hold(e, tell, tRoot) then
		return false
	end
	if o.drive then
		pose(e, o.drive, 0.1)
	end
	if o.driveBody then
		bodyPose(e, o.driveBody, 0.1)
	end
	setTrail(e, true)
	playSound(root, SOUNDS.Lunge, 0.8, o.pitch or 0.7)
	local dir = flat(root.CFrame.LookVector)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = { e.model, core.EnemiesFolder }
	rp.RespectCanCollide = true
	local hits, any, t0 = {}, false, now()
	while now() - t0 < (o.time or 0.5) do
		if not e.alive or now() < e.staggerUntil then
			break
		end
		if workspace:Raycast(root.Position, dir * (def.Radius + 2), rp) then
			break
		end
		root.AssemblyLinearVelocity = dir * (o.speed or 40) + Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
		for _, pl in ipairs(playersInRadius(root.Position + dir * 2, o.reach or 4.5, 6 * def.Scale)) do
			if not hits[pl] then
				hits[pl] = true
				if damagePlayer(pl, o.damage or def.Damage, root.Position, o.level or def.HitLevel) then
					any = true
				end
			end
		end
		RunService.Heartbeat:Wait()
	end
	root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
	hum:MoveTo(root.Position)
	setTrail(e, false)
	if o.onDone then
		o.onDone(any)
	end
	return e.alive, any
end

-- up and over, coming down where you stood when it left the floor. Short of any wall, and it won't go if there's no floor there.
-- o: set, setBody, tell, air, airBody, land, landBody, time, height, damage, area, level, color, onLand(at)
function K.leap(e, tRoot, o)
	local def, root = e.def, e.root
	local tell = o.tell or def.Windup
	if o.set then
		pose(e, o.set, tell * 0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	end
	bodyPose(e, o.setBody or "GBLow", tell * 0.8)
	if not hold(e, tell, tRoot) or not tRoot.Parent then
		return false
	end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = { e.model, tRoot.Parent, core.EnemiesFolder }
	rp.RespectCanCollide = true
	local from = root.Position
	local goal = Vector3.new(tRoot.Position.X, from.Y, tRoot.Position.Z)
	local wall = workspace:Raycast(from, goal - from, rp)
	if wall then
		goal = wall.Position - (goal - from).Unit * (def.Radius + 1.5)
	end
	local below = workspace:Raycast(goal + Vector3.new(0, 4, 0), Vector3.new(0, -16, 0), rp)
	if not below then -- (nothing to come down on: it stays where it is)
		return true
	end
	goal = below.Position + Vector3.new(0, 3 * def.Scale + 0.1, 0)
	local top = workspace:Raycast(from, Vector3.new(0, o.height or 12, 0), rp)
	local rise = top and math.max(top.Distance - 5 * def.Scale, 0) or (o.height or 12)
	if o.air then
		pose(e, o.air, 0.14)
	end
	bodyPose(e, o.airBody or "GBAir", 0.14)
	setTrail(e, true)
	playSound(root, SOUNDS.Lunge, 0.9, o.pitch or 0.55)
	root.Anchored = true
	local T, t0, look = o.time or 0.7, now(), flat(goal - from)
	look = look.Magnitude > 0.5 and look.Unit or flat(root.CFrame.LookVector)
	while true do
		local u = math.min((now() - t0) / T, 1)
		if not e.alive then
			break
		end
		local p = from:Lerp(goal, u) + Vector3.new(0, rise * 4 * u * (1 - u), 0)
		root.CFrame = CFrame.lookAt(p, p + look)
		if u >= 1 then
			break
		end
		RunService.Heartbeat:Wait()
	end
	root.Anchored = false
	if not e.alive then
		return false
	end
	if o.land then
		pose(e, o.land, 0.08)
	end
	bodyPose(e, o.landBody or "GBLand", 0.08)
	local at = feet(e)
	for _, pl in ipairs(playersInRadius(at, o.area or 7, 4)) do
		damagePlayer(pl, o.damage or def.Damage, at, o.level or "Knockdown")
	end
	burst(at, o.color or K.IVORY, 28, 0.6, 22)
	dustCloud(at, o.area or 7, 12)
	playSound(root, SOUNDS.WatchdogSmash, 0.85, o.boom or 0.9)
	K.shake(at, o.shake or 0.5)
	if o.onLand then
		o.onLand(at)
	end
	setTrail(e, false)
	return true
end

-- spins on the spot, then comes at you still going. o: grip, body, wind, time, radius, damage, every, speed, turn
function K.whirl(e, tRoot, o)
	local def, root, hum = e.def, e.root, e.hum
	if o.grip then
		pose(e, o.grip, 0.25)
	end
	bodyPose(e, o.body or "GBSpin", 0.25)
	playSound(root, SOUNDS.Unsheath, 0.5, 0.7)
	if not hold(e, o.wind or 0.55, tRoot) then
		return false
	end
	setTrail(e, true)
	local hits, t0, last, yaw, lastWhoosh, ok = {}, now(), now(), 0, 0, true
	while now() - t0 < (o.time or 2) do
		local t = now()
		local dt = t - last
		last = t
		if not e.alive or t < e.staggerUntil then
			ok = false
			break
		end
		local turn = (o.turn or 13) * math.min((t - t0) / 0.5 + 0.2, 1)
		yaw = turn * dt
		root.CFrame *= CFrame.Angles(0, yaw, 0)
		if tRoot.Parent then
			hum.WalkSpeed = o.speed or 7
			hum:MoveTo(tRoot.Position)
		end
		if t - lastWhoosh > 0.45 then
			lastWhoosh = t
			playSound(root, SOUNDS.Lunge, 0.5, 0.65)
		end
		for _, pl in ipairs(playersInRadius(root.Position, o.radius or 7, 6 * def.Scale)) do
			if t - (hits[pl] or -99) > (o.every or 0.6) then
				hits[pl] = t
				damagePlayer(pl, o.damage or def.Damage * 0.5, root.Position, "Medium")
			end
		end
		RunService.Heartbeat:Wait()
	end
	hum.WalkSpeed = def.Speed
	hum:MoveTo(root.Position)
	setTrail(e, false)
	return ok
end

-- something flung. o: from (a Vector3), vel, damage, level, radius, life, gravity, size, color, material, shape, make(part),
-- home (radians a second it can turn towards homeOn), homeOn, trail (Color3), onLand(pos), spin
function K.shot(e, o)
	local p = Instance.new("Part")
	p.Name = "GildedShot"
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Size = o.size or Vector3.new(0.7, 0.7, 0.7)
	p.Shape = o.shape or Enum.PartType.Ball
	p.Color, p.Material = o.color or K.GOLD, o.material or Enum.Material.Metal
	p.CFrame = CFrame.new(o.from)
	if o.make then
		o.make(p)
	end
	p.Parent = workspace
	Debris:AddItem(p, (o.life or 3) + 1)
	if o.trail then
		local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
		a0.Position, a1.Position = Vector3.new(0, 0.3, 0), Vector3.new(0, -0.3, 0)
		a0.Parent, a1.Parent = p, p
		local tr = Instance.new("Trail")
		tr.Attachment0, tr.Attachment1 = a0, a1
		tr.Color = ColorSequence.new(o.trail)
		tr.LightEmission, tr.Lifetime = 0.6, 0.3
		tr.Transparency = NumberSequence.new(0.2, 1)
		tr.Parent = p
	end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = { e.model, core.EnemiesFolder }
	rp.RespectCanCollide = true
	task.spawn(function()
		local vel, t0, last, spin = o.vel, now(), now(), 0
		local g = Vector3.new(0, -(o.gravity or 0), 0)
		while p.Parent and now() - t0 < (o.life or 3) do
			RunService.Heartbeat:Wait()
			local t = now()
			local dt = t - last
			last = t
			if o.home and o.homeOn and o.homeOn.Parent then
				local want = (o.homeOn.Position - p.Position).Unit
				local sp = vel.Magnitude
				local turn = math.min(o.home * dt, 1)
				vel = vel.Unit:Lerp(want, turn).Unit * sp
			end
			vel += g * dt
			local from, to = p.Position, p.Position + vel * dt
			for _, pl in ipairs(o.visual and {} or playersInRadius(to, o.radius or 1.5, (o.radius or 1.5) + 3)) do
				if damagePlayer(pl, o.damage or 18, from, o.level or "Small") then
					burst(to, p.Color, 10, 0.3, 12)
					p:Destroy()
					return
				end
			end
			local hit = workspace:Raycast(from, to - from, rp)
			if hit then
				burst(hit.Position, p.Color, 8, 0.3, 10)
				if o.onLand then
					o.onLand(hit.Position)
				end
				p:Destroy()
				return
			end
			spin += (o.spin or 0) * dt
			p.CFrame = CFrame.lookAt(to, to + vel) * CFrame.Angles(0, 0, spin)
		end
		if p.Parent then
			p:Destroy()
		end
	end)
	return p
end

-- whatever's held out on a part breathing out a cone. o: part, set, setBody, draw, blowBody, time, reach, half, damage, tick, c0, c1, c2,
-- poison (standing in it, Config's poison)
function K.breath(e, tRoot, o)
	local def, root = e.def, e.root
	if o.set then
		pose(e, o.set, 0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	end
	bodyPose(e, o.setBody or "GBDraught", (o.draw or 1) * 0.8)
	playSound(root, SOUNDS.FireHit, 0.3, 0.4)
	if not hold(e, o.draw or 1, tRoot) then
		return false
	end
	bodyPose(e, o.blowBody or "GBBlow", 0.15)
	local src = o.part or root
	local em = Instance.new("ParticleEmitter")
	em.Texture = o.texture or "rbxasset://textures/particles/smoke_main.dds"
	em.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, o.c0), ColorSequenceKeypoint.new(0.4, o.c1), ColorSequenceKeypoint.new(1, o.c2) })
	em.LightEmission = o.glow or 0.6
	em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, o.spread or 5) })
	em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	em.Lifetime, em.Rate, em.Speed = NumberRange.new(0.35, 0.55), 120, NumberRange.new((o.reach or 13) * 1.8, (o.reach or 13) * 2.4)
	em.EmissionDirection, em.SpreadAngle = Enum.NormalId.Front, Vector2.new(o.half or 20, o.half or 20)
	em.Rotation, em.RotSpeed = NumberRange.new(0, 360), NumberRange.new(-200, 200)
	em.Parent = src
	playSound(root, SOUNDS.FireHit, 0.7, o.pitch or 0.6)
	local t0, lastTick = now(), -1
	while now() - t0 < (o.time or 1.2) and e.alive and now() >= e.staggerUntil do
		if now() - lastTick >= (o.tick or 0.3) then
			lastTick = now()
			for _, pl in ipairs(playersInSector(root.CFrame, o.reach or 13, o.half or 24, 6 * def.Scale)) do
				damagePlayer(pl, o.damage or 11, root.Position, "Small")
				if o.poison then
					core.poisonPlayer(pl, o.poison)
				end
			end
		end
		task.wait()
	end
	em.Enabled = false
	Debris:AddItem(em, 0.7)
	return e.alive
end

-- a cloud hanging where it's put, for a while. o: radius, life, color, tick, damage, poison
function K.cloud(pos, o)
	local p = Instance.new("Part")
	p.Name = "GildedCloud"
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.Transparency = true, false, false, false, 1
	p.Size = Vector3.new(o.radius * 1.6, 2, o.radius * 1.6)
	p.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
	p.Parent = workspace
	local em = Instance.new("ParticleEmitter")
	em.Texture = o.texture or "rbxasset://textures/particles/smoke_main.dds"
	em.Color = ColorSequence.new(o.color)
	em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 5) })
	em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.45), NumberSequenceKeypoint.new(1, 1) })
	em.Lifetime, em.Rate, em.Speed = NumberRange.new(1, 1.8), o.rate or 30, NumberRange.new(0.5, 1.5)
	em.SpreadAngle = Vector2.new(180, 180)
	em.Rotation, em.RotSpeed = NumberRange.new(0, 360), NumberRange.new(-40, 40)
	em.Parent = p
	Debris:AddItem(p, o.life + 2)
	task.spawn(function()
		local t0 = now()
		while now() - t0 < o.life do
			task.wait(o.tick or 0.5)
			for _, pl in ipairs(playersInRadius(pos, o.radius, 6)) do
				if o.damage then
					damagePlayer(pl, o.damage, pos, "Small")
				end
				if o.poison then
					core.poisonPlayer(pl, o.poison)
				end
			end
		end
		em.Enabled = false
	end)
	return p
end

-- where a thing thrown from from, at speed, must go to land on the target about now (a little lead)
function K.aim(from, tRoot, speed, lead)
	local at = tRoot.Position + tRoot.AssemblyLinearVelocity * Vector3.new(1, 0, 1) * (lead or 0.15)
	return (at - from).Unit * speed
end
function K.hand(e)
	local h = e.weld and e.weld.Part1
	return h and h.Position or e.root.Position + Vector3.new(0, 1, 0)
end
-- M.attack from a picker: pick(e, tRoot, distance) runs its moves and returns (carried on?, rest after)
function K.brain(pick)
	return function(e, targetChar)
		local def, hum, root = e.def, e.hum, e.root
		local tRoot = targetChar:FindFirstChild("HumanoidRootPart")
		if not tRoot then
			return
		end
		e.attacking = true
		hum:MoveTo(root.Position)
		hum.AutoRotate = false
		local ok, rest = pick(e, tRoot, flat(tRoot.Position - root.Position).Magnitude)
		if ok then
			hold(e, rest or def.Recover)
		end
		setTrail(e, false)
		if root.Anchored then
			root.Anchored = false
		end
		if e.alive then
			pose(e, "Idle", 0.4)
		end
		hum.WalkSpeed = def.Speed
		hum.AutoRotate = true
		e.attacking = false
	end
end

return K
]]></ProtectedString>
				<string name="ScriptGuid">{33FC7F8E-F119-4053-A4B2-3853CE064168}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">GildedKit</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">1b708a45896e4346a55e0b5e1c61178d</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX126AE7E99233449A9F0F3BBFA00ECF62">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- How the Wardens are dressed: nothing on them is one big box. The rig's own boxes are shrunk out of sight (G.sink), and what you see
-- is built over them from small parts: rings of overlapping folds round an oval body, wrapped limbs, jointed fists, hoops of short
-- rounded pieces. Every function takes the k that RigBuilder hands to M.Look; sizes are unscaled, like k.V and k.at.
local CollectionService = game:GetService("CollectionService")

local G = {}
local TAU = 2 * math.pi
local CYL = Enum.PartType.Cylinder
G.UP = CFrame.Angles(0, 0, math.pi / 2) -- (a cylinder's axis is its X: this stands it upright)

-- the rig's own boxes, shrunk and darkened inside whatever's built over them
function G.sink(k, names, factor, color)
	for _, n in ipairs(names) do
		local p = k.parts[n]
		if p then
			p.Size *= factor
			p.Color = color
		end
	end
end

-- a ring of cloth folds round an oval: o = { a, c (radii across and front-to-back), top, bottom, n, tiers, color, dark, flare?, name? }.
-- Tiers overlap like shingles, each offset from the last, so no seam runs the whole way down
function G.shell(k, on, rng, o)
	local deco, V, at = k.deco, k.V, k.at
	local tall = (o.top - o.bottom) / o.tiers
	local around = TAU * math.sqrt((o.a * o.a + o.c * o.c) / 2)
	for t = 1, o.tiers do
		local y = o.top - (t - 0.5) * tall
		local grow = 1 + (o.tiers - t) * 0.04 -- (the upper tier lies over the lower)
		for i = 0, o.n - 1 do
			local ang = (i + (t % 2) * 0.5) / o.n * TAU + rng:NextNumber(-0.04, 0.04)
			local x, z = math.sin(ang) * o.a * grow, math.cos(ang) * o.c * grow
			local col = o.color:Lerp(o.dark, rng:NextNumber() ^ 1.4)
			local tilt = -(o.flare or 0.05) + rng:NextNumber(-0.05, 0.05)
			deco(on, o.name or "Fold", V(around / o.n * rng:NextNumber(1.25, 1.55), tall * rng:NextNumber(1.15, 1.4), rng:NextNumber(0.05, 0.09)), at(x, y + rng:NextNumber(-0.03, 0.03), z) * CFrame.Angles(0, ang, 0) * CFrame.Angles(tilt, 0, rng:NextNumber(-0.05, 0.05)), col, k.MAT.Fabric)
		end
	end
end

-- a closed hoop of short rounded pieces, flat in the part's XZ plane, on an oval (a rope, a belt, a rim, a band)
function G.hoop(k, on, y, a, c, n, thick, color, mat, name)
	local deco, V, at = k.deco, k.V, k.at
	local around = TAU * math.sqrt((a * a + c * c) / 2)
	for i = 0, n - 1 do
		local ang = i / n * TAU
		deco(on, name or "Hoop", V(around / n * 1.18, thick, thick), at(math.sin(ang) * a, y, math.cos(ang) * c) * CFrame.Angles(0, ang, 0), color, mat, CYL)
	end
end

-- one flat round slice, stood level
function G.disc(k, on, y, r, h, color, mat, name, tilt)
	k.deco(on, name or "Disc", k.V(h, r * 2, r * 2), k.at(0, y, 0) * CFrame.Angles(tilt or 0, 0, 0) * G.UP, color, mat, CYL)
end

-- a limb bound in strips, top to bottom
function G.wraps(k, on, rng, top, bottom, r, count, color, dark, mat)
	local step = (top - bottom) / count
	for i = 0, count - 1 do
		G.disc(k, on, top - (i + 0.5) * step, r * rng:NextNumber(0.96, 1.05), step * 1.3, color:Lerp(dark, rng:NextNumber()), mat, "Wrap", rng:NextNumber(-0.13, 0.13))
	end
end

-- the fist round a grip: palm, four fingers, thumb. y: its middle on that part. The rig's own square fist goes
function G.fist(k, on, y, w, color, dark)
	local deco, V, at, MAT = k.deco, k.V, k.at, k.MAT
	G.disc(k, on, y + 0.05, w * 0.46, w * 0.72, dark, MAT.Fabric, "Palm")
	for i = 0, 3 do
		local fy = y + w * (0.24 - i * 0.16)
		deco(on, "Finger", V(w * 0.84, w * 0.2, w * 0.2), at(0, fy, -w * 0.36), color, MAT.Fabric, CYL)
		deco(on, "Knuckle", V(w * 0.2, w * 0.2, w * 0.2), at(w * 0.36, fy, -w * 0.24), color, MAT.Fabric, Enum.PartType.Ball)
	end
	deco(on, "Thumb", V(w * 0.62, w * 0.24, w * 0.24), at(-w * 0.34, y + w * 0.1, -w * 0.26) * CFrame.Angles(0, math.pi / 2, 0.4), color, MAT.Fabric, CYL)
end
function G.hideRigFists(k)
	for _, c in ipairs(k.parts.Chest.Parent:GetChildren()) do
		if c.Name == "Fist" then
			c.Transparency = 1
		end
	end
end

-- a boot's foot: rounded lengths side by side, strapped across
function G.foot(k, on, size, color, dark)
	local deco, V, at, MAT = k.deco, k.V, k.at, k.MAT
	local along = CFrame.Angles(0, math.pi / 2, 0)
	for _, x in ipairs({ -0.33, 0, 0.33 }) do
		deco(on, "BootPart", V(size.Z * 0.96, size.X * 0.42, size.X * 0.42), at(x * size.X, 0, 0) * along, color, MAT.Leather, CYL)
	end
	for _, z in ipairs({ -0.28, 0.26 }) do
		deco(on, "BootStrap", V(size.X * 1.14, size.Y * 0.85, 0.09), at(0, 0, z * size.Z), dark, MAT.Leather)
	end
end

-- long cloth to the floor: narrow strips of the game's hanging cloth round an oval, each its own length and shade.
-- o = { a, c, y, n, len (of a segment), color, dark, from?, to? (angles round from the back, in turns) }
function G.skirt(k, on, rng, o)
	local from, to = o.from or 0, o.to or 1
	local around = TAU * math.sqrt((o.a * o.a + o.c * o.c) / 2) * (to - from)
	for i = 0, o.n - 1 do
		local ang = (from + (i + 0.5) / o.n * (to - from)) * TAU
		local col = o.color:Lerp(o.dark, rng:NextNumber())
		local anchor = k.deco(on, "SkirtAnchor", k.V(0.2, 0.2, 0.2), k.at(math.sin(ang) * o.a, o.y, math.cos(ang) * o.c) * CFrame.Angles(0, ang + math.pi, 0), col, k.MAT.SmoothPlastic)
		anchor.Transparency = 1
		anchor:SetAttribute("Drag", 0.95)
		anchor:SetAttribute("Gravity", 1.2)
		anchor:SetAttribute("Segs", 5)
		anchor:SetAttribute("Len", o.len * rng:NextNumber(0.82, 1.08) * k.s)
		anchor:SetAttribute("Width", around / o.n * rng:NextNumber(1.1, 1.45) * k.s)
		anchor:SetAttribute("Color", col)
		CollectionService:AddTag(anchor, "ClothChain")
	end
end

return G
]]></ProtectedString>
				<string name="ScriptGuid">{33FC7F8E-F119-4053-A4B2-3853CE064168}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">WardenGarb</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">525e73d6786540a5a57096397c2dcfd1</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX7933C846294B4A0ABAE5D11BA58CBA1A">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
-- THE WARDEN'S FIGHT: everything the candidate Wardens (Characters/WardenTurnkey, WardenPlate, WardenBones, WardenBell, and the hybrids) share and
-- nothing of who they are: the states, the brain that picks moves, stagger and death, the fog and the exit door, and a kit of
-- helpers for writing moves. Characters/Warden.luau's M.spawn/start/reset/... forward here, so the rest of the game still
-- just talks to Roster.byKind.Warden. The one that stands in the arena is Config.Boss.Trial's.
--
-- A candidate calls F = Fight.init(core) in its M.init, then Fight.define({ ... }):
--   id, label, kind, scale, weapon, idleGrip, hp, poise, stagger, radius
--   walk, turn (deg/s), rest = { lo, hi } (seconds between moves), keep = { near, far } (how close it circles)
--   phase2At (0..1 of its health), tempo2 (multiplies its wind-ups in phase 2), restMult2, walk2 and keep2 (its phase 2 gait and range)
--   moves = { { name, fn(b, target), min, max, weight, cd, phase1?, phase2?, behind?, ground? } ... }
--   onSpawn(b), intro(b), phase2(b), idle(b), onStagger(b), onStaggerEnd(b), stalk(b, tr, rel), approach(b, tr), damageMult(b, player)
local Fight = { specs = {}, order = {} }

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Config = require(ReplicatedStorage:WaitForChild("Config"))

local F = {} -- the kit
local C -- Core
local boss: any = { state = "none", gen = 0 }
local EASE, INOUT = Enum.EasingStyle.Sine, Enum.EasingDirection.InOut
local X1, X2, Z1, Z2 = -43, 43, 217, 303 -- the arena's floor
local FLOOR_Y = 0.12

---------------------------------------------------------------------------
-- the kit: state
---------------------------------------------------------------------------
function F.live(b)
	return boss.gen == b.gen and boss.state == "fight" and b.hum.Parent ~= nil and b.hum.Health > 0
end
function F.free(b)
	return F.live(b) and C.now() >= (boss.staggerUntil or 0)
end
function F.phase2()
	return boss.phase2 == true
end
function F.tempo()
	return boss.phase2 and (boss.spec.tempo2 or 1) or 1
end
function F.gait()
	return boss.phase2 and boss.spec.walk2 or boss.spec.walk
end
-- anything a move has to put right if it's cut short (a thrown weapon, a chain out)
function F.setCleanup(fn)
	boss.cleanup = fn
end
function F.wait(b, t) -- false once the fight's over
	local t0 = C.now()
	while C.now() - t0 < t do
		if not F.live(b) then
			return false
		end
		task.wait()
	end
	return F.live(b)
end
function F.hold(b, t) -- false once it's over or it's been staggered out of the move
	local t0 = C.now()
	while C.now() - t0 < t do
		if not F.free(b) then
			return false
		end
		task.wait()
	end
	return F.free(b)
end
function F.wrap(b, fn) -- a loop of its own: fn(), every frame, while this life lasts and it returns true
	task.spawn(function()
		while boss.gen == b.gen and boss.state ~= "dead" and fn() do
			task.wait()
		end
	end)
end

---------------------------------------------------------------------------
-- the kit: moving
---------------------------------------------------------------------------
function F.clamp(p, margin)
	margin = margin or 0
	return Vector3.new(math.clamp(p.X, X1 + margin, X2 - margin), p.Y, math.clamp(p.Z, Z1 + margin, Z2 - margin))
end
function F.feet(b)
	return b.root.Position - Vector3.new(0, b.model:GetAttribute("StandHeight") or 3, 0)
end
function F.stand(b) -- root height, stood on the arena floor
	return b.model:GetAttribute("StandHeight") or 3
end
function F.fwd(b)
	local v = C.flat(b.root.CFrame.LookVector)
	return v.Magnitude > 0.01 and v.Unit or Vector3.new(0, 0, 1)
end
function F.turn(b, pos, maxRad)
	local root = b.root
	if not root.Anchored then
		C.turnTowards(root, pos, maxRad)
		return
	end
	local want = C.flat(pos - root.Position)
	if want.Magnitude < 0.1 then
		return
	end
	local look = C.flat(root.CFrame.LookVector)
	local yaw, goal = math.atan2(-look.X, -look.Z), math.atan2(-want.X, -want.Z)
	local d = (goal - yaw + math.pi) % (2 * math.pi) - math.pi
	root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw + math.clamp(d, -maxRad, maxRad), 0)
end
function F.halt(b)
	if not b.root.Anchored then
		b.hum:MoveTo(b.root.Position)
	end
end
-- a burst of its own walk toward where it faces
function F.step(b, dist, dur)
	if b.root.Anchored then
		return
	end
	b.hum.WalkSpeed = dist / dur
	b.hum:MoveTo(F.clamp(b.root.Position + F.fwd(b) * dist, 4))
	task.delay(dur, function()
		if boss.gen == b.gen and b.hum.Parent and not b.root.Anchored then
			b.hum.WalkSpeed = F.gait()
			b.hum:MoveTo(b.root.Position)
		end
	end)
end
-- carried bodily along a jump, a to z (root positions), rising height at the top. each(t) every frame. Lands it again unless it
-- hovers. keepYaw: it keeps facing as it was (each can turn it). A newer arc takes over from one still running.
function F.arc(b, a, z, dur, height, each, keepYaw)
	local root = b.root
	root.Anchored = true
	local token = {}
	b.arc = token
	local dir = C.flat(z - a)
	local along = not keepYaw and dir.Magnitude > 0.1
	local t0 = C.now()
	while true do
		local t = math.min((C.now() - t0) / dur, 1)
		local p = a:Lerp(z, t) + Vector3.new(0, 4 * height * t * (1 - t), 0)
		root.CFrame = along and CFrame.lookAt(p, p + dir) or (CFrame.new(p) * root.CFrame.Rotation)
		if each then
			each(t)
		end
		if t >= 1 or boss.gen ~= b.gen or boss.state == "dead" or b.arc ~= token then
			break
		end
		RunService.Heartbeat:Wait()
	end
	if b.arc ~= token then
		return false
	end
	b.arc = nil
	if boss.gen ~= b.gen then
		return false
	end
	root.AssemblyLinearVelocity = Vector3.zero
	if boss.state == "fight" then
		root.Anchored = false
		pcall(function()
			root:SetNetworkOwner(nil)
			b.hum:ChangeState(Enum.HumanoidStateType.Running)
		end)
	end
	return boss.state ~= "dead"
end

---------------------------------------------------------------------------
-- the kit: posing
---------------------------------------------------------------------------
function F.draw(b, grip, body, t)
	boss.idleTok = nil -- (a move has begun: a pending return to stance mustn't land on top of it)
	if grip and b.weld then
		C.pose(b, grip, t, EASE, INOUT)
	end
	if body then
		C.bodyPose(b, body, t)
	end
end
-- wind up, turning toward the target for the first frac of it (then it's committed). false if interrupted
function F.track(b, target, dur, frac, rate)
	local t0 = C.now()
	rate = math.rad(rate or (boss.spec.turn * 1.5))
	while C.now() - t0 < dur do
		if not F.free(b) then
			return false
		end
		local tr = target and target:FindFirstChild("HumanoidRootPart")
		local dt = task.wait()
		if tr and C.now() - t0 < dur * frac then
			F.turn(b, tr.Position, rate * dt)
		end
	end
	return F.free(b)
end
-- a wind-up in beats: { grip, body, seconds, onStart? } each, tracking for the first `track` seconds in all
function F.beats(b, target, list, track)
	local m = F.tempo()
	track = (track or 0) * m
	for _, bt in ipairs(list) do
		local t = bt[3] * m
		F.draw(b, bt[1], bt[2], t)
		if bt[4] then
			bt[4]()
		end
		if not F.track(b, target, t, math.clamp(track / t, 0, 1)) then
			return false
		end
		track -= t
	end
	return true
end
function F.idle(b)
	C.setTrail(b, false)
	if boss.spec.idle then
		boss.spec.idle(b)
	else
		if b.weld then
			C.pose(b, "Idle", 0.5, EASE, INOUT)
		end
		C.bodyPose(b, "Idle", 0.5)
	end
end
function F.recover(b, t, body)
	C.setTrail(b, false)
	if body ~= false then
		C.bodyPose(b, body or "Recover", 0.3)
	end
	if F.hold(b, t * F.tempo()) then
		F.idle(b)
		return true
	end
	return false
end
function F.hideWeapon(b, hidden)
	local w = b.model:FindFirstChild("Weapon")
	if w then
		for _, p in ipairs(w:GetDescendants()) do
			if p:IsA("BasePart") then
				if hidden then
					p:SetAttribute("Was", p:GetAttribute("Was") or p.Transparency)
					p.Transparency = 1
				else
					p.Transparency = p:GetAttribute("Was") or 0
				end
			end
		end
	end
end
-- a loose copy of the weapon in the world (the handle's what to move: everything's welded to it)
function F.cloneWeapon(b)
	local w = b.model:FindFirstChild("Weapon")
	if not w then
		return nil
	end
	local copy = w:Clone()
	local grip = copy:FindFirstChild("GripWeld", true)
	local handle = grip and grip.Part1
	if not handle then
		copy:Destroy()
		return nil
	end
	grip:Destroy()
	for _, p in ipairs(copy:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = p == handle
		elseif p:IsA("Trail") then
			p.Enabled = true
		end
	end
	copy.Parent = boss.fx
	return copy, handle
end

---------------------------------------------------------------------------
-- the kit: hurting
---------------------------------------------------------------------------
function F.dmg(x)
	return math.max(1, math.floor(x * (Config.Boss.DamageScale or 1) + 0.5))
end
function F.hit(list, seen, damage, from, level, push)
	for _, pl in ipairs(list) do
		if not seen[pl] and C.damagePlayer(pl, F.dmg(damage), from, level, push) then
			seen[pl] = true
		end
	end
end
function F.radius(pos, r, height)
	return C.playersInRadius(pos, r, height or 12)
end
function F.ends(b)
	local handle = b.weld and b.weld.Parent and b.weld.Part1
	if not handle or not handle.Parent then
		return nil
	end
	local base, tip = handle:FindFirstChild("BladeBase"), handle:FindFirstChild("BladeTip")
	if base and tip then
		return base.WorldPosition, tip.WorldPosition
	end
	return nil
end
local function toSegment(p, a, z)
	local ab = z - a
	local t = ab:Dot(ab) > 1e-4 and math.clamp((p - a):Dot(ab) / ab:Dot(ab), 0, 1) or 0
	return (a + ab * t - p).Magnitude
end
-- the weapon's real path hurts: sampled every frame, between frames too. Judged from above, as long as it's down at your level:
-- on these giants a blow that visibly reaches you would otherwise pass over a head a quarter of their height
function F.sweep(b, dur, damage, level, seen, radius)
	local t0, pb, pt = C.now(), nil, nil
	while C.now() - t0 < dur and F.live(b) do
		local base, tip = F.ends(b)
		if base then
			pb, pt = pb or base, pt or tip
			for _, pl in ipairs(Players:GetPlayers()) do
				local char, _, hrp = C.aliveChar(pl)
				if char and not seen[pl] then
					local at = Vector3.new(hrp.Position.X, 0, hrp.Position.Z)
					for i = 0, 4 do
						local x, y = pb:Lerp(base, i / 4), pt:Lerp(tip, i / 4)
						if math.min(x.Y, y.Y) < hrp.Position.Y + 9 and toSegment(at, C.flat(x), C.flat(y)) <= radius + 2 then
							F.hit({ pl }, seen, damage, b.root.Position, level)
							break
						end
					end
				end
			end
			pb, pt = base, tip
		end
		RunService.Heartbeat:Wait()
	end
end
function F.toSegment(p, a, z)
	return toSegment(p, a, z)
end

---------------------------------------------------------------------------
-- the kit: things in the world (all in one folder per life, gone when it's reset)
---------------------------------------------------------------------------
function F.part(props)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = boss.fx
	return p
end
local function fade(p, t, goal)
	TweenService:Create(p, TweenInfo.new(t, EASE, Enum.EasingDirection.Out), goal or { Transparency = 1 }):Play()
	task.delay(t + 0.05, function()
		if p.Parent then
			p:Destroy()
		end
	end)
end
F.fade = fade
-- the floor gives something away before it lands here: hairline cracks spreading, grit hopping, a rumble
function F.ring(pos, radius, lead)
	C.groundHeave(Vector3.new(pos.X, FLOOR_Y, pos.Z), radius, lead)
end
-- the same, along a line: something's coming along it
function F.strip(a, z, width, lead)
	local n = math.clamp(math.ceil((z - a).Magnitude / width), 1, 5)
	for i = 0, n do
		F.ring(a:Lerp(z, i / n), width / 2, lead)
	end
end
-- a blow travelling through the floor: a low heave of stone rolling out from center, dust thrown off its crest. You can't outrun
-- it, you roll through it as it reaches you
function F.wave(b, center, speed, maxR, damage, level)
	task.spawn(function()
		local N, segs, seen = 44, {}, {}
		for i = 1, N do
			segs[i] = F.part({ Name = "Wave", Size = Vector3.new(1, 1, 1), Material = Enum.Material.Slate, Color = Color3.fromRGB(82, 78, 72):Lerp(Color3.fromRGB(44, 42, 38), math.random()) })
		end
		local t0, dust = C.now(), 0
		while F.live(b) do
			local r = (C.now() - t0) * speed
			if r > maxR then
				break
			end
			local width = 2 * math.pi * math.max(r, 1) / N * 1.15
			local rise = 2 - r / maxR
			for i, s in ipairs(segs) do
				local a = i / N * 2 * math.pi
				local h = rise * (0.75 + 0.25 * math.sin(i * 2.4))
				local p = Vector3.new(center.X + math.cos(a) * r, FLOOR_Y + h * 0.3, center.Z + math.sin(a) * r)
				s.Transparency = F.clamp(p) == p and 0 or 1 -- (it dies at the walls)
				s.Size = Vector3.new(width, h, 1.7)
				s.CFrame = CFrame.lookAt(p, Vector3.new(center.X, p.Y, center.Z)) * CFrame.Angles(0.4, 0, 0)
			end
			if C.now() > dust then
				dust = C.now() + 0.14
				for _ = 1, 4 do
					local a = math.random() * 2 * math.pi
					local p = Vector3.new(center.X + math.cos(a) * r, FLOOR_Y, center.Z + math.sin(a) * r)
					if F.clamp(p) == p then
						C.dustCloud(p, 1.6, 3)
					end
				end
			end
			for _, pl in ipairs(Players:GetPlayers()) do
				local char, _, hrp = C.aliveChar(pl)
				if char and not seen[pl] and math.abs(C.flat(hrp.Position - center).Magnitude - r) < 2.2 and hrp.Position.Y < 9 then
					F.hit({ pl }, seen, damage, center, level)
				end
			end
			task.wait()
		end
		for _, s in ipairs(segs) do
			s:Destroy()
		end
	end)
end
-- all of it gone (the weapon too) or back
function F.hideBody(b, hidden)
	for _, p in ipairs(b.model:GetDescendants()) do
		if p:IsA("BasePart") and p ~= b.root then
			if hidden then
				p:SetAttribute("Was", p:GetAttribute("Was") or p.Transparency)
				p.Transparency = 1
			else
				p.Transparency = p:GetAttribute("Was") or 0
				p:SetAttribute("Was", nil)
			end
		end
	end
end
-- a part thrown in an arc, a to z; onLand(z) when it's down (if the fight's still on)
function F.lob(b, part, a, z, dur, height, onLand)
	task.spawn(function()
		local t0 = C.now()
		while part.Parent and boss.gen == b.gen do
			local t = math.min((C.now() - t0) / dur, 1)
			part.CFrame = CFrame.new(a:Lerp(z, t) + Vector3.new(0, 4 * height * t * (1 - t), 0)) * CFrame.Angles(t * 7, t * 5, 0)
			if t >= 1 then
				break
			end
			RunService.Heartbeat:Wait()
		end
		if part.Parent then
			part:Destroy()
		end
		if boss.gen == b.gen and F.live(b) then
			onLand(z)
		end
	end)
end
function F.quake(b, pos, r, shake)
	C.shockwave(Vector3.new(pos.X, FLOOR_Y, pos.Z), r)
	C.playSound(b.root, C.SOUNDS.Impact, 1, 0.55)
	C.FxRemote:FireAllClients("Shake", pos, shake or 1)
end

---------------------------------------------------------------------------
-- the brain
---------------------------------------------------------------------------
local function nearest(b)
	local best, bestD, bestPl
	for _, pl in ipairs(Players:GetPlayers()) do
		local char, _, hrp = C.aliveChar(pl)
		if char and hrp.Position.Z > 214 then
			local d = C.flat(hrp.Position - b.root.Position).Magnitude
			if not bestD or d < bestD then
				best, bestD, bestPl = char, d, pl
			end
		end
	end
	return best, bestPl
end
F.nearest = nearest

local function pick(dist, behind, healing)
	local list, total = {}, 0
	local t = C.now()
	for _, mv in ipairs(boss.spec.moves) do
		local allowed = (not mv.phase2 or boss.phase2) and not (mv.phase1 and boss.phase2)
		if allowed and dist >= mv.min and dist <= mv.max and t >= (boss.cd[mv.name] or 0) then
			local w = mv.weight
			if behind then
				w *= mv.behind and 4 or 0.3
			end
			if healing and mv.fast then
				w *= 3
			end
			if mv.name == boss.lastMove then
				w *= 0.2
			end
			total += w
			table.insert(list, { mv, w })
		end
	end
	if total <= 0 then
		return nil
	end
	local r = math.random() * total
	for _, e in ipairs(list) do
		r -= e[2]
		if r <= 0 then
			return e[1]
		end
	end
	return list[#list][1]
end

local function brain(b)
	local spec = boss.spec
	boss.cd, boss.stalkUntil, boss.stalkSide, boss.faceAt = {}, 0, 1, nil
	local turner = RunService.Heartbeat:Connect(function(dt)
		local tr = boss.faceAt
		if tr and tr.Parent and F.free(b) then
			F.turn(b, tr.Position, math.rad(spec.turn) * dt)
		end
	end)
	while F.live(b) do
		task.wait(0.1)
		if not F.live(b) then
			break
		end
		if C.now() < (boss.staggerUntil or 0) then
			continue
		end
		b.hum.AutoRotate = false
		local target, pl = nearest(b)
		if not target then
			F.halt(b)
			continue
		end
		if spec.phase2At and not boss.phase2 and b.hum.Health <= b.hum.MaxHealth * spec.phase2At then
			boss.phase2 = true
			boss.faceAt = nil
			ReplicatedStorage:SetAttribute("Music", "boss2")
			local ok, err = pcall(spec.phase2, b)
			if not ok then
				warn("[DGUS] Warden phase 2 error: " .. tostring(err))
			end
			boss.stalkUntil = C.now() + 0.4
			continue
		end
		local tr = target:FindFirstChild("HumanoidRootPart")
		if not tr then
			continue
		end
		local rel = C.flat(tr.Position - b.root.Position)
		local dist = rel.Magnitude
		local behind = dist > 0.1 and F.fwd(b):Dot(rel.Unit) < -0.15
		local st = C.states[pl]
		local healing = st and st.healing
		local band = boss.phase2 and spec.keep2 or spec.keep
		if C.now() < boss.stalkUntil and not healing then
			boss.faceAt = tr
			if spec.stalk then
				spec.stalk(b, tr, rel)
			elseif dist > 0.1 then
				local keep = math.clamp(dist, band[1], band[2])
				b.hum.WalkSpeed = F.gait() * 0.7
				b.hum:MoveTo(tr.Position + CFrame.Angles(0, boss.stalkSide * 0.55, 0):VectorToWorldSpace(-rel.Unit) * keep)
			end
			continue
		end
		local mv = pick(dist, behind, healing)
		if mv then
			boss.faceAt = nil
			b.hum.WalkSpeed = F.gait()
			boss.lastMove = mv.name
			boss.cd[mv.name] = C.now() + mv.cd
			if Config.Debug then
				print("[Warden] " .. spec.id .. ": " .. mv.name)
			end
			local ok, err = pcall(mv.fn, b, target)
			if not ok then
				warn("[DGUS] Warden move " .. mv.name .. " error: " .. tostring(err))
			end
			if boss.cleanup then
				boss.cleanup()
				boss.cleanup = nil
			end
			if boss.gen == b.gen and b.root.Anchored and boss.state == "fight" then
				b.root.Anchored = false
			end
			boss.stalkSide = math.random() < 0.5 and -1 or 1
			local rest = spec.rest[1] + math.random() * (spec.rest[2] - spec.rest[1])
			boss.stalkUntil = C.now() + rest * (boss.phase2 and (spec.restMult2 or 0.7) or 1)
		else
			boss.faceAt = tr
			if spec.approach then
				spec.approach(b, tr, dist)
			elseif dist < band[1] * 0.6 then
				b.hum.WalkSpeed = F.gait() * 0.8
				b.hum:MoveTo(b.root.Position - rel.Unit * band[1])
			else
				b.hum.WalkSpeed = F.gait()
				b.hum:MoveTo(tr.Position)
			end
		end
	end
	boss.faceAt = nil
	turner:Disconnect()
end

---------------------------------------------------------------------------
-- life and death, and the door
---------------------------------------------------------------------------
local doorHome
local function openWay()
	TweenService:Create(C.Map.Fog, TweenInfo.new(2), { Transparency = 1 }):Play()
	C.Map.Fog.CanCollide = false
	C.Map.FogPrompt.Enabled = false
	local pe = C.Map.Fog:FindFirstChildOfClass("ParticleEmitter")
	if pe then
		pe.Enabled = false
	end
	doorHome = doorHome or C.Map.ExitDoor.CFrame
	TweenService:Create(C.Map.ExitDoor, TweenInfo.new(4, EASE), { CFrame = doorHome + Vector3.new(0, 15.5, 0) }):Play()
	local glow = C.Map.ExitLight:FindFirstChildOfClass("PointLight")
	if glow then
		glow.Enabled = true
	end
	local gen = boss.gen
	task.delay(3.5, function() -- the veil of light behind the door thins away: the Ruined Township lies beyond
		if boss.gen == gen then
			TweenService:Create(C.Map.ExitLight, TweenInfo.new(2.5), { Transparency = 1 }):Play()
			C.Map.ExitLight.CanCollide = false
			C.Map.ExitLight.CanQuery = false
		end
	end)
end
local function onDied(b)
	if boss.gen ~= b.gen or boss.state == "dead" then
		return
	end
	boss.state = "dead"
	C.Save.mark("Warden")
	if boss.cleanup then
		boss.cleanup()
		boss.cleanup = nil
	end
	ReplicatedStorage:SetAttribute("BossActive", false)
	ReplicatedStorage:SetAttribute("Music", "victory")
	C.FxRemote:FireAllClients("Banner", "WARDEN FELLED", "Victory")
	C.dropSplinter(b.root.Position, b.model)
	C.playSound(b.root, C.SOUNDS.Groan, 1, 0.22)
	for _, d in ipairs(b.model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	task.spawn(function()
		if boss.spec.onDied then
			boss.spec.onDied(b)
		end
		for _ = 1, 6 do
			if b.root.Parent then
				C.burst(b.root.Position + Vector3.new(math.random(-4, 4), math.random(-4, 6), math.random(-4, 4)), Color3.fromRGB(70, 66, 60), 40, 1, 10)
			end
			task.wait(0.35)
		end
		for _, d in ipairs(b.model:GetDescendants()) do
			if d:IsA("BasePart") then
				TweenService:Create(d, TweenInfo.new(2), { Transparency = 1 }):Play()
			end
		end
		task.wait(2.2)
		b.model:Destroy()
	end)
	openWay()
end

local function clearLife()
	boss.gen += 1
	boss.cleanup = nil
	if boss.fx then
		boss.fx:Destroy()
	end
	boss.fx = Instance.new("Folder")
	boss.fx.Name = "WardenFx"
	boss.fx.Parent = workspace
	if boss.model then
		boss.model:Destroy()
		boss.model = nil
	end
end

local function spawnBoss()
	clearLife()
	local spec = Fight.specs[boss.id]
	boss.spec = spec
	local model, hum, weld = C.makeRig("Warden", spec.kind, spec.scale, spec.weapon)
	if not model then
		return
	end
	hum.MaxHealth, hum.Health = spec.hp, spec.hp
	hum.WalkSpeed = spec.walk
	hum.BreakJointsOnDeath = false
	hum.AutoRotate = false
	model:SetAttribute("Radius", spec.radius)
	model:SetAttribute("Boss", true)
	local root = model:FindFirstChild("HumanoidRootPart")
	model:PivotTo(C.Map.BossHome + Vector3.new(0, 3 * spec.scale - 3, 0))
	root.Anchored = true -- (pinned at its exact height until its entrance lets it go)
	root.AssemblyLinearVelocity = Vector3.zero
	root.CollisionGroup = "EnemyRoot"
	pcall(function()
		root:SetNetworkOwner(nil)
		hum:ChangeState(Enum.HumanoidStateType.Running)
	end)
	boss.model = model
	boss.phase2, boss.poise, boss.staggerUntil, boss.lastMove = false, nil, 0, nil
	boss.state = "dormant"
	local b = { model = model, hum = hum, root = root, weld = weld, scale = spec.scale, gen = boss.gen, idleGrip = spec.idleGrip }
	boss.current = b
	if weld and spec.idleGrip then
		weld.C0 = C.poseCF(spec.idleGrip, spec.scale)
	end
	ReplicatedStorage:SetAttribute("BossMaxHP", spec.hp)
	ReplicatedStorage:SetAttribute("BossHP", spec.hp)
	hum.HealthChanged:Connect(function(h)
		if boss.gen == b.gen then
			ReplicatedStorage:SetAttribute("BossHP", math.max(0, h))
		end
	end)
	hum.Died:Connect(function()
		onDied(b)
	end)
	if spec.onSpawn then
		spec.onSpawn(b)
	end
end

function Fight.start()
	if boss.state ~= "dormant" then
		return
	end
	boss.state = "intro"
	local b = boss.current
	ReplicatedStorage:SetAttribute("BossName", Config.Boss.Name)
	ReplicatedStorage:SetAttribute("BossMaxHP", b.hum.MaxHealth)
	ReplicatedStorage:SetAttribute("BossHP", b.hum.Health)
	ReplicatedStorage:SetAttribute("BossActive", true)
	ReplicatedStorage:SetAttribute("Music", "boss")
	task.spawn(function()
		local ok, err = pcall(boss.spec.intro, b)
		if not ok then
			warn("[DGUS] Warden intro error: " .. tostring(err))
		end
		if boss.gen ~= b.gen or boss.state ~= "intro" then
			return
		end
		boss.state = "fight"
		b.root.Anchored = false
		pcall(function()
			b.root:SetNetworkOwner(nil)
			b.hum:ChangeState(Enum.HumanoidStateType.Running)
		end)
		F.idle(b)
		task.wait(0.6)
		brain(b)
	end)
end
function Fight.spawn()
	boss.id = boss.id or Fight.specs[Config.Boss.Trial] and Config.Boss.Trial or Fight.order[1]
	if C.Save.done("Warden") then -- (felled in this save: gone, the way on open)
		boss.state = "dead"
		openWay()
		return
	end
	spawnBoss()
end
function Fight.reset()
	if boss.state == "dead" or boss.state == "dormant" then
		return
	end
	ReplicatedStorage:SetAttribute("BossActive", false)
	ReplicatedStorage:SetAttribute("Music", "none")
	spawnBoss()
end
function Fight.state()
	return boss.state
end
function Fight.isDead()
	return boss.state == "dead"
end
function Fight.model()
	return boss.model
end
function Fight.anyoneInArena()
	for _, pl in ipairs(Players:GetPlayers()) do
		local char, _, hrp = C.aliveChar(pl)
		if char and hrp.Position.Z > 214 then
			return true
		end
	end
	return false
end
function Fight.define(spec)
	if not Fight.specs[spec.id] then
		table.insert(Fight.order, spec.id)
	end
	Fight.specs[spec.id] = spec
end

function Fight.init(core)
	if C then
		return F
	end
	C = core
	for _, name in ipairs({ "now", "flat", "SOUNDS", "playSound", "burst", "dustCloud", "shockwave", "debrisChunks", "crackLines", "fadeAway", "pose", "bodyPose", "setTrail", "aliveChar", "states", "FxRemote", "Map" }) do
		F[name] = core[name]
	end
	core.registerTarget(function(model)
		if not boss.model or boss.model ~= model then
			return nil
		end
		return {
			owner = boss,
			actor = boss.current,
			maxPoise = boss.spec.poise,
			freeze = false,
			damageMult = boss.spec.damageMult and function(player)
				return boss.spec.damageMult(boss.current, player)
			end or nil,
			onBreak = function()
				if boss.state ~= "fight" then
					return
				end
				local b, t = boss.current, C.now()
				local dur = boss.spec.stagger
				boss.staggerUntil = t + dur
				if Config.Debug then
					print("[Warden] " .. boss.spec.id .. ": staggered")
				end
				boss.idleTok = nil
				C.setTrail(b, false)
				F.halt(b)
				C.playSound(b.root, C.SOUNDS.Groan, 0.9, 0.5)
				C.FxRemote:FireAllClients("Shake", b.root.Position, 0.5)
				if boss.spec.onStagger then
					boss.spec.onStagger(b, dur)
				else
					if b.weld then
						C.pose(b, "Flinch", 0.15)
					end
					C.bodyPose(b, "Stagger", 0.12)
				end
				local gen = boss.gen
				task.delay(dur, function()
					if boss.gen == gen and boss.state == "fight" then
						if boss.spec.onStaggerEnd then
							boss.spec.onStaggerEnd(b)
						end
						F.idle(b)
					end
				end)
			end,
		}
	end)
	return F
end

return Fight
]]></ProtectedString>
