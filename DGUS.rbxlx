			end
			d.Prompt = prompt(ghost(V3(471.4, PF + 4, 183)), "Lift the bar", "Door", 0.6, 7)
			d.LockedPrompt = prompt(ghost(V3(466.6, PF + 4, 183)), "Open", "Door", 0, 7)
			table.insert(palaceDoors, d)
