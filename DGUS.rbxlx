				return p.X > 470
			end }
			d.Bar = blk("DoorBar", V3(0.7, 0.8, 8), CFrame.new(470.5, PF + 4, 183), MAT.Wood, WOOD, false)
			d.BarAside = CFrame.new(471, PF + 4.2, 188.6) * CFrame.Angles(-0.2, 0, 0) * CFrame.Angles(math.pi / 2, 0, 0)
			for _, z in ipairs({ 179.4, 186.6 }) do
